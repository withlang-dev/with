// sqlite3 3.51.0 (conan-center-index recipes/sqlite3). Every clause cites
// sqlite3.h or the SQLite C API manual.
//
// Raw functions (genuinely unmodeled/unsafe by nature):
// - sqlite3_config, sqlite3_db_config, sqlite3_vtab_config, sqlite3_test_control,
//   sqlite3_file_control: untyped variadic control interfaces whose argument
//   types vary dynamically by op-code.
// - sqlite3_mprintf, sqlite3_vmprintf, sqlite3_snprintf, sqlite3_vsnprintf:
//   printf-style format variadics.
// - sqlite3_vfs_*, sqlite3_create_module*, sqlite3_create_collation*,
//   sqlite3_set_authorizer, sqlite3_commit_hook, sqlite3_rollback_hook,
//   sqlite3_update_hook, sqlite3_trace_v2, sqlite3_progress_handler:
//   callback/vtable hooks with retained raw pointers or custom allocators.
// - sqlite3_malloc*, sqlite3_realloc*, sqlite3_free, sqlite3_msize:
//   raw memory allocator functions.
// - sqlite3_bind_text/blob/pointer (destructor function-pointer convention
//   SQLITE_STATIC/SQLITE_TRANSIENT) and sqlite3_column_blob (interior raw ptr).
// - sqlite3_get_table / sqlite3_free_table: legacy double-pointer result table.
c facts sqlite3 error SqliteError:
    resource Database wraps *mut sqlite3
        from sqlite3_open(out param 1)    // sqlite3.h 3.51.0: opens database connection into *ppDb; returns SQLITE_OK on success and may still allocate *ppDb on failure
        from sqlite3_open_v2(out param 1)    // sqlite3.h 3.51.0: opens database connection with flags and optional VFS name into *ppDb
        drop sqlite3_close    // sqlite3.h 3.51.0: closes database connection and releases its resources
        destroys sqlite3_close_v2    // sqlite3.h 3.51.0: closes database connection (deferring final destruction if statements remain)
        ok SQLITE_OK    // sqlite3.h 3.51.0: SQLITE_OK indicates success
        message sqlite3_errmsg    // sqlite3.h 3.51.0: English-language description of the most recent failed sqlite3_* API call on db
        thread creator    // sqlite3.h 3.51.0: threading mode is runtime/open-flag configured, never inferred
    resource Statement wraps *mut sqlite3_stmt
        from sqlite3_prepare_v2(out param 3)    // sqlite3.h 3.51.0: compiles SQL text into prepared statement *ppStmt
        drop sqlite3_finalize    // sqlite3.h 3.51.0: deletes prepared statement
        borrows param 0    // sqlite3.h 3.51.0: statement depends on its database connection and must be finalized before close
        ok SQLITE_OK    // sqlite3.h 3.51.0: SQLITE_OK indicates success
        message sqlite3_errmsg    // sqlite3.h 3.51.0: parent connection describes prepare/statement errors
        thread creator    // sqlite3.h 3.51.0: bound to creator thread
    handle Context wraps *mut sqlite3_context    // sqlite3.h 3.51.0: callback-scope context passed to application-defined SQL functions
    handle Value wraps *mut sqlite3_value    // sqlite3.h 3.51.0: callback-scope protected value object passed to application-defined SQL functions
    fn sqlite3_open_v2
        nullable param 3    // sqlite3.h 3.51.0: zVfs may be NULL to select the default VFS
