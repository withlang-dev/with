        param pzTail fixed null    // sqlite3.h 3.51.0: NULL declines tail pointer for single-statement prepare
        lend    // sqlite3.c sqlite3ValueNew: p->db = db is db's own error value back-pointer, freed by sqlite3_close
    fn sqlite3_errmsg
