        rename new    // libssh2.h 1.11.1:649: Session.new() mirrors libssh2_session_init()
        param 0 fixed null    // libssh2.h 1.11.1:646: default allocator
        param 1 fixed null    // libssh2.h 1.11.1:647: default deallocator
        param 2 fixed null    // libssh2.h 1.11.1:648: default reallocator
        param 3 fixed null    // libssh2.h 1.11.1:648: NULL abstract user pointer
