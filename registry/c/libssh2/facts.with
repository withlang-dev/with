        of Session    // libssh2.h 1.11.1:662: sets local SSH protocol banner
        lend    // libssh2.h 1.11.1:662: copies banner string into session
    fn libssh2_banner_set
        of Session    // libssh2.h 1.11.1:666: deprecated alias for libssh2_session_banner_set
        rename legacy_banner_set    // libssh2.h 1.11.1:666: disambiguate from session_banner_set
