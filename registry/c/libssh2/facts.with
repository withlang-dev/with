// libssh2 1.11.1, the version `with get c.libssh2` pins. Every citation is a
// line of the package's installed headers, include/libssh2.h and
// include/libssh2_sftp.h.
//
// Resource hierarchy:
// - Session (`LIBSSH2_SESSION *`), created by libssh2_session_init_ex (with
//   default allocators and NULL abstract) and freed by libssh2_session_free.
// - Channel (`LIBSSH2_CHANNEL *`), borrows Session, created by
//   libssh2_channel_open_ex / direct_tcpip_ex / direct_streamlocal_ex and
//   freed by libssh2_channel_free.
// - Sftp (`LIBSSH2_SFTP *`), borrows Session, created by libssh2_sftp_init
//   and shut down by libssh2_sftp_shutdown.
// - SftpHandle (`LIBSSH2_SFTP_HANDLE *`), borrows Sftp, created by
//   libssh2_sftp_open_ex and closed by libssh2_sftp_close_handle.
// - KnownHosts (`LIBSSH2_KNOWNHOSTS *`), borrows Session.
// - Agent (`LIBSSH2_AGENT *`), borrows Session.
//
// Raw functions (genuinely unmodeled/unsafe by nature):
// - libssh2_free / libssh2_session_abstract / libssh2_session_callback_set*:
//   raw allocator frees, untyped void** abstract storage, generic callback casts.
// - libssh2_session_supported_algs / libssh2_base64_decode /
//   libssh2_userauth_banner / libssh2_channel_get_exit_signal: out-pointers
//   allocating buffers freed via libssh2_free.
// - libssh2_userauth_publickey / keyboard_interactive / publickey_sk / sign_sk:
//   raw crypto signing and interactive prompt callbacks with void** abstract.
// - libssh2_poll / libssh2_channel_forward_*: raw pollfd arrays and listener loops.
// - libssh2_scp_*: legacy SCP protocol with platform `struct stat` pointers.
// - libssh2_publickey_*: legacy publickey subsystem with raw list allocations.
c facts libssh2:
    // ── Session ───────────────────────────────────────────────────
    resource Session wraps *mut _LIBSSH2_SESSION
        from libssh2_session_init_ex    // libssh2.h 1.11.1:646: allocates a new SSH session
        drop libssh2_session_free    // libssh2.h 1.11.1:682: frees all session resources
