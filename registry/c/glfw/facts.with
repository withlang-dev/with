// glfw 3.4 (conan-center-index recipes/glfw). Every clause cites GLFW/glfw3.h
// installed by the package.
//
// Raw functions (genuinely unmodeled/unsafe by nature):
// - glfwInitAllocator: custom malloc/realloc/free function-pointer table.
// - glfwSetWindowUserPointer, glfwGetWindowUserPointer,
//   glfwSetMonitorUserPointer, glfwGetMonitorUserPointer,
//   glfwSetJoystickUserPointer, glfwGetJoystickUserPointer: untyped void*
//   user-pointer storage with no type pairing.
// - glfwGetMonitors, glfwGetVideoModes, glfwGetJoystickAxes/Buttons/Hats,
//   glfwGetRequiredInstanceExtensions, glfwGetError: return raw unowned array
//   or string pointers via out-parameters.
// - glfwGetMonitor*, glfwSetGamma*, glfwGetGammaRamp, glfwSetWindowMonitor:
//   operate on global borrowed GLFWmonitor* handles invalidated on hotplug.
// - glfwSetWindowIcon, glfwCreateCursor: accept GLFWimage structs holding raw
//   unsigned char *pixels pointers.
// - glfwGetProcAddress, glfwGetCurrentContext: raw OpenGL/context pointers.
c facts glfw:
    resource Window wraps *mut GLFWwindow
        from glfwCreateWindow    // glfw3.h 3.4:3235: creates window and OpenGL context freed by glfwDestroyWindow
        drop glfwDestroyWindow    // glfw3.h 3.4:3264: destroys window and its context
    resource Cursor wraps *mut GLFWcursor
        from glfwCreateStandardCursor    // glfw3.h 3.4:5094: creates standard cursor freed by glfwDestroyCursor
        drop glfwDestroyCursor    // glfw3.h 3.4:5121: destroys cursor
    fn glfwCreateWindow
        rename create    // glfw3.h 3.4:3235: Window.create(width, height, title)
        param 3 fixed null    // glfw3.h 3.4:3235: NULL monitor selects windowed mode
        param 4 fixed null    // glfw3.h 3.4:3235: NULL share selects unshared context
    fn glfwGetVersion
        fills param 0    // glfw3.h 3.4:2392: writes *major
        fills param 1    // glfw3.h 3.4:2392: writes *minor
        fills param 2    // glfw3.h 3.4:2392: writes *rev
    fn glfwSetErrorCallback
        callback param 0    // glfw3.h 3.4:2503: global error callback with no userdata parameter
        callback_thread any    // glfw3.h 3.4:2503: may be called from any thread reporting a GLFW error
