// lz4 1.11.1 (conan-center-index recipes/lz4). Every clause cites lz4.h,
// lz4hc.h, or lz4frame.h installed by the package.
//
// Raw functions (genuinely unmodeled/unsafe by nature):
// - LZ4_compress_fast_extState, LZ4_compress_HC_extStateHC,
//   LZ4_compress_HC_destSize: take an untyped caller-allocated `void* state`
//   buffer whose required size and 8-byte alignment are runtime-checked only.
// - LZ4_loadDict, LZ4_loadDictSlow, LZ4_attach_dictionary,
//   LZ4_compress_fast_continue, LZ4_setStreamDecode,
//   LZ4_decompress_safe_continue, LZ4_loadDictHC, LZ4_compress_HC_continue,
//   LZ4_compress_HC_continue_destSize, LZ4_attach_HC_dictionary,
//   LZ4F_compressBegin_usingDict, LZ4F_compressBegin_usingCDict,
//   LZ4F_decompress_usingDict: retain pointers into the caller's dictionary or
//   previous 64 KB history ring buffer across subsequent calls.
// - lz4file.h (`LZ4F_readOpen`, `LZ4F_writeOpen`, etc.): operate on `FILE*`.
