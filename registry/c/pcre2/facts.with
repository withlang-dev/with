        buffer param 7 capacity param 8 elements    // pcre2.h 10.49 line 758: workspace int array of wscount ints
        lend    // pcre2.h 10.49 lines 757 to 758: borrows code, match_data, and match_context
    fn pcre2_substitute_8
        buffer param 1 len param 2    // pcre2.h 10.49 line 829: reads subject[0..length]
        buffer param 7 len param 8    // pcre2.h 10.49 lines 830 to 831: reads replacement[0..rlength]
        buffer param 9 capacity param 10 inout    // pcre2.h 10.49 line 831: outputbuffer capacity on entry, written length on exit
        ok >= 0    // pcre2.h 10.49 line 829: returns number of substitutions (>= 0) on success, negative error code on failure
        lend    // pcre2.h 10.49 lines 829 to 831: borrows code, match_data, and match_context
