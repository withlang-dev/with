// zstd 1.6.0 (conan-center-index recipes/zstd). Every clause cites zstd.h,
// zstd_errors.h, or zdict.h installed by the package.
//
// Raw functions (genuinely unmodeled/unsafe by nature):
// - ZSTD_compressStream2, ZSTD_compressStream, ZSTD_flushStream, ZSTD_endStream,
//   ZSTD_decompressStream: take caller-owned ZSTD_inBuffer / ZSTD_outBuffer
//   structs carrying raw pointer + size + pos fields across calls.
// - ZSTD_createDDict_byReference, ZSTD_CCtx_refCDict, ZSTD_CCtx_refPrefix,
//   ZSTD_DCtx_refDDict, ZSTD_DCtx_refPrefix: retain uncopied external pointers
//   past return without transferring ownership.
// - ZSTD_CCtx_loadDictionary_advanced, ZSTD_DCtx_loadDictionary_advanced:
//   behavior depends on runtime ZSTD_dictLoadMethod_e (byCopy vs byRef).
// - ZDICT_trainFromBuffer, ZDICT_finalizeDictionary: take a concatenated sample
//   buffer whose total byte length is the sum of samplesSizes[0..nbSamples].
// - ZSTD_getFrameHeader: writes ZSTD_frameHeader output struct.
c facts zstd:
    resource CCtx wraps *mut ZSTD_CCtx_s
        from ZSTD_createCCtx    // zstd.h 1.6.0:303: allocates ZSTD_CCtx freed by ZSTD_freeCCtx
        from ZSTD_createCStream    // zstd.h 1.6.0: allocates streaming ZSTD_CCtx freed by ZSTD_freeCStream/ZSTD_freeCCtx
        drop ZSTD_freeCCtx    // zstd.h 1.6.0:304: frees ZSTD_CCtx (compatible with NULL)
        destroys ZSTD_freeCStream    // zstd.h 1.6.0: frees streaming ZSTD_CCtx
    resource DCtx wraps *mut ZSTD_DCtx_s
        from ZSTD_createDCtx    // zstd.h 1.6.0:326: allocates ZSTD_DCtx freed by ZSTD_freeDCtx
        from ZSTD_createDStream    // zstd.h 1.6.0: allocates streaming ZSTD_DCtx freed by ZSTD_freeDStream/ZSTD_freeDCtx
        drop ZSTD_freeDCtx    // zstd.h 1.6.0:327: frees ZSTD_DCtx (compatible with NULL)
        destroys ZSTD_freeDStream    // zstd.h 1.6.0: frees streaming ZSTD_DCtx
    resource CDict wraps *mut ZSTD_CDict_s
        from ZSTD_createCDict    // zstd.h 1.6.0:1034: copies dictBuffer into a new ZSTD_CDict freed by ZSTD_freeCDict
        drop ZSTD_freeCDict    // zstd.h 1.6.0:1040: frees ZSTD_CDict (compatible with NULL)
    resource DDict wraps *mut ZSTD_DDict_s
        from ZSTD_createDDict    // zstd.h 1.6.0:1058: copies dictBuffer into a new ZSTD_DDict freed by ZSTD_freeDDict
        drop ZSTD_freeDDict    // zstd.h 1.6.0: frees ZSTD_DDict (compatible with NULL)
    fn ZSTD_createCCtx
        rename new    // zstd.h 1.6.0:303: CCtx.new()
    fn ZSTD_createDCtx
        rename new    // zstd.h 1.6.0:326: DCtx.new()
