        from tjInitDecompress    // turbojpeg.h 3.2.1 line 2746: creates a TurboJPEG decompressor instance, NULL on error
        from tjInitTransform    // turbojpeg.h 3.2.1 line 2800: creates a TurboJPEG transformer instance, NULL on error
        drop tj3Destroy    // turbojpeg.h 3.2.1 line 1353: destroys a TurboJPEG instance (NULL is a no-op)
        destroys tjDestroy    // turbojpeg.h 3.2.1 line 2740: destroys a TurboJPEG instance, returning 0 on success

