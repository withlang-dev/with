// yyjson 0.12.0 (conan-center-index recipes/yyjson). Every clause cites
// yyjson.h installed by the package.
//
// Raw functions (genuinely unmodeled/unsafe by nature):
// - yyjson_alc_pool_init, yyjson_alc_dyn_new, yyjson_alc_dyn_free: custom
//   allocator function-pointer tables (malloc/realloc/free + void *ctx).
// - yyjson_read_opts with YYJSON_READ_INSITU, yyjson_incr_new/read/free:
//   in-situ parsing mutates and retains caller input buffer pointers.
// - yyjson_read_fp, yyjson_write_fp, yyjson_mut_write_fp, yyjson_val_write_fp,
//   yyjson_mut_val_write_fp: take raw C FILE * handles.
// - yyjson_mut_str, yyjson_mut_strn, yyjson_mut_obj_add_str*,
//   yyjson_mut_arr_add_str*: store caller's raw const char * without copying
//   (use yyjson_mut_strcpy / yyjson_mut_arr_add_strcpy for safe copies).
// - yyjson_write_number: writes into uncounted caller char *buf.
// - unsafe_yyjson_*: internal low-level helpers with unchecked invariants.
