    fn cJSON_AddRawToObject
        returns borrow CJSON from param 0    // cJSON.h 1.7.19 line 276: creates, attaches, and returns borrowed child owned by object
    fn cJSON_AddObjectToObject
        returns borrow CJSON from param 0    // cJSON.h 1.7.19 line 277: creates, attaches, and returns borrowed child owned by object
    fn cJSON_AddArrayToObject
