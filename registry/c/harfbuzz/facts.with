// harfbuzz 15.2.0 (conan-center-index recipes/harfbuzz). Every clause cites
// harfbuzz/*.h installed by the package.
//
// Raw functions (genuinely unmodeled/unsafe by nature):
// - hb_blob_create, hb_blob_create_or_fail: borrow caller memory under a
//   runtime hb_memory_mode_t enum + destroy callback contract.
// - hb_blob_get_data, hb_blob_get_data_writable: return raw `char *` paired
//   with an out-length pointer (not NUL-terminated text).
// - hb_buffer_get_glyph_infos, hb_buffer_get_glyph_positions: return raw
//   mutable element pointers paired with an out-length pointer; use
//   `hb_buffer_serialize_glyphs` for safe formatted glyph/position inspection.
// - hb_*_set_user_data, hb_*_get_user_data: keyed void* attachment tables with
//   destroy callbacks.
// - hb_face_create_for_tables, hb_font_set_funcs, hb_unicode_funcs_set_*:
//   callback vtable registration APIs.
// - hb_shape_list_shapers, hb_face_list_loaders, hb_buffer_serialize_list_formats:
//   return NULL-terminated `const char **` arrays.
c facts harfbuzz:
    resource Blob wraps *mut hb_blob_t
        from hb_blob_create_or_fail    // harfbuzz/hb-blob.h 15.2.0:94: copies data under HB_MEMORY_MODE_DUPLICATE into blob, released by hb_blob_destroy
        from hb_blob_create_from_file    // harfbuzz/hb-blob.h 15.2.0:101: maps/reads font file into blob, released by hb_blob_destroy
        from hb_blob_create_from_file_or_fail    // harfbuzz/hb-blob.h 15.2.0:104: maps/reads font file or returns NULL, released by hb_blob_destroy
        from hb_blob_get_empty    // harfbuzz/hb-blob.h 15.2.0:121: returns empty singleton blob safe to pass to hb_blob_destroy
        drop hb_blob_destroy    // harfbuzz/hb-blob.h 15.2.0:127: decrements refcount and frees blob
    resource Face wraps *mut hb_face_t
        from hb_face_create    // harfbuzz/hb-face.h 15.2.0:59: creates face referencing blob (increments blob refcount), released by hb_face_destroy
        from hb_face_create_or_fail    // harfbuzz/hb-face.h 15.2.0:63: creates face referencing blob or returns NULL, released by hb_face_destroy
        from hb_face_create_from_file_or_fail    // harfbuzz/hb-face.h 15.2.0:72: creates face from font file or returns NULL, released by hb_face_destroy
        drop hb_face_destroy    // harfbuzz/hb-face.h 15.2.0:117: decrements refcount and frees face
    resource Font wraps *mut hb_font_t
        from hb_font_create    // harfbuzz/hb-font.h 15.2.0:1117: creates font referencing face (increments face refcount), released by hb_font_destroy
        drop hb_font_destroy    // harfbuzz/hb-font.h 15.2.0:1151: decrements refcount and frees font
    resource Buffer wraps *mut hb_buffer_t
        from hb_buffer_create    // harfbuzz/hb-buffer.h 15.2.0:253: allocates shaping buffer, released by hb_buffer_destroy
        drop hb_buffer_destroy    // harfbuzz/hb-buffer.h 15.2.0:269: decrements refcount and frees buffer
    resource Map wraps *mut hb_map_t
        from hb_map_create    // harfbuzz/hb-map.h 15.2.0:59: allocates codepoint map, released by hb_map_destroy
        drop hb_map_destroy    // harfbuzz/hb-map.h 15.2.0:68: decrements refcount and frees map
    fn hb_version_string
        returns static CStr    // harfbuzz/hb-version.h 15.2.0:85: returns static library version string
    fn hb_direction_to_string
        returns static CStr    // harfbuzz/hb-common.h 15.2.0:269: returns static direction name
    fn hb_language_to_string
        returns static CStr    // harfbuzz/hb-common.h 15.2.0:342: returns static language tag string
    fn hb_direction_from_string
        lend    // harfbuzz/hb-common.h 15.2.0:266: parses direction string without retaining it
        buffer param 0 len param 1    // harfbuzz/hb-common.h 15.2.0:266: reads len bytes from str
    fn hb_script_from_string
        lend    // harfbuzz/hb-common.h 15.2.0:368: parses script tag string without retaining it
        buffer param 0 len param 1    // harfbuzz/hb-common.h 15.2.0:368: reads len bytes from str
    fn hb_blob_create_or_fail
        buffer param 0 len param 1    // harfbuzz/hb-blob.h 15.2.0:95: reads length bytes from data
