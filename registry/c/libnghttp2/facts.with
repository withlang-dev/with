// libnghttp2 1.68.1, the version `with get c.libnghttp2` pins. Every citation
// is a line of the package's installed header, include/nghttp2/nghttp2.h.
//
// Core resources:
// - SessionCallbacks (`nghttp2_session_callbacks *`), allocated via out-param
//   by nghttp2_session_callbacks_new and freed by nghttp2_session_callbacks_del.
// - SessionOption (`nghttp2_option *`), allocated via out-param by
//   nghttp2_option_new and freed by nghttp2_option_del.
// - Session (`nghttp2_session *`), allocated via out-param by
//   nghttp2_session_client_new/server_new/client_new2/server_new2 (copies
//   callbacks and option by value, so independent of both) and freed by
//   nghttp2_session_del.
// - HdDeflater / HdInflater (`nghttp2_hd_deflater *` / `nghttp2_hd_inflater *`),
//   allocated via out-param by nghttp2_hd_deflate_new / nghttp2_hd_inflate_new
//   and freed by nghttp2_hd_deflate_del / nghttp2_hd_inflate_del.
//
// Raw functions (genuinely unmodeled/unsafe by nature):
// - nghttp2_session_client_new3 / server_new3 / hd_deflate_new2 / hd_inflate_new2:
//   custom nghttp2_mem allocator function-pointer table.
// - nghttp2_session_get_stream_user_data / set_stream_user_data / set_user_data:
//   untyped void* user_data storage.
// - nghttp2_submit_data / data2 / extension / altsvc / origin: data provider
//   callback unions and raw extension payload pointers.
// - nghttp2_rcbuf_* / nghttp2_hd_deflate_get_table_entry / hd_inflate_get_table_entry:
//   manual refcount and raw nghttp2_nv* table pointers.
// - nghttp2_set_debug_vprintf_callback: C va_list debug logger.
c facts libnghttp2:
