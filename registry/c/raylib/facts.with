// raylib 6.0 (conan-center-index recipes/raylib). Image, Wave, Font, Shader,
// and AudioStream are passed by value and hold heap/device-owned buffers, so
// the functions that take one are pointer functions (§16.2b.5); raylib's source
// and raylib.h 6.0 state who allocates each buffer and who frees it.
//
// Raw functions (genuinely unmodeled/unsafe by nature):
// - TraceLog, TextFormat: printf-style format variadics.
// - MemAlloc, MemRealloc, MemFree: raw untyped memory allocator.
// - SetTraceLogCallback, SetLoadFileDataCallback, SetSaveFileDataCallback,
//   SetLoadFileTextCallback, SetSaveFileTextCallback, AttachAudioMixedProcessor,
//   DetachAudioMixedProcessor: global C callback hooks without userdata.
// - LoadFileData/Text, SaveFileData/Text, CompressData, DecompressData,
//   EncodeDataBase64, DecodeDataBase64, ComputeCRC32/MD5/SHA1/SHA256,
//   LoadImageColors/Palette, LoadUTF8/Codepoints/TextLines: raw malloc'd byte
//   or element arrays returned without an owned slice wrapper.
// - rlLoadVertexBuffer/Texture/ShaderBuffer, rlSetUniform, rlUpdateTexture,
//   rlGetProcAddress, rlLoadExtensions: low-level raw void* OpenGL upload APIs.
// - Mesh, Model, Material, FilePathList, AutomationEventList, rlRenderBatch:
//   multi-pointer aggregate records whose fields are mutated in place by
//   independent allocators.
// - LoadSoundAlias: aliases another Sound's buffer without owning it.
// - Generators such as GenImageColor: a huge width*height writes through a
//   failed allocation in raylib 6.0.
c facade raylib:
    runs threads    // raudio.c 464-511, InitAudioDevice: ma_device_init(&AUDIO.System.context, &config, &AUDIO.System.device) with config.dataCallback = OnSendAudioDataToDevice, then ma_device_start; miniaudio calls OnSendAudioDataToDevice (raudio.c 2558) on its own device thread
    resource ImageData wraps Image
        from LoadImageFromScreen, nonnull field data    // raylib.h 6.0: "Image LoadImageFromScreen(void); // Load image from screen buffer and (screenshot)"; rtextures.c 584-595, LoadImageFromScreen: image.data = rlReadScreenPixels(width, height), a buffer the caller owns; a NULL there (no pixels were read) is a contract failure, so an Image with no buffer never exists
        from LoadImage, nullable field data    // raylib.h 6.0: "Image LoadImage(const char *fileName); // Load image from file into CPU memory (RAM)"; rtextures.c 263-300, LoadImage: the file is read into a buffer the image owns, a zeroed Image when it cannot be read
        drop UnloadImage    // raylib.h 6.0: "void UnloadImage(Image image); // Unload image from CPU memory (RAM)"; rtextures.c 612-615, UnloadImage: RL_FREE(image.data), a no-op on the zeroed Image
    fn GetImageColor
        of ImageData    // raylib.h 6.0: "Color GetImageColor(Image image, int x, int y); // Get image pixel color at (x, y) position"; rtextures.c 3192-3196, GetImageColor: reads image.data only when 0 <= x < width and 0 <= y < height, returns a Color by value, stores nothing
    fn IsImageValid
        of ImageData    // rtextures.c 598-609, IsImageValid: compares the record's fields, follows no pointer
    fn ExportImage
        of ImageData    // rtextures.c 619-623, ExportImage: returns at once when width or height is 0 or data is NULL (its "Security check"), then reads image.data to write the file; stores nothing
    fn LoadTextureFromImage
        of ImageData    // raylib.h 6.0:1442: "Texture2D LoadTextureFromImage(Image image);"; uploads image.data to GPU texture and returns Texture2D by value, retaining no pointer to image.data
    fn LoadTextureCubemap
        of ImageData    // raylib.h 6.0: uploads cubemap faces from image.data and returns TextureCubemap by value, retaining no pointer to image.data
    fn GetImageAlphaBorder
        of ImageData    // raylib.h 6.0: scans image.data and returns Rectangle by value, retaining nothing
    fn SetWindowIcon
        of ImageData    // raylib.h 6.0: copies icon pixels from image.data into the platform window, retaining nothing
    resource FontData wraps Font
        from GetFontDefault, nonnull field glyphs    // raylib.h 6.0:1489: "Font GetFontDefault(void);"; returns built-in default font; UnloadFont explicitly no-ops when font.texture.id == GetFontDefault().texture.id
        from LoadFont, nullable field glyphs    // raylib.h 6.0:1490: "Font LoadFont(const char *fileName);"; loads font into GPU VRAM and glyph arrays, zeroed Font on failure
        drop UnloadFont    // raylib.h 6.0:1498: "void UnloadFont(Font font);"; frees recs, glyphs, and texture; no-op on zeroed or default Font
    fn IsFontValid
        of FontData    // raylib.h 6.0:1494: checks font fields without storing pointers
    fn DrawTextEx
        of FontData    // raylib.h 6.0:1504: draws text using font atlas and glyph rects, stores nothing
    fn DrawTextPro
        of FontData    // raylib.h 6.0: draws rotated text using font atlas and glyph rects, stores nothing
    fn DrawTextCodepoint
        of FontData    // raylib.h 6.0: draws one glyph from font, stores nothing
    fn MeasureTextEx
        of FontData    // raylib.h 6.0: measures text dimensions using font glyph metrics, stores nothing
    fn GetGlyphIndex
        of FontData    // raylib.h 6.0: looks up glyph index in font.glyphs, stores nothing
    fn GetGlyphAtlasRec
        of FontData    // raylib.h 6.0: looks up glyph rectangle in font.recs, stores nothing
    resource ShaderData wraps Shader
        from LoadShader, nullable field locs    // raylib.h 6.0:1069: "Shader LoadShader(const char *vsFileName, const char *fsFileName);"; loads shader program and allocates locs array
        from LoadShaderFromMemory, nullable field locs    // raylib.h 6.0: compiles shader program from source strings and allocates locs array
        drop UnloadShader    // raylib.h 6.0:1078: "void UnloadShader(Shader shader);"; unloads shader program and frees locs
    fn IsShaderValid
        of ShaderData    // raylib.h 6.0:1071: validates shader id and locs, stores nothing
    fn BeginShaderMode
        of ShaderData    // raylib.h 6.0: activates shader program id for drawing, stores no pointer to locs
    fn GetShaderLocation
        of ShaderData    // raylib.h 6.0: queries uniform location by name, stores nothing
    fn GetShaderLocationAttrib
        of ShaderData    // raylib.h 6.0: queries attribute location by name, stores nothing
    fn SetShaderValueMatrix
        of ShaderData    // raylib.h 6.0: uploads Matrix uniform to shader, stores nothing
    fn SetShaderValueTexture
        of ShaderData    // raylib.h 6.0: binds Texture2D uniform to shader, stores nothing
    resource WaveData wraps Wave
        from LoadWave, nullable field data    // raylib.h 6.0: "Wave LoadWave(const char *fileName); // Load wave data from file"; raudio.c 789-803, LoadWave: the samples are decoded into a buffer the wave owns, a zeroed Wave when the file cannot be read
        drop UnloadWave    // raylib.h 6.0: "void UnloadWave(Wave wave); // Unload wave data"; raudio.c 1030-1034, UnloadWave: RL_FREE(wave.data), a no-op on the zeroed Wave
    fn IsWaveValid
        of WaveData    // raudio.c 916-927, IsWaveValid: compares the record's fields, follows no pointer
    resource AudioStreamData wraps AudioStream
        from LoadAudioStream, nullable field buffer    // raylib.h 6.0:1717: "AudioStream LoadAudioStream(unsigned int sampleRate, unsigned int sampleSize, unsigned int channels);"; allocates rAudioBuffer when audio device is ready, zeroed AudioStream otherwise
        drop UnloadAudioStream    // raylib.h 6.0:1719: "void UnloadAudioStream(AudioStream stream);"; frees stream buffer, no-op when buffer is NULL
    fn IsAudioStreamValid
        of AudioStreamData    // raylib.h 6.0:1718: checks stream buffer and metadata, stores nothing
    fn IsAudioStreamProcessed
        of AudioStreamData    // raylib.h 6.0: queries whether audio stream buffers were processed, stores nothing
    fn PlayAudioStream
        of AudioStreamData    // raylib.h 6.0:1722: starts playing audio stream, stores nothing
    fn PauseAudioStream
        of AudioStreamData    // raylib.h 6.0: pauses audio stream, stores nothing
    fn ResumeAudioStream
        of AudioStreamData    // raylib.h 6.0: resumes paused audio stream, stores nothing
    fn IsAudioStreamPlaying
        of AudioStreamData    // raylib.h 6.0: queries whether audio stream is playing, stores nothing
    fn StopAudioStream
        of AudioStreamData    // raylib.h 6.0:1726: stops playing audio stream, stores nothing
    fn SetAudioStreamVolume
        of AudioStreamData    // raylib.h 6.0: sets audio stream volume, stores nothing
    fn SetAudioStreamPitch
        of AudioStreamData    // raylib.h 6.0: sets audio stream pitch, stores nothing
    fn SetAudioStreamPan
        of AudioStreamData    // raylib.h 6.0: sets audio stream pan, stores nothing
