// libgit2 1.9.1 (conan-center-index recipes/libgit2). Every clause cites
// git2/*.h installed by the package.
//
// Raw functions (genuinely unmodeled/unsafe by nature):
// - git_blob_rawcontent, git_odb_object_data: return uncounted `const void *`
//   whose byte length is queried by a separate call (`git_blob_rawsize`).
// - git_commit_create_v: C variadic parent commit list.
// - git_libgit2_opts: C variadic global option setter/getter.
// - git_remote_*, git_clone, git_fetch, git_push, git_checkout_*: network and
//   working-tree operations carrying callback option tables (`git_*_options`)
//   with raw function pointers and user payloads.
// - git_diff_foreach, git_diff_print, git_tree_walk, git_status_foreach_ext,
//   git_tag_foreach, git_config_foreach: iterator callbacks carrying raw
//   `git_diff_delta *` / `git_diff_hunk *` / `git_diff_line *` or unmodeled
//   option tables.
// - git_buf_* / git_strarray_*: caller-allocated C buffers holding raw heap
//   `char *` / `char **` pointers.
// - git_oid_tostr: returns a raw `char *` aliasing its caller-provided buffer
//   (use `git_oid_nfmt` for safe buffer formatting).
// - git_tree_entry_byname, git_tree_entry_byindex, git_tree_entry_byid:
//   return borrowed `const git_tree_entry *` while `TreeEntry` wraps owned
//   `*mut git_tree_entry` (use `TreeEntry.bypath` for safe lookup).
