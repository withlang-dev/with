// libevent 2.1.12 (conan-center-index recipes/libevent). Every clause cites
// event2/*.h installed by the package.
//
// Raw functions (genuinely unmodeled/unsafe by nature):
// - event_set_mem_functions, event_set_log_callback, event_set_fatal_callback,
//   evthread_set_lock_callbacks, evthread_set_condition_callbacks,
//   evthread_set_id_callback: global allocator/threading/log callback tables.
// - event_assign, event_base_dump_events: caller-managed struct event storage
//   or raw C FILE * handles.
// - evbuffer_add_printf, evbuffer_add_vprintf: printf-style variadics.
// - evbuffer_add_reference, evbuffer_peek, evbuffer_reserve_space,
//   evbuffer_commit_space, evbuffer_pullup: zero-copy raw iovec/pointer views
//   whose lifetime depends on subsequent buffer mutations.
// - evdns_*, evrpc_*, evconnlistener_*: asynchronous networking callbacks with
//   raw sockaddr / DNS / RPC pointer payloads.
c facts libevent:
    resource EventConfig wraps *mut event_config
        from event_config_new    // event2/event.h 2.1.12:467: allocates event_config freed by event_config_free
        drop event_config_free    // event2/event.h 2.1.12:475: frees event_config
    resource EventBase wraps *mut event_base
        from event_base_new    // event2/event.h 2.1.12:344: allocates event_base freed by event_base_free
