*.w linguist-language=With
bootstrap/** linguist-vendored
out/** linguist-generated

# The seed/SDK locks are parsed line-by-line by the build layer, and
# seed-driver length-checks each digest at exactly 64 hex chars. Under
# core.autocrlf=true a native Windows checkout rewrites them to CRLF, so
# every digest reads 65 chars with a trailing "\r" and seed-driver refuses
# the pinned seed on Windows only (run 39296788835). Pin LF so the locks
# parse to the same values on every platform.
seed.lock text eol=lf
sdk.lock text eol=lf

# embed_file fixtures are embedded byte-for-byte and their content is asserted
# exactly. Pin LF so a native Windows checkout (core.autocrlf=true, the default
# on GitHub's Windows runners) does not rewrite them to CRLF, which would make
# embed_file read "...\r\n" and break the byte-exact assertions (#801).
test/behavior/*.txt text eol=lf
test/behavior/**/*.txt text eol=lf

# With source is content-hashed cross-platform: docs/with-abi.sha256 records the
# sha256 of the ABI-defining sources (build/abi.w, docs/spec/abi/with-abi.md §7 / D38), and
# that hash keys every .wo bundle, so the bytes fed to it must be identical on
# every platform. Under core.autocrlf=true a Windows checkout rewrites LF to CRLF,
# which both changes each source's hash (abi-hash-check mismatch) and leaves a
# trailing "\r" on the record's path column that trips the comptime ToolFs
# project-root check. Pin LF so the hash is stable and the record parses cleanly.
*.w text eol=lf
docs/with-abi.sha256 text eol=lf

# .wi interface fixtures (test/bundle_interface/*.wi) are compared byte-for-byte
# against the compiler's freshly-emitted interface. Under core.autocrlf=true a
# native Windows checkout rewrites the checked-in fixture's LF to CRLF, so each
# read line carries a trailing "\r" the emitted (LF) interface never has, and the
# byte-exact comparison fails on every line — reddening bundle-interface-tests on
# Windows only. Pin LF so the fixture matches emitted output on every platform.
*.wi text eol=lf

# Contract-view and UAT expectations are compared byte-for-byte as well: each
# test/contract/*.w's contract view against its .expected file, and the UAT
# runner's report and listing against test/uat/expected*.txt. Under
# core.autocrlf=true a native Windows checkout rewrites them to CRLF, so every
# line carries a "\r" the (LF) output never has, and contract-view-tests and
# uat-tests go red on Windows only. Pin LF so they compare the same bytes on
# every platform.
test/contract/*.expected text eol=lf
test/uat/**/*.txt text eol=lf

# The promoted engine corpora and the spec are read line-by-line by the build
# layer: corpus.stamp's module hash is split on "\n" (corpus_stamp_field),
# contracts.tsv is hashed whole, the spec's fenced blocks are found by "```\n"
# (comp_first_fenced_block), and `with init`'s AI guide is compared to
# docs/spec/guide/with_for_ai.md byte for byte. Under core.autocrlf=true a
# native Windows checkout rewrites them to CRLF, and eight battery targets go
# red on Windows only (#2832): the six corpus integrity checks,
# spec-inventory-check and cli-selfhost-project-tests. Every file under these
# two trees is text; pin LF so each reads the same bytes on every platform.
lib/std/engines/** text eol=lf
docs/spec/** text eol=lf
