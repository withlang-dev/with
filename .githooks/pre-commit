#!/bin/sh
# bootstrap/ is permanently frozen — it is a historical artifact.
# The compiler is fully self-hosted. Recovery uses the installed binary
# (~/.local/bin/with) or seed downloads from GitHub releases.
#
# DO NOT override this freeze for any reason unless the selfhost binary
# is catastrophically lost and no checkpoint exists anywhere.
if git diff --cached --name-only | grep -q '^bootstrap/'; then
    echo "error: bootstrap/ is permanently frozen — the compiler is self-hosted"
    echo "       recovery uses installed binary or GitHub release seeds, not the Zig bootstrap"
    echo "       do not override this freeze unless the selfhost binary is catastrophically lost"
    exit 1
fi

# No new ceremony in a commit (Eric, 2026-11-25): the census counts the known
# patterns in each changed file against HEAD and refuses a rise. The same check
# runs on every pull request (.github/workflows/ceremony-census.yml).
if git diff --cached --name-only | grep -q '\.with$'; then
    if ! command -v with >/dev/null 2>&1; then
        echo "error: no \`with\` on PATH to run the ceremony census"
        exit 1
    fi
    with run tools/ceremony_census.with --diff HEAD || exit 1
fi
