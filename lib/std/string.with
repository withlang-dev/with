// std.string — String utility functions
//
// Most string methods are built-in on the str type:
//   s.len()         → i64    — string length
//   s.is_empty()    → bool   — true if length is 0
//   s.contains(sub) → bool   — true if sub is found in s
//   s.starts_with(p)→ bool   — true if s starts with prefix p
//   s.ends_with(sf) → bool   — true if s ends with suffix sf
//   s.find(sub)     → i64    — index of first occurrence, or -1
//   s.to_upper()    → str    — new uppercase string
//   s.to_lower()    → str    — new lowercase string
//   s.trim()        → str    — string with leading/trailing whitespace removed
//   s.repeat(n)     → str    — string repeated n times
//   s.slice(a, b)   → str    — substring from index a to b
//   s.replace(o, n) → str    — replace all occurrences of o with n
//   s.split(delim)  → List[str] — split by delimiter
//
// This module provides additional utility functions.
// No c_import — uses with_* runtime functions.

use std.traits
use std.option
use std.result
use std.collections
use rt.rt_core
use rt.panic_runtime
use std.numeric

/// Amortized string builder for code that appends in loops.
///
/// `++` is fine for short expressions, but repeated `out = out ++ part`
/// copies the whole prefix on every append. StringBuilder stores bytes in a
/// List[u8], so appending N total bytes grows geometrically and finishes with
/// one materialized str.
pub type StringBuilder {
    bytes: List[u8],
}

/// Create an empty builder.
pub fn StringBuilder.new() -> Self:
    StringBuilder { bytes: List[u8].new() }

/// Create an empty builder with room for at least `capacity` bytes.
pub fn StringBuilder.with_capacity(capacity: i64) -> Self:
    let cap = if capacity > 0: capacity else: 0
    StringBuilder { bytes: List[u8].with_capacity(cap) }

/// Append raw UTF-8 bytes from a string.
impl StringBuilder:
    // #919: one grow-to-fit + one memcpy — the old per-byte push loop was
    // ~100x slower natively and interpreted per byte under the comptime
    // evaluator (the test-green 77s anomaly's core).
    pub comptime mut fn push_str(s: &str):
        with_vec_append_bytes((&raw mut self.bytes) as *mut u8, s)
        return

    /// Append one byte.
    pub comptime mut fn push_byte(b: u8):
        self.bytes.push(b)
        return

    /// Append one byte from an integer code point.
    pub comptime mut fn push_char(b: i32):
        self.bytes.push(b as u8)
        return

    /// Number of bytes appended so far.
    pub comptime fn len() -> isize:
        self.bytes.len()

    /// True when no bytes have been appended.
    pub comptime fn is_empty() -> bool:
        self.bytes.len == 0

    /// Materialize the accumulated bytes as an owned str.
    pub comptime fn to_str() -> str:
        with_str_from_vec_u8((&raw const self.bytes) as *const u8)

/// String length (same as `s.len()`).
pub fn string_len(s: &str) -> i64:
    with_str_len(s)

/// StrView length helper.
pub fn view_len(v: &str) -> i64:
    v.len

/// StrView emptiness helper.
pub fn view_is_empty(v: &str) -> bool:
    v.len == 0

/// StrView equality helper.
pub fn view_eq(a: &str, b: &str) -> bool:
    a == b

/// C string byte length, excluding the trailing NUL.
impl CStr:
    pub fn len() -> isize:
        self.len as isize  // the builtin header field is i64 until headers take the size width (D114)

    /// Raw pointer to the NUL-terminated bytes this `CStr` borrows.
    pub fn ptr() -> *const c_char: self.ptr

    /// An owned copy of the text (D51 §41: allocation is explicit): the `str`
    /// outlives the C storage.
    pub fn to_owned() -> str: with_str_from_bytes(self.ptr as *const u8, self.len)

    /// The bytes as With text, validated (D51 §41, spec §16.2b.8): a view of
    /// the same storage — no copy — when every byte is well-formed UTF-8, or
    /// `Err(.InvalidAt(offset))` naming the first byte that is not. Nothing
    /// is repaired silently; `to_str_lossy` makes repair explicit. `str` and
    /// `CStr` share a `{ptr, len}` layout, so the view is a reinterpret.
    pub fn to_str() -> Result[&str, Utf8Error]:
        let bad = unsafe { utf8_first_invalid(self.ptr as *const u8, self.len) }
        if bad >= 0: return Err(.InvalidAt(bad))
        Ok(unsafe { (self as *const CStr as *const str) as &str })

    /// An owned copy with every ill-formed sequence replaced by U+FFFD, the
    /// replacement character — repair spelled out (D51 §41).
    pub fn to_str_lossy() -> str:
        var sb = StringBuilder.new()
        var i: i64 = 0
        while i < self.len:
            let n = unsafe { utf8_sequence_len(self.ptr as *const u8, i, self.len) }
            if n == 0:
                sb.push_byte(0xEF as u8)
                sb.push_byte(0xBF as u8)
                sb.push_byte(0xBD as u8)
                i = i + 1
            else:
                for k in 0..n:
                    sb.push_byte(unsafe { self.ptr[i + k] } as u8)
                i = i + n
        sb.to_str()

/// The view of a nullable foreign string a facade presents (D51 §32, §41;
/// spec §16.2b.8): `None` for NULL, else the `CStr` over the bytes. The
/// compiler applies it to a presented call's result (MirLower.with lower_call);
/// the facade clause is what vouches for the pointer, so the conversion is
/// `unsafe`: its caller guarantees `p` is NULL or a live C string (#1473).
pub unsafe fn cstr_option_from_ptr(p: *const c_char) -> Option[CStr]:
    if p == null: None else: CStr.from_ptr(p)

/// Why a `CStr` is not With text.
pub enum Utf8Error:
    /// The byte offset of the first ill-formed sequence.
    InvalidAt(i64)

/// The length of the well-formed UTF-8 sequence at byte `i` of `p[0..n]`
/// (RFC 3629: no overlongs, no surrogates, nothing past U+10FFFF), or 0 when
/// the bytes there are ill-formed or truncated. The caller vouches that
/// `p[0..n]` is readable — a `CStr`'s own bytes.
unsafe fn utf8_sequence_len(p: *const u8, i: i64, n: i64) -> i64:
    let b0 = p[i] as i32
    if b0 < 0x80: return 1
    var need: i64 = 0
    var lo = 0x80
    var hi = 0xBF
    if b0 >= 0xC2 and b0 <= 0xDF:
        need = 1
    else if b0 == 0xE0:
        need = 2
        lo = 0xA0
    else if (b0 >= 0xE1 and b0 <= 0xEC) or b0 == 0xEE or b0 == 0xEF:
        need = 2
    else if b0 == 0xED:
        need = 2
        hi = 0x9F
    else if b0 == 0xF0:
        need = 3
        lo = 0x90
    else if b0 >= 0xF1 and b0 <= 0xF3:
        need = 3
    else if b0 == 0xF4:
        need = 3
        hi = 0x8F
    else:
        return 0
    if i + need >= n: return 0
    for k in 1..need + 1:
        let b = p[i + k] as i32
        let (l, h) = if k == 1: (lo, hi) else: (0x80, 0xBF)
        if b < l or b > h: return 0
    need + 1

/// The offset of the first ill-formed UTF-8 sequence in `p[0..n]`, or -1.
unsafe fn utf8_first_invalid(p: *const u8, n: i64) -> i64:
    var i: i64 = 0
    while i < n:
        let k = utf8_sequence_len(p, i, n)
        if k == 0: return i
        i = i + k
    -1

/// View the NUL-terminated string C handed back (§16.1). The caller vouches
/// that `ptr` is non-null, NUL-terminated, and stays valid while the view is
/// used: that is the one fact With cannot check.
pub unsafe fn CStr.from_ptr(ptr: *const c_char) -> CStr:
    var len: i64 = 0
    while ptr[len] != 0: len += 1
    CStr { ptr, len }

// ── String conversion surface (§15.1–§15.3) ───────────────────────────

/// Borrow an owned `String` as a `StrView` (`&str`). The view borrows `self`
/// and must not outlive it.
impl str:
    pub comptime fn as_view() -> StrView:
        self

    /// Whether `needle` occurs in the text. Bytes are compared. Declared
    /// here, as D110 asks of every built-in method (#3483).
    pub comptime fn contains(needle: &str) -> bool: with_str_contains_ref(self, needle) != 0

    /// Whether the text begins with `prefix`.
    pub comptime fn starts_with(prefix: &str) -> bool: with_str_starts_with_ref(self, prefix) != 0

    /// Whether the text ends with `suffix`.
    pub comptime fn ends_with(suffix: &str) -> bool: with_str_ends_with_ref(self, suffix) != 0

    /// The byte index of the first occurrence of `needle`, or -1.
    pub comptime fn index_of(needle: &str) -> isize: with_str_index_of_ref(self, needle) as isize

    /// The text with its ASCII letters in upper case.
    pub comptime fn to_upper() -> str: with_str_to_upper_ref(self)
    pub comptime fn upper() -> str: self.to_upper()

    /// The text with its ASCII letters in lower case.
    pub comptime fn to_lower() -> str: with_str_to_lower_ref(self)
    pub comptime fn lower() -> str: self.to_lower()

    /// The text with every occurrence of `from` replaced by `to`.
    pub comptime fn replace(from: &str, to: &str) -> str: with_str_replace_ref(self, from, to)

    /// The text repeated `count` times.
    pub comptime fn repeat(count: i64) -> str: with_str_repeat_ref(self, count)

    /// The byte at `index`, counted from 0.
    pub comptime fn byte_at(index: i64) -> i32: with_str_byte_at_ref(self, index)

    /// A copy of the bytes from `start` up to, not including, `end`. Both
    /// are clamped to the text; an empty range gives the empty text.
    pub comptime fn slice(start: i64, end: i64) -> str: with_str_slice_ref(self, start, end)

    /// The pieces of the text between occurrences of `sep`. An empty text
    /// has no pieces; an empty `sep` gives the whole text as one piece.
    pub comptime fn split(sep: &str) -> List[str]:
        var pieces = List[str].new()
        with_str_split_vec_ref(&raw mut pieces as *mut u8, self, sep)
        pieces

    /// The bytes as a view (§16.5): `s as []u8`, spelled as a method.
    pub comptime fn as_bytes() -> []u8:
        (*self) as []u8

    /// Copy a `StrView` (or any `&str`) into a fresh owned `str`.
    pub comptime fn to_owned() -> str:
        var sb = StringBuilder.new()
        for i in 0..self.len():
            sb.push_byte(self[i] as u8)
        sb.to_str()

    /// The byte index of the first occurrence of `needle` at or after
    /// `from`, or -1 (#2377, D129): `s.find(x, first + 1)` finds the next
    /// one. `from` past `len()` finds nothing; a negative `from` is out of
    /// range (D71); an empty needle is found at `from`.
    pub comptime fn find(needle: &str, from: isize = 0) -> isize:
        if from > self.len(): return -1
        let at = self[from..self.len()].index_of(needle)
        if at < 0: -1 else: from + at

    /// The byte index of the last occurrence of `needle`, or -1 (#2206):
    /// `find` from the other end. An empty needle is found at `len()`.
    /// Bytes are compared: a view cut inside a multibyte character panics.
    pub comptime fn rfind(needle: &str) -> i64:
        let hay = self.as_bytes()
        let pat = needle.as_bytes()
        let n = pat.len()
        var at = hay.len() - n
        while at >= 0:
            var j = 0
            while j < n and hay[at + j] == pat[j]: j += 1
            if j == n: return at
            at -= 1
        -1

    /// The view past any leading ASCII whitespace (`' '`, `'\t'`, `'\n'`,
    /// `'\r'`): the rest of an indented line (#2206). A view, never a copy.
    pub comptime fn trim_start() -> &str:
        var start: i64 = 0
        while start < self.len() and str_is_ascii_space(self[start]):
            start += 1
        self[start..self.len()]

    /// The view between any leading and trailing ASCII whitespace (#2225):
    /// `trim_start` and `trim_end` in one, a view, never a copy. (It was
    /// the `STR_TRIM` intrinsic over an owned runtime copy, from before D71
    /// made `s[a..b]` a view; a caller that keeps the result past `s`
    /// spells `.to_owned()`.)
    pub comptime fn trim() -> &str:
        var start: i64 = 0
        while start < self.len() and str_is_ascii_space(self[start]):
            start += 1
        var end = self.len()
        while end > start and str_is_ascii_space(self[end - 1]):
            end -= 1
        self[start..end]

    /// The view before any trailing ASCII whitespace (#2206). A view, never
    /// a copy.
    pub comptime fn trim_end() -> &str:
        var end = self.len()
        while end > 0 and str_is_ascii_space(self[end - 1]):
            end -= 1
        self[0..end]

    /// The whitespace-separated fields, awk's default `$1`, `$2`, … (#959):
    /// runs of the ASCII whitespace `trim` strips separate fields, and
    /// leading, trailing or repeated blanks make no empty field (unlike
    /// `split(" ")`). `" a\tb  c ".fields()` is `["a", "b", "c"]`; an
    /// all-blank string has none. Owned, like `lines()` and `split()`.
    pub comptime fn fields() -> List[str]:
        var out: List[str] = List.new()
        let n = self.len()
        var i: i64 = 0
        while i < n:
            while i < n and str_is_ascii_space(self[i]):
                i += 1
            let start = i
            while i < n and not str_is_ascii_space(self[i]):
                i += 1
            if i > start:
                out.push(self.slice(start, i))
        out

    /// The characters in reverse order, as `rev` prints a line (#960). A
    /// UTF-8 sequence stays whole: `"héllo".reverse()` is `"olléh"`.
    pub comptime fn reverse() -> str:
        var out = StringBuilder.with_capacity(self.len())
        var end = self.len()
        while end > 0:
            var start = end - 1
            while start > 0 and (self[start] & 0xC0) == 0x80:
                start -= 1
            out.push_str(self.slice(start, end))
            end = start
        out.to_str()

    /// The text as a value of the type its use demands (§15.5): `let n: i64
    /// = s.parse() ?? 0`. None unless the whole text is one value of that
    /// type. `base:` reads an integer as digits of that base, 2 through 36.
    pub fn parse[T: Parse](base: i32 = 0) -> Option[T]: if base == 0: T.parse_text(self) else: T.parse_text_in(self, base)

    /// The bytes, one at a time (#2206): `for b in s.bytes()`.
    @[iter_of_self]
    pub comptime fn bytes() -> ByteIter: ByteIter { bytes: self.as_bytes(), at: 0 }

fn str_is_ascii_space(c: i32): c == ' ' or c == '\t' or c == '\n' or c == '\r'

/// `s.bytes()`: each byte of the string, in order (§15.4; `.bytes() ->
/// ByteIter`). Borrows the string it was taken from.
pub type ByteIter ephemeral { bytes: []u8, at: i64 }

impl Iter[u8] for ByteIter:
    comptime mut fn next() -> Option[u8]:
        if self.at >= self.bytes.len(): return None
        let b = self.bytes[self.at]
        self.at += 1
        b

/// Why a `str` could not be converted to a `CString`.
pub enum CStringError:
    InteriorNul

/// An owned, heap-allocated, NUL-terminated C string. `len` is the byte count
/// excluding the terminator. Frees its buffer on drop.
pub type CString { ptr: *mut u8, len: i64 }

impl Drop for CString:
    move fn drop():
        with_free(self.ptr)

/// Convert to an owned C string, rejecting an interior NUL loudly (§16.3c):
/// the conversion never silently truncates. Returns `Err(.InteriorNul)` when
/// the string contains a NUL byte.
impl str:
    pub fn to_cstring() -> Result[CString, CStringError]:
        let n = self.len()
        var i: i64 = 0
        while i < n:
            if self[i] == 0:
                return Err(.InteriorNul)
            i = i + 1
        let buf = with_alloc(n + 1)
        var j: i64 = 0
        while j < n:
            unsafe { *((buf as i64 + j) as *mut u8) = self[j] as u8 }
            j = j + 1
        unsafe { *((buf as i64 + n) as *mut u8) = 0 as u8 }
        Ok(CString { ptr: buf, len: n })

/// Borrow the owned C string as a `&CStr` view (no copy, no allocation). The
/// view borrows `self` and must not outlive it. `CString` and `CStr` share a
/// `{ptr, len}` layout, so this is a reinterpret of the owned buffer.
impl CString:
    pub fn as_cstr() -> &CStr:
        unsafe { (self as *const CString as *const CStr) as &CStr }

    /// Byte length of the owned C string, excluding the terminator.
    pub fn len(): self.len

/// Compare two strings for equality. Returns true if equal.
pub fn string_eq(a: &str, b: &str) -> bool:
    with_str_eq_ref(a, b) != 0

/// Compare two strings lexicographically. Returns negative, 0, or positive.
pub fn string_cmp(a: &str, b: &str) -> i32:
    // Byte-by-byte comparison
    let al = a.len()
    let bl = b.len()
    let min_len = if al < bl: al else: bl
    var i: i64 = 0
    while i < min_len:
        let ca = a[i] as i32
        let cb = b[i] as i32
        if ca != cb:
            return ca - cb
        i = i + 1
    if al < bl: return -1
    if al > bl: return 1
    0

/// Returns true if the character code is alphabetic (A-Z, a-z).
pub fn is_alpha(c: i32) -> bool:
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)

/// Returns true if the character code is a decimal digit (-9).
pub fn is_digit(c: i32) -> bool:
    c >= 48 and c <= 57

/// Returns true if the character code is whitespace (space, tab, newline, etc.).
pub fn is_space(c: i32) -> bool:
    c == 32 or c == 9 or c == 10 or c == 13 or c == 12 or c == 11

/// Returns true if the character code is alphanumeric (letter or digit).
pub fn is_alnum(c: i32) -> bool:
    is_alpha(c) or is_digit(c)

/// Returns true if the character code is an uppercase letter (A-Z).
pub fn is_upper(c: i32) -> bool:
    c >= 65 and c <= 90

/// Returns true if the character code is a lowercase letter (a-z).
pub fn is_lower(c: i32) -> bool:
    c >= 97 and c <= 122

/// Returns true if the character code is a hex digit (-9, a-f, A-F).
pub fn is_xdigit(c: i32) -> bool:
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)

/// Returns true if the character code is printable (0x20-0x7E).
pub fn is_print(c: i32) -> bool:
    c >= 32 and c <= 126

/// Convert uppercase to lowercase (ASCII). Returns unchanged if not uppercase.
pub fn to_lower(c: i32) -> i32:
    if c >= 65 and c <= 90: c + 32 else: c

/// Convert lowercase to uppercase (ASCII). Returns unchanged if not lowercase.
pub fn to_upper(c: i32) -> i32:
    if c >= 97 and c <= 122: c - 32 else: c

/// Convert a string to an i64 integer. Returns 0 on invalid input.
/// A With digit loop, not the runtime's with_parse_i64_ref: parsing is pure,
/// so it is comptime-evaluable (#2460; a build action evaluated at comptime
/// parses its env and args through here).
pub comptime fn string_to_int(s: &str) -> i64:
    if s.len() == 0: return 0
    var neg = false
    var i: i64 = 0
    if s[0] == 45:
        neg = true
        i = 1
    else if s[0] == 43:
        i = 1
    var result: i64 = 0
    while i < s.len():
        let c = s[i]
        if c < 48 or c > 57: break
        result = result * 10 + (c - 48) as i64
        i = i + 1
    if neg: 0 - result else: result

/// Split text into lines. Returns a List of strings, one per line.
pub fn lines(s: &str) -> List[str]:
    var out: List[str] = List{ ptr: 0, len: 0, cap: 0, start: 0 }
    with_lines_out_ref((&raw mut out) as *mut u8, s)
    out

/// Parse a string as an i32 integer.
pub comptime fn parse(s: &str) -> i32:
    let n = string_to_int(s)
    n as i32

// The magnitude of the decimal integer at `s[start..]`, digits until the
// first non-digit — string_to_int's rule at 128 bits (#914). The checked
// arithmetic panics past u128's range, as it does at 64 bits.
fn parse_u128_magnitude(s: &str, start: i64) -> u128:
    var result: u128 = 0
    var i = start
    while i < s.len():
        let c = s[i]
        if c < 48 or c > 57: break
        result = result * 10 + (c - 48) as u128
        i = i + 1
    result

/// Parse a string as an i128 integer. Returns 0 on invalid input, like
/// string_to_int; a magnitude outside i128's range panics.
pub fn parse_i128(s: &str) -> i128:
    if s.len() == 0: return 0
    var start: i64 = 0
    var neg = false
    if s[0] == 45:
        neg = true
        start = 1
    else if s[0] == 43:
        start = 1
    let mag = parse_u128_magnitude(s, start)
    let limit: u128 = if neg: 170141183460469231731687303715884105728 else: 170141183460469231731687303715884105727
    if mag > limit:
        panic("parse_i128: value out of range for i128")
    if neg and mag == limit: -170141183460469231731687303715884105728 else if neg: 0 - (mag as i128) else: mag as i128

/// Parse a string as a u128 integer. Returns 0 on invalid input, like
/// string_to_int; a magnitude outside u128's range panics.
pub fn parse_u128(s: &str) -> u128:
    if s.len() == 0: return 0
    parse_u128_magnitude(s, if s[0] == 43: 1 else: 0)

/// A type made from text (§15.5, D203): `i32("42")` and `"42".parse()` are
/// one conversion. `parse_text` is the value the whole of `text` spells, or
/// None. An integer type also reads digits of a stated base. The call form
/// panics where `parse` is None, and `parse_failure` is what its message
/// says after the text: ": overflow" for a value the type cannot hold.
pub trait Parse:
    fn parse_text(text: &str) -> Option[Self]
    fn parse_text_in(text: &str, base: i32) -> Option[Self]: None
    fn parse_failure(text: &str, base: i32) -> str: ""

/// `text as T` (§15.5): the value the whole of `text` spells, or the panic
/// that names the type, the text and the cast. The compiler writes the
/// call, with the type's name and the cast's place.
pub fn __value_from_text[T: Parse](text: str, type_name: str, file: str, line: i32, column: i32) -> T:
    match T.parse_text(text):
        Some(value) => value
        None =>
            let shown = if text.len() > 64: text.slice(0, 64) ++ "..." else: text.to_owned()
            // The place is the cast's, stated in the message: the panic has
            // no site of its own here.
            with_panic(f"cannot parse {type_name} from \"{shown}\"{T.parse_failure(text, 0)}\n  at {file}:{line}:{column}", "", 0)

// What integer text was (§15.5).
const PARSED_VALUE = 0
const PARSED_NOT_A_NUMBER = 1
const PARSED_OVERFLOW = 2

// The value of a digit character in bases up to 36, or 36 for any other.
fn digit_value(c: u8) -> u32:
    if c >= '0' and c <= '9': return (c - '0') as u32
    if c >= 'a' and c <= 'z': return (c - 'a') as u32 + 10
    if c >= 'A' and c <= 'Z': return (c - 'A') as u32 + 10
    36

// The sign and magnitude the whole of `text` spells as an integer, and
// which of the three it was. `base` 0 is With's notation: decimal, or
// `0x`, `0o`, `0b` in either case; otherwise the digits are of that base
// and no prefix is read. `_` stands only between two digits. A magnitude
// past u128 is an overflow only when every character was a digit.
fn parse_integer_parts(text: &str, base: i32) -> (i32, bool, u128):
    if base != 0 and (base < 2 or base > 36): panic(f"base: {base} is not a base; an integer is read in base 2 through 36")
    let neg = text.len() > 0 and text[0] == '-'
    var i = if neg or (text.len() > 0 and text[0] == '+'): 1 else: 0
    var radix: u128 = if base == 0: 10 else: base as u128
    if base == 0 and i + 1 < text.len() and text[i] == '0':
        let mark = text[i + 1]
        let prefixed: u128 = if mark == 'x' or mark == 'X': 16 else if mark == 'o' or mark == 'O': 8 else if mark == 'b' or mark == 'B': 2 else: 0
        if prefixed != 0:
            radix = prefixed
            i += 2
    if i == text.len(): return (PARSED_NOT_A_NUMBER, neg, 0)
    let most: u128 = 340282366920938463463374607431768211455
    var mag: u128 = 0
    var overflow = false
    var after_digit = false
    while i < text.len():
        let c = text[i]
        i += 1
        if c == '_':
            // Between two digits: one before it, one after it.
            if not after_digit or i == text.len() or digit_value(text[i]) as u128 >= radix: return (PARSED_NOT_A_NUMBER, neg, 0)
            after_digit = false
            continue
        let digit = digit_value(c) as u128
        if digit >= radix: return (PARSED_NOT_A_NUMBER, neg, 0)
        after_digit = true
        if mag > (most - digit) / radix: overflow = true
        else: mag = mag * radix + digit
    (if overflow: PARSED_OVERFLOW else: PARSED_VALUE, neg, mag)

// A signed integer of `bits` bits, and which of the three the text was.
fn parse_signed(text: &str, bits: u32, base: i32) -> (i32, i128):
    let (what, neg, mag) = parse_integer_parts(text, base)
    if what != PARSED_VALUE: return (what, 0)
    let limit = (1 as u128) << (bits - 1)
    if neg:
        if mag > limit: return (PARSED_OVERFLOW, 0)
        if mag == 0: return (PARSED_VALUE, 0)
        return (PARSED_VALUE, 0 - ((mag - 1) as i128) - 1)
    if mag >= limit: return (PARSED_OVERFLOW, 0)
    (PARSED_VALUE, mag as i128)

// An unsigned integer of `bits` bits ("-0" is 0), and which of the three
// the text was: a negative value is one the type cannot hold.
fn parse_unsigned(text: &str, bits: u32, base: i32) -> (i32, u128):
    let (what, neg, mag) = parse_integer_parts(text, base)
    if what != PARSED_VALUE: return (what, 0)
    if (neg and mag != 0) or (bits < 128 and mag >= (1 as u128) << bits): return (PARSED_OVERFLOW, 0)
    (PARSED_VALUE, mag)

fn signed_value(text: &str, bits: u32, base: i32) -> Option[i128]:
    let (what, value) = parse_signed(text, bits, base)
    if what != PARSED_VALUE: return None
    value

fn unsigned_value(text: &str, bits: u32, base: i32) -> Option[u128]:
    let (what, value) = parse_unsigned(text, bits, base)
    if what != PARSED_VALUE: return None
    value

fn overflow_text(what: i32) -> str: if what == PARSED_OVERFLOW: ": overflow" else: ""

// Whether the whole of `text` is a decimal float: an optional sign, digits
// with an optional fraction (at least one digit in all), and an optional
// exponent with at least one digit.
fn float_text_is_number(text: &str) -> bool:
    var i = if text.len() > 0 and (text[0] == '-' or text[0] == '+'): 1 else: 0
    var digits = 0
    while i < text.len() and text[i] >= '0' and text[i] <= '9':
        i += 1
        digits += 1
    if i < text.len() and text[i] == '.':
        i += 1
        while i < text.len() and text[i] >= '0' and text[i] <= '9':
            i += 1
            digits += 1
    if digits == 0: return false
    if i < text.len() and (text[i] == 'e' or text[i] == 'E'):
        i += 1
        if i < text.len() and (text[i] == '-' or text[i] == '+'): i += 1
        var exp_digits = 0
        while i < text.len() and text[i] >= '0' and text[i] <= '9':
            i += 1
            exp_digits += 1
        if exp_digits == 0: return false
    i == text.len()

// The float a name spells (§15.5): `inf` and `infinity` under an optional
// sign, `nan` under none, in any case. None for any other text.
fn float_named(text: &str) -> Option[f64]:
    let signed = text.len() > 0 and (text[0] == '-' or text[0] == '+')
    let name = (if signed: text.slice(1, text.len()) else: text).to_lower()
    if name == "inf" or name == "infinity": return if signed and text[0] == '-': -f64.inf else: f64.inf
    if name == "nan" and not signed: return f64.nan
    None

// The double of float text and which of the three the text was: finite
// text too large for a double is an overflow, never infinity. The finite
// value is strtod's, the correctly rounded one (#2176).
fn parse_double(text: &str) -> (i32, f64):
    match float_named(text):
        Some(v) => return (PARSED_VALUE, v)
        None => {}
    if not float_text_is_number(text): return (PARSED_NOT_A_NUMBER, 0.0)
    match text.to_cstring():
        Ok(c) =>
            let v = with_libc_strtold(c.as_cstr().ptr(), null)
            if v == f64.inf or v == -f64.inf: (PARSED_OVERFLOW, 0.0) else: (PARSED_VALUE, v)
        Err(_) => (PARSED_NOT_A_NUMBER, 0.0)

// The same for a float: the nearest float of the text itself (strtof's),
// not of its double.
fn parse_float(text: &str) -> (i32, f32):
    match float_named(text):
        Some(v) => return (PARSED_VALUE, v as f32)
        None => {}
    if not float_text_is_number(text): return (PARSED_NOT_A_NUMBER, 0.0)
    match text.to_cstring():
        Ok(c) =>
            let v = with_libc_strtof(c.as_cstr().ptr(), null)
            if v == f32.inf or v == -f32.inf: (PARSED_OVERFLOW, 0.0) else: (PARSED_VALUE, v)
        Err(_) => (PARSED_NOT_A_NUMBER, 0.0)

impl Parse for i8:
    fn parse_text(text: &str) -> Option[i8]: signed_value(text, 8, 0)? as i8
    fn parse_text_in(text: &str, base: i32) -> Option[i8]: signed_value(text, 8, base)? as i8
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_signed(text, 8, base).0)
impl Parse for i16:
    fn parse_text(text: &str) -> Option[i16]: signed_value(text, 16, 0)? as i16
    fn parse_text_in(text: &str, base: i32) -> Option[i16]: signed_value(text, 16, base)? as i16
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_signed(text, 16, base).0)
impl Parse for i32:
    fn parse_text(text: &str) -> Option[i32]: signed_value(text, 32, 0)? as i32
    fn parse_text_in(text: &str, base: i32) -> Option[i32]: signed_value(text, 32, base)? as i32
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_signed(text, 32, base).0)
impl Parse for i64:
    fn parse_text(text: &str) -> Option[i64]: signed_value(text, 64, 0)? as i64
    fn parse_text_in(text: &str, base: i32) -> Option[i64]: signed_value(text, 64, base)? as i64
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_signed(text, 64, base).0)
impl Parse for i128:
    fn parse_text(text: &str) -> Option[i128]: signed_value(text, 128, 0)
    fn parse_text_in(text: &str, base: i32) -> Option[i128]: signed_value(text, 128, base)
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_signed(text, 128, base).0)
impl Parse for isize:
    fn parse_text(text: &str) -> Option[isize]: signed_value(text, sizeof[isize]() as u32 * 8, 0)? as isize
    fn parse_text_in(text: &str, base: i32) -> Option[isize]: signed_value(text, sizeof[isize]() as u32 * 8, base)? as isize
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_signed(text, sizeof[isize]() as u32 * 8, base).0)
impl Parse for u8:
    fn parse_text(text: &str) -> Option[u8]: unsigned_value(text, 8, 0)? as u8
    fn parse_text_in(text: &str, base: i32) -> Option[u8]: unsigned_value(text, 8, base)? as u8
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_unsigned(text, 8, base).0)
impl Parse for u16:
    fn parse_text(text: &str) -> Option[u16]: unsigned_value(text, 16, 0)? as u16
    fn parse_text_in(text: &str, base: i32) -> Option[u16]: unsigned_value(text, 16, base)? as u16
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_unsigned(text, 16, base).0)
impl Parse for u32:
    fn parse_text(text: &str) -> Option[u32]: unsigned_value(text, 32, 0)? as u32
    fn parse_text_in(text: &str, base: i32) -> Option[u32]: unsigned_value(text, 32, base)? as u32
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_unsigned(text, 32, base).0)
impl Parse for u64:
    fn parse_text(text: &str) -> Option[u64]: unsigned_value(text, 64, 0)? as u64
    fn parse_text_in(text: &str, base: i32) -> Option[u64]: unsigned_value(text, 64, base)? as u64
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_unsigned(text, 64, base).0)
impl Parse for u128:
    fn parse_text(text: &str) -> Option[u128]: unsigned_value(text, 128, 0)
    fn parse_text_in(text: &str, base: i32) -> Option[u128]: unsigned_value(text, 128, base)
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_unsigned(text, 128, base).0)
impl Parse for usize:
    fn parse_text(text: &str) -> Option[usize]: unsigned_value(text, sizeof[usize]() as u32 * 8, 0)? as usize
    fn parse_text_in(text: &str, base: i32) -> Option[usize]: unsigned_value(text, sizeof[usize]() as u32 * 8, base)? as usize
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_unsigned(text, sizeof[usize]() as u32 * 8, base).0)

impl Parse for f64:
    fn parse_text(text: &str) -> Option[f64]:
        let (what, value) = parse_double(text)
        if what != PARSED_VALUE: return None
        value
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_double(text).0)
impl Parse for f32:
    fn parse_text(text: &str) -> Option[f32]:
        let (what, value) = parse_float(text)
        if what != PARSED_VALUE: return None
        value
    fn parse_failure(text: &str, base: i32) -> str: overflow_text(parse_float(text).0)

/// `it.collect[String]()` over bytes (§13.3): the bytes in order, one str.
pub fn iter_collect_string[I: Iter[u8]](iter: I) -> str:
    var i = iter
    var out = StringBuilder.new()
    while true:
        match i.next():
            None => break
            Some(b) => out.push_byte(b)
    out.to_str()

pub fn iter_collect_string_views[I: Iter[&u8]](iter: I) -> str:
    var i = iter
    var out = StringBuilder.new()
    while true:
        match i.next():
            None => break
            Some(b) => out.push_byte(b)
    out.to_str()
