@[repr(C)]
pub type twords = union { pub all: i128 = 0, pub s: twords_s }
impl Copy for twords

@[repr(C)]
pub type utwords_s { low: u64 = 0, high: u64 = 0 }
impl Copy for utwords_s
@[repr(C)]
pub type utwords = union { pub all: u128 = 0, pub s: utwords_s }
impl Copy for utwords

@[repr(C)]
pub type float_bits = union { pub u: u32 = 0, pub f: f32 = 0.0 }
impl Copy for float_bits

@[repr(C)]
pub type double_bits = union { pub u: udwords, pub f: f64 = 0.0 }
impl Copy for double_bits

@[repr(C)]
pub type uqwords { pub low: udwords, pub high: udwords }
impl Copy for uqwords

@[repr(C)]
pub type Fcomplex { pub real: f32 = 0.0, pub imaginary: f32 = 0.0 }
