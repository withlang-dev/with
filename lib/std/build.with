    pub timeout_ms: i32,
    pub stdin_path: str,
    pub capture_stdout: bool,
    pub capture_stderr: bool,
}

pub enum ArchiveEntryKind: i32:
    File = 0
    Directory = 1
    Symlink = 2

pub type ArchiveEntry {
    pub kind: ArchiveEntryKind,
    pub source_path: str,
    pub archive_path: str,
    pub mode: i32,
}

pub fn archive_file_entry(source_path: str, archive_path: str, mode: i32) -> ArchiveEntry:
    ArchiveEntry {
        kind: ArchiveEntryKind.File,
        source_path,
        archive_path,
        mode,
    }

pub fn archive_dir_entry(archive_path: str, mode: i32) -> ArchiveEntry:
    ArchiveEntry {
        kind: ArchiveEntryKind.Directory,
        source_path: "",
        archive_path,
        mode,
    }

pub fn archive_symlink_entry(target: str, archive_path: str, mode: i32) -> ArchiveEntry:
    ArchiveEntry {
        kind: ArchiveEntryKind.Symlink,
        source_path: target,
        archive_path,
        mode,
    }

pub fn process_spec(executable: str) -> ProcessSpec:
    ProcessSpec {
        executable,
        args: [],
        cwd: "",
        env: ProcessEnv { vars: [] },
        timeout_ms: 0,
        stdin_path: "",
        capture_stdout: true,
        capture_stderr: true,
    }

impl ProcessSpec:
    // D32 (§2.2): builder steps rebind the consumed receiver to a `var` and
    // mutate in place — no field leaves the value, so nothing vacates.
    pub move fn arg(value: str) -> ProcessSpec:
        let owned = self
        owned.args.push(value)
        owned

    pub move fn working_dir(path: str) -> ProcessSpec:
        let owned = self
        owned.cwd = path
        owned

    pub move fn timeout(ms: i32) -> ProcessSpec:
        let owned = self
        owned.timeout_ms = ms
        owned

    pub move fn stdin(path: str) -> ProcessSpec:
        let owned = self
        owned.stdin_path = path
        owned

    pub move fn env_var(name: str, value: str) -> ProcessSpec:
        var owned = self
        owned.env = (move owned.env).set(name, value)
        owned

    pub move fn capture(stdout: bool, stderr: bool) -> ProcessSpec:
        let owned = self
        owned.capture_stdout = stdout
        owned.capture_stderr = stderr
        owned

