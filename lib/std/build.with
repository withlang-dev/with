// std.build — typed build graph construction API.
//
// The compiler driver is responsible for executing build.with in tool mode and
// turning this graph into concrete compiler/linker actions.

use std.crypto.sha256
use std.fs.IoError
use std.libc.fopen
use std.libc.fclose
