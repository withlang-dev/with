    /// The environment variable `name` ("" when unset), read as a declared
    /// input of this action's target (§17.1a): the value is recorded with the
    /// target, and a run whose value differs reruns the target instead of
    /// reusing its cached output.
    ///
    ///     if ctx.env_input("WITH_TEST_NETWORK") == "1": run_network_case(ctx)
    pub fn env_input(name: &str) -> str:
        tool_capability_require(self.token, "ActionCtx")
        tool_effect_record_env(self.target_name_value, name)
        with_getenv_str(name)

fn build_graph_escape(value: &str) -> str:
    let out = StringBuilder.with_capacity(value.len())
    for i in 0..value.len():
        let ch = value[i]
        if ch == 92:
            out.push_str("\\\\")
        else if ch == 9:
            out.push_str("\\t")
        else if ch == 10:
            out.push_str("\\n")
        else if ch == 13:
            out.push_str("\\r")
        else:
            out.push_str(value.slice(i, (i + 1)))
    out.to_str()

pub fn new_build(package: Package) -> Build:
    Build {
        package,
        default_target: "",
        targets: [],
        generated_sources: [],
    }

impl Build:
    pub move fn default(target_name: str) -> Build:
        let out = self
        out.default_target = target_name
        out

pub fn target_new(kind: BuildKind, name: str, entry: str) -> Target:
    Target {
        kind,
        name,
        entry,
        output: "",
        target_kind: BuildTarget.native,
        optimize_mode: OptimizeMode.debug,
        system_libs: [],
        library_paths: [],
        rpaths: [],
        include_paths: [],
        defines: [],
        inputs: [],
        extra_outputs: [],
        write_scopes: [],
        deps: [],
        args: [],
        action: build_noop_action,
        timeout_ms: 0,
        cwd: "",
        env: [],
        network: false,
        parallel: false,
    }

impl Target:
    pub move fn timeout(ms: i32) -> Target:
        let out = self
        out.timeout_ms = ms
        out

    pub move fn working_dir(path: str) -> Target:
        let out = self
        out.cwd = path
        out

    pub move fn with_env(key: &str, value: &str) -> Target:
        let out = self
        out.env.push(key ++ "=" ++ value)
        out

    pub move fn allow_network() -> Target:
        let out = self
        out.network = true
        out

    // Declares this action a pure function of its declared inputs: no reads of
    // undeclared state, no effect-ordering against other targets. The executor
    // may run it concurrently with other allow_parallel targets.
    pub move fn allow_parallel() -> Target:
        let out = self
        out.parallel = true
        out

