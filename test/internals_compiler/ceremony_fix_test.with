//! expect-stdout: ok

// #3061: `with fix-ceremony` over a program with every shape its first two
// passes decide — an annotation the initializer's type already gives (a
// read, an f-string, a non-generic call), one a literal needs (`3`, `[]`),
// a `var` rebound in a loop, a `var` only pushed into, and a `var` copied
// from — and the rewritten program still checks.
//
// #3061 slice 3: `for i in 0..xs.len():` whose counter indexes only `xs`
// iterates the list; a loop that also uses the counter as a number, or
// writes through it, or indexes another list, stays.
//
// #3061 slice 2: a widening cast under a demand of its target goes, and
// (D197) so does a `(k as u32)` shift count with its parens; a
// `List.new()` / `HashMap.new()` / `HashSet.new()` under a written type is
// the empty literal (D93); a narrowing cast, a cast that types a binding,
// and a constructor without a written type all stay.
//
// #3061 slice 4: the census's typed patterns rewrite — `.clone()` on a str
// goes (D111), an explicit `&x` at a `&T` parameter goes (§3.8), `Some(x)`
// under an Option demand becomes `x` (D103). A clone of a List and a `&x`
// at a `T` parameter stay.
//
// One program for the four slices: each test that imports the compiler
// compiles it, and four of them took the lane past its hour on the nightly
// runner (#3231).
use CeremonyFix
use compiler.Compilation
use std.fs

let SAMPLE_BASIC = "fn total(xs: &List[i32]) -> i64:\n    var n: i64 = 0\n    for x in xs: n = n + x\n    n\n\nfn label(k: i32) -> str:\n    let name: str = f\"item {k}\"\n    var other: str = name\n    let width: i32 = k\n    let twice: i64 = total([k, k])\n    let count: i64 = 3\n    var xs: List[i32] = []\n    xs.push(width)\n    f\"{other} {width} {twice} {count} {xs.len()}\"\n\nfn main:\n    print(label(2))\n"

let EXPECTED_BASIC = "fn total(xs: &List[i32]) -> i64:\n    var n: i64 = 0\n    for x in xs: n = n + x\n    n\n\nfn label(k: i32) -> str:\n    let name = f\"item {k}\"\n    let other = name\n    let width = k\n    let twice = total([k, k])\n    let count: i64 = 3\n    let xs: List[i32] = []\n    xs.push(width)\n    f\"{other} {width} {twice} {count} {xs.len()}\"\n\nfn main:\n    print(label(2))\n"

let SAMPLE_LOOPS = "fn later(names: &List[str]):\n    for i in 0..names.len():\n        print(names[i])\n    let name = \"z\"\n    print(name)\nfn main:\n    later([\"q\"])\n    let text = \"ab\"\n    for i in 0..text.len():\n        print(text[i])\n    let modules = [1]\n    for i in 0..modules.len():\n        print(modules[i])\n    let parts = [\"a\", \"b\"]\n    let ws = [1, 2, 3]\n    var total = 0\n    for i in 0..parts.len():\n        print(parts[i])\n    for i in 0..ws.len():\n        total = total + ws[i] * i\n    for i in 0..ws.len():\n        ws[i] = ws[i] + 1\n    for i in 0..parts.len():\n        print(f\"{parts[i]} {ws[i]}\")\n    print(f\"{total}\")\n"

let EXPECTED_LOOPS = "fn later(names: &List[str]):\n    for i in 0..names.len():\n        print(names[i])\n    let name = \"z\"\n    print(name)\nfn main:\n    later([\"q\"])\n    let text = \"ab\"\n    for i in 0..text.len():\n        print(text[i])\n    let modules = [1]\n    for each_module in modules:\n        print(each_module)\n    let parts = [\"a\", \"b\"]\n    let ws = [1, 2, 3]\n    var total = 0\n    for part in parts:\n        print(part)\n    for i in 0..ws.len():\n        total = total + ws[i] * i\n    for i in 0..ws.len():\n        ws[i] = ws[i] + 1\n    for i in 0..parts.len():\n        print(f\"{parts[i]} {ws[i]}\")\n    print(f\"{total}\")\n"

let SAMPLE_CASTS = "use std.collections.HashMap\nuse std.collections.HashSet\nfn wide(n: i64) -> i64: n\nfn narrow(n: i32) -> i32: n\nfn main:\n    let k: i32 = 3\n    let a = wide(k as i64)\n    let b = narrow(a as i32)\n    let c = k as i64\n    let sh = 1 << (k as u32)\n    let xs: List[i32] = List.new()\n    let m: HashMap[str, i32] = HashMap.new()\n    let s: HashSet[i32] = HashSet.new()\n    let ys = List.new()\n    ys.push(1)\n    xs.push(k)\n    print(f\"{sh} {a} {b} {c} {xs.len()} {m.len()} {s.len()} {ys.len()}\")\n"

let EXPECTED_CASTS = "use std.collections.HashMap\nuse std.collections.HashSet\nfn wide(n: i64) -> i64: n\nfn narrow(n: i32) -> i32: n\nfn main:\n    let k: i32 = 3\n    let a = wide(k)\n    let b = narrow(a as i32)\n    let c = k as i64\n    let sh = 1 << k\n    let xs: List[i32] = []\n    let m: HashMap[str, i32] = [:]\n    let s: HashSet[i32] = []\n    let ys = List.new()\n    ys.push(1)\n    xs.push(k)\n    print(f\"{sh} {a} {b} {c} {xs.len()} {m.len()} {s.len()} {ys.len()}\")\n"

let SAMPLE_TYPED = "fn peek(s: &str) -> i64: s.len()\nfn take(n: i32) -> i32: n\nfn pick(flag: bool) -> Option[i32]:\n    if flag: Some(1) else: None\nfn main:\n    let name = \"ab\"\n    let twin = name.clone()\n    let xs = [1, 2]\n    let ys = xs.clone()\n    let k = 3\n    print(f\"{peek(&name)} {take(k)} {twin} {ys.len()} {pick(true).unwrap()}\")\n"

let EXPECTED_TYPED = "fn peek(s: &str) -> i64: s.len()\nfn take(n: i32) -> i32: n\nfn pick(flag: bool) -> Option[i32]:\n    if flag: 1 else: None\nfn main:\n    let name = \"ab\"\n    let twin = name\n    let xs = [1, 2]\n    let ys = xs.clone()\n    let k = 3\n    print(f\"{peek(name)} {take(k)} {twin} {ys.len()} {pick(true).unwrap()}\")\n"

// A trait impl method's written return type that is the trait's own goes
// (a plain type, an alias of it, a `Result`); an impl of a generic type and
// a free function keep theirs.
let SAMPLE_CONTRACT = "trait Uno:\n    fn one() -> Self\n    fn size(self: &Self) -> i64\n    fn name(self: &Self) -> str\n    fn checked(self: &Self) -> Result[i64, str]\n\ntype Num = i64\n\ntype P \{ n: i64 }\n\nimpl Uno for f64:\n    fn one() -> f64: 1.0\n    fn size() -> i64: 8\n    fn name() -> str: \"f64\"\n    fn checked() -> Result[i64, str]: 8\n\nimpl Uno for P:\n    fn one() -> P: P \{ n: 1 }\n    fn size() -> Num:\n        self.n\n    fn name(): \"p\"\n    fn checked() -> Result[i64, str]:\n        if self.n < 0: return Err(\"negative\")\n        self.n\n\ntype Box2[T] \{ v: T }\n\nimpl[T] Uno for Box2[T]:\n    fn one() -> Box2[T]: panic(\"none\")\n    fn size() -> i64: 1\n    fn name() -> str: \"box\"\n    fn checked() -> Result[i64, str]: 1\n\nfn free() -> i64: 3\n\nfn main:\n    let p = P.one()\n    let f: f64 = f64.one()\n    print(f\"\{p.size()} \{p.name()} \{p.checked() ?? -1} \{f.size()} \{f.name()} \{f.checked() ?? -1} \{free()}\")\n"

let EXPECTED_CONTRACT = "trait Uno:\n    fn one() -> Self\n    fn size(self: &Self) -> i64\n    fn name(self: &Self) -> str\n    fn checked(self: &Self) -> Result[i64, str]\n\ntype Num = i64\n\ntype P \{ n: i64 }\n\nimpl Uno for f64:\n    fn one(): 1.0\n    fn size(): 8\n    fn name(): \"f64\"\n    fn checked(): 8\n\nimpl Uno for P:\n    fn one(): P \{ n: 1 }\n    fn size():\n        self.n\n    fn name(): \"p\"\n    fn checked():\n        if self.n < 0: return Err(\"negative\")\n        self.n\n\ntype Box2[T] \{ v: T }\n\nimpl[T] Uno for Box2[T]:\n    fn one() -> Box2[T]: panic(\"none\")\n    fn size() -> i64: 1\n    fn name() -> str: \"box\"\n    fn checked() -> Result[i64, str]: 1\n\nfn free() -> i64: 3\n\nfn main:\n    let p = P.one()\n    let f = f64.one()\n    print(f\"\{p.size()} \{p.name()} \{p.checked() ?? -1} \{f.size()} \{f.name()} \{f.checked() ?? -1} \{free()}\")\n"

fn fixes(path: str, sample: str, expected: str, count: isize):
    assert(write_file(path, sample) == 0)
    var comp = Compilation.init()
    let pool = comp.compile_entry_file(path)
    assert(pool.decl_count() > 0 and not comp.zcu.diagnostics.has_errors())
    let edits = cf_collect(comp.zcu.last_sema, pool, [], false)
    let mine = [e for e in edits if e.path == path]
    assert_eq(mine.len(), count)
    let rewritten = cf_rewrite(sample, mine)
    assert_eq(rewritten, expected)
    assert(write_file(path, rewritten) == 0)
    var again = Compilation.init()
    let pool2 = again.compile_entry_file(path)
    assert(pool2.decl_count() > 0 and not again.zcu.diagnostics.has_errors())

// #2522 (D183): the narrowing casts of a length are reported, never
// rewritten, in two classes: an `i32` declaration demands the cast (an
// annotated binding, a field, a parameter), or nothing does (a plain
// binding, a range bound). A widening cast of a length is neither.
let SAMPLE_LEN_CASTS = "type Table { count: i32 }\nfn take(n: i32) -> i32: n\nfn main:\n    let xs = [1, 2, 3]\n    let n = xs.len() as i32\n    let m: i32 = xs.len() as i32\n    let t = Table { count: xs.len() as i32 }\n    var sum = take(xs.len() as i32)\n    for i in 0..xs.len() as i32:\n        sum = sum + i\n    let wide = xs.len() as i64\n    print(n + m + t.count + sum + wide as i32)\n"

fn reports_len_casts(path: str):
    assert(write_file(path, SAMPLE_LEN_CASTS) == 0)
    var comp = Compilation.init()
    let pool = comp.compile_entry_file(path)
    assert(pool.decl_count() > 0 and not comp.zcu.diagnostics.has_errors())
    let notes = cf_len_cast_notes(comp.zcu.last_sema, pool, [], false)
    let text = notes.join("\n")
    for line in [5, 9]: assert(text.contains(f"{path}:{line}: len cast: nothing demands `i32` here"))
    for line in [6, 7, 8]: assert(text.contains(f"{path}:{line}: len cast: an `i32` declaration demands it"))
    assert(not text.contains(f"{path}:11:"))
    assert(text.contains("fix-ceremony: 5 length cast(s): 3 demanded by a declaration, 2 that set a width nothing asks for"))
    // Reported, not rewritten: no edit touches a narrowing cast.
    assert_eq([e for e in cf_collect(comp.zcu.last_sema, pool, [], false) if e.what.contains("as i32")].len(), 0)

fn main:
    reports_len_casts("out/ceremony_fix_len_casts_sample.with")
    fixes("out/ceremony_fix_sample.with", SAMPLE_BASIC, EXPECTED_BASIC, 6)
    fixes("out/ceremony_fix_loops_sample.with", SAMPLE_LOOPS, EXPECTED_LOOPS, 4)
    fixes("out/ceremony_fix_casts_sample.with", SAMPLE_CASTS, EXPECTED_CASTS, 6)
    fixes("out/ceremony_fix_typed_sample.with", SAMPLE_TYPED, EXPECTED_TYPED, 4)
    fixes("out/ceremony_fix_contract_sample.with", SAMPLE_CONTRACT, EXPECTED_CONTRACT, 8)
    print("ok")
