//! expect-exit: 134
//! expect-stdout: overlay 1
//! expect-stderr: Callback.poll: a poll of this message is already running

// D216 (#2425): a message with `release` whose producer receives no resource
// has nothing a poll could borrow. A poll begun inside the body of another
// would release the payload the outer body still reads, so it panics.
use c_import("behav_d216_callbacks.h")

c contract steamish:
    message Callback wraps Msg
        from msg_next(out param 1)
        tag tag
        case OverlayActivated when CB_OVERLAY : Overlay
        case StatsStored when CB_STORED : Stored
        payload data size size
        release msg_free

fn main:
    for cb in Callback.poll(3):
        match cb:
            .OverlayActivated(o) => print(f"overlay {o.active}")
            _ => {}
        for inner in Callback.poll(3):
            match inner:
                _ => print("unreachable")
