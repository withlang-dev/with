//! expect-stdout: c_import complex implicit ok

// No explicit `use std.complex` here: c_import imports std.complex on demand
// when the header uses `_Complex`.
use c_import("#include <complex.h>\nstatic inline double _Complex c_add_z(double _Complex a, double _Complex b) { return a + b; }\n") as cplx

fn main():
    let z = cplx.c_add_z(Complex64.new(1.0, 2.0), Complex64.new(3.0, 4.0))
    assert(z.real == 4.0 and z.imag == 6.0)
    print("c_import complex implicit ok")
