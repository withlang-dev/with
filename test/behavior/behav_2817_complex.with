//! expect-stdout: complex ok

use std.complex
use std.math
use std.libc

fn near64(a: f64, b: f64, eps: f64) -> bool:
    let d = a - b
    if d < 0.0: -d < eps else: d < eps

fn near32(a: f32, b: f32, eps: f32) -> bool:
    let d = a - b
    if d < 0.0: -d < eps else: d < eps

fn main():
    // Basic arithmetic (Complex64)
    let a = Complex64.new(3.0, 4.0)
    let b = Complex64.new(1.0, 2.0)
    assert(a + b == Complex64.new(4.0, 6.0))
    assert(a - b == Complex64.new(2.0, 2.0))
    assert(a * b == Complex64.new(-5.0, 10.0))
    assert((a * b) / b == a)
    assert(-a == Complex64.new(-3.0, -4.0))
    assert(a.conj() == Complex64.new(3.0, -4.0))
    assert(a.norm_sq() == 25.0)
    assert(Complex64.default() == Complex64.new(0.0, 0.0))
    assert(Complex64.one() == Complex64.new(1.0, 0.0))
    assert(Complex64.from_real(2.5) == Complex64.new(2.5, 0.0))
    assert(Complex64.from_imag(-1.5) == Complex64.new(0.0, -1.5))

    // Basic arithmetic (Complex32)
    let af = Complex32.new(3.0, 4.0)
    let bf = Complex32.new(1.0, 2.0)
    assert(af + bf == Complex32.new(4.0, 6.0))
    assert(af - bf == Complex32.new(2.0, 2.0))
    assert(af * bf == Complex32.new(-5.0, 10.0))
    assert((af * bf) / bf == af)
    assert(-af == Complex32.new(-3.0, -4.0))
    assert(af.conj() == Complex32.new(3.0, -4.0))
    assert(af.norm_sq() == 25.0)

    // C99 Annex G edge cases via migrated compiler-rt engine
    let inf64 = 1.0 / 0.0
    let mi = Complex64.new(inf64, 0.0) * Complex64.new(1.0, 1.0)
    assert(isinf(mi.real) != 0 and isinf(mi.imag) != 0)
    let di = Complex64.new(1.0, 1.0) / Complex64.new(0.0, 0.0)
    assert(isinf(di.real) != 0 and isinf(di.imag) != 0)
    let big = Complex64.new(1e300, 1e300) / Complex64.new(1e300, 1e300)
    assert(near64(big.real, 1.0, 1e-12) and near64(big.imag, 0.0, 1e-12))

    let inf32: f32 = (1.0 as f32) / (0.0 as f32)
    let mif = Complex32.new(inf32, 0.0) * Complex32.new(1.0, 1.0)
    assert(isinf(mif.real as f64) != 0 and isinf(mif.imag as f64) != 0)
    let bigf = Complex32.new(1e30, 1e30) / Complex32.new(1e30, 1e30)
    assert(near32(bigf.real, 1.0, 1e-5) and near32(bigf.imag, 0.0, 1e-5))

    // C99 <complex.h> libm functions (f64)
    assert(creal(a) == 3.0 and cimag(a) == 4.0)
    assert(conj(a) == Complex64.new(3.0, -4.0))
    assert(near64(cabs(a), 5.0, 1e-12))
    assert(near64(a.abs(), 5.0, 1e-12))
    assert(near64(carg(Complex64.new(0.0, 1.0)), PI / 2.0, 1e-12))
    let euler = cexp(Complex64.new(0.0, PI))
    assert(near64(euler.real, -1.0, 1e-12) and near64(euler.imag, 0.0, 1e-12))
    let w = Complex64.new(1.0, 0.5)
    let rt = clog(cexp(w))
    assert(near64(rt.real, w.real, 1e-12) and near64(rt.imag, w.imag, 1e-12))
    let sq = csqrt(Complex64.new(-1.0, 0.0))
    assert(near64(sq.real, 0.0, 1e-12) and near64(sq.imag, 1.0, 1e-12))
    let pw = cpow(Complex64.new(0.0, 1.0), Complex64.new(2.0, 0.0))
    assert(near64(pw.real, -1.0, 1e-12) and near64(pw.imag, 0.0, 1e-12))

    // C99 <complex.h> libm functions (f32)
    assert(crealf(af) == 3.0 and cimagf(af) == 4.0)
    assert(conjf(af) == Complex32.new(3.0, -4.0))
    assert(near32(cabsf(af), 5.0, 1e-5))
    assert(near32(cargf(Complex32.new(0.0, 1.0)), (PI / 2.0) as f32, 1e-5))
    let eulerf = cexpf(Complex32.new(0.0, PI as f32))
    assert(near32(eulerf.real, -1.0, 1e-5) and near32(eulerf.imag, 0.0, 1e-5))
    let rtf = clogf(cexpf(Complex32.new(1.0, 0.5)))
    assert(near32(rtf.real, 1.0, 1e-5) and near32(rtf.imag, 0.5, 1e-5))
    let sqf = csqrtf(Complex32.new(-1.0, 0.0))
    assert(near32(sqf.real, 0.0, 1e-5) and near32(sqf.imag, 1.0, 1e-5))
    let pwf = cpowf(Complex32.new(0.0, 1.0), Complex32.new(2.0, 0.0))
    assert(near32(pwf.real, -1.0, 1e-5) and near32(pwf.imag, 0.0, 1e-5))

    print("complex ok")
