//! expect-stdout: ok

// A Copy field of a global read through a consuming method is a copy.
// `table[i].f.unwrap()` on a global table of C function pointers (zlib's
// `configuration_table[level].func.unwrap()`) was lowered as a `move` out
// of the global, which D52 forbids: `analyze audit:mir` failed on a program
// that ran correctly, and on the zlib corpus compiled from source.
use pre_d_build_runner

fn table_text -> str:
    "type step_fn = unsafe extern \"C\" fn(i32) -> i32\n" ++
        "type Entry { f: Option[step_fn], n: i32 }\n\n" ++
        "unsafe fn inc(x: i32) -> i32: x + 1\n\n" ++
        "let table: List[Entry] = [Entry { f: Some(inc), n: 1 }, Entry { f: Some(inc), n: 2 }]\n\n" ++
        "fn pick(i: i32) -> i32:\n" ++
        "    unsafe { table[i].f.unwrap()(i) }\n\n" ++
        "fn main:\n" ++
        "    print(pick(0) + pick(0) + pick(1))\n"

fn main:
    let case_dir = p7_prepare_case("copy_field_of_global_unwrap", "copy_field_of_global_unwrap")
    p7_write(case_dir, "src/table.with", table_text())
    let ran = p7_run(case_dir, "table_run", "run\0src/table.with\0")
    p7_assert_success(ran, "the table program runs")
    assert(ran.stdout.contains("4"))
    let audited = p7_run(case_dir, "table_audit", "analyze\0src/table.with\0audit:mir\0")
    p7_assert_success(audited, "audit:mir over a Copy field of a global")
    assert(audited.stdout.contains("violations=0"))
    print("ok")
