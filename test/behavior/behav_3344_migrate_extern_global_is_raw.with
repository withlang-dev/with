//! expect-stdout: ok
// #3344 (§31.4): a C global the migrated unit only declares is emitted
// `extern`, so a body that names it reads or writes a C global: raw unless
// it is `const` or thread-local, and an array of unknown size is a pointer
// whose index is a raw index. The bodies were emitted bare (`counter =
// counter + 1`, `tab[i]`) and the output did not check (E0921, "raw pointer
// indexing requires unsafe context"). A global the unit defines is With's
// own and stays as it was.
use std.fs
use pre_d_build_runner

fn main:
    let root = p7_prepare_case("migrate_extern_global_is_raw", "externglobal")
    p7_write(root, "c/p.c", "extern int counter;\nint bump(void) { counter = counter + 1; return counter; }\nextern const unsigned char tab[];\nint look(int i) { return tab[i]; }\nextern const int limit;\nint cap(void) { return limit; }\nstatic int own = 3;\nint mine(void) { own = own + 1; return own; }\n")
    assert(mkdir_p(root ++ "/w") == 0)
    let migrated = p7_run(root, "migrate", p7_argv_append(p7_argv_append(p7_argv_append(p7_argv_append("", "migrate"), "c/p.c"), "-o"), "w/p.with"))
    let said = migrated.stdout ++ migrated.stderr
    if said.contains("does not check"): print(said)
    p7_assert_success(migrated, "migrating a unit that reads and writes extern globals")
    let text = read_file(root ++ "/w/p.with") ?? ""
    // The extern that is written, and the extern array, are raw.
    assert(text.contains("unsafe { counter = ") and text.contains("return unsafe { counter }"))
    assert(text.contains("(unsafe tab["))
    // A `const` scalar extern and the unit's own global are not.
    assert(not text.contains("unsafe { limit"))
    assert(not text.contains("unsafe { own"))
    // A directory is checked as a file is: it said "4 functions translated"
    // over this same output when it did not compile.
    let whole = p7_run(root, "migrate-dir", p7_argv_append(p7_argv_append(p7_argv_append(p7_argv_append("", "migrate"), "c"), "-o"), "wd"))
    p7_assert_success(whole, "migrating the directory")
    let checked = p7_run(root, "check-dir-output", p7_argv_append(p7_argv_append("", "check"), "wd/p.with"))
    p7_assert_success(checked, "the directory's output checks")
    print("ok")
