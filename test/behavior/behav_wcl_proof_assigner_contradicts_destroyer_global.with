//! expect-stdout: ok
// §31.8.6: a destroyer clause that names a function-pointer global says the
// library assigns it only in functions that stay raw. Where `with get` read
// the package's source and recorded a function that assigns the global
// (contract-proofs.txt, `F<TAB>assigns<TAB>G<TAB>proof`), a contract that
// describes that function contradicts the clause: an error naming both,
// unless the clause is marked `override` (§31.7). A function that assigns
// it and that the contract leaves alone contradicts nothing.
use std.fs
use pre_d_build_runner

fn stated(drop: &str, described: &str) -> str:
    "use c_import(\"fake.h\")\n\n" ++
    "c contract fake:\n" ++
    "    resource Engine wraps *mut engine\n" ++
    "        from engine_new\n" ++
    "        " ++ drop ++ "\n" ++
    described

fn main:
    let root = p7_prepare_case("wcl_proof_assigner_contradicts_destroyer_global", "assigner")
    p7_write(root, "with.toml", "[package]\nname = \"assigner\"\nversion = \"0.1.0\"\n\n[deps]\nc.fake = \"1.0\"\n")
    p7_write(root, ".with/deps/c/fake/1.0/metadata.json", "{\n  \"name\": \"fake\",\n  \"version\": \"1.0\",\n  \"include_paths\": [\"include\"],\n  \"lib_paths\": [],\n  \"libs\": []\n}\n")
    p7_write(root, ".with/deps/c/fake/1.0/include/fake.h", "typedef struct engine engine;\nengine *engine_new(void);\nextern void (*engine_release)(engine *e);\nvoid engine_reset_release(void);\nint engine_count(void);\n")
    p7_write(root, ".with/deps/c/fake/1.0/contract.with", "use c_import(\"fake.h\")\n\nc contract fake:\n    resource Engine wraps *mut engine\n        from engine_new    // proof: malloc, a fresh allocation never retained\n")
    p7_write(root, ".with/deps/c/fake/1.0/contract-proofs.txt", "engine_reset_release\tassigns\tengine_release\tthe body of engine_reset_release assigns engine_release\n")
    p7_write(root, "src/main.with", "use contracts.fake\n\nfn main: print(\"x\")\n")

    p7_write(root, "src/contracts/fake.with", stated("drop engine_release", "    fn engine_reset_release\n"))
    let refused = p7_run(root, "contradiction", p7_argv_append(p7_argv_append("", "check"), "src/main.with"))
    let said = refused.stdout ++ refused.stderr
    assert(said.contains("the clause names the global 'engine_release', which 'engine_reset_release' assigns, and this contract describes 'engine_reset_release': a function that assigns the global stays raw (§31.8.6)"))
    assert(said.contains("= proof: the body of engine_reset_release assigns engine_release"))
    assert(said.contains("the clause can be marked `override`"))

    // The assigner left raw: the proof contradicts nothing.
    p7_write(root, "src/contracts/fake.with", stated("drop engine_release", "    fn engine_count\n"))
    let clean = p7_run(root, "undescribed", p7_argv_append(p7_argv_append("", "check"), "src/main.with"))
    p7_assert_success(clean, "a contract that leaves the assigner raw")

    p7_write(root, "src/contracts/fake.with", stated("override drop engine_release", "    fn engine_reset_release\n"))
    let view = p7_run(root, "override-view", p7_argv_append(p7_argv_append(p7_argv_append("", "analyze"), "src/main.with"), "contract"))
    p7_assert_success(view, "the contract view with the override")
    let shown = view.stdout ++ view.stderr
    assert(shown.contains("against proof: the body of engine_reset_release assigns engine_release]"))
    assert(shown.contains("overrides=1 stale-overrides=0"))
    print("ok")
