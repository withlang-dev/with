//! expect-stdout: ok

// D179: an unannotated `let` bound to an `if` whose arms read a field
// through `self` copies out of a join: each arm is lowered at the view
// type and the join's recorded adjustment reads the value. `analyze
// audit:resolution` compared the arm's view with the field's own type and
// reported "an expression lowered to an operand of another type (MIR &i32,
// Sema i32)": 30 false violations on the compiler's own source.
use pre_d_build_runner

fn arms_text -> str:
    "type Syms { some: i32, none: i32 }\n" ++
        "type Holder { syms: Syms }\n\n" ++
        "impl Holder:\n" ++
        "    fn pick(success: bool) -> i32:\n" ++
        "        let variant = if success: self.syms.some else: self.syms.none\n" ++
        "        variant\n\n" ++
        "fn main:\n" ++
        "    let h = Holder { syms: Syms { some: 1, none: 2 } }\n" ++
        "    print(h.pick(true) + h.pick(false))\n"

fn main:
    let case_dir = p7_prepare_case("audit_copy_out_join_arm", "audit_copy_out_join_arm")
    p7_write(case_dir, "src/arms.with", arms_text())
    let ran = p7_run(case_dir, "arms_run", "run\0src/arms.with\0")
    p7_assert_success(ran, "the arms program runs")
    assert(ran.stdout.contains("3"))
    let audited = p7_run(case_dir, "arms_audit", "analyze\0src/arms.with\0audit:resolution\0")
    p7_assert_success(audited, "audit:resolution over a copy-out join")
    assert(audited.stdout.contains("violations=0"))
    print("ok")
