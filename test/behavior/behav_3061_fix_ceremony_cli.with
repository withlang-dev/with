//! expect-stdout: ok

// `with fix-ceremony --help` prints the usage and exits 0; an option the
// command does not have is refused by name. Both were read as the entry
// file: "cannot open '--help'" (#3061).
use std.fs
use std.process

fn main:
    let compiler = env("WITH_TEST_COMPILER")
    assert(compiler.len() > 0)
    let dir = f"out/tmp/fix-ceremony-help-{pid()}"
    assert(mkdir_p(dir) == 0)
    let help = run_to_files(&[compiler, "fix-ceremony", "--help"], dir ++ "/help.out", dir ++ "/help.err", 600000)
    assert(help.code == 0)
    let text = read_file(dir ++ "/help.out").unwrap()
    assert(text.contains("usage: with fix-ceremony") and text.contains("--apply") and text.contains("--std"))
    let bad = run_to_files(&[compiler, "fix-ceremony", "--nope"], dir ++ "/bad.out", dir ++ "/bad.err", 600000)
    assert(bad.code == 2)
    assert(read_file(dir ++ "/bad.err").unwrap().contains("no option `--nope`"))
    // Item 8: a run of numbered constants is reported, never rewritten.
    let program = dir ++ "/kinds.with"
    assert(write_file(program, "let KIND_A: i32 = 1\nlet KIND_B: i32 = 2\nlet KIND_C: i32 = 3\nlet OTHER: i32 = 9\n\nfn main:\n    print(KIND_A + KIND_B + KIND_C + OTHER)\n") == 0)
    let report = run_to_files(&[compiler, "fix-ceremony", "--report", program], dir ++ "/report.out", dir ++ "/report.err", 600000)
    assert(report.code == 0)
    let listed = read_file(dir ++ "/report.out").unwrap()
    if not listed.contains("3 numbered constants `KIND_A` .. `KIND_C`"): print(listed)
    assert(listed.contains("3 numbered constants `KIND_A` .. `KIND_C`"))
    assert(read_file(program).unwrap().contains("let KIND_B: i32 = 2"))
    // Item 5: `List.new()` / `HashMap.new()` where a field, an assignment
    // or an argument demands its type becomes the empty literal, and the
    // program still runs.
    let bag = dir ++ "/bag.with"
    assert(write_file(bag, "use std.collections.HashMap\n\ntype Bag {\n    items: List[i32],\n    index: HashMap[str, i32],\n}\n\nfn total(xs: List[i32]) -> i32:\n    var s = 0\n    for x in xs: s = s + x\n    s\n\nfn main:\n    var b = Bag { items: List.new(), index: HashMap.new() }\n    b.items = List.new()\n    b.items.push(3)\n    b.index.insert(\"a\", 1)\n    print(total(List.new()) + total(b.items))\n") == 0)
    let applied = run_to_files(&[compiler, "fix-ceremony", "--apply", bag], dir ++ "/apply.out", dir ++ "/apply.err", 600000)
    assert(applied.code == 0)
    let after = read_file(bag).unwrap()
    if after.contains(".new()"): print(after)
    assert(after.contains("Bag { items: [], index: [:] }") and after.contains("b.items = []") and after.contains("total([])") and not after.contains(".new()"))
    let ran = run_to_files(&[compiler, "run", bag], dir ++ "/run.out", dir ++ "/run.err", 600000)
    assert(ran.code == 0 and read_file(dir ++ "/run.out").unwrap() == "3\n")
    // Item 1: a private function's return type that its body already has
    // goes, and only where the function then infers the same type. A
    // literal tail, a widening, an `Option` demand, an early `return`, a
    // function that calls itself and a `pub` signature keep theirs.
    let rets = dir ++ "/rets.with"
    assert(write_file(rets, "pub type P \{ n: i64, name: str, items: List[i64] }\n\nfn area(w: i64, h: i64) -> i64: w * h\n\nfn label(p: &P) -> str: p.name\n\nfn lit() -> i64: 1\n\nfn widened(x: i32) -> i64: x\n\nfn maybe(flag: bool) -> Option[i64]:\n    if flag: 1 else: None\n\nfn both(flag: bool, a: i64) -> i64:\n    if flag: return a\n    a + a\n\nfn fact(n: i64) -> i64:\n    if n <= 1: 1 else: n * fact(n - 1)\n\npub fn shown(w: i64) -> i64: w + w\n\nfn items_of(p: &P) -> List[i64]: p.items\n\nfn count(p: &P) -> isize: p.items.len()\n\nimpl P:\n    fn twice() -> i64: self.n + self.n\n    pub fn open() -> i64: self.n\n\nfn main:\n    let p = P \{ n: 3, name: \"p\", items: [1, 2] }\n    print(f\"\{area(2, 3)} \{label(p)} \{lit()} \{widened(4)} \{maybe(true) ?? 0} \{both(true, 5)} \{fact(4)} \{shown(2)} \{items_of(p).len()} \{count(p)} \{p.twice()} \{p.open()}\")\n") == 0)
    let rets_run = run_to_files(&[compiler, "fix-ceremony", "--apply", rets], dir ++ "/rets.out", dir ++ "/rets.err", 600000)
    assert(rets_run.code == 0)
    let rets_after = read_file(rets).unwrap()
    if not rets_after.contains("fn area(w: i64, h: i64): w * h"): print(rets_after)
    assert(rets_after.contains("fn area(w: i64, h: i64): w * h") and rets_after.contains("fn label(p: &P): p.name") and rets_after.contains("fn items_of(p: &P): p.items"))
    for kept in ["fn lit() -> i64: 1", "fn widened(x: i32) -> i64: x", "fn maybe(flag: bool) -> Option[i64]:", "fn both(flag: bool, a: i64) -> i64:", "fn fact(n: i64) -> i64:", "pub fn shown(w: i64) -> i64: w + w"]: assert(rets_after.contains(kept))
    let rets_ran = run_to_files(&[compiler, "run", rets], dir ++ "/rets-run.out", dir ++ "/rets-run.err", 600000)
    assert(rets_ran.code == 0 and read_file(dir ++ "/rets-run.out").unwrap() == "6 p 1 4 1 5 24 4 2 2 6 3\n")
    // Two functions that call each other cannot both lose their return
    // type (D143): the program stops checking, so every one removed in the
    // run is put back and the file is as it was.
    let cycle = dir ++ "/cycle.with"
    let cycle_text = "fn ping(n: i64) -> i64: pong(n)\n\nfn pong(n: i64) -> i64: ping(n)\n\nfn area(w: i64, h: i64) -> i64: w * h\n\nfn main:\n    var keep = 0\n    keep = keep + area(2, 3)\n    if keep < 0: print(ping(1))\n    print(keep)\n"
    assert(write_file(cycle, cycle_text) == 0)
    let cycle_run = run_to_files(&[compiler, "fix-ceremony", "--apply", cycle], dir ++ "/cycle.out", dir ++ "/cycle.err", 600000)
    assert(cycle_run.code == 0)
    assert(read_file(cycle).unwrap() == cycle_text)
    assert(read_file(dir ++ "/cycle.out").unwrap().contains("3 return type(s) kept as written"))
    assert(remove_tree(dir) == 0)
    print("ok")
