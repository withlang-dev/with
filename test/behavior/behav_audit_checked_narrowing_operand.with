//! expect-stdout: ok

// D183 (§4.2.6): a shift count narrows to `u32` with a range check Sema
// records on the count's expression. `analyze audit:resolution` compared
// the narrowed operand with the expression's own type and reported "an
// expression lowered to an operand of another type (MIR u32, Sema i32)"
// for every such shift: 36 false violations on the compiler's own source.
use pre_d_build_runner

fn shifts_text -> str:
    "fn low_mask(bits: i32) -> i64: ((1 as i64) << bits) - 1\n\n" ++
        "fn top(value: i64, shift: i32) -> i64: value >> shift\n\n" ++
        "fn main:\n" ++
        "    print(low_mask(5) + top(1024, 4))\n"

fn main:
    let case_dir = p7_prepare_case("audit_checked_narrowing_operand", "audit_checked_narrowing_operand")
    p7_write(case_dir, "src/shifts.with", shifts_text())
    let ran = p7_run(case_dir, "shifts_run", "run\0src/shifts.with\0")
    p7_assert_success(ran, "the shifts program runs")
    assert(ran.stdout.contains("95"))
    let audited = p7_run(case_dir, "shifts_audit", "analyze\0src/shifts.with\0audit:resolution\0")
    p7_assert_success(audited, "audit:resolution over a checked narrowing")
    assert(audited.stdout.contains("violations=0"))
    print("ok")
