module <embedded-std>/std/wi_demo.w
pub type Bits = union { whole: u32, half: u16 }
impl Copy for Bits
@[repr(C)]
pub type Callback { call: extern "C" fn(i32) -> i32, tag: u8 }
impl Copy for Callback
pub enum Color:
    Red
    Green
    Mixed(i32, i32)
pub type Handle = distinct i32
pub enum Level: u8:
    Low = 1
    High = 200
impl Copy for Level
@[packed]
pub type Packet { pub tag: u8, pub word: i32 }
pub type Pair { pub a: i32, pub b: i32 }
pub type VarArgs = c_va_list
pub type Word = i32
pub const GREETING: str = "hi\n"
pub const K: i32 = 7
pub var COUNTER: i32
var LEVEL: i32
pub let TABLE: [u8; 4]
pub fn add(p: &Pair) -> i32
pub fn bump() -> Unit writes COUNTER
pub fn call_once(f: once fn() -> i32) -> i32
pub fn call_twice(f: fn() -> i32) -> i32
pub fn greeting() -> &str from static
pub fn level() -> &i32 from LEVEL
pub fn level_value(l: Level) -> u8
pub fn packet_word(p: &Packet) -> i32
pub fn raise() -> Unit writes LEVEL
pub fn reserve() -> i32 writes COUNTER
pub unsafe fn set_first(p: *mut Pair, v: i32) -> Unit
pub fn sum_slice(xs: []i32) -> i32
pub fn table_at(i: i64) -> u8
pub fn take(p: Pair) -> i32
pub fn va_size(args: &c_va_list) -> i64
impl Pair:
    pub move fn into_word() -> i32
    pub mut fn scale(k: i32) -> Unit
    pub fn sum() -> i32
