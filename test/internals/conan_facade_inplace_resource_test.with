//! expect-stdout: ok
// #3173 (§16.2b.3, D198): a record the caller allocates and an init/end
// pair fill and release (`z_stream` between `deflateInit` and `deflateEnd`)
// is an in-place resource. The draft proposes `init` and `drop` only from a
// proof over the source, never from a name:
//   - the init function gives a field of the record it is handed a fresh
//     allocation nothing else keeps, and the end function frees that field;
//   - an init that returns a status is drafted only with the status it
//     returns on success proven and named (`ok PACK_OK`). Without `ok` the
//     resource would be live after a failed init, and the end function
//     would run on storage the init never filled.
// `codec_open` returns the literal 0, which `ok` cannot name: it stays raw
// and the report says what was proven. `other_start` allocates nothing and
// is no init whatever it is called.
use compiler.ConanClient
use std.fs
use std.os
use std.process

fn main:
    let root = "out/tmp/conan_facade_inplace_resource_test"
    let dep = root ++ "/dep"
    let src = root ++ "/src"
    let build = root ++ "/build"
    assert(mkdir_p(dep ++ "/include") == 0)
    assert(mkdir_p(src) == 0)
    assert(mkdir_p(build) == 0)
    let header = "typedef struct codec { void *state; int total; } codec;\nint codec_open(codec *c, int level);\nint codec_close(codec *c);\n#define PACK_OK 0\n#define PACK_NOMEM 2\ntypedef struct pack { void *state; int total; } pack;\nint pack_open(pack *p, int level);\nint pack_step(pack *p, int flush);\nvoid pack_close(pack *p);\ntypedef struct tape { void *cells; int at; } tape;\nvoid tape_start(tape *t);\nint tape_at(const tape *t);\nvoid tape_stop(tape *t);\ntypedef struct other { void *state; int n; } other;\nvoid other_start(other *o);\ntypedef struct spool { void *state; int n; } spool;\nint spool_open(spool *s);\nvoid spool_close(spool *s);\n"
    assert(write_file(dep ++ "/include/codec.h", header) == 0)
    assert(write_file(src ++ "/codec.h", header) == 0)
    assert(write_file(src ++ "/codec.c", "#include <stdlib.h>\n#include \"codec.h\"\nstruct inner { int level; int count; };\nint codec_open(codec *c, int level) { struct inner *s = malloc(sizeof(struct inner)); if (!s) return -1; s->level = level; s->count = 0; c->state = s; c->total = 0; return 0; }\nint codec_close(codec *c) { free(c->state); c->state = 0; return 0; }\nint pack_open(pack *p, int level) { struct inner *s = malloc(sizeof(struct inner)); if (!s) return PACK_NOMEM; s->level = level; s->count = 0; p->state = s; p->total = 0; return PACK_OK; }\nint pack_step(pack *p, int flush) { struct inner *s = p->state; s->count = s->count + flush; p->total = p->total + 1; return s->count; }\nvoid pack_close(pack *p) { free(p->state); p->state = 0; }\nvoid tape_start(tape *t) { int *cells = calloc(16, sizeof(int)); t->cells = cells; t->at = 0; }\nint tape_at(const tape *t) { return t->at; }\nvoid tape_stop(tape *t) { free(t->cells); t->cells = 0; }\nvoid other_start(other *o) { o->state = 0; o->n = 1; }\nstatic void spool_release(void *p) { int *q = p; *q = 0; free(p); }\nint spool_open(spool *s) { s->state = malloc(8); s->n = 0; return 0; }\nvoid spool_close(spool *s) { spool_release(s->state); s->state = 0; }\n") == 0)
    assert(write_file(build ++ "/compile_commands.json", "[\n{\n  \"directory\": \"" ++ src ++ "\",\n  \"command\": \"cc -I " ++ src ++ " -c codec.c\",\n  \"file\": \"codec.c\"\n}\n]\n") == 0)
    assert(write_file(dep ++ "/metadata.json", "{\"include_paths\": [\"include\"], \"libs\": [\"codec\"]}\n") == 0)
    assert(set_env("WITH_REGISTRY", "file:///nonexistent-registry") == 0)
    conan_write_facade("codec", "1.0", dep, src, build)
    let contract = read_file(dep ++ "/contract.with") ?? ""
    let report = read_file(dep ++ "/contract-report.txt") ?? ""
    let named = contract.contains("    resource Pack wraps pack\n        init pack_open(self)") and contract.contains("        drop pack_close") and contract.contains("        init pack_open(self)") and contract.contains("\n        ok PACK_OK    // proof: ") and contract.contains("    fn pack_step\n        lend")
    let void_init = contract.contains("    resource Tape wraps tape\n        init tape_start(self)") and contract.contains("        drop tape_stop") and not contract.contains("fn tape_start") and report.contains("tape_at: raw: its name ends in 'at', a field of the record")
    // A success status with no name is drafted as the literal (D226 C).
    let literal = contract.contains("    resource Codec wraps codec\n        init codec_open(self)") and contract.contains("\n        ok 0    // proof: ")
    // D226 (A): an init that can report success with its allocation failed is
    // no proof unless the destroyer accepts NULL. `free` does; a function of
    // the library that reads through the pointer does not.
    let guarded = not contract.contains("resource Spool") and report.contains("spool_open: raw: an in-place initializer of spool") and report.contains("but it can report success after its allocation failed, and spool_close hands the field to spool_release, which is not known to accept NULL")
    let by_name = not contract.contains("resource Other")
    if not (named and void_init and literal and by_name and guarded):
        print(contract)
        print(report)
    assert(named)
    assert(void_init)
    assert(literal)
    assert(by_name)
    assert(guarded)
    print("ok")
