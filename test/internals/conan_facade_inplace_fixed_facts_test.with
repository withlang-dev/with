//! expect-stdout: ok
// §16.2b.11, §31.8.1 (#3173): a facts file fixes the parameters of an
// in-place resource's initializer that the presented call always passes.
// zlib's real initializer is `inflateInit_(strm, ZLIB_VERSION,
// (int)sizeof(z_stream))`: the header's version text and the stream's size.
// The two clauses are one `fn` item in the draft, each with `registry:`
// provenance.
use compiler.ConanClient
use std.fs
use std.process
use std.os

fn main:
    let root = "out/tmp/conan_facade_inplace_fixed_facts_test"
    let dep = root ++ "/dep"
    let src = root ++ "/src"
    let build = root ++ "/build"
    let registry = root ++ "/registry"
    assert(mkdir_p(dep ++ "/include") == 0)
    assert(mkdir_p(src) == 0)
    assert(mkdir_p(build) == 0)
    assert(mkdir_p(registry ++ "/registry/c/zs") == 0)
    let header = "#define ZS_OK 0\n#define ZS_VERSION \"1.0\"\ntypedef struct strm { void *state; int total; } strm;\nint strm_init_(strm *s, const char *version, int size);\nint strm_end(strm *s);\n"
    assert(write_file(dep ++ "/include/zs.h", header) == 0)
    assert(write_file(src ++ "/zs.h", header) == 0)
    assert(write_file(src ++ "/zs.c", "#include <stdlib.h>\n#include \"zs.h\"\nint strm_init_(strm *s, const char *version, int size) { if (version == 0 || version[0] != '1' || size != (int)sizeof(strm)) return -6; s->state = malloc(8); if (!s->state) return -4; s->total = 0; return ZS_OK; }\nint strm_end(strm *s) { free(s->state); s->state = 0; return ZS_OK; }\n") == 0)
    let commands = "[\n{\n  \"directory\": \"" ++ src ++ "\",\n  \"command\": \"cc -I " ++ src ++ " -c zs.c\",\n  \"file\": \"zs.c\"\n}\n]\n"
    assert(write_file(build ++ "/compile_commands.json", commands) == 0)
    assert(write_file(dep ++ "/metadata.json", "{\"include_paths\": [\"include\"], \"libs\": [\"zs\"]}\n") == 0)
    assert(write_file(registry ++ "/registry/c/zs/facts.with", "c facts zs:\n    resource Stream wraps strm\n        init strm_init_(self), ok ZS_OK    // zs.h: returns ZS_OK once the state is allocated\n        drop strm_end    // zs.h: frees the state\n    fn strm_init_\n        param version fixed ZS_VERSION    // zs.h: the version the caller was compiled against\n        param size fixed sizeof(strm)    // zs.h: the size of the caller's strm\n") == 0)
    assert(set_env("WITH_REGISTRY", "file://" ++ current_dir() ++ "/" ++ registry) == 0)
    conan_write_facade("zs", "1.0", dep, src, build)
    let facade = read_file(dep ++ "/contract.with") ?? ""
    let report = read_file(dep ++ "/contract-report.txt") ?? ""
    // The report agrees with the contract: neither function is raw.
    assert(report.contains("strm_init_: stated by the registry's resource") and report.contains("strm_end: stated by the registry's resource") and not report.contains(": raw: "))
    let ok = facade.contains("    resource Stream wraps strm\n        init strm_init_(self), ok ZS_OK    // registry: ") and facade.contains("    fn strm_init_\n        param version fixed ZS_VERSION    // registry: zs.h: the version the caller was compiled against\n        param size fixed sizeof(strm)    // registry: zs.h: the size of the caller's strm\n")
    if not ok:
        print(facade)
        print(read_file(dep ++ "/contract-report.txt") ?? "")
    assert(ok)
    print("ok")
