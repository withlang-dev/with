//! expect-stdout: ok
// §31.8.1 (Eric, 2026-11-21, #3173 D): a facts file states an in-place
// resource as a contract does: `init F(self)`, the initializer's own success
// status on its line (`init F(self), ok K`), a resource-level `ok K` for
// the initializers that state none, and `drop G`, each line cited. Two
// init/end pairs over one record (zlib's inflate and deflate over a
// `z_stream`) are two resources, and no draft can choose between them: the
// registry states them. The draft carries the stanzas as written, with
// `registry:` provenance.
use compiler.ConanClient
use std.fs
use std.process
use std.os

fn main:
    let root = "out/tmp/conan_facade_inplace_resource_facts_test"
    let dep = root ++ "/dep"
    let src = root ++ "/src"
    let build = root ++ "/build"
    let registry = root ++ "/registry"
    assert(mkdir_p(dep ++ "/include") == 0)
    assert(mkdir_p(src) == 0)
    assert(mkdir_p(build) == 0)
    assert(mkdir_p(registry ++ "/registry/c/pair") == 0)
    let header = "#define PAIR_OK 0\ntypedef struct strm { void *state; int total; } strm;\nint enc_open(strm *s, int level);\nint enc_step(strm *s, int flush);\nint enc_close(strm *s);\nint dec_open(strm *s);\nint dec_close(strm *s);\n"
    assert(write_file(dep ++ "/include/pair.h", header) == 0)
    assert(write_file(src ++ "/pair.h", header) == 0)
    assert(write_file(src ++ "/pair.c", "#include <stdlib.h>\n#include \"pair.h\"\nint enc_open(strm *s, int level) { int *st = malloc(sizeof(int)); if (!st) return 4; *st = level; s->state = st; s->total = 0; return PAIR_OK; }\nint enc_step(strm *s, int flush) { s->total = s->total + flush; return s->total; }\nint enc_close(strm *s) { free(s->state); s->state = 0; return PAIR_OK; }\nint dec_open(strm *s) { int *st = malloc(sizeof(int)); if (!st) return 4; *st = 0; s->state = st; s->total = 0; return 0; }\nint dec_close(strm *s) { free(s->state); s->state = 0; return 0; }\n") == 0)
    let commands = "[\n{\n  \"directory\": \"" ++ src ++ "\",\n  \"command\": \"cc -I " ++ src ++ " -c pair.c\",\n  \"file\": \"pair.c\"\n}\n]\n"
    assert(write_file(build ++ "/compile_commands.json", commands) == 0)
    assert(write_file(dep ++ "/metadata.json", "{\"include_paths\": [\"include\"], \"libs\": [\"pair\"]}\n") == 0)
    assert(write_file(registry ++ "/registry/c/pair/facts.with", "c facts pair:\n    resource Encoder wraps strm\n        init enc_open(self), ok PAIR_OK    // pair.h: returns PAIR_OK once the state is allocated\n        drop enc_close    // pair.h: frees the state\n    resource Decoder wraps strm\n        init dec_open(self)    // pair.h: allocates the state\n        ok 0    // pair.h: returns 0 on success\n        drop dec_close    // pair.h: frees the state\n    fn enc_step\n        of Encoder    // pair.c: updates the total, stores nothing\n") == 0)
    assert(set_env("WITH_REGISTRY", "file://" ++ current_dir() ++ "/" ++ registry) == 0)
    conan_write_facade("pair", "1.0", dep, src, build)
    let facade = read_file(dep ++ "/contract.with") ?? ""
    let ok = facade.contains("    resource Encoder wraps strm\n        init enc_open(self), ok PAIR_OK    // registry: pair.h: returns PAIR_OK once the state is allocated\n        drop enc_close    // registry: pair.h: frees the state\n") and facade.contains("    resource Decoder wraps strm\n        init dec_open(self)    // registry: pair.h: allocates the state\n        ok 0    // registry: pair.h: returns 0 on success\n        drop dec_close    // registry: pair.h: frees the state\n") and facade.contains("    fn enc_step\n        of Encoder    // registry: ")
    if not ok:
        print(facade)
        print(read_file(dep ++ "/contract-report.txt") ?? "")
    assert(ok)
    print("ok")
