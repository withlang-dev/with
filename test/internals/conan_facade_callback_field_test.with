//! expect-stdout: ok
// D213 (#3124): `field F of R is callback` says the only values a
// function-pointer field holds are callbacks the program registered through
// a presented setter. A call through it lends its arguments for the call
// and keeps none, so an operation that reaches such a call (libcurl's
// `curl_easy_perform` calling the debug callback) is no longer raw as
// "retains param 0". The package itself must not fill the field: a unit
// that stores a named package function into it contradicts the role.
use compiler.ConanClient
use std.fs
use std.os
use std.process

fn draft(root: &str, facts: &str, extra_source: &str) -> str:
    let dep = root ++ "/dep"
    let src = root ++ "/src"
    let build = root ++ "/build"
    let registry = root ++ "/registry"
    assert(mkdir_p(dep ++ "/include") == 0)
    assert(mkdir_p(src) == 0)
    assert(mkdir_p(build) == 0)
    assert(mkdir_p(registry ++ "/registry/c/traced") == 0)
    let header = "typedef struct handle handle;\ntypedef void (*trace_fn)(handle *h, const char *text);\nhandle *handle_new(void);\nvoid handle_free(handle *h);\nvoid handle_set_trace(handle *h, trace_fn f);\nint handle_run(handle *h);\nvoid handle_reset(handle *h);\nhandle *handle_dup(const handle *h);\n"
    assert(write_file(dep ++ "/include/traced.h", header) == 0)
    assert(write_file(src ++ "/traced.h", header) == 0)
    assert(write_file(src ++ "/traced.c", "#include <stdlib.h>\n#include \"traced.h\"\nstruct handle { trace_fn trace; int n; };\nhandle *handle_new(void) { handle *h = malloc(sizeof(handle)); if (!h) return 0; h->trace = 0; h->n = 0; return h; }\nvoid handle_free(handle *h) { free(h); }\nvoid handle_set_trace(handle *h, trace_fn f) { h->trace = f; }\nint handle_run(handle *h) { if (h->trace) h->trace(h, \"run\"); h->n = h->n + 1; return h->n; }\nvoid handle_reset(handle *h) { h->trace = 0; h->n = 0; }\nhandle *handle_dup(const handle *h) { handle *d = malloc(sizeof(handle)); if (!d) return 0; *d = *h; return d; }\n" ++ extra_source) == 0)
    let commands = "[\n{\n  \"directory\": \"" ++ src ++ "\",\n  \"command\": \"cc -I " ++ src ++ " -c traced.c\",\n  \"file\": \"traced.c\"\n}\n]\n"
    assert(write_file(build ++ "/compile_commands.json", commands) == 0)
    assert(write_file(dep ++ "/metadata.json", "{\"include_paths\": [\"include\"], \"libs\": [\"traced\"]}\n") == 0)
    assert(write_file(registry ++ "/registry/c/traced/facts.with", "c facts traced:\n" ++ facts) == 0)
    assert(set_env("WITH_REGISTRY", if facts.len() > 0: "file://" ++ current_dir() ++ "/" ++ registry else: "file:///nonexistent-registry") == 0)
    conan_write_facade("traced", "1.0", dep, src, build)
    (read_file(dep ++ "/contract.with") ?? "") ++ "\n====\n" ++ (read_file(dep ++ "/contract-report.txt") ?? "")

fn main:
    let role_alone = "    field trace of handle is callback    // traced.h: the trace function is the program's, set with handle_set_trace\n"
    let role = role_alone ++ "    fn handle_set_trace\n        callback param 1    // traced.h: called with the handle and a message\n        retains param 1 by param 0    // traced.c: stored in the handle\n        callback_thread registering    // traced.h: called from handle_run, on the caller's thread\n"
    let bare = draft("out/tmp/conan_facade_callback_field_test/bare", "", "")
    let stated = draft("out/tmp/conan_facade_callback_field_test/stated", role, "")
    // Without the role the handle is retained by a call nothing decides.
    let bare_ok = bare.contains("handle_run: raw: retains param 0 (passed through the function pointer field trace")
    // With it the operation lends its handle. The null store in
    // `handle_reset` and the whole-record copy in `handle_dup` are no
    // contradiction.
    let stated_ok = stated.contains("    fn handle_run\n        lend") and stated.contains("//   field trace of handle is callback") and conan_facts_contradicted().len() == 0
    // A package that stores its own function into the field contradicts
    // the role: no contract is written, and the refusal names the store.
    let filled = draft("out/tmp/conan_facade_callback_field_test/filled", role, "static void quiet(handle *h, const char *text) { (void)h; (void)text; }\nvoid handle_quiet(handle *h) { h->trace = quiet; }\n")
    let refusal = conan_facts_contradicted()
    let filled_ok = not filled.contains("c contract traced:") and refusal.contains("field trace of handle is callback") and refusal.contains("DISAGREES: the package stores its own function `quiet` into it")
    if not (bare_ok and stated_ok and filled_ok):
        print(bare)
        print(stated)
        print(filled)
        print(refusal)
    // The drafter finds the setter from source: with the role stated and
    // the setter not described, the role is refused naming it.
    let before = conan_facts_contradicted().len()
    let undescribed = draft("out/tmp/conan_facade_callback_field_test/undescribed", role_alone, "")
    let setter_refusal = conan_facts_contradicted().slice(before, conan_facts_contradicted().len())
    let setter_ok = not undescribed.contains("c contract traced:") and setter_refusal.contains("`handle_set_trace` stores into it and the facts describe it with no `callback param N`")
    // Described, the setter is presented with the clauses the facts state.
    let setter_presented = stated.contains("    fn handle_set_trace\n") and stated.contains("        callback param 1    // registry: ") and stated.contains("        retains param 1 by param 0    // registry: ") and stated.contains("        callback_thread registering    // registry: ")
    if not (setter_ok and setter_presented):
        print(stated)
        print(setter_refusal)
    // The stores that fit the role are null, a whole-record copy, and the
    // parameter the storing function's own callback clause names. A value
    // the package loaded from somewhere else is none of them: nothing says
    // the program registered it, so the field is undecided, the role is not
    // applied, and the operation that calls through it stays raw.
    let loaded = draft("out/tmp/conan_facade_callback_field_test/loaded", role, "static trace_fn saved;\nvoid handle_restore(handle *h) { h->trace = saved; }\n")
    let loaded_ok = loaded.contains("c contract traced:") and loaded.contains("field trace of handle: undecided: `handle_restore` stores a value that is not one of its parameters into it") and loaded.contains("handle_run: raw: retains param 0")
    // So is a parameter the clause does not name.
    let two = "    fn handle_set_both\n        callback param 1    // traced.c: the first function is the trace\n        retains param 1 by param 0    // traced.c: stored in the handle\n        callback_thread registering    // traced.c: called from handle_run\n"
    let misnamed = draft("out/tmp/conan_facade_callback_field_test/misnamed", role ++ two, "void handle_set_both(handle *h, trace_fn a, trace_fn b) { (void)a; h->trace = b; }\n")
    let misnamed_ok = misnamed.contains("field trace of handle: undecided: `handle_set_both` stores param 2, which its callback clause does not name, into it") and misnamed.contains("handle_run: raw: retains param 0")
    if not (loaded_ok and misnamed_ok):
        print(loaded)
        print(misnamed)
    // A store of the same field of another record fits the role: whatever
    // that field holds, this one now holds (libcurl copies its debug
    // callback from one handle's settings to another's).
    let shared = draft("out/tmp/conan_facade_callback_field_test/shared", role, "void handle_share(handle *to, const handle *from) { to->trace = from->trace; }\n")
    let shared_ok = shared.contains("    fn handle_run\n        lend") and not shared.contains("undecided")
    if not shared_ok: print(shared)
    assert(shared_ok)
    // libcurl's shape: the public setter is variadic and hands its
    // arguments to an internal function, which stores the next one. Here
    // the store sits under an `if`, not a `case` of a switch on the
    // selector, so which option it belongs to is not proven.
    let variadic = draft("out/tmp/conan_facade_callback_field_test/variadic", role, "#include <stdarg.h>\nstatic void vset(handle *h, int opt, va_list ap) { if (opt == 1) h->trace = va_arg(ap, trace_fn); }\nvoid handle_setopt(handle *h, int opt, ...) { va_list ap; va_start(ap, opt); vset(h, opt, ap); va_end(ap); }\n")
    let variadic_ok = variadic.contains("field trace of handle: undecided: `vset` stores the next variadic argument into it: in `vset` the store is not under a `case K` of a switch on a parameter") and variadic.contains("handle_run: raw: retains param 0")
    if not variadic_ok: print(variadic)
    assert(variadic_ok)
    assert(loaded_ok)
    assert(misnamed_ok)
    assert(setter_ok)
    assert(setter_presented)
    assert(bare_ok)
    assert(stated_ok)
    assert(filled_ok)
    print("ok")
