//! expect-stdout: ok

use compiler.BundleInterfaces

// D30 R3: the runtime is a bundle whose corpus is the embedded runtime tree,
// `rt` naming `<embedded-rt>/rt`, as a migrated corpus's `std/engines/pcre2` names
// `<embedded-std>/std/engines/pcre2`; a runtime module's dotted name is `rt.<module>`.
fn main:
    assert(bundle_corpus_contains("rt", "<embedded-rt>/rt/rt_core.with"))
    assert(bundle_corpus_contains("rt", "<embedded-rt>/rt/fiber_core_darwin.with"))
    assert(not bundle_corpus_contains("rt", "<embedded-std>/std/rt.with"))
    assert(not bundle_corpus_contains("rt", "rt/rt_core.with"))
    assert(bundle_corpus_contains("std/engines/pcre2", "<embedded-std>/std/engines/pcre2/defs.with"))
    assert(not bundle_corpus_contains("std/engines/pcre2", "<embedded-rt>/rt/rt_core.with"))
    assert(bundle_module_dotted_name("<embedded-rt>/rt/rt_core.with") == "rt.rt_core")
    assert(bundle_module_dotted_name("<embedded-std>/std/engines/pcre2/defs.with") == "std.engines.pcre2.defs")
    assert(bundle_module_dotted_name("src/main.with") == "")
    print("ok")
