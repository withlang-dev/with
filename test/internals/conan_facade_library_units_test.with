//! expect-stdout: ok
// A package's build compiles more than its library: tools, tests. The
// drafter reads the units that feed the libraries the package installs, by
// the build's own graph (the `build <artifact>:` statement of each library
// in build.ninja). libcurl 8.23.0's build names six units of the `curl`
// tool and its test programs that the build generates; in a configured
// tree they are not there, and counted as units of the package they voided
// proofs about library functions ("a unit of the package could not be
// read"). Without a graph that answers, every unit is read as before and
// the report says so.
use compiler.ConanClient
use std.fs
use std.os
use std.process

fn draft(rel: &str, graph: &str) -> str:
    // The root is written into compile_commands.json, where a Windows
    // path's backslashes read as escapes (`D:\a\with` became `D:awith`,
    // and every unit was "cannot read").
    let root = current_dir().replace("\\", "/") ++ "/" ++ rel
    let dep = root ++ "/dep"
    let src = root ++ "/src"
    let build = root ++ "/build"
    assert(mkdir_p(dep ++ "/include") == 0)
    assert(mkdir_p(src) == 0)
    assert(mkdir_p(build) == 0)
    let header = "typedef struct box box;\nbox *box_new(void);\nvoid box_free(box *b);\nint box_size(const box *b);\n"
    assert(write_file(dep ++ "/include/boxes.h", header) == 0)
    assert(write_file(src ++ "/boxes.h", header) == 0)
    assert(write_file(src ++ "/boxes.c", "#include <stdlib.h>\n#include \"boxes.h\"\nstruct box { int n; };\nbox *box_new(void) { box *b = malloc(sizeof(box)); if (!b) return 0; b->n = 0; return b; }\nvoid box_free(box *b) { free(b); }\nint box_size(const box *b) { return b->n; }\n") == 0)
    // The tool's unit is generated by the build, which has not run.
    let commands = "[\n{\n  \"directory\": \"" ++ build ++ "\",\n  \"command\": \"cc -I " ++ src ++ " -o CMakeFiles/boxes.dir/boxes.c.o -c " ++ src ++ "/boxes.c\",\n  \"file\": \"" ++ src ++ "/boxes.c\",\n  \"output\": \"" ++ build ++ "/CMakeFiles/boxes.dir/boxes.c.o\"\n},\n{\n  \"directory\": \"" ++ build ++ "\",\n  \"command\": \"cc -I " ++ src ++ " -o CMakeFiles/boxtool.dir/help.c.o -c " ++ build ++ "/help.c\",\n  \"file\": \"" ++ build ++ "/help.c\",\n  \"output\": \"CMakeFiles/boxtool.dir/help.c.o\"\n}\n]\n"
    assert(write_file(build ++ "/compile_commands.json", commands) == 0)
    if graph.len() > 0: assert(write_file(build ++ "/build.ninja", graph) == 0)
    assert(write_file(dep ++ "/metadata.json", "{\"include_paths\": [\"include\"], \"libs\": [\"boxes\"]}\n") == 0)
    assert(set_env("WITH_REGISTRY", "file:///nonexistent-registry") == 0)
    conan_write_facade("boxes", "1.0", dep, src, build)
    (read_file(dep ++ "/contract.with") ?? "") ++ "\n====\n" ++ (read_file(dep ++ "/contract-report.txt") ?? "")

fn main:
    let base = "out/tmp/conan_facade_library_units_test"
    let graph = "rule C_COMPILER\n  command = cc\nrule C_STATIC_LIBRARY_LINKER__boxes_\n  command = ar\nrule C_EXECUTABLE_LINKER__boxtool_\n  command = cc\nbuild CMakeFiles/boxes.dir/boxes.c.o: C_COMPILER ../src/boxes.c\nbuild CMakeFiles/boxtool.dir/help.c.o: C_COMPILER help.c\nbuild libboxes.a: C_STATIC_LIBRARY_LINKER__boxes_ CMakeFiles/boxes.dir/boxes.c.o\nbuild boxtool: C_EXECUTABLE_LINKER__boxtool_ CMakeFiles/boxtool.dir/help.c.o | libboxes.a || libboxes.a\n"
    // With the graph, the tool's missing unit is not the library's.
    let scoped = draft(base ++ "/scoped", graph)
    let scoped_ok = scoped.contains("resource Box wraps *mut box") and not scoped.contains("were not there") and not scoped.contains("could not be read") and not scoped.contains("every unit it compiles was read")
    // Without one, every unit is read and the report says why.
    let whole = draft(base ++ "/whole", "")
    let whole_ok = whole.contains("the build has no build.ninja naming the units of its libraries, so every unit it compiles was read") and (whole.contains("were not there") or whole.contains("could not be read"))
    if not (scoped_ok and whole_ok):
        print(scoped)
        print(whole)
    assert(scoped_ok)
    assert(whole_ok)
    print("ok")
