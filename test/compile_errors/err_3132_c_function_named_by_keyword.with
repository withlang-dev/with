//! expect-check-fail: expected expression: `trait` is a reserved word and cannot name a value

// A C function whose name is a With keyword is imported with a trailing
// underscore (`trait_`). Calling it by its C name said only "expected
// expression" (#3132).
use c_import("static inline int trait(int x) { return x + 1; }\n")

fn main:
    print(trait(1))
