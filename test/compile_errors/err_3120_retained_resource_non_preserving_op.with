//! expect-check-fail: 'headers' cannot be passed to 'HeaderList.mutate' while 'Easy' holds a retained borrow of it (§16.2b.5, §16.2b.9)
//! expect-check-fail: = note: operations not marked 'preserves' may mutate or invalidate the borrowed resource
//! expect-check-fail: = help: release the retention or reset/destroy 'Easy' first, or mark 'HeaderList.mutate' 'preserves' in its contract if C does not mutate or invalidate it

// #3120 (D235, spec §16.2b.5): while a retaining handle holds a shared
// borrow of a facade resource, an operation on that resource not marked
// `preserves` is refused at compile time.
use c_import("typedef struct h h;\ntypedef struct slist slist;\nh *h_new(void);\nvoid h_free(h *x);\nvoid h_reset(h *x);\nint h_set(h *x, int opt, ...);\nint h_run(h *x);\nslist *slist_new(void);\nvoid slist_free(slist *s);\nint slist_mutate(slist *s);\n#define OPT_HEADERS 1\n#define H_OK 0\n")

c contract hlib:
    resource Easy wraps *mut h
        from h_new
        drop h_free
        abandon h_reset
    resource HeaderList wraps *mut slist
        from slist_new
        drop slist_free
    fn h_reset
        rename reset
        lend
        callbacks none
    fn h_set
        rename setopt
        lend
        callbacks none
        ok H_OK
        variadic param 2 selected by param opt:
            case OPT_HEADERS: &HeaderList retains by param 0
    fn h_run
        rename perform
        lend
    fn slist_mutate
        rename mutate
        lend

fn main:
    let headers = HeaderList.new().unwrap()
    let easy = Easy.new().unwrap()
    if easy.setopt(OPT_HEADERS, headers).is_err(): return
    let _ = headers.mutate()
    print(f"{easy.perform()}")
