//! expect-check-fail: fn 'node_child': 'returns borrow Node' borrows a resource with no 'drop', so 'Node' has no presented type to borrow (§16.2b.3, §16.2b.6)
//! expect-check-fail: = help: add 'drop <fn>' on 'Node'

// #3129 / D246 (§16.2b.3, §16.2b.6): a resource that states a producer without
// a `drop` has no presented type to borrow (a borrow-only child resource with
// no producer or destroyer is modeled under D246).
use c_import("typedef struct node node;\nnode *node_new(void);\nvoid node_free(node *n);\nnode *node_child(node *n, int i);\nconst char *node_text(node *n, int k);\nnode *node_at(int i, node *n);\n")

c contract tree:
    resource Node wraps *mut node
        from node_new
    fn node_child
        returns borrow Node from param 0

fn main:
    print(1)
