//! expect-check-fail: producer 'part_new' with no 'drop' and no 'destroys'
// #3114 / D246: a borrow-only resource (no producer, no drop) is valid under
// D246, whereas a resource that declares a producer without a `drop` is still
// refused and renders no `BorrowedPart`.
use c_import("typedef struct mime mime; typedef struct part part;
mime *mime_new(void);
void mime_free(mime *m);
part *part_new(void);
part *mime_addpart(mime *m);
")

c contract mimes:
    resource Mime wraps *mut mime
        from mime_new
        drop mime_free
    resource Part wraps *mut part
        from part_new
    fn mime_addpart
        rename add_part
        returns borrow Part from param 0

fn main:
    print("ok")
