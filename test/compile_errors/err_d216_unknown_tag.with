//! expect-check-fail: 'tag nope' names no field of Ev
// D216 (#2425): the tag is a field of the record.
use c_import("err_d216_message.h")

c contract evs:
    message Event wraps Ev
        from ev_poll(out param 0)
        tag nope
        case Key when EV_KEY field key

fn main:
    print("x")
