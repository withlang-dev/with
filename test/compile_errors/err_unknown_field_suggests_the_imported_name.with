// A C field whose name is a With word is imported with an underscore
// (libyaml's `parser.error` is `error_`). The refusal said only "unknown
// field"; it now names the field meant, as it does for a misspelling.

use c_import("typedef struct parser_s { int error; long offset; } parser_s;\n")

fn main:
    let p = parser_s.zeroed()
    print(f"{p.error} {p.offst}")
