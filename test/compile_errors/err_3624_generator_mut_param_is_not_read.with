//! expect-check-fail: already mutably borrowed
// #3624 (D172): the place a generator took `mut` is not read in the loop
// body either: the generator writes it between the body's runs.
type Box { n: i32 }

gen fn walk(mut b: Box) -> i32:
    while b.n > 0:
        b.n = b.n - 1
        yield b.n

fn peek(b: &Box) -> i32: b.n

fn main:
    var b = Box { n: 2 }
    for x in walk(mut b):
        print(peek(b))
