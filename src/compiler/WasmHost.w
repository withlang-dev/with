// compiler/WasmHost.w — the JavaScript host emitted beside every wasm
// program (the emscripten-shaped "userspace" for a With module).
//
// A With program compiled for wasm32 imports WASI preview1 system calls
// and nothing else (rt/wasm.w). Any WASI host runs it (wasmtime, node's
// wasi module); this file writes `<program>.js`, a host that runs it in
// node with the real filesystem, argv, env, and stdio, and in a browser
// with an in-memory filesystem and console stdio. The JS is data the
// compiler emits, kept here as the string it is.

use compiler.Runtime

extern fn with_eprint(s: &str) -> Unit
extern fn with_str_clone_ref(s: &str) -> str

// `foo.wasm` -> `foo.js`; a bare `foo` -> `foo.js`.
pub fn wasm_host_js_path(bin_path: &str) -> str:
    if bin_path.ends_with(".wasm"):
        return bin_path.slice(0, bin_path.len() - 5) ++ ".js"
    bin_path ++ ".js"

fn wasm_host_basename(path: &str) -> str:
    var i = path.len() as i32
    while i > 0:
        let ch = path[(i - 1)]
        if ch == 47 or ch == 92:
            break
        i = i - 1
    path.slice(i as i64, path.len())

pub fn wasm_host_emit(bin_path: &str) -> i32:
    let js_path = wasm_host_js_path(bin_path)
    let text = wasm_host_js_text(wasm_host_basename(bin_path))
    if runtime_write_file(js_path, text) != 0:
        with_eprint("error: could not write wasm host script: " ++ js_path)
        return 1
    0

fn wasm_host_js_text(wasm_file: &str) -> str:
    let l: Vec[str] = Vec.new()
    l.push("// Generated by the With compiler: host runtime for " ++ wasm_file ++ ".")
    l.push("// Runs the module under node (real filesystem, argv, env, stdio) or in a")
    l.push("// browser (in-memory filesystem, console stdio) by serving its WASI")
    l.push("// preview1 imports. node: `node " ++ wasm_host_basename(wasm_host_js_path(wasm_file)) ++ " [args]`.")
    l.push("// browser: load this script, then `WithWasm.run({ args, env, stdin, files, stdout, stderr })`.")
    l.push("'use strict';")
    l.push("(function (root) {")
    l.push("  const WASM_FILE = '" ++ wasm_file ++ "';")
    l.push("  const isNode = typeof process !== 'undefined' && process.versions != null && process.versions.node != null;")
    l.push("  const enc = new TextEncoder();")
    l.push("  const dec = new TextDecoder();")
    l.push("  const NL = String.fromCharCode(10);")
    l.push("  class WithExit { constructor(code) { this.code = code; } }")
    l.push("  const E = { EACCES: 2, EAGAIN: 6, EBADF: 8, EBUSY: 10, EEXIST: 20, EINVAL: 28, EIO: 29, EISDIR: 31, ELOOP: 32, ENAMETOOLONG: 37, EMFILE: 41, ENOENT: 44, ENOSPC: 51, ENOSYS: 52, ENOTDIR: 54, ENOTEMPTY: 55, ENOTSUP: 58, EPERM: 63, EPIPE: 64, EROFS: 69, ESPIPE: 70 };")
    l.push("  const FT = { UNKNOWN: 0, CHARDEV: 2, DIR: 3, REG: 4, SYMLINK: 7 };")
    l.push("  const RIGHTS_ALL = 0x0fffffffn;")
    l.push("  function mkErr(code) { const e = new Error(code); e.code = code; return e; }")
    l.push("  function errnoOf(e) { const code = e && e.code; return (code && E[code] !== undefined) ? E[code] : E.EIO; }")
    l.push("  function nowNs(id) { return id === 0 ? BigInt(Date.now()) * 1000000n : BigInt(Math.round(performance.now() * 1e6)); }")
    l.push("  function busySleep(ns) { const end = performance.now() + Number(ns) / 1e6; while (performance.now() < end) {} }")
    l.push("  function sleepNs(ns) { try { Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, Number(ns) / 1e6); } catch (e) { busySleep(ns); } }")
    l.push("")
    l.push("  // ---- node backend: the real filesystem ---------------------------------")
    l.push("  function nodeBackend() {")
    l.push("    const fs = require('fs');")
    l.push("    const pathMod = require('path');")
    l.push("    const c = fs.constants;")
    l.push("    function typeOf(st) { return st.isDirectory() ? FT.DIR : st.isSymbolicLink() ? FT.SYMLINK : st.isFile() ? FT.REG : st.isCharacterDevice() ? FT.CHARDEV : FT.UNKNOWN; }")
    l.push("    function statOf(st) { return { type: typeOf(st), size: st.size, mtime: BigInt(Math.round(st.mtimeMs * 1e6)), ino: BigInt(st.ino || 0), nlink: BigInt(st.nlink || 1) }; }")
    l.push("    return {")
    l.push("      stat(p, follow) { return statOf(follow ? fs.statSync(p) : fs.lstatSync(p)); },")
    l.push("      open(p, o) {")
    l.push("        if (o.directory) { if (!fs.statSync(p).isDirectory()) throw mkErr('ENOTDIR'); return { dir: true, entries: null }; }")
    l.push("        let flags = o.write ? (o.read ? c.O_RDWR : c.O_WRONLY) : c.O_RDONLY;")
    l.push("        if (o.create) flags |= c.O_CREAT;")
    l.push("        if (o.excl) flags |= c.O_EXCL;")
    l.push("        if (o.trunc) flags |= c.O_TRUNC;")
    l.push("        if (o.append) flags |= c.O_APPEND;")
    l.push("        if (!o.follow && c.O_NOFOLLOW) flags |= c.O_NOFOLLOW;")
    l.push("        const fd = fs.openSync(p, flags, 0o644);")
    l.push("        if (fs.fstatSync(fd).isDirectory()) { fs.closeSync(fd); return { dir: true, entries: null }; }")
    l.push("        return { dir: false, fd: fd, pos: 0, append: !!o.append };")
    l.push("      },")
    l.push("      read(h, buf) { const n = fs.readSync(h.fd, buf, 0, buf.length, h.pos); h.pos += n; return n; },")
    l.push("      write(h, buf) { let off = 0; while (off < buf.length) { const n = fs.writeSync(h.fd, buf, off, buf.length - off, h.append ? null : h.pos + off); off += n; } h.pos += off; return off; },")
    l.push("      seek(h, off, whence) { const np = whence === 0 ? off : whence === 1 ? h.pos + off : fs.fstatSync(h.fd).size + off; if (np < 0) throw mkErr('EINVAL'); h.pos = np; return np; },")
    l.push("      fstat(h) { return statOf(h.dir ? fs.statSync(h.path) : fs.fstatSync(h.fd)); },")
    l.push("      close(h) { if (!h.dir) fs.closeSync(h.fd); },")
    l.push("      readdir(h) { return fs.readdirSync(h.path, { withFileTypes: true }).map((d) => ({ name: d.name, type: d.isDirectory() ? FT.DIR : d.isSymbolicLink() ? FT.SYMLINK : d.isFile() ? FT.REG : FT.UNKNOWN })); },")
    l.push("      mkdir(p) { fs.mkdirSync(p); },")
    l.push("      unlink(p) { fs.unlinkSync(p); },")
    l.push("      rmdir(p) { fs.rmdirSync(p); },")
    l.push("      rename(a, b) { fs.renameSync(a, b); },")
    l.push("      symlink(t, p) { fs.symlinkSync(t, p); },")
    l.push("      readlink(p) { return fs.readlinkSync(p); },")
    l.push("      writeStd(fd, buf) { let off = 0; while (off < buf.length) { try { off += fs.writeSync(fd, buf, off, buf.length - off); } catch (e) { if (e.code !== 'EAGAIN') throw e; sleepNs(1000000n); } } return buf.length; },")
    l.push("      readStd(buf) { for (;;) { try { return fs.readSync(0, buf, 0, buf.length, null); } catch (e) { if (e.code === 'EAGAIN') { sleepNs(5000000n); continue; } if (e.code === 'EOF') return 0; throw e; } } },")
    l.push("      isTTY(fd) { const s = fd === 0 ? process.stdin : fd === 1 ? process.stdout : process.stderr; return !!(s && s.isTTY); },")
    l.push("      args(opts) { return opts.args || [WASM_FILE].concat(process.argv.slice(2)); },")
    l.push("      env(opts) { return opts.env || Object.assign({}, process.env, { PWD: process.cwd() }); },")
    l.push("      sleep: sleepNs,")
    l.push("      random(buf) { require('crypto').randomFillSync(buf); },")
    l.push("      loadWasm(opts) { return fs.readFileSync(opts.wasmPath || pathMod.join(__dirname, WASM_FILE)); },")
    l.push("      flush() {},")
    l.push("    };")
    l.push("  }")
    l.push("")
    l.push("  // ---- browser backend: an in-memory filesystem ---------------------------")
    l.push("  function memBackend(opts) {")
    l.push("    const rootDir = { type: FT.DIR, children: new Map(), mtime: 0n };")
    l.push("    const stdout = opts.stdout || ((s) => console.log(s));")
    l.push("    const stderr = opts.stderr || ((s) => console.error(s));")
    l.push("    const pending = ['', ''];")
    l.push("    let stdinBytes = opts.stdin != null ? (typeof opts.stdin === 'string' ? enc.encode(opts.stdin) : opts.stdin) : new Uint8Array(0);")
    l.push("    let stdinPos = 0;")
    l.push("    function parts(p) { return p.split('/').filter((s) => s.length > 0 && s !== '.'); }")
    l.push("    // Walk `p`; returns { parent, name, node } where node is null when the last component is absent.")
    l.push("    function walk(p, follow) {")
    l.push("      let stack = [rootDir];")
    l.push("      let segs = parts(p);")
    l.push("      let hops = 0;")
    l.push("      for (let i = 0; i < segs.length; i++) {")
    l.push("        const s = segs[i];")
    l.push("        const cur = stack[stack.length - 1];")
    l.push("        if (s === '..') { if (stack.length > 1) stack.pop(); continue; }")
    l.push("        if (cur.type !== FT.DIR) throw mkErr('ENOTDIR');")
    l.push("        const child = cur.children.get(s);")
    l.push("        const last = i === segs.length - 1;")
    l.push("        if (!child) { if (last) return { parent: cur, name: s, node: null }; throw mkErr('ENOENT'); }")
    l.push("        if (child.type === FT.SYMLINK && (!last || follow)) {")
    l.push("          if (++hops > 40) throw mkErr('ELOOP');")
    l.push("          const t = parts(child.target);")
    l.push("          if (child.target.startsWith('/')) stack = [rootDir];")
    l.push("          segs.splice(i, 1, ...t);")
    l.push("          i -= 1;")
    l.push("          continue;")
    l.push("        }")
    l.push("        if (last) return { parent: cur, name: s, node: child };")
    l.push("        stack.push(child);")
    l.push("      }")
    l.push("      return { parent: null, name: '', node: stack[stack.length - 1] };")
    l.push("    }")
    l.push("    function need(p, follow) { const r = walk(p, follow); if (!r.node) throw mkErr('ENOENT'); return r; }")
    l.push("    function statOf(n) { return { type: n.type, size: n.type === FT.REG ? n.size : 0, mtime: n.mtime, ino: 0n, nlink: 1n }; }")
    l.push("    function addFile(p, data) {")
    l.push("      const segs = parts(p);")
    l.push("      let dir = rootDir;")
    l.push("      for (let i = 0; i < segs.length - 1; i++) { let d = dir.children.get(segs[i]); if (!d) { d = { type: FT.DIR, children: new Map(), mtime: 0n }; dir.children.set(segs[i], d); } dir = d; }")
    l.push("      const bytes = typeof data === 'string' ? enc.encode(data) : data;")
    l.push("      dir.children.set(segs[segs.length - 1], { type: FT.REG, data: bytes.slice(), size: bytes.length, mtime: nowNs(0) });")
    l.push("    }")
    l.push("    if (opts.files) for (const k of Object.keys(opts.files)) addFile(k, opts.files[k]);")
    l.push("    function emit(fd, buf) {")
    l.push("      const sink = fd === 1 ? stdout : stderr;")
    l.push("      let text = pending[fd - 1] + dec.decode(buf);")
    l.push("      let cut = text.lastIndexOf(NL);")
    l.push("      if (cut >= 0) { sink(text.slice(0, cut)); text = text.slice(cut + 1); }")
    l.push("      pending[fd - 1] = text;")
    l.push("      return buf.length;")
    l.push("    }")
    l.push("    return {")
    l.push("      stat(p, follow) { return statOf(need(p, follow).node); },")
    l.push("      open(p, o) {")
    l.push("        const r = walk(p, o.follow !== false);")
    l.push("        let n = r.node;")
    l.push("        if (!n) {")
    l.push("          if (!o.create) throw mkErr('ENOENT');")
    l.push("          n = { type: FT.REG, data: new Uint8Array(0), size: 0, mtime: nowNs(0) };")
    l.push("          r.parent.children.set(r.name, n);")
    l.push("        } else if (o.create && o.excl) throw mkErr('EEXIST');")
    l.push("        if (o.directory && n.type !== FT.DIR) throw mkErr('ENOTDIR');")
    l.push("        if (n.type === FT.DIR) { if (o.write) throw mkErr('EISDIR'); return { dir: true, node: n, entries: null }; }")
    l.push("        if (o.trunc) { n.data = new Uint8Array(0); n.size = 0; }")
    l.push("        return { dir: false, node: n, pos: 0, append: !!o.append };")
    l.push("      },")
    l.push("      read(h, buf) { const n = Math.max(0, Math.min(buf.length, h.node.size - h.pos)); buf.set(h.node.data.subarray(h.pos, h.pos + n)); h.pos += n; return n; },")
    l.push("      write(h, buf) {")
    l.push("        const n = h.node;")
    l.push("        const at = h.append ? n.size : h.pos;")
    l.push("        const end = at + buf.length;")
    l.push("        if (end > n.data.length) { const grown = new Uint8Array(Math.max(end, n.data.length * 2, 64)); grown.set(n.data.subarray(0, n.size)); n.data = grown; }")
    l.push("        n.data.set(buf, at);")
    l.push("        if (end > n.size) n.size = end;")
    l.push("        n.mtime = nowNs(0);")
    l.push("        h.pos = end;")
    l.push("        return buf.length;")
    l.push("      },")
    l.push("      seek(h, off, whence) { const np = whence === 0 ? off : whence === 1 ? h.pos + off : h.node.size + off; if (np < 0) throw mkErr('EINVAL'); h.pos = np; return np; },")
    l.push("      fstat(h) { return statOf(h.node); },")
    l.push("      close(h) {},")
    l.push("      readdir(h) { return Array.from(h.node.children.keys()).sort().map((name) => ({ name: name, type: h.node.children.get(name).type })); },")
    l.push("      mkdir(p) { const r = walk(p, true); if (r.node) throw mkErr('EEXIST'); if (!r.parent) throw mkErr('ENOENT'); r.parent.children.set(r.name, { type: FT.DIR, children: new Map(), mtime: nowNs(0) }); },")
    l.push("      unlink(p) { const r = need(p, false); if (r.node.type === FT.DIR) throw mkErr('EISDIR'); r.parent.children.delete(r.name); },")
    l.push("      rmdir(p) { const r = need(p, false); if (r.node.type !== FT.DIR) throw mkErr('ENOTDIR'); if (r.node.children.size > 0) throw mkErr('ENOTEMPTY'); if (!r.parent) throw mkErr('EBUSY'); r.parent.children.delete(r.name); },")
    l.push("      rename(a, b) { const src = need(a, false); const dst = walk(b, false); if (dst.node && dst.node.type === FT.DIR && dst.node.children.size > 0) throw mkErr('ENOTEMPTY'); src.parent.children.delete(src.name); dst.parent.children.set(dst.name, src.node); },")
    l.push("      symlink(t, p) { const r = walk(p, false); if (r.node) throw mkErr('EEXIST'); r.parent.children.set(r.name, { type: FT.SYMLINK, target: t, mtime: nowNs(0) }); },")
    l.push("      readlink(p) { const r = need(p, false); if (r.node.type !== FT.SYMLINK) throw mkErr('EINVAL'); return r.node.target; },")
    l.push("      writeStd(fd, buf) { return emit(fd, buf); },")
    l.push("      readStd(buf) { const n = Math.min(buf.length, stdinBytes.length - stdinPos); buf.set(stdinBytes.subarray(stdinPos, stdinPos + n)); stdinPos += n; return n; },")
    l.push("      isTTY(fd) { return false; },")
    l.push("      args(opts) { return opts.args || [WASM_FILE]; },")
    l.push("      env(opts) { return opts.env || { PWD: '/' }; },")
    l.push("      sleep: sleepNs,")
    l.push("      random(buf) { crypto.getRandomValues(buf); },")
    l.push("      async loadWasm(opts) {")
    l.push("        if (opts.wasmBytes) return opts.wasmBytes;")
    l.push("        if (isNode && !opts.wasmUrl) return require('fs').readFileSync(opts.wasmPath || require('path').join(__dirname, WASM_FILE));")
    l.push("        const base = opts.wasmUrl || new URL(WASM_FILE, SCRIPT_URL || (typeof location !== 'undefined' ? location.href : '')).href;")
    l.push("        const res = await fetch(base);")
    l.push("        if (!res.ok) throw new Error('could not fetch ' + base + ': ' + res.status);")
    l.push("        return new Uint8Array(await res.arrayBuffer());")
    l.push("      },")
    l.push("      flush() { if (pending[0].length > 0) { stdout(pending[0]); pending[0] = ''; } if (pending[1].length > 0) { stderr(pending[1]); pending[1] = ''; } },")
    l.push("      root: rootDir,")
    l.push("    };")
    l.push("  }")
    l.push("  const SCRIPT_URL = (typeof document !== 'undefined' && document.currentScript && document.currentScript.src) ? document.currentScript.src : '';")
    l.push("")
    l.push("  // ---- WASI preview1 over a backend ----------------------------------------")
    l.push("  function createWasi(be, opts) {")
    l.push("    let memory = null;")
    l.push("    let mem8 = null;")
    l.push("    let view = null;")
    l.push("    function refresh() { if (mem8 === null || mem8.buffer !== memory.buffer) { mem8 = new Uint8Array(memory.buffer); view = new DataView(memory.buffer); } }")
    l.push("    const u32 = (p) => { refresh(); return view.getUint32(p, true); };")
    l.push("    const setU8 = (p, v) => { refresh(); mem8[p] = v; };")
    l.push("    const setU16 = (p, v) => { refresh(); view.setUint16(p, v, true); };")
    l.push("    const setU32 = (p, v) => { refresh(); view.setUint32(p, v >>> 0, true); };")
    l.push("    const setU64 = (p, v) => { refresh(); view.setBigUint64(p, BigInt(v), true); };")
    l.push("    const bytes = (p, n) => { refresh(); return mem8.subarray(p, p + n); };")
    l.push("    const str = (p, n) => dec.decode(bytes(p, n));")
    l.push("    const fds = new Map();")
    l.push("    let nextFd = 4;")
    l.push("    fds.set(0, { std: 0 });")
    l.push("    fds.set(1, { std: 1 });")
    l.push("    fds.set(2, { std: 2 });")
    l.push("    fds.set(3, { preopen: '/', dir: true, path: '/', entries: null });")
    l.push("    const args = be.args(opts);")
    l.push("    const envObj = be.env(opts);")
    l.push("    const envPairs = Object.keys(envObj).map((k) => k + '=' + envObj[k]);")
    l.push("    function fdOf(fd) { const h = fds.get(fd); if (!h) throw mkErr('EBADF'); return h; }")
    l.push("    function pathOf(dirfd, p, n) {")
    l.push("      const h = fdOf(dirfd);")
    l.push("      if (!h.dir) throw mkErr('ENOTDIR');")
    l.push("      const rel = str(p, n);")
    l.push("      if (rel === '.' || rel.length === 0) return h.path;")
    l.push("      return h.path.endsWith('/') ? h.path + rel : h.path + '/' + rel;")
    l.push("    }")
    l.push("    function wrap(fn) { return function () { try { return fn.apply(null, arguments); } catch (e) { if (e instanceof WithExit) throw e; if (opts.trace) console.error('wasi:', e); return errnoOf(e); } }; }")
    l.push("    function writeStat(buf, st) { setU64(buf, 0n); setU64(buf + 8, st.ino); setU8(buf + 16, st.type); setU64(buf + 24, st.nlink); setU64(buf + 32, BigInt(st.size)); setU64(buf + 40, st.mtime); setU64(buf + 48, st.mtime); setU64(buf + 56, st.mtime); }")
    l.push("    function sizesOf(list, countPtr, sizePtr) { setU32(countPtr, list.length); setU32(sizePtr, list.reduce((a, s) => a + enc.encode(s).length + 1, 0)); return 0; }")
    l.push("    function fillList(list, ptrs, buf) { let p = buf; for (let i = 0; i < list.length; i++) { setU32(ptrs + i * 4, p); const b = enc.encode(list[i]); bytes(p, b.length).set(b); setU8(p + b.length, 0); p += b.length + 1; } return 0; }")
    l.push("    const imports = {")
    l.push("      args_sizes_get: wrap((countPtr, sizePtr) => sizesOf(args, countPtr, sizePtr)),")
    l.push("      args_get: wrap((ptrs, buf) => fillList(args, ptrs, buf)),")
    l.push("      environ_sizes_get: wrap((countPtr, sizePtr) => sizesOf(envPairs, countPtr, sizePtr)),")
    l.push("      environ_get: wrap((ptrs, buf) => fillList(envPairs, ptrs, buf)),")
    l.push("      clock_time_get: wrap((id, precision, out) => { setU64(out, nowNs(id)); return 0; }),")
    l.push("      clock_res_get: wrap((id, out) => { setU64(out, 1000n); return 0; }),")
    l.push("      fd_close: wrap((fd) => { const h = fdOf(fd); if (h.std === undefined && !h.preopen) { be.close(h); fds.delete(fd); } return 0; }),")
    l.push("      fd_fdstat_get: wrap((fd, buf) => { const h = fdOf(fd); const t = h.std !== undefined ? (be.isTTY(h.std) ? FT.CHARDEV : FT.UNKNOWN) : (h.dir ? FT.DIR : FT.REG); setU8(buf, t); setU16(buf + 2, h.append ? 1 : 0); setU64(buf + 8, RIGHTS_ALL); setU64(buf + 16, RIGHTS_ALL); return 0; }),")
    l.push("      fd_fdstat_set_flags: wrap((fd, flags) => { const h = fdOf(fd); if (h.std === undefined && !h.dir) h.append = (flags & 1) !== 0; return 0; }),")
    l.push("      fd_filestat_get: wrap((fd, buf) => { const h = fdOf(fd); if (h.std !== undefined) { writeStat(buf, { type: FT.CHARDEV, size: 0, mtime: 0n, ino: 0n, nlink: 1n }); return 0; } writeStat(buf, be.fstat(h)); return 0; }),")
    l.push("      fd_prestat_get: wrap((fd, buf) => { const h = fds.get(fd); if (!h || !h.preopen) return E.EBADF; setU8(buf, 0); setU32(buf + 4, enc.encode(h.preopen).length); return 0; }),")
    l.push("      fd_prestat_dir_name: wrap((fd, p, n) => { const h = fds.get(fd); if (!h || !h.preopen) return E.EBADF; const b = enc.encode(h.preopen); const k = Math.min(n, b.length); bytes(p, k).set(b.subarray(0, k)); return 0; }),")
    l.push("      fd_read: wrap((fd, iovs, iovsLen, nread) => {")
    l.push("        const h = fdOf(fd);")
    l.push("        let total = 0;")
    l.push("        for (let i = 0; i < iovsLen; i++) {")
