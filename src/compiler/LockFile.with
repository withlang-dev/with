// LockFile — deterministic `.with/lock.json` handling for fetched packages.
//
// Manual `[deps.c.X]` entries are intentionally not represented here: they
// point at user-owned paths and have no fetched artifact to hash-pin.

use compiler.Runtime
use compiler.ConanClient
use compiler.ProjectConfig
use std.crypto.sha256
use rt.rt_core

type LockEntry {
    name: str,
    source: str,
    version: str,
    recipe_rev: str,
    package_id: str,
    package_rev: str,
    sha256: str,
    // D121 step 5: the commit of the toolchain's repository whose registry
    // facts file (registry/c/<name>/facts.with, D136) the package's facade was
    // built with, and that file's digest; "" when none was used. A restore
    // fetches the file at that commit.
    registry: str,
    facts_sha256: str,
    // #2757: per-platform effective recipe options (such as TLS backend),
    // stored as `"<platform>|<opt1>,<opt2>"`, sorted by platform.
    platform_options: List[str],
}
// #747: str field — owned, non-Copy now; moves/clones spell intent.

fn lock_entry_none() -> LockEntry:
    LockEntry { name: "", source: "", version: "", recipe_rev: "", package_id: "", package_rev: "", sha256: "", registry: "", facts_sha256: "", platform_options: [] }

fn lock_platform_id() -> str:
    let raw_os = runtime_sysinfo_os()
    let os = if raw_os == "Macos": "macos" else if raw_os == "Linux": "linux" else if raw_os == "Windows": "windows" else: raw_os
    os ++ "-" ++ runtime_sysinfo_arch()

fn lock_platform_opt_key(item: &str) -> str:
    let bar = lock_find_text(item, "|")
    if bar <= 0: return ""
    item.slice(0, bar)

fn lock_platform_opt_val(item: &str) -> str:
    let bar = lock_find_text(item, "|")
    if bar <= 0: return ""
    item.slice(bar + 1, item.len())

fn lock_platform_options_upsert(items: &List[str], platform: &str, opts: &str) -> List[str]:
    let out = []
    if platform.len() == 0 or opts.len() == 0:
        for item in items: out.push(with_str_clone_ref(item))
        return out
    let entry = platform ++ "|" ++ opts
    var inserted = false
    for item in items:
        let existing_plat = lock_platform_opt_key(item)
        let cmp = lock_str_compare(platform, existing_plat)
        if cmp == 0:
            if not inserted:
                out.push(with_str_clone_ref(entry))
                inserted = true
        else:
            if not inserted and cmp < 0:
                out.push(with_str_clone_ref(entry))
                inserted = true
            out.push(with_str_clone_ref(item))
    if not inserted: out.push(entry)
    out

fn lock_platform_options_merge(existing: &List[str], incoming: &List[str]) -> List[str]:
    var out = []
    for item in existing:
        out = lock_platform_options_upsert(out, lock_platform_opt_key(item), lock_platform_opt_val(item))
    for item in incoming:
        out = lock_platform_options_upsert(out, lock_platform_opt_key(item), lock_platform_opt_val(item))
    out

fn lock_platform_options_for(items: &List[str], platform: &str) -> str:
    for item in items:
        if lock_platform_opt_key(item) == platform:
            return lock_platform_opt_val(item)
    ""

// #2757: when another platform in the lock recorded different options than
// `current_opts` on `platform`, returns a human-readable summary of the
// difference; "" when all recorded platforms agree.
fn lock_platform_diff_note(entry: &LockEntry, platform: &str, current_opts: &str) -> str:
    if current_opts.len() == 0: return ""
    var others = ""
    for item in entry.platform_options:
        let plat = lock_platform_opt_key(item)
        let val = lock_platform_opt_val(item)
        if plat == platform or val == current_opts or val.len() == 0: continue
        if others.len() > 0: others = others ++ ", "
        others = others ++ val ++ " on " ++ plat
    if others.len() == 0: return ""
    entry.name ++ "@" ++ entry.version ++ ": locked with " ++ others ++ "; using " ++ current_opts ++ " on " ++ platform

type LockFile {
    entries: List[LockEntry],
}

fn lock_file_path(project_root: &str):
    project_root ++ "/.with/lock.json"

fn lock_empty -> LockFile:
    LockFile { entries: [] }

fn lock_str_compare(a: &str, b: &str) -> i32:
    let min_len = if a.len() < b.len(): a.len() else: b.len()
    for i in 0..min_len as i32:
        let ca = a[i] as i32
        let cb = b[i] as i32
        if ca < cb:
            return -1
        if ca > cb:
            return 1
    if a.len() < b.len():
        return -1
    if a.len() > b.len():
        return 1
    0

fn lock_json_escape(value: &str):
    var out = ""
    for i in 0..value.len():
        let ch = value[i]
        if ch == 34 or ch == 92:
            out = out ++ "\\"
        out = out ++ value.slice(i, (i + 1))
    out

fn lock_json_string(key: &str, value: &str, comma: bool):
    let q = "\x22"
    let suffix = if comma: "," else: ""
    "      " ++ q ++ key ++ q ++ ": " ++ q ++ lock_json_escape(value) ++ q ++ suffix ++ "\n"

fn lock_find_text(text: &str, needle: &str) -> isize:
    if needle.len() == 0:
        return 0
    let n = text.len()
    let m = needle.len()
    var i = 0
    while i <= n - m:
        var ok = true
        for j in 0..m:
            if text[(i + j)] != needle[j]:
                ok = false
                break
        if ok:
            return i
        i = i + 1
    -1

fn lock_json_extract_string(json: &str, key: &str) -> str:
    let needle = "\"" ++ key ++ "\""
    let json_len = json.len()
    var pos = 0
    while pos < json_len - needle.len():
        var found = true
        for ni in 0..needle.len():
            if json[(pos + ni)] != needle[ni]:
                found = false
                break
        if found:
            var vi = pos + needle.len()
            while vi < json_len and json[vi] != 58:
                vi = vi + 1
            while vi < json_len and json[vi] != 34:
                vi = vi + 1
            if vi >= json_len:
                return ""
            vi = vi + 1
            let start = vi
            var escaped = false
            while vi < json_len:
                let ch = json[vi]
                if escaped:
                    escaped = false
                else if ch == 92:
                    escaped = true
                else if ch == 34:
                    break
                vi = vi + 1
            return json.slice(start, vi)
        pos = pos + 1
    ""

fn lock_json_extract_string_array(json: &str, key: &str) -> List[str]:
    let result: List[str] = []
    let needle = "\"" ++ key ++ "\""
    let json_len = json.len()
    var pos = 0
    while pos < json_len - needle.len():
        var found = true
        for ni in 0..needle.len():
            if json[(pos + ni)] != needle[ni]:
                found = false
                break
        if found:
            var ai = pos + needle.len()
            while ai < json_len and json[ai] != 91:
                ai = ai + 1
            if ai >= json_len:
                return result
            ai = ai + 1
            while ai < json_len and json[ai] != 93:
                if json[ai] == 34:
                    let start = ai + 1
                    var end = start
                    var escaped = false
                    while end < json_len:
                        let ch = json[end]
                        if escaped:
                            escaped = false
                        else if ch == 92:
                            escaped = true
                        else if ch == 34:
                            break
                        end = end + 1
                    if end > start:
                        result.push(json.slice(start, end))
                    ai = end + 1
                else:
                    ai = ai + 1
            return result
        pos = pos + 1
    result

fn lock_split_nonempty_lines(text: &str):
    let lines: List[str] = []
    let n = text.len()
    var start = 0
    var i = 0
    while i <= n:
        let at_end = i == n
        let ch = if at_end: 10 else: text[i]
        if ch == 10:
            var line = text.slice(start, i)
            if line.len() > 0 and line[line.len() - 1] == 13:
                line = line.slice(0, line.len() - 1)
            if line.len() > 0:
                lines.push(line)
            start = i + 1
        i = i + 1
    lines

fn lock_line_string_value(line: &str, key: &str) -> str:
    let needle = "\"" ++ key ++ "\""
    let key_pos = lock_find_text(line, needle)
    if key_pos < 0:
        return ""
    var pos = key_pos + needle.len()
    let n = line.len()
    while pos < n and line[pos] != 58:
        pos = pos + 1
    while pos < n and line[pos] != 34:
        pos = pos + 1
    if pos >= n:
        return ""
    let start = pos + 1
    var end = start
    while end < n and line[end] != 34:
        end = end + 1
    line.slice(start, end)

fn lock_line_kv(line: &str) -> (str, str):
    let n = line.len()
    var p = 0
    while p < n and line[p] != 34: p = p + 1
    if p >= n: return ("", "")
    let k_start = p + 1
    p = k_start
    while p < n and line[p] != 34: p = p + 1
    if p >= n: return ("", "")
    let key = line.slice(k_start, p)
    p = p + 1
    while p < n and line[p] != 58: p = p + 1
    while p < n and line[p] != 34: p = p + 1
    if p >= n: return ("", "")
    let v_start = p + 1
    p = v_start
    while p < n and line[p] != 34: p = p + 1
    if p >= n: return ("", "")
    (key, line.slice(v_start, p))

fn lock_line_entry_name(line: &str) -> str:
    if lock_find_text(line, "\": {") < 0:
        return ""
    var start = 0
    let n = line.len()
    while start < n and line[start] != 34:
        start = start + 1
    if start >= n:
        return ""
    start = start + 1
    var end = start
    while end < n and line[end] != 34:
        end = end + 1
    let name = line.slice(start, end)
    if name == "deps" or name == "options":
        return ""
    name

fn lock_load(project_root: &str) -> LockFile:
    let path = lock_file_path(project_root)
    if runtime_file_exists(path) == 0:
        return lock_empty()
    let json = runtime_read_file(path)
    var lock = lock_empty()
    var current = lock_entry_none()
    var in_options = false
    let lines = lock_split_nonempty_lines(json)
    for line in lines:
        if in_options:
            if lock_find_text(line, "}") >= 0:
                in_options = false
                continue
            let (plat, opts) = lock_line_kv(line)
            if plat.len() > 0 and opts.len() > 0:
                current.platform_options = lock_platform_options_upsert(current.platform_options, plat, opts)
            continue
        if current.name.len() > 0 and lock_find_text(line, "\"options\": {") >= 0:
            in_options = true
            continue
        let entry_name = lock_line_entry_name(line)
        if entry_name.len() > 0:
            current = LockEntry { name: entry_name, source: "", version: "", recipe_rev: "", package_id: "", package_rev: "", sha256: "", registry: "", facts_sha256: "", platform_options: [] }
            continue
        if current.name.len() == 0:
            continue
        let source = lock_line_string_value(line, "source")
        if source.len() > 0:
            current.source = source
            continue
        let version = lock_line_string_value(line, "version")
        if version.len() > 0:
            current.version = version
            continue
        let recipe_rev = lock_line_string_value(line, "recipe_rev")
        if recipe_rev.len() > 0:
            current.recipe_rev = recipe_rev
            continue
        let package_id = lock_line_string_value(line, "package_id")
        if package_id.len() > 0:
            current.package_id = package_id
            continue
        let package_rev = lock_line_string_value(line, "package_rev")
        if package_rev.len() > 0:
            current.package_rev = package_rev
            continue
        let facts_digest = lock_line_string_value(line, "facts_sha256")
        if facts_digest.len() > 0:
            current.facts_sha256 = facts_digest
            continue
        let digest = lock_line_string_value(line, "sha256")
        if digest.len() > 0:
            current.sha256 = digest
            continue
        let registry = lock_line_string_value(line, "registry")
        if registry.len() > 0:
            current.registry = registry
            continue
        if lock_find_text(line, "}") >= 0:
            lock = lock_upsert(lock, current)
            current = lock_entry_none()
    lock

fn lock_upsert(lock: &LockFile, entry: LockEntry) -> LockFile:
    let out_entries: List[LockEntry] = []
    var inserted = false
    for existing in lock.entries:
        let cmp = lock_str_compare(entry.name, existing.name)
        if cmp == 0:
            if not inserted:
                var merged = lock_entry_clone(entry)
                if existing.platform_options.len() > 0:
                    merged.platform_options = lock_platform_options_merge(existing.platform_options, entry.platform_options)
                    let cur_plat = lock_platform_id()
                    let cur_opts = lock_platform_options_for(entry.platform_options, cur_plat)
                    let diff = lock_platform_diff_note(merged, cur_plat, cur_opts)
                    if diff.len() > 0: runtime_eprint("  note: " ++ diff)
                out_entries.push(merged)
                inserted = true
        else:
            if not inserted and cmp < 0:
                out_entries.push(lock_entry_clone(entry))
                inserted = true
            out_entries.push(lock_entry_clone(existing))
    if not inserted:
        out_entries.push(entry)
    LockFile { entries: out_entries }

fn lock_remove(lock: &LockFile, name: &str) -> LockFile:
    let out_entries: List[LockEntry] = []
    for i in 0..lock.entries.len():
        let entry = lock.entries[i]
        if entry.name != name:
            out_entries.push(lock_entry_clone(entry))
    LockFile { entries: out_entries }

fn lock_write(project_root: &str, lock: &LockFile) -> i32:
    let dir = project_root ++ "/.with"
    if runtime_mkdir_p(dir) != 0:
        runtime_eprint("error: failed to create .with directory")
        return 1
    let q = "\x22"
    var text = "{\n"
    text = text ++ "  " ++ q ++ "version" ++ q ++ ": 1,\n"
    text = text ++ "  " ++ q ++ "deps" ++ q ++ ": {\n"
    for i in 0..lock.entries.len():
        let entry = lock.entries[i]
        text = text ++ "    " ++ q ++ lock_json_escape(entry.name) ++ q ++ ": {\n"
        text = text ++ lock_json_string("source", entry.source, true)
        let has_opts = entry.platform_options.len() > 0
        // D121 step 5: the registry commit and facts digest the facade was
        // built with, when the registry had a file for the package.
        let pinned = entry.registry.len() > 0 or entry.facts_sha256.len() > 0
        let has_more_after_version = entry.source == "conan" or entry.source == "built" or has_opts
        text = text ++ lock_json_string("version", entry.version, has_more_after_version)
        if entry.source == "built": text = text ++ lock_json_string("sha256", entry.sha256, has_opts or pinned)
        if entry.source == "conan":
            text = text ++ lock_json_string("recipe_rev", entry.recipe_rev, true)
            text = text ++ lock_json_string("package_id", entry.package_id, true)
            text = text ++ lock_json_string("package_rev", entry.package_rev, true)
            text = text ++ lock_json_string("sha256", entry.sha256, has_opts or pinned)
        if has_opts:
            text = text ++ "      " ++ q ++ "options" ++ q ++ ": {\n"
            for oi in 0..entry.platform_options.len():
                let plat = lock_platform_opt_key(entry.platform_options[oi])
                let val = lock_platform_opt_val(entry.platform_options[oi])
                let opt_comma = if oi + 1 < entry.platform_options.len(): "," else: ""
                text = text ++ "        " ++ q ++ lock_json_escape(plat) ++ q ++ ": " ++ q ++ lock_json_escape(val) ++ q ++ opt_comma ++ "\n"
            let close_comma = if pinned and (entry.source == "built" or entry.source == "conan"): "," else: ""
            text = text ++ "      }" ++ close_comma ++ "\n"
        if pinned and (entry.source == "built" or entry.source == "conan"):
            text = text ++ lock_json_string("registry", entry.registry, true)
            text = text ++ lock_json_string("facts_sha256", entry.facts_sha256, false)
        let suffix = if i + 1 < lock.entries.len(): "," else: ""
        text = text ++ "    }" ++ suffix ++ "\n"
    text = text ++ "  }\n"
    text = text ++ "}\n"
    runtime_write_file(lock_file_path(project_root), text)

fn lock_sha256_text(data: &str):
    let digest: [32]u8 = [0 as u8; 32]
    sha256_hash_str(data, &raw mut digest[0] as *mut u8)
    sha256_hex(&digest[0] as *const u8)

fn lock_sha256_file(path: &str) -> str:
    if runtime_file_exists(path) == 0:
        return ""
    lock_sha256_text(runtime_read_file(path))

fn lock_c_dep_dir(project_root: &str, name: &str, version: &str):
    project_root ++ "/.with/deps/c/" ++ name ++ "/" ++ version

fn lock_ref_name(req: &str) -> str:
    let slash = lock_find_text(req, "/")
    if slash <= 0:
        return ""
    req.slice(0, slash)

fn lock_ref_version(req: &str) -> str:
    let slash = lock_find_text(req, "/")
    if slash <= 0:
        return ""
    var end = req.len()
    let at = lock_find_text(req, "@")
    if at > slash:
        end = at
    req.slice((slash + 1), end)

fn lock_entry_from_installed_c_dep(project_root: &str, name: &str, version: &str) -> LockEntry:
    let dep_dir = lock_c_dep_dir(project_root, name, version)
    let meta = runtime_read_file(dep_dir ++ "/metadata.json")
    if meta.len() == 0:
        return lock_entry_none()
    let recipe_rev = lock_json_extract_string(meta, "recipe_revision")
    let package_id = lock_json_extract_string(meta, "package_id")
    let package_rev = lock_json_extract_string(meta, "package_revision")
    let dep_name = "c." ++ name
    // D121 step 5: the registry pin the facade was built with (facade.json).
    let pin = runtime_read_file(dep_dir ++ "/contract.json")
    let registry = lock_json_extract_string(pin, "registry_commit")
    let facts_sha256 = lock_json_extract_string(pin, "facts_sha256")
    let opts = lock_json_extract_string_array(meta, "options")
    let platform_options = []
    if opts.len() > 0:
        platform_options.push(lock_platform_id() ++ "|" ++ opts.join(","))
    if recipe_rev == "system" and package_id == "system" and package_rev == "system":
        return LockEntry { name: dep_name, source: "system", version: with_str_clone_ref(version), recipe_rev: "", package_id: "", package_rev: "", sha256: "", registry: "", facts_sha256: "", platform_options }
    // Built from source: what pins it is the source archive's digest.
    if recipe_rev == "built":
        return LockEntry { name: dep_name, source: "built", version: with_str_clone_ref(version), recipe_rev: "", package_id: "", package_rev: "", sha256: package_rev, registry, facts_sha256, platform_options }
    let tgz_path = dep_dir ++ "/conan_package.tgz"
    let digest = lock_sha256_file(tgz_path)
    if digest.len() == 0:
        runtime_eprint("error: cannot lock c." ++ name ++ "@" ++ version ++ ": missing fetched archive " ++ tgz_path)
        return lock_entry_none()
    LockEntry { name: dep_name, source: "conan", version: with_str_clone_ref(version), recipe_rev, package_id, package_rev, sha256: digest, registry, facts_sha256, platform_options }

// The dedup memo travels WITH the lock through the recursion: sibling
// subtrees must see each other's visits, and an owned List parameter is
// consumed by the first recursive call (pre-#691 handle-copy aliasing is
// gone), so both are threaded as one walk value.
type LockDepWalk { lock: LockFile, seen: List[str] }

fn lock_upsert_installed_c_dep_tree_seen(walk: LockDepWalk, project_root: &str, name: &str, version: &str) -> LockDepWalk:
    let key = name ++ "/" ++ version
    var out = walk
    for i in 0..out.seen.len():
        if out.seen[i] == key:
            return out
    out.seen.push(key)
    let entry = lock_entry_from_installed_c_dep(project_root, name, version)
    if entry.name.len() == 0:
        out.lock = LockFile { entries: [] }
        return out
    out.lock = lock_upsert(move out.lock, entry)
    let meta = runtime_read_file(lock_c_dep_dir(project_root, name, version) ++ "/metadata.json")
    let requirements = lock_json_extract_string_array(meta, "requires")
    for requirement in requirements:
        let req = requirement
        let req_name = lock_ref_name(req)
        let req_version = lock_ref_version(req)
        if req_name.len() == 0 or req_version.len() == 0:
            runtime_eprint("error: unsupported locked Conan requirement reference: " ++ req)
            out.lock = LockFile { entries: [] }
            return out
        out = lock_upsert_installed_c_dep_tree_seen(out, project_root, req_name, req_version)
        if out.lock.entries.len() == 0:
            return out
    out

fn lock_upsert_installed_c_dep_tree(lock: LockFile, project_root: &str, name: &str, version: &str) -> LockFile:
    let walk = LockDepWalk { lock, seen: [] }
    var done = lock_upsert_installed_c_dep_tree_seen(walk, project_root, name, version)
    return move done.lock

fn lock_c_name(entry_name: &str) -> str:
    if entry_name.starts_with("c."):
        return entry_name.slice(2, entry_name.len())
    ""

fn lock_cached_archive_matches(entry: &LockEntry, project_root: &str, dep_dir: &str) -> bool:
    let meta_path = dep_dir ++ "/metadata.json"
    let tgz_path = dep_dir ++ "/conan_package.tgz"
    if runtime_file_exists(meta_path) == 0 or runtime_file_exists(tgz_path) == 0:
        return false
    let actual = lock_sha256_file(tgz_path)
    actual.len() > 0 and actual == entry.sha256

fn lock_restore_entry(project_root: &str, entry: &LockEntry) -> i32:
    if entry.source == "registry":
        runtime_eprint("error: the With package registry is not available yet; cannot restore With package '" ++ entry.name ++ "'")
        runtime_eprint("  With packages (spec §18.8) will come from the With package registry, which is not live yet.")
        runtime_eprint("  Registry progress is tracked at: https://github.com/withlang-dev/with/issues/547")
        return 1
    let c_name = lock_c_name(entry.name)
    if c_name.len() == 0:
        runtime_eprint("error: unsupported lock entry '" ++ entry.name ++ "'")
        return 1
    if entry.source == "system":
        if conan_write_known_system_package(c_name, entry.version, project_root):
            runtime_eprint("restored " ++ entry.name ++ "@" ++ entry.version ++ " (system)")
            return 0
        runtime_eprint("error: unsupported system package in lock file: " ++ entry.name ++ "@" ++ entry.version)
        return 1
    // D121 step 5: a facade rebuilt by the restore uses the registry at the
    // commit the lock pinned.
    conan_set_registry_commit(entry.registry)
    if entry.source == "built":
        if conan_restore_locked_source(c_name, entry.version, entry.sha256, project_root):
            runtime_eprint("restored " ++ entry.name ++ "@" ++ entry.version ++ " (built from source)")
            let dep_dir = lock_c_dep_dir(project_root, c_name, entry.version)
            let actual_opts = lock_json_extract_string_array(runtime_read_file(dep_dir ++ "/metadata.json"), "options").join(",")
            let diff = lock_platform_diff_note(entry, lock_platform_id(), actual_opts)
            if diff.len() > 0: runtime_eprint("  note: " ++ diff)
            return 0
        return 1
    if entry.source != "conan":
        runtime_eprint("error: unsupported lock source '" ++ entry.source ++ "' for " ++ entry.name)
        return 1
    let dep_dir = lock_c_dep_dir(project_root, c_name, entry.version)
    if lock_cached_archive_matches(entry, project_root, dep_dir):
        runtime_eprint("restored " ++ entry.name ++ "@" ++ entry.version ++ " (cached)")
        return 0
    let tgz_path = dep_dir ++ "/conan_package.tgz"
    if runtime_file_exists(tgz_path) != 0:
        let actual = lock_sha256_file(tgz_path)
        runtime_eprint("error: hash mismatch for " ++ entry.name ++ "@" ++ entry.version ++ ": expected " ++ entry.sha256 ++ ", got " ++ actual)
        let _remove = runtime_remove_tree(dep_dir)
        return 1
    if entry.sha256.len() == 0 or entry.recipe_rev.len() == 0 or entry.package_id.len() == 0 or entry.package_rev.len() == 0:
        runtime_eprint("error: incomplete lock entry for " ++ entry.name ++ "@" ++ entry.version)
        return 1
    if conan_restore_locked_binary_package(c_name, entry.version, entry.recipe_rev, entry.package_id, entry.package_rev, entry.sha256, project_root):
        runtime_eprint("restored " ++ entry.name ++ "@" ++ entry.version)
        return 0
    1

fn lock_manifest_has_direct_c_dep(toml: &str, name: &str) -> bool:
    var in_deps = false
    for raw in toml.split("\n"):
        let line = raw.trim()
        if line == "[deps]": in_deps = true
        else if line.starts_with("["): in_deps = false
        else if in_deps and line.starts_with("c." ++ name):
            let rest = line.slice(2 + name.len(), line.len()).trim()
            if rest.starts_with("="): return true
    false

fn lock_restore(project_root: &str) -> i32:
    let path = lock_file_path(project_root)
    if runtime_file_exists(path) == 0:
        runtime_eprint("error: no lock file at .with/lock.json; run 'with get c.<name>' to add dependencies first")
        return 1
    let lock = lock_load(project_root)
    if lock.entries.len() == 0:
        runtime_eprint("error: lock file has no dependencies: .with/lock.json")
        return 1
    let toml = runtime_read_file(project_root ++ "/with.toml")
    conan_set_pinned_options(project_config_c_dep_options_from_toml(toml))
    let platform = lock_platform_id()
    let restore_opts = []
    for entry in lock.entries:
        let c_name = lock_c_name(entry.name)
        if c_name.len() == 0: continue
        let plat_opts = lock_platform_options_for(entry.platform_options, platform)
        if plat_opts.len() == 0: continue
        for opt in plat_opts.split(","):
            if opt.len() > 0: restore_opts.push(c_name ++ ":" ++ opt)
    conan_set_restore_options(restore_opts)
    // Restore built packages whose options vary across platforms first, so if
    // a package falls back to another TLS backend on this platform (e.g.
    // macos openssl -> linux-aarch64 mbedtls, #2757), we know not to restore
    // the other platform's transitive binary backend.
    let switched_away_openssl = []
    let restored_names = []
    for entry in lock.entries:
        if entry.source != "built" or entry.platform_options.len() == 0: continue
        let plat_opts = lock_platform_options_for(entry.platform_options, platform)
        if plat_opts.contains("with_ssl=openssl"): continue
        let rc = lock_restore_entry(project_root, entry)
        if rc != 0: return rc
        restored_names.push(with_str_clone_ref(entry.name))
        let c_name = lock_c_name(entry.name)
        let meta = runtime_read_file(lock_c_dep_dir(project_root, c_name, entry.version) ++ "/metadata.json")
        let actual_opts = lock_json_extract_string_array(meta, "options").join(",")
        if not actual_opts.contains("with_ssl=openssl"):
            for item in entry.platform_options:
                if lock_platform_opt_val(item).contains("with_ssl=openssl"):
                    switched_away_openssl.push(with_str_clone_ref(entry.name))
                    break
    for entry in lock.entries:
        if restored_names.contains(entry.name): continue
        if entry.name == "c.openssl" and entry.source == "conan" and switched_away_openssl.len() > 0 and not lock_manifest_has_direct_c_dep(toml, "openssl"):
            runtime_eprint("  note: skipping " ++ entry.name ++ "@" ++ entry.version ++ " (locked for another platform's TLS backend)")
            continue
        let rc = lock_restore_entry(project_root, entry)
        if rc != 0:
            return rc
    0

// #747: explicit owned copy — LockEntry's fields are owned strs now.
fn lock_entry_clone(e: &LockEntry) -> LockEntry:
    let opts = []
    for item in e.platform_options: opts.push(with_str_clone_ref(item))
    LockEntry { name: with_str_clone_ref(e.name), source: with_str_clone_ref(e.source), version: with_str_clone_ref(e.version), recipe_rev: with_str_clone_ref(e.recipe_rev), package_id: with_str_clone_ref(e.package_id), package_rev: with_str_clone_ref(e.package_rev), sha256: with_str_clone_ref(e.sha256), registry: with_str_clone_ref(e.registry), facts_sha256: with_str_clone_ref(e.facts_sha256), platform_options: opts }

// #2757: whether the lock's entry for `c.<name>` on the current platform
// holds every pinned option in `pinned_for_pkg`.
fn lock_holds_options(lock: &LockFile, name: &str, pinned_for_pkg: &List[str]) -> bool:
    if pinned_for_pkg.len() == 0: return true
    let platform = lock_platform_id()
    for entry in lock.entries:
        if entry.name != "c." ++ name: continue
        let plat_opts = lock_platform_options_for(entry.platform_options, platform)
        if plat_opts.len() == 0: return false
        let have = plat_opts.split(",")
        for want in pinned_for_pkg:
            if not have.contains(want): return false
        return true
    false

// #2355: a with.toml constraint that names one version, not a range
// (`[>=3 <4]`, `^1.2`, ...). Only such a pin can disagree with the lock.
fn lock_pin_is_exact(constraint: &str) -> bool:
    if constraint.len() == 0: return false
    for i in 0..constraint.len():
        let ch = constraint[i]
        if ch == '[' or ch == '<' or ch == '>' or ch == '~' or ch == '^' or ch == '*' or ch == ' ' or ch == ',': return false
    true

// #2355: whether the lock already holds `c.<name>` at `version`. A pin it
// does not hold is installed before a restore, so the lock never overrides
// with.toml.
fn lock_holds_pin(lock: &LockFile, name: &str, version: &str) -> bool:
    for entry in lock.entries:
        if entry.name == "c." ++ name and entry.version == version: return true
    false
