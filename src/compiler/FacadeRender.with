// FacadeRender — D51 §16.2b stages 4-5: a `c facade` block's resources
// rendered as ordinary With (modeled-c-implementation-plan.md).
//
// The Frontend calls facade_render_block after every source file and every
// `<c_import …>` translation is parsed and before Sema, and splices the text
// back in as a second synthetic file, `<facade NAME>`. Sema then sees a plain
// struct with a Drop impl, and collect_c_facades still verifies §61 against
// the same declarations, so a rendering that assumed something false is
// caught there — never silently.
//
// Per pointer or by-value resource `R wraps Repr` with drop `d`, destroyers
// `k…` and a direct-return producer `p`:
//
//     type R { repr: Repr, live: bool }
//     impl Drop for R:
//         move fn drop():
//             if self.live: unsafe { d(self.repr) }
//     impl R:
//         fn l(<args after the representation>) -> <ret>:      // a lend
//             unsafe { l(self.repr, <args>) }
//         move fn k(<args after the representation>) -> <ret>:
//             self.live = false
//             unsafe { k(self.repr, <args>) }
//     fn R.p(<args>) -> Option[R]:                           // one per `from`
//         let repr = unsafe { p(<args>) }
//         if repr == null: None else: Some(R { repr, live: true })
//
// (a by-value representation's producer yields `R` directly; `unsafe` only
// where the callee is raw).
//
// `live` is the Drop arming bit (ruling §13.2): a `move fn` destroyer consumes
// `self`, and With has no spelling that forgets a consumed value's Drop — a
// destroyer that read `self.repr` and let `self` drop destroyed twice (the
// counting test in behav_c_facade_resource_destroys_once.with) — so the
// destroyer clears the bit and Drop checks it, the way std.regex's Regex arms
// its pcre2 free. Stage 4b's in-place resources arm the same bit from `init`.
//
// The rendering is the safe surface of the representation; the C name stays
// raw (SemaFacade.with facade_covers_param: a safe `db_close(d.repr)` would
// destroy through C and let Drop destroy again, §16.2b.5). So each C call
// the rendering makes sits in an inner `unsafe {}` when the callee is raw
// (facade_render_call), and bare when it is not — an `unsafe` block around
// a call that needs none is itself an error. A `*const i8` parameter is presented as `str`:
// the c_import extern lends a `str` to a `const char *` (§16.3c, D47), and
// the resource's constructor passes the `str` straight through.
//
// An in-place resource (`init`) is pinned unless the facade says `movable`
// (spec §16.2b.3, D54): `repr` is a `Box[Repr]` cell the value owns, every
// pointer handed to C is `self.repr.as_mut_ptr()` (`.as_ptr()` for a const
// parameter), and R's own Drop runs the destroyer before the field's Drop
// frees the cell. A `movable` in-place resource, or a by-value token whose
// destroyer takes its address, is handed `&raw mut self.repr` over a
// by-value field. The `init` constructor is facade_render_init below.
//
// The three production forms (spec §16.2b.4, ruling §15): a direct return
// (above), a pointer out-parameter (facade_render_out_producer: NULL slot,
// call, inspect — `(status, Option[R])`), and in-place `init`
// (facade_render_init). With `ok CONST` a status-returning producer is
// projected onto `Result[R, <R>Error]` instead (facade_render_error_type).
// Constructors, destroyers and lend methods are spelled by presentation
// (§16.2b.11, stage 8 below): `Database.open` for `sqlite3_open`, or the
// item's `rename`; the C name where the convention is ambiguous.
//
// A producer that receives other resources produces a dependent resource
// (stage 6, spec §16.2b.6): the received resource is a borrow `&P` of the
// constructor, and the product is an ephemeral struct holding a view of each
// parent it depends on (facade_render_deps below):
//
//     type Statement ephemeral { parent: &Database, repr: *mut st, live: bool }
//     fn Statement.db_prepare(d: &Database, sql: str) -> (c_int, Option[Statement]):
//         var slot: *mut st = null
//         let status = unsafe { db_prepare(d.repr, sql, &raw mut slot) }
//         (status, if slot == null: None else: Some(Statement { parent: d, repr: slot, live: true }))
//
// A dependent resource under `ok` (ruling §18: the error "may" own the
// failure-state resource "where required"): its `<R>Error` never owns the
// child, since an error escapes scopes and a dependent value cannot; a
// failure that still produced is destroyed in the constructor at once, and
// the error is `Failed | NothingProduced` (facade_render_out_producer).
// Nothing is ever rendered as a placeholder: a resource the renderer cannot
// express yields no text, the facade-level diagnostic names it, and Sema's
// verify_facade_resources reports a resource that passed every check without
// becoming a type, or a producer without its constructor.

use Ast
use InternPool
use render
use CImport
use TargetSpec
use Token
use std.collections.HashMap
use std.collections.Minted

// A pinned resource's cell is a `Box` (D54): Resolve makes the facade block
// that declares one this module's import of std.box (the D29 gate), since
// the rendering is spliced after resolution.
fn facade_render_block(pool: &AstPool, intern: &InternPool, facade: i32, ci: &List[i32]):
    var out = ""
    let extra_start = pool.get_data1(facade as NodeId)
    let count = pool.get_data2(facade as NodeId)
    let names: List[str] = []
    let uses: List[FacadeErrorUse] = []
    var name_ops = ""
    for i in 0..count:
        let item = pool.get_extra(extra_start + i)
        if facade_item_is_handle(pool, item):
            out = out ++ facade_render_handle(pool, intern, ci, item)
            continue
        if pool.kind(item as NodeId) == NodeKind.NK_FACADE_MESSAGE:
            out = out ++ facade_render_message(pool, intern, ci, item)
            continue
        if pool.kind(item as NodeId) == NodeKind.NK_FACADE_RESOURCE:
            let text_view = facade_render_text_view(pool, intern, item)
            out = out ++ facade_render_hosted_fn_errors(pool, intern, ci, item)
            // The borrowed view's impl (plain_methods) carries the
            // borrow-returning lends too (D122, D134): a borrow taken
            // through a borrow is one `Borrowed<R>[_]` viewing that borrow.
            let (text, use_of_error) = facade_render_resource(pool, intern, ci, item, facade_render_lend_methods(pool, intern, ci, item, true, false) ++ text_view ++ facade_render_callback_methods(pool, intern, ci, item), facade_render_lend_methods(pool, intern, ci, item, true, false, true) ++ text_view, facade_render_lend_methods(pool, intern, ci, item, false, true))
            out = out ++ text
            let rname = intern.resolve(pool.get_data0(item as NodeId))
            if text.starts_with("type " ++ rname ++ " "): name_ops = name_ops ++ facade_render_imported_name_ops(pool, intern, ci, item)
            names.push(rname)
            uses.push(use_of_error)
    out = out ++ facade_render_unshared_name_ops(name_ops)
    out = out ++ facade_render_shared_error_type(pool, intern, ci, facade, names, uses)
    // Record-view hosts (D122, §16.2b.6): `impl T:` for each record this
    // block's items borrow and no resource wraps, carrying its operations.
    let views = facade_render_record_view_names(pool, intern, facade)
    for view in views:
        let methods = facade_render_record_view_methods(pool, intern, ci, view)
        if methods.len() > 0:
            out = out ++ "impl " ++ view ++ ":\n" ++ methods
    // Free operations (D64): the block's own fn items presented with a
    // buffer pairing or a fixed argument and hosted by no resource.
    out = out ++ facade_render_free_ops(pool, intern, ci, facade)
    facade_render_public(out)

// ── D216: a polled tagged message ───────────────────────────────────
//
// `message Event wraps Ev` with `from ev_poll(out param 0)`, `tag type` and
// its cases renders the open sum and the poll:
//
//     enum Event ephemeral:
//         Key(&KeyEv)
//         Window
//         Other(u32)
//     gen fn Event.poll() -> Event:
//         var raw: Ev
//         while unsafe { ev_poll(&raw mut raw) }:
//             let tag = raw.type_
//             if tag as i64 == EV_KEY as i64: yield Event.Key(&raw.key)
//             else if tag as i64 >= EV_A as i64 and tag as i64 <= EV_B as i64: yield Event.Window
//             else: yield Event.Other(tag)
//
// The record lives in the generator, so a case's view of it is valid for
// the loop body that receives it and no longer; the sum is ephemeral, so it
// cannot be kept past that. Only the shape this function can express is
// rendered (facade_render_message_presentable); Sema names the others.

// The line of kind `kind` in a message item, or 0.
fn facade_render_message_line(pool: &AstPool, item: i32, kind: i32) -> i32:
    let ex = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let line = pool.get_extra(ex + 1 + k)
        if pool.get_data0(line as NodeId) == kind: return line
    0

// A record field under C's own name: as written, or with the trailing
// underscore a With keyword takes on import. (imported name, type text);
// both "" when the record has no such field.
fn facade_render_message_field(pool: &AstPool, intern: &InternPool, record: &str, cname: &str) -> (str, str):
    let direct = facade_render_record_field_type(pool, intern, record, cname)
    if direct.len() > 0: return (with_str_clone_ref(cname), direct)
    let escaped = facade_render_record_field_type(pool, intern, record, cname ++ "_")
    if escaped.len() > 0: return (cname ++ "_", escaped)
    ("", "")

// Whether this renderer presents the message, which Sema's verification
// mirrors (verify_facade_polled_message): its producer is declared, and a
// `release` takes exactly what the producer takes besides the record.
fn facade_render_message_presentable(pool: &AstPool, intern: &InternPool, ci: &List[i32], item: i32) -> bool:
    let from_line = facade_render_message_line(pool, item, FacadeMessageLine.From)
    if from_line == 0 or facade_render_message_line(pool, item, FacadeMessageLine.Tag) == 0: return false
    let ops = pool.get_data1(from_line as NodeId)
    let decl = facade_render_find_fn(pool, intern, ci, pool.get_extra(ops))
    if decl == 0: return false
    let filled = facade_render_param_ref(pool, intern, decl, pool.get_extra(ops + 1))
    let meta = pool.find_fn_meta(decl as NodeId)
    if meta < 0 or filled < 0 or filled >= pool.fn_meta_param_count(meta): return false
    let release_line = facade_render_message_line(pool, item, FacadeMessageLine.Release)
    if release_line == 0: return true
    if facade_render_message_line(pool, item, FacadeMessageLine.Payload) == 0: return false
    let releaser = facade_render_find_fn(pool, intern, ci, pool.get_extra(pool.get_data1(release_line as NodeId)))
    if releaser == 0: return false
    let rmeta = pool.find_fn_meta(releaser as NodeId)
    if rmeta < 0 or pool.fn_meta_param_count(rmeta) != pool.fn_meta_param_count(meta) - 1: return false
    var ri = 0
    for pi in 0..pool.fn_meta_param_count(meta):
        if pi == filled: continue
        if facade_render_param_type(pool, intern, releaser, ri) != facade_render_param_type(pool, intern, decl, pi): return false
        ri += 1
    true

fn facade_render_message(pool: &AstPool, intern: &InternPool, ci: &List[i32], item: i32) -> str:
    if not facade_render_message_presentable(pool, intern, ci, item): return ""
    let name = intern.resolve(pool.get_data0(item as NodeId))
    let ex = pool.get_data1(item as NodeId)
    let record = render_type_expr(pool, intern, pool.get_extra(ex) as NodeId)
    let from_line = facade_render_message_line(pool, item, FacadeMessageLine.From)
    let from_ops = pool.get_data1(from_line as NodeId)
    let decl = facade_render_find_fn(pool, intern, ci, pool.get_extra(from_ops))
    let producer = intern.resolve(pool.get_extra(from_ops))
    let filled = facade_render_param_ref(pool, intern, decl, pool.get_extra(from_ops + 1))
    let tag_line = facade_render_message_line(pool, item, FacadeMessageLine.Tag)
    let (tag_field, tag_type) = facade_render_message_field(pool, intern, record, intern.resolve(pool.get_extra(pool.get_data1(tag_line as NodeId))))
    if tag_field.len() == 0: return ""
    // The poll's parameters are the producer's, the record aside; `release`
    // takes the same ones.
    var params = ""
    var call_args = ""
    var passed = ""
    var raw_pointer_passed = false
    var resource_passed = false
    let release_line = facade_render_message_line(pool, item, FacadeMessageLine.Release)
    for pi in 0..pool.fn_meta_param_count(pool.find_fn_meta(decl as NodeId)):
        if call_args.len() > 0: call_args = call_args ++ ", "
        if pi == filled:
            call_args = call_args ++ "&raw mut raw"
            continue
        let ptype = facade_render_param_type(pool, intern, decl, pi)
        // A message with `release` takes the resource its producer
        // receives `mut`: no other operation on it, a second poll included,
        // runs while the loop does (D216). The C call gets its handle.
        let resource = if release_line != 0: facade_render_resource_wrapping(pool, intern, facade_render_unalias(pool, intern, ptype)) else: ""
        if resource.len() > 0:
            resource_passed = true
            params = params ++ (if params.len() > 0: ", " else: "") ++ f"mut p{pi}: " ++ resource
            passed = passed ++ (if passed.len() > 0: ", " else: "") ++ f"p{pi}.repr"
            call_args = call_args ++ f"p{pi}.repr"
            continue
        if ptype.starts_with("*"): raw_pointer_passed = true
        params = params ++ (if params.len() > 0: ", " else: "") ++ f"p{pi}: " ++ ptype
        passed = passed ++ (if passed.len() > 0: ", " else: "") ++ f"p{pi}"
        call_args = call_args ++ f"p{pi}"
    // The pointer form: the payload's two fields.
    let payload_line = facade_render_message_line(pool, item, FacadeMessageLine.Payload)
    var ptr_field = ""
    var size_field = ""
    if payload_line != 0:
        let pops = pool.get_data1(payload_line as NodeId)
        let (pf, _) = facade_render_message_field(pool, intern, record, intern.resolve(pool.get_extra(pops)))
        let (sf, _) = facade_render_message_field(pool, intern, record, intern.resolve(pool.get_extra(pops + 1)))
        if pf.len() == 0 or sf.len() == 0: return ""
        ptr_field = pf
        size_field = sf
    var cases = ""
    var arms = ""
    var viewers = ""
    for k in 0..pool.get_data2(item as NodeId):
        let line = pool.get_extra(ex + 1 + k)
        if pool.get_data0(line as NodeId) != FacadeMessageLine.Case: continue
        let ops = pool.get_data1(line as NodeId)
        let cname = intern.resolve(pool.get_extra(ops))
        let low = intern.resolve(pool.get_extra(ops + 1))
        let high_sym = pool.get_extra(ops + 2)
        let form = pool.get_extra(ops + 3)
        var carried = ""
        var value = ""
        var test = if high_sym == 0: "tag as i64 == " ++ low ++ " as i64" else: "tag as i64 >= " ++ low ++ " as i64 and tag as i64 <= " ++ intern.resolve(high_sym) ++ " as i64"
        if form == FacadeMessageCase.Member:
            let (member, member_type) = facade_render_message_field(pool, intern, record, intern.resolve(pool.get_extra(ops + 4)))
            if member.len() == 0: return ""
            carried = "(&" ++ member_type ++ ")"
            value = "(&raw." ++ member ++ ")"
        else if form == FacadeMessageCase.Payload:
            if ptr_field.len() == 0: return ""
            // A typed case only when the pointer is non-null, the payload is
            // large enough and the pointer is aligned for the type (D216);
            // anything else is `Other(tag)`.
            let payload_type = render_type_expr(pool, intern, pool.get_extra(ops + 4) as NodeId)
            carried = "(&" ++ payload_type ++ ")"
            test = test ++ " and raw." ++ ptr_field ++ " != null and raw." ++ size_field ++ " as i64 >= sizeof[" ++ payload_type ++ "]() as i64 and (raw." ++ ptr_field ++ " as i64) % (alignof[" ++ payload_type ++ "]() as i64) == 0"
            // The view is taken through a function of the record, so that
            // it is a view of the record: it then ends with the loop body,
            // before the release. Read straight off the raw pointer it would
            // view nothing the checker knows.
            let viewer = "__with_message_" ++ name ++ "_" ++ cname
            viewers = viewers ++ "fn " ++ viewer ++ "(record: &" ++ record ++ ") -> &" ++ payload_type ++ ": unsafe { &*(record." ++ ptr_field ++ " as *const " ++ payload_type ++ ") }\n"
            value = "(" ++ viewer ++ "(&raw))"
        cases = cases ++ "    " ++ cname ++ carried ++ "\n"
        arms = arms ++ "        " ++ (if arms.len() == 0: "if " else: "else if ") ++ test ++ ": yield " ++ name ++ "." ++ cname ++ value ++ "\n"
    if arms.len() == 0: return ""
    // `release f`: after the body returns, however it leaves (a `break`
    // included), before the next poll.
    var release = ""
    if release_line != 0:
        let call = intern.resolve(pool.get_extra(pool.get_data1(release_line as NodeId))) ++ "(" ++ passed ++ ")"
        release = "        defer: " ++ (if raw_pointer_passed or resource_passed: "unsafe { " ++ call ++ " }" else: call) ++ "\n"
    // A message with `release` whose producer receives no resource has
    // nothing a poll could borrow, and a poll begun inside the body of
    // another would release the payload the outer body still views. One
    // flag per message: the second poll panics (D216, Eric 2026-11-25).
    var guard_decl = ""
    var guard = ""
    if release_line != 0 and not resource_passed:
        let flag = "__with_message_" ++ name ++ "_polling"
        guard_decl = "global " ++ flag ++ ": Atomic[i64] = Atomic.new(0)\n"
        guard = "    if " ++ flag ++ ".swap(1, .SeqCst) != 0: panic(\"" ++ name ++ ".poll: a poll of this message is already running, and its release would end the payload that loop is reading\")\n    defer: " ++ flag ++ ".store(0, .SeqCst)\n"
    var out = "enum " ++ name ++ " ephemeral:\n" ++ cases ++ "    Other(" ++ tag_type ++ ")\n" ++ viewers ++ guard_decl
    out = out ++ "gen fn " ++ name ++ ".poll(" ++ params ++ ") -> " ++ name ++ ":\n" ++ guard ++ "    var raw: " ++ record ++ "\n    while unsafe { " ++ producer ++ "(" ++ call_args ++ ") }:\n" ++ release ++ "        let tag = raw." ++ tag_field ++ "\n" ++ arms ++ "        else: yield " ++ name ++ ".Other(tag)\n"
    out

// Two presentations of one function (ruling Amendment 3, §16.2b.11): "An fn
// item may be written more than once when each states a distinct `rename`.
// Each is a presentation with its own fixed parameters." The first item
// keeps the C declaration. Each later one gets a declaration of its own that
// links to the same C symbol,
//
//     @[link_name("sqlite3_exec")]
//     extern fn __with_presented_exec_with__of__sqlite3_exec(…) -> c_int
//
// and is renamed to it, so every rule that reads an fn item by the function
// it names — its contract, its hosting, its fixed parameters, its rendering —
// reads this presentation's own. Returns those declarations as source text
// ("" when the block repeats nothing); a repetition without distinct
// renames is left as written, and Sema refuses it.
fn facade_render_presentation_prefix(): "__with_presented_"

// A diagnostic names such a declaration by the C function it declares:
// `text` with every presentation's declaration name replaced by that
// function's.
fn facade_render_shown_names(text: &str) -> str:
    let prefix = facade_render_presentation_prefix()
    if not text.contains(prefix):
        return text
    let parts = text.split(prefix)
    var out = parts[0]
    for i in 1..parts.len():
        let at = parts[i].find("__of__")
        out = out ++ (if at >= 0: parts[i].slice(at + 6, parts[i].len()) else: prefix ++ parts[i])
    out

// D214: a second presentation of a producer is a producer too (`Mime.new()`
// beside `Mime.from_easy(e)`, both `curl_mime_init`). The resource that
// names the function in a `from` clause gets the same clause for the
// presentation's declaration, so every rule that reads a resource's
// producers reads both.
fn facade_render_alias_producer(work: AstPool, intern: &InternPool, facade: i32, cname: &str, alias: &str):
    let start = work.get_data1(facade as NodeId)
    for i in 0..work.get_data2(facade as NodeId):
        let res = work.get_extra(start + i)
        if work.kind(res as NodeId) != NodeKind.NK_FACADE_RESOURCE:
            continue
        let rstart = work.get_data1(res as NodeId)
        let count = work.get_data2(res as NodeId)
        var from_clause = 0
        for k in 0..count:
            let clause = work.get_extra(rstart + 1 + k)
            if work.get_data0(clause as NodeId) == FACADE_CLAUSE_FROM and intern.resolve(work.get_extra(work.get_data1(clause as NodeId))) == cname: from_clause = clause
        if from_clause == 0:
            continue
        let ops = work.add_extra(intern.intern(alias))
        work.add_extra(work.get_extra(work.get_data1(from_clause as NodeId) + 1))
        let added = work.add_node(NodeKind.NK_FACADE_CLAUSE, work.get_start(from_clause as NodeId), work.get_end(from_clause as NodeId), FACADE_CLAUSE_FROM, ops, 2)
        // Appending moves nothing: the old run is read while the new one grows.
        let moved = work.add_extra(work.get_extra(rstart))
        for k in 0..count: work.add_extra(work.get_extra(rstart + 1 + k))
        work.add_extra(added as i32)
        work.set_data1(res as NodeId, moved)
        work.set_data2(res as NodeId, count + 1)
    work

// Also returns, per declaration emitted, the C name and the presentation's
// name: the caller owns the pool and makes each a producer where the
// function is one (facade_render_alias_producer).
fn facade_render_presentation_aliases(pool: &AstPool, intern: &InternPool, facade: i32, ci: &List[i32]) -> (str, List[i32], List[str]):
    var out = ""
    let presented = []
    // Per declaration emitted, the index of the import's declaration it
    // is another name for.
    let origins: List[i32] = []
    let start = pool.get_data1(facade as NodeId)
    let count = pool.get_data2(facade as NodeId)
    for i in 0..count:
        let item = pool.get_extra(start + i)
        if pool.kind(item as NodeId) != NodeKind.NK_FACADE_FN:
            continue
        let cname = intern.resolve(pool.get_data0(item as NodeId))
        // Every item of this block naming the same function, in order.
        let group: List[i32] = []
        for k in 0..count:
            let other = pool.get_extra(start + k)
            if pool.kind(other as NodeId) == NodeKind.NK_FACADE_FN and intern.resolve(pool.get_data0(other as NodeId)) == cname: group.push(other)
        if group.len() < 2 or group[0] != item:
            continue
        let renames: List[str] = []
        var distinct = true
        for group_item in group:
            let rename = facade_render_item_rename_of(pool, intern, group_item)
            if rename.len() == 0 or renames.contains(rename): distinct = false
            renames.push(rename)
        let decl = facade_render_find_fn(pool, intern, ci, pool.get_data0(item as NodeId))
        let meta = if decl != 0: pool.find_fn_meta(decl as NodeId) else: -1
        if not distinct or meta < 0:
            continue
        var params = ""
        let pstart = pool.fn_meta_param_start(meta)
        for pi in 0..pool.fn_meta_param_count(meta):
            if pi > 0: params = params ++ ", "
            params = params ++ facade_render_param_name(pool, intern, pstart, pi) ++ ": " ++ render_type_expr(pool, intern, pool.fn_param_type(pstart, pi) as NodeId)
        for g in 1..group.len():
            let alias = facade_render_presentation_prefix() ++ renames[g] ++ "__of__" ++ cname
            out = out ++ "@[link_name(\"" ++ cname ++ "\")]\nextern fn " ++ alias ++ "(" ++ params ++ ")" ++ facade_render_return(pool, intern, decl) ++ "\n"
            pool.set_data0(group[g] as NodeId, intern.intern(alias))
            presented.push(cname.to_owned())
            presented.push(alias)
            for di in 0..pool.decl_count():
                if pool.get_decl(di) as i32 == decl: origins.push(di)
    (out, origins, presented)

// The `rename` an fn item itself states, or "".
fn facade_render_item_rename_of(pool: &AstPool, intern: &InternPool, item: i32) -> str:
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) == FACADE_CLAUSE_RENAME: return intern.resolve(pool.get_extra(pool.get_data1(clause as NodeId)))
    ""

// `message <fn>` (ruling Amendment 3, §16.2b.4): how one of `resource`'s
// methods reads the text of its most recent failure — the text view the
// clause names, on the resource itself or on the one parent it holds — or
// "" when the resource states none (Sema refuses a clause that is neither).
fn facade_render_message_call(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32) -> str:
    var named: i32 = 0
    let extra_start = pool.get_data1(resource as NodeId)
    for k in 0..pool.get_data2(resource as NodeId):
        let clause = pool.get_extra(extra_start + 1 + k)
        if pool.get_data0(clause as NodeId) == FACADE_CLAUSE_MESSAGE: named = pool.get_extra(pool.get_data1(clause as NodeId))
    if named == 0:
        return ""
    let decl = facade_render_find_fn(pool, intern, ci, named)
    if decl == 0:
        return ""
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0:
        return ""
    let li = facade_render_lend_item(pool, intern, ci, item)
    let fname = intern.resolve(named)
    let own_repr = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.get_extra(pool.get_data1(resource as NodeId)) as NodeId))
    if facade_render_lend_hosted(pool, intern, li, resource, own_repr):
        return "self." ++ facade_render_present(pool, intern, ci, resource, fname) ++ "()"
    for parent in facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE):
        if parent == resource:
            continue
        let parent_repr = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.get_extra(pool.get_data1(parent as NodeId)) as NodeId))
        if not facade_render_lend_hosted(pool, intern, li, parent, parent_repr):
            continue
        let field = facade_render_parent_field(pool, intern, ci, resource, intern.resolve(pool.get_data0(parent as NodeId)))
        if field.len() > 0:
            return "self." ++ field ++ "." ++ facade_render_present(pool, intern, ci, parent, fname) ++ "()"
    ""

// The same text for a producer received through a parent (ruling Amendment
// 3: `sqlite3_prepare_v2(db, …)` is an operation on the connection, so a
// failed prepare carries the connection's message): the parent's message
// call, read through the producer's first parameter. "" when the producer
// has no receiver or the receiver states no `message`.
fn facade_render_producer_message_call(pool: &AstPool, intern: &InternPool, ci: &List[i32], producer: i32) -> str:
    let parent = facade_render_receiver(pool, intern, producer)
    let meta = pool.find_fn_meta(producer as NodeId)
    if parent <= 0 or meta < 0:
        return ""
    let call = facade_render_message_call(pool, intern, ci, parent)
    if not call.starts_with("self."):
        return ""
    facade_render_param_name(pool, intern, pool.fn_meta_param_start(meta), 0) ++ call.slice(4, call.len())

// The `<Fn>Error` types of the resource's lend methods that present a
// copied-back length under `ok` (D64): declared beside the resource, since
// an error type cannot live inside its impl.
fn facade_render_hosted_fn_errors(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32):
    let repr_text = render_type_expr(pool, intern, pool.get_extra(pool.get_data1(resource as NodeId)) as NodeId)
    let repr = facade_render_unalias(pool, intern, repr_text)
    var out = facade_render_drop_helper(pool, intern, ci, resource)
    // The abandonment path's helper, when `abandon f(param N)` or fixed
    // parameters need one.
    let cstart = pool.get_data1(resource as NodeId)
    for k in 1..pool.get_data2(resource as NodeId) + 1:
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_ABANDON: continue
        let abandon_fn = facade_render_find_fn(pool, intern, ci, pool.get_extra(pool.get_data1(clause as NodeId)))
        if abandon_fn != 0 and (facade_render_destroyer_at(pool, intern, resource, abandon_fn) != 0 or facade_render_param_count(pool, abandon_fn) > 1):
            out = out ++ facade_render_abandon_helper(pool, intern, resource, abandon_fn)
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_FN)
    for item in items:
        let li = facade_render_lend_item(pool, intern, ci, item)
        if not li.bridged or li.variadic != 0 or li.text_view or li.borrow_res != 0 or not facade_render_lend_hosted(pool, intern, li, resource, repr):
            continue
        let at = facade_render_lend_at(pool, intern, li)
        let bridge = if at == 0: facade_render_bridge(pool, intern, li.decl, 1, -1, "") else: facade_render_bridge(pool, intern, li.decl, 0, at, "self.repr")
        let fname = intern.resolve(pool.get_data0(li.decl as NodeId))
        // D210: the record a field-paired operation returns.
        if bridge.ok: out = out ++ facade_render_step_type(pool, intern, li.decl, intern.resolve(pool.get_data0(resource as NodeId)), facade_render_present(pool, intern, ci, resource, fname))
        if not bridge.ok or facade_render_fn_oks(pool, intern, li.decl).len() == 0:
            continue
        out = out ++ facade_render_fn_error_type(pool, intern, li.decl, facade_render_present(pool, intern, ci, resource, fname), facade_render_message_call(pool, intern, ci, resource).len() > 0)
    // A variadic operation hosted here with `ok CONST` (D242, #3128): every
    // listed case presents a `Result` (`Result[T, E]` for `fills T`,
    // `Result[Unit, E]` for all other cases).
    for item in items:
        let li = facade_render_lend_item(pool, intern, ci, item)
        if li.variadic == 0 or li.decl == 0 or not facade_render_lend_hosted(pool, intern, li, resource, repr) or facade_render_fn_ok(pool, intern, li.decl) == 0: continue
        out = out ++ facade_render_fn_error_type(pool, intern, li.decl, facade_render_present(pool, intern, ci, resource, intern.resolve(pool.get_data0(li.decl as NodeId))), facade_render_message_call(pool, intern, ci, resource).len() > 0)
    // A callback operation hosted here (`db.exec(sql, callback, userdata)`).
    for item in items:
        let cbi = facade_render_callback_item(pool, intern, ci, item)
        if cbi.decl == 0 or not facade_render_callback_hosted(pool, intern, cbi, resource, repr) or facade_render_fn_oks(pool, intern, cbi.decl).len() == 0:
            continue
        let fname = intern.resolve(pool.get_data0(cbi.decl as NodeId))
        out = out ++ facade_render_fn_error_type(pool, intern, cbi.decl, facade_render_present(pool, intern, ci, resource, fname), facade_render_message_call(pool, intern, ci, resource).len() > 0)
    out

// Everything a facade renders is its module's public surface (spec
// §16.2b.1: a facade is written in the importing project or shipped by a
// package, and its resource types are used wherever the module is
// imported — the SQLite facade lives in its own module, stage 12): every
// rendered type, error, constructor and method is `pub`. A Drop body is
// the type's own and stays as it is.
fn facade_render_public(text: &str):
    var out = ""
    var in_drop = false
    var start = 0
    while start < text.len():
        var end = start
        while end < text.len() and text[end] != '\n': end = end + 1
        let line = text.slice(start, end)
        // A generic impl (`impl[Origin] BorrowedR[Origin]:`, D134) is an
        // impl too.
        if line.starts_with("impl Drop for ") or line.starts_with("impl[Origin] Drop for ") or line.starts_with("impl Deref["): in_drop = true
        else if line.starts_with("impl ") or line.starts_with("impl["): in_drop = false
        var shown = line
        if line.starts_with("type ") or line.starts_with("error ") or line.starts_with("fn "):
            shown = "pub " ++ line
        else if not in_drop and (line.starts_with("    fn ") or line.starts_with("    mut fn ") or line.starts_with("    move fn ")):
            shown = "    pub " ++ line.slice(4, line.len())
        out = out ++ shown ++ (if end < text.len(): "\n" else: "")
        start = end + 1
    out

// Owned foreign text (ruling §42, spec §16.2b.8: "Caller-owned returned
// memory is a resource … It exposes a borrowed `CStr` view"): a pointer
// resource whose representation is a C string — `*mut c_char`, `*const
// c_char`, strdup's `*mut i8` — carries
//
//     fn as_cstr() -> CStr: unsafe { CStr.from_ptr(self.repr as *const c_char) }
//
// a view of the bytes the resource owns, ephemeral like every `CStr`, and
// kept inside the resource's life by the declared summary Sema puts on it
// (SemaFacade.with verify_facade_text_views). The foreign allocator pairing is
// untouched: the view copies nothing, and `to_owned` is the explicit copy.
fn facade_render_text_view(pool: &AstPool, intern: &InternPool, resource: i32) -> str:
    let repr = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.get_extra(pool.get_data1(resource as NodeId)) as NodeId))
    if not facade_render_is_c_string_ptr(repr):
        return ""
    "    fn as_cstr() -> CStr: unsafe { CStr.from_ptr(self.repr as *const c_char) }\n"

// A callback-scope handle (§16.2b.9, ruling Amendment 1, #1611): "A foreign
// representation that exists only for a callback's invocation … Nothing
// produces or destroys it, it has no `Drop`, and it is borrowed for the
// callback's scope and cannot outlive it. Operations stated `of` the handle
// are its methods, so a callback body calls them safely." It renders as the
// representation alone in an ephemeral struct — no `live` bit, no Drop, no
// constructor — with the lends hosted on it (stated `of` it, or on a
// representation it alone wraps, as for a resource):
//
//     type Context ephemeral { repr: *mut sqlite3_context }
//     impl Context:
//         fn result_int(v: c_int): unsafe { sqlite3_result_int(self.repr, v) }
//
// A value of it exists only as the argument C passes a callback
// (facade_render_handle_callback_type), and ephemerality is what keeps it
// inside the callback: the ordinary analysis (§5, §22) refuses it in global
// or heap storage, in a non-ephemeral struct, or in anything that outlives
// the call. Sema refuses a literal of it outside this rendering, so nothing
// else produces one (SemaCheck.with check_struct_literal).
fn facade_render_handle(pool: &AstPool, intern: &InternPool, ci: &List[i32], item: i32) -> str:
    let name = intern.resolve(pool.get_data0(item as NodeId))
    let repr_text = render_type_expr(pool, intern, pool.get_extra(pool.get_data1(item as NodeId)) as NodeId)
    // A representation that is not a pointer is Sema's error
    // (verify_facade_handle); nothing is rendered for it.
    if not facade_render_unalias(pool, intern, repr_text).starts_with("*"):
        return ""
    var out = "type " ++ name ++ " ephemeral { repr: " ++ repr_text ++ " }\n"
    // A vector of it a callback is passed (D76): the slice the generated
    // wrapper makes of C's `T **` and count (facade_render_wrapper).
    if facade_render_handle_sliced(pool, intern, name):
        out = out ++ "type " ++ facade_render_slice_alias(name) ++ " = []" ++ name ++ "\n"
    let methods = facade_render_lend_methods(pool, intern, ci, item, true, false)
    if methods.len() == 0:
        return out
    out ++ "impl " ++ name ++ ":\n" ++ methods

// The handle that alone wraps the (unaliased) representation `repr`, or "".
fn facade_render_handle_for(pool: &AstPool, intern: &InternPool, repr: &str) -> str:
    var found = ""
    var n = 0
    for item in facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE):
        if not facade_item_is_handle(pool, item):
            continue
        let r = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.get_extra(pool.get_data1(item as NodeId)) as NodeId))
        if r == repr:
            let hname = intern.resolve(pool.get_data0(item as NodeId))
            found = hname
            n = n + 1
    if n == 1: found else: ""

// The callable type `text` with each parameter C passes as a handle's
// representation presented as the handle (§16.2b.9): C's
// `extern "C" fn(*mut sqlite3_context, c_int, *mut *mut sqlite3_value)` is
// `extern "C" fn(Context, c_int, *mut *mut sqlite3_value)`. The handle is a
// struct of the one pointer, which each C ABI With targets passes exactly as
// the pointer (Codegen.with c_abi_direct_struct_param_type: a composite of at
// most 16 bytes in a general register on AAPCS64, one INTEGER eightbyte on
// SysV x86_64, an 8-byte aggregate as an integer on Win64; elsewhere LLVM
// splits the one-element aggregate into its element), so the presented
// callback is transmuted to C's type and C calls it unchanged. A
// pointer to a representation (`sqlite3_value **`) is not the handle and
// stays as C declares it; so does a representation several handles wrap.
// Returns `text` itself when no parameter is a handle's.
fn facade_render_handle_callback_type(pool: &AstPool, intern: &InternPool, text: &str) -> str:
    // The presented callback is safe With (a safe extern fn passes where C
    // declares an unsafe one, as for the typed callback).
    let raw = facade_render_callback_raw_type(facade_render_unalias(pool, intern, text))
    if not facade_render_is_callable_type(raw):
        return text
    let (head, parts, tail) = facade_render_callable_parts(raw)
    if head.len() == 0:
        return text
    var out = ""
    var changed = false
    for j in 0..parts.len():
        let handle = facade_render_handle_for(pool, intern, facade_render_unalias(pool, intern, parts[j]))
        if handle.len() > 0: changed = true
        out = out ++ (if j > 0: ", " else: "") ++ (if handle.len() > 0: handle else: parts[j])
    if not changed:
        return text
    head ++ out ++ tail

// A NUL-terminated C string's pointer type as c_import spells it, aliases
// chased: `char *` is `*mut i8`, `const char *` is `*const i8`.
fn facade_render_is_c_string_ptr(text: &str):
    text == "*mut i8" or text == "*const i8" or text == "*mut c_char" or text == "*const c_char"

fn facade_render_text_view_name(): "as_cstr"

// A lend operation on a pointer or in-place resource, rendered as a `&self`
// method of the resource (§16.2b.5: "once a resource is modeled, its
// facade-exposed operations borrow it"; With proves the receiver live,
// unmoved and undestroyed, which it cannot prove of a raw pointer — so the C
// name stays raw, SemaFacade.with facade_covers_param). An fn item whose first
// parameter takes the representation — a pointer resource's handle, or the
// address of an in-place resource's storage — of exactly one resource of
// any block, or the one its `of` names (§16.2b.3), and that states nothing
// stronger than a lend (`lend`, `of`, `rename`, `preserves`) becomes
//
//     impl R:
//         fn <presented name>(<args after the representation>) -> <ret>:
//             unsafe { <name>(self.repr, <args>) }
//
// under its presented name (facade_render_present: the C name less the
// representation's prefix, or its `rename`). A pinned resource hands C its
// cell's address; a movable one the address of its field, which through a
// mutable pointer is a `mut fn`. Anything else stays as stated: a
// consuming, destroying or retaining item is not a lend, a by-value token
// is not recognized by its type, and an item describing a resource's own
// producer, initializer or destroyer adds facts to that operation.
//
// `failed_only` (stage 12b, #1612; spec §16.2b.4, ruling Amendment 1): the
// operations the facade marks `valid on failed` — lends, text views and
// record views — rendered on the failed-state type `Failed<R>`, the same
// body over the same `repr` field, and nothing else (a borrowed-resource
// return holds a view of a live `R`; Sema refuses the mark on one).
// `for_view`: the text is the borrowed view's impl (`BorrowedR[Origin]`),
// where `self` is the view and a borrow taken through it views the view
// (D122, D134); a parent borrow (D85) reads a field the view lacks and is
// not rendered there.
fn facade_render_lend_methods(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32, with_borrowed_returns: bool, failed_only: bool, for_view: bool = false):
    let repr_text = render_type_expr(pool, intern, pool.get_extra(pool.get_data1(resource as NodeId)) as NodeId)
    let repr = facade_render_unalias(pool, intern, repr_text)
    let in_place = not repr.starts_with("*") and facade_render_has_clause(pool, resource, FACADE_CLAUSE_INIT)
    let pinned = in_place and not facade_render_has_clause(pool, resource, FACADE_CLAUSE_MOVABLE)
    var out = ""
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_FN)
    for item in items:
        let li = facade_render_lend_item(pool, intern, ci, item)
        if not facade_render_lend_hosted(pool, intern, li, resource, repr):
            continue
        // A `detaches` item is a move method of the borrowed view (D134,
        // facade_render_detach_methods), never a lend.
        if li.detaches != 0:
            continue
        if failed_only and (not li.valid_on_failed or (li.borrow_res != 0 and not li.record_view)):
            continue
        let decl = li.decl
        let meta = pool.find_fn_meta(decl as NodeId)
        let fname = intern.resolve(pool.get_data0(decl as NodeId))
        let mname = facade_render_present(pool, intern, ci, resource, fname)
        // How `self` reaches C: the handle, the pinned cell's address, or
        // the address of a movable representation — which a mutable
        // pointer writes through, so that lend is a `mut fn`.
        let at = facade_render_lend_at(pool, intern, li)
        let repr_arg = facade_render_repr_arg_at(pool, intern, decl, at, repr_text, "self.repr", pinned)
        if repr_arg.len() == 0:
            continue
        let head = if repr_arg.starts_with("&raw mut "): "    mut fn " else: "    fn "
        let bridge = if at == 0: facade_render_bridge(pool, intern, decl, 1, -1, "") else: facade_render_bridge(pool, intern, decl, 0, at, repr_arg)
        if not bridge.ok:
            continue
        let params = bridge.params
        let gen = if bridge.generics.len() > 0: "[" ++ bridge.generics ++ "]" else: ""
        let args = bridge.args
        let pro = facade_render_indent(bridge.prologue, "        ")
        let call_args = if at != 0: args else if args.len() > 0: repr_arg ++ ", " ++ args else: repr_arg
        if li.text_view:
            // `returns borrow CStr from …` / `returns static CStr` (ruling
            // §32, §40, §41; spec §16.2b.8): the nullable foreign string is
            // `Option[CStr]` — the `CStr` value is the borrowed modeled text,
            // a view (Sema.with: `CStr` is ephemeral) — over the same bytes, no
            // copy; NULL is `None` (unknown nullability is nullable, §43).
            // What keeps it inside its origin — the resource `self`, a C
            // string parameter, a domain, or nothing for static — is the
            // declared summary Sema puts on this method
            // (SemaFacade.with verify_facade_borrowed_returns).
            let handle = facade_render_fresh("repr", facade_render_param_names(pool, intern, decl))
            out = out ++ head ++ mname ++ gen ++ "(" ++ params ++ ") -> Option[CStr]:\n" ++ pro ++ "        let " ++ handle ++ " = " ++ facade_render_call(pool, intern, decl, call_args) ++ "\n        if " ++ handle ++ " == null: None else: Some(unsafe { CStr.from_ptr(" ++ handle ++ " as *const c_char) })\n"
            continue
        if li.variadic != 0:
            // A variadic contract (D66, §16.2b.5): one method per case,
            // `<name>__<CONST>`; Sema retargets the presented call to the
            // case its selector picks (facade_render_variadic_cases). With
            // `present cases` (D242, #3128), also one typed per-option method.
            let msg_call = facade_render_message_call(pool, intern, ci, resource)
            let blocked = facade_render_surface_blocked_names(pool, intern, ci, resource, fname)
            out = out ++ facade_render_variadic_cases(pool, intern, decl, li.variadic, li.present_cases, head, mname, mname, repr_arg, 1, "        ", msg_call, blocked)
            continue
        if li.record_view:
            // `returns borrow T from …` for an imported record T (D66,
            // §16.2b.6): `Option[&T]`, a view of the record C points at —
            // NULL is `None` — kept inside its origin by the declared
            // summary Sema puts on this method (verify_facade_record_return)
            // or, from a domain, by the call effect (facade_index_call_effects).
            let view = facade_render_record_view_type(pool, intern, decl)
            if view.len() == 0:
                continue
            let handle = facade_render_fresh("repr", facade_render_param_names(pool, intern, decl))
            out = out ++ head ++ mname ++ gen ++ "(" ++ params ++ ") -> Option[" ++ view ++ "]:\n" ++ pro ++ "        let " ++ handle ++ " = " ++ facade_render_call(pool, intern, decl, call_args) ++ "\n        if " ++ handle ++ " == null: None else: Some(unsafe { " ++ handle ++ " as " ++ view ++ " })\n"
            continue
        if li.borrow_res != 0:
            if not with_borrowed_returns:
                continue
            // `returns borrow R from param N` (ruling §26): the result is a
            // `Borrowed<R>` — no Drop, dependent on the parameter named —
            // and, unknown nullability being nullable (§16.2b.8), an Option
            // of it (facade_render_borrowed_type).
            let from = facade_render_param_ref(pool, intern, decl, li.borrow_from)
            if from < 0:
                continue
            if for_view and li.borrow_parent != 0:
                continue
            // A borrow through a borrow is a borrow of the same origin
            // (D122, D134): in the view's impl the result views the view's
            // origin, never the view (a view of a view would nest the
            // origin type once per call, and instantiation would not end).
            var origin = if from == 0: (if for_view: "self.origin" else: "self") else: facade_render_param_name(pool, intern, pool.fn_meta_param_start(meta), from)
            // The origin's type, spelled so Sema's view-of-param facts read
            // the declared result (D134): the host (the view's origin, in
            // the view's impl), the parameter's resource, or the parent.
            let host_name = intern.resolve(pool.get_data0(resource as NodeId))
            var otype = if for_view: "Origin" else: host_name
            if li.borrow_parent != 0: otype = intern.resolve(li.borrow_parent)
            else if from != 0:
                let arg_res = facade_render_received(pool, intern, render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(meta), from) as NodeId))
                if arg_res <= 0:
                    continue
                if facade_render_is_borrow_only_resource(pool, arg_res):
                    origin = origin ++ ".origin"
                    otype = f"__FO{from}"
                else:
                    otype = intern.resolve(pool.get_data0(arg_res as NodeId))
            // `returns borrow R from parent R of param N` (D85, §16.2b.6):
            // the borrow holds the parent the argument's resource holds —
            // its `parent` view — so it views the parent's origin, not the
            // argument. A shape with no one parent field renders nothing;
            // Sema names it (verify_facade_parent_borrow).
            if li.borrow_parent != 0:
                let arg_res = facade_render_received(pool, intern, render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(meta), from) as NodeId))
                if arg_res <= 0:
                    continue
                let pfield = facade_render_parent_field(pool, intern, ci, arg_res, intern.resolve(li.borrow_parent))
                if pfield.len() == 0:
                    continue
                origin = origin ++ "." ++ pfield
            let bname = facade_render_borrowed_name(intern.resolve(li.borrow_res))
            let handle = facade_render_fresh("repr", facade_render_param_names(pool, intern, decl))
            let ret_ty = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.fn_meta_ret(meta) as NodeId))
            if not ret_ty.starts_with("*"):
                out = out ++ head ++ mname ++ gen ++ "(" ++ params ++ ") -> " ++ bname ++ "[" ++ otype ++ "]:\n" ++ pro ++ "        let " ++ handle ++ " = " ++ facade_render_call(pool, intern, decl, call_args) ++ "\n        " ++ bname ++ " { origin: " ++ origin ++ ", repr: " ++ handle ++ " }\n"
            else:
                out = out ++ head ++ mname ++ gen ++ "(" ++ params ++ ") -> Option[" ++ bname ++ "[" ++ otype ++ "]]:\n" ++ pro ++ "        let " ++ handle ++ " = " ++ facade_render_call(pool, intern, decl, call_args) ++ "\n        if " ++ handle ++ " == null: None else: Some(" ++ bname ++ " { origin: " ++ origin ++ ", repr: " ++ handle ++ " })\n"
            continue
        if li.text_free != 0:
            let text_ret = facade_render_text_return(pool, intern, ci, decl, facade_render_call(pool, intern, decl, call_args), li.text_free, facade_render_text_utf8(pool) and not li.text_bytes, "        ", pro)
            if text_ret.len() > 0: out = out ++ head ++ mname ++ gen ++ "(" ++ params ++ ")" ++ text_ret
            continue
        if facade_render_field_buffers(pool, intern, decl).len() > 0 and not facade_render_field_buffers_ok(pool, intern, decl): continue
        if facade_render_field_buffers(pool, intern, decl).len() > 0:
            out = out ++ facade_render_field_buffer_method(pool, intern, decl, intern.resolve(pool.get_data0(resource as NodeId)), head, mname, repr_arg, bridge, if failed_only: "" else: facade_render_message_call(pool, intern, ci, resource))
            continue
        let (ret, body) = facade_render_bridge_body(pool, intern, decl, bridge, facade_render_call(pool, intern, decl, call_args), mname, "        ", if failed_only: "" else: facade_render_message_call(pool, intern, ci, resource))
        out = out ++ head ++ mname ++ gen ++ "(" ++ params ++ ")" ++ ret ++ ":\n" ++ pro ++ body
    out

// The names of a rendered parameter list, as arguments: `a: A, mut b: B`
// is `a, b`. A comma inside a type's brackets is not a separator.
fn facade_render_forward_names(params: &str):
    var out = ""
    var depth = 0
    var start = 0
    var i = 0
    while i <= params.len():
        if i < params.len():
            let c = params[i]
            if c == '[' or c == '(' or c == '{': depth = depth + 1
            else if c == ']' or c == ')' or c == '}': depth = depth - 1
            if c != ',' or depth != 0:
                i = i + 1
                continue
        let part = params.slice(start, i).trim()
        start = i + 1
        i = i + 1
        if part.len() == 0: continue
        let bare = if part.starts_with("mut "): part.slice(4, part.len()) else: part
        let colon = bare.find(":")
        out = out ++ (if out.len() > 0: ", " else: "") ++ (if colon < 0: bare else: bare.slice(0, colon)).trim()
    out

// D198 (§16.2b.5, §16.2b.11): a by-value token's record holds a pointer, so
// its C functions are pointer-parameter functions and raw; the resource is
// what models the type. Its operations are presented under their imported
// names too, over the resource — the same operations, not a second surface:
//
//     fn __with_facade_LoadImageFromScreen() -> LoadedImage: LoadedImage.from_screen()
//     fn __with_facade_GetImageColor(facade_self: &LoadedImage, x: i32, y: i32) -> Color: facade_self.get_color(x, y)
//     fn __with_facade_UnloadImage(facade_self: LoadedImage): the value ends here, and Drop is the destroyer
//
// A call of the C name is redirected to the rendering (Sema
// facade_bridge_redirect), as a D64 bridge's is. Direct-return producers,
// plain lends and the `drop` are presented this way; an operation whose
// result is a view keeps its method alone.
// §16.2b.4: the field a by-value producer states (`from F, nullable field
// a.b`), as (word, "a.b"): the word is `nullable` or `nonnull`, "" when the
// producer states none.
fn facade_render_produced_field(pool: &AstPool, intern: &InternPool, resource: i32, producer_name: &str) -> (str, str):
    let extra_start = pool.get_data1(resource as NodeId)
    for k in 0..pool.get_data2(resource as NodeId):
        let clause = pool.get_extra(extra_start + 1 + k)
        if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_PRODUCED_FIELD: continue
        let ops = pool.get_data1(clause as NodeId)
        if intern.resolve(pool.get_extra(ops)) != producer_name: continue
        var path = ""
        for s in 2..pool.get_data2(clause as NodeId):
            path = path ++ (if s > 2: "." else: "") ++ intern.resolve(pool.get_extra(ops + s))
        return (intern.resolve(pool.get_extra(ops + 1)), path)
    ("", "")

// D215: a C name means one modeled operation. A function two resources
// describe (`db_close` the drop of `Database` and of `Shared`) has two, so
// its name is rendered for neither and a call by it stays the raw call the
// error explains. `ops` is every resource's forwarders: each begins at a
// line `fn <name>(` and runs to the next.
fn facade_render_unshared_name_ops(ops: &str):
    let lines = ops.split("\n")
    let seen: HashMap[str, i32] = [:]
    for line in lines:
        if line.starts_with("fn "): seen.increment(line.slice(3, line.find("(")).to_owned())
    var out = ""
    var keep = true
    // D215: a function more than one resource names as its drop consumes
    // whichever of those resources it is given. Its forwarders (each `fn
    // NAME(facade_self: R):` over one line that ends the value) become one
    // function over the resources that name it.
    let enders: HashMap[str, str] = [:]
    let mixed: HashMap[str, i32] = [:]
    var li = 0
    while li < lines.len():
        let line = lines[li]
        if line.starts_with("fn ") and (seen.get(line.slice(3, line.find("("))) ?? &0) > 1:
            let name = line.slice(3, line.find("(")).to_owned()
            let head = "fn " ++ name ++ "(facade_self: "
            let is_end = line.starts_with(head) and line.ends_with("):") and li + 1 < lines.len() and lines[li + 1] == "    let facade_ended = facade_self"
            if is_end:
                let resource = line.slice(head.len(), line.len() - 2)
                enders.insert(name, (enders.get(name) ?? &"") ++ resource ++ "\n")
            else: mixed.insert(name, 1)
        li += 1
    let emitted: HashMap[str, i32] = [:]
    for line in lines:
        if line.starts_with("fn "):
            let name = line.slice(3, line.find("(")).to_owned()
            keep = (seen.get(name) ?? &0) == 1
            if not keep and enders.contains(name) and not mixed.contains(name) and not emitted.contains(name):
                emitted.insert(name, 1)
                let marker = "EndedBy_" ++ name.slice(facade_render_bridge_name("").len(), name.len())
                out = out ++ "trait " ++ marker ++ " {}\n"
                for resource in enders.get(name).unwrap().split("\n"):
                    if resource.len() > 0: out = out ++ "impl " ++ marker ++ " for " ++ resource ++ "\n"
                out = out ++ "fn " ++ name ++ "[T: " ++ marker ++ "](facade_self: T):\n    let facade_ended = facade_self\n"
        if keep and line.len() > 0: out = out ++ line ++ "\n"
    out

// Whether a C function's first parameter is `void *` (of either constness).
fn facade_render_first_param_is_void_ptr(pool: &AstPool, intern: &InternPool, decl: i32) -> bool:
    let meta = pool.find_fn_meta(decl as NodeId)
    if meta < 0 or pool.fn_meta_param_count(meta) == 0: return false
    let text = render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(meta), 0) as NodeId)
    text == "*mut c_void" or text == "*const c_void"

// Whether an fn item states a clause of `kind` (an item's clauses start at
// its first extra; a resource's follow its representation).
fn facade_render_item_has_clause(pool: &AstPool, item: i32, kind: i32) -> bool:
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        if pool.get_data0(pool.get_extra(cstart + k) as NodeId) == kind: return true
    false

fn facade_render_imported_name_ops(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32):
    let name = intern.resolve(pool.get_data0(resource as NodeId))
    let extra_start = pool.get_data1(resource as NodeId)
    let repr_text = render_type_expr(pool, intern, pool.get_extra(extra_start) as NodeId)
    let repr = facade_render_unalias(pool, intern, repr_text)
    // Rendered for every by-value token. Whether a call of the imported
    // name means the rendering is Sema's to say: it does when the token's
    // record holds a pointer, and a token that holds none (`Fd wraps
    // c_int`) keeps its C functions as they are
    // (SemaFacade.facade_index_imported_name_ops).
    // D215: a described function's C name is its modeled operation for
    // every representation: by value, a pointer, initialized in place.
    var out = ""
    for k in 0..pool.get_data2(resource as NodeId):
        let clause = pool.get_extra(extra_start + 1 + k)
        let kind = pool.get_data0(clause as NodeId)
        let ops = pool.get_data1(clause as NodeId)
        if kind == FACADE_CLAUSE_FROM and pool.get_extra(ops + 1) == 0:
            let producer = facade_render_find_fn(pool, intern, ci, pool.get_extra(ops))
            if producer == 0: continue
            let cname = intern.resolve(pool.get_data0(producer as NodeId))
            let (cidx, nstat) = facade_render_consuming_same_producer(pool, intern, resource, producer)
            if cidx >= 0 and nstat != 0:
                let cbridge = facade_render_bridge(pool, intern, producer, 0, cidx, "facade_self.repr")
                if not cbridge.ok: continue
                let head = if cbridge.params.len() > 0: "facade_self: " ++ name ++ ", " ++ cbridge.params else: "facade_self: " ++ name
                out = out ++ "fn " ++ facade_render_bridge_name(cname) ++ "(" ++ head ++ "):\n    facade_self." ++ facade_render_present(pool, intern, ci, resource, cname) ++ "(" ++ facade_render_forward_names(cbridge.params) ++ ")\n"
                continue
            let bridge = facade_render_bridge(pool, intern, producer, 0, -1, "")
            if not bridge.ok: continue
            let made = if facade_render_produced_field(pool, intern, resource, cname).0 == "nullable": "Option[" ++ name ++ "]" else: with_str_clone_ref(name)
            // A pointer resource's constructor states its own result (an
            // Option for a nullable producer, a Result for a failing one):
            // the forwarder's result is the constructor's, inferred (§9.1).
            let result = if repr.starts_with("*"): "" else: " -> " ++ made
            out = out ++ "fn " ++ facade_render_bridge_name(cname) ++ "(" ++ bridge.params ++ ")" ++ result ++ ":\n    " ++ name ++ "." ++ facade_render_present(pool, intern, ci, resource, cname) ++ "(" ++ facade_render_forward_names(bridge.params) ++ ")\n"
        else if kind == FACADE_CLAUSE_INIT and not facade_render_has_clause(pool, resource, FACADE_CLAUSE_PREINIT):
            // D215: an in-place producer by its C name takes the modeled
            // argument list; the storage slot is what the contract removes.
            let init_fn = facade_render_find_fn(pool, intern, ci, pool.get_extra(ops))
            if init_fn == 0: continue
            let cname = intern.resolve(pool.get_data0(init_fn as NodeId))
            let (iparams, _) = facade_render_params(pool, intern, init_fn, 1)
            out = out ++ "fn " ++ facade_render_bridge_name(cname) ++ "(" ++ iparams ++ "):\n    " ++ name ++ "." ++ facade_render_present(pool, intern, ci, resource, cname) ++ "(" ++ facade_render_forward_names(iparams) ++ ")\n"
        else if kind == FACADE_CLAUSE_DROP:
            let dropper = facade_render_find_fn(pool, intern, ci, pool.get_extra(ops))
            // D215 (§16.2b.11): a function whose resource parameter is
            // `void *` takes any pointer (`free`), so it is not one
            // resource's operation and its name keeps its raw meaning.
            if dropper != 0 and not facade_render_first_param_is_void_ptr(pool, intern, dropper):
                out = out ++ "fn " ++ facade_render_bridge_name(intern.resolve(pool.get_data0(dropper as NodeId))) ++ "(facade_self: " ++ name ++ "):\n    let facade_ended = facade_self\n"
        else if kind == FACADE_CLAUSE_DESTROYS:
            // A destroyer's name consumes the resource too, with the
            // destroyer's other arguments: the consuming method, by C name.
            let destroyer = facade_render_find_fn(pool, intern, ci, pool.get_extra(ops))
            // D209: `destroys f(param N)` hands the resource at N, and the
            // other parameters are the method's, fixed or discarded; the
            // forwarder takes what the method takes.
            let at = if destroyer != 0: facade_render_destroyer_at(pool, intern, resource, destroyer) else: 0
            let placed_form = destroyer != 0 and (at != 0 or facade_render_fixes_or_discards(pool, intern, destroyer))
            if destroyer != 0 and (placed_form or not facade_render_first_param_is_void_ptr(pool, intern, destroyer)):
                let dname = intern.resolve(pool.get_data0(destroyer as NodeId))
                var dparams = ""
                if placed_form:
                    let placed = facade_render_bridge(pool, intern, destroyer, 0, at, "facade_self.repr")
                    if not placed.ok: continue
                    dparams = placed.params
                else:
                    let (plain, _) = facade_render_params_but(pool, intern, destroyer, 1, -1, "")
                    dparams = plain
                let head = if dparams.len() > 0: "facade_self: " ++ name ++ ", " ++ dparams else: "facade_self: " ++ name
                out = out ++ "fn " ++ facade_render_bridge_name(dname) ++ "(" ++ head ++ "):\n    facade_self." ++ facade_render_present(pool, intern, ci, resource, dname) ++ "(" ++ facade_render_forward_names(dparams) ++ ")\n"
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_FN)
    for item in items:
        let li = facade_render_lend_item(pool, intern, ci, item)
        if not facade_render_lend_hosted(pool, intern, li, resource, repr): continue
        if li.detaches != 0 or li.text_view or li.variadic != 0 or li.record_view or li.borrow_res != 0 or li.text_free != 0: continue
        // A buffer-field operation (D210) takes the buffers and returns
        // the step's record: its method is not the C function's shape, so
        // no forwarder is rendered and the name keeps its raw meaning.
        if facade_render_item_has_clause(pool, item, FACADE_CLAUSE_BUFFER_FIELD): continue
        let decl = li.decl
        let fname = intern.resolve(pool.get_data0(decl as NodeId))
        let mname = facade_render_present(pool, intern, ci, resource, fname)
        let at = facade_render_lend_at(pool, intern, li)
        let repr_arg = facade_render_repr_arg_at(pool, intern, decl, at, repr_text, "self.repr", false)
        if repr_arg.len() == 0: continue
        let bridge = if at == 0: facade_render_bridge(pool, intern, decl, 1, -1, "") else: facade_render_bridge(pool, intern, decl, 0, at, repr_arg)
        if not bridge.ok: continue
        let ret = facade_render_bridge_body(pool, intern, decl, bridge, facade_render_call(pool, intern, decl, repr_arg), mname, "        ", facade_render_message_call(pool, intern, ci, resource)).0
        let receiver = if repr_arg.starts_with("&raw mut "): "mut facade_self: " ++ name else: "facade_self: &" ++ name
        let params = if bridge.params.len() > 0: receiver ++ ", " ++ bridge.params else: receiver
        let gen = if bridge.generics.len() > 0: "[" ++ bridge.generics ++ "]" else: ""
        out = out ++ "fn " ++ facade_render_bridge_name(fname) ++ gen ++ "(" ++ params ++ ")" ++ ret ++ ":\n    facade_self." ++ mname ++ "(" ++ facade_render_forward_names(bridge.params) ++ ")\n"
    out

// The borrowed value a `returns borrow R from param N` operation yields
// (ruling §26, spec §16.2b.6): "no Drop; cannot outlive the named origin;
// cannot independently be consumed or destroyed". It is the distinct type
// `Borrowed<R>` (D59's precedent: a resource state with its own surface is
// its own type), ephemeral and holding a view of the origin resource — the
// one the operation's param N receives — so the ordinary origin analysis
// keeps it inside the origin's life; it carries R's lend methods (the
// non-destroying, non-consuming ones) over the same `repr` field, and none
// of R's destroyers or Drop:
//
//     type BorrowedDatabase ephemeral { origin: &Statement, repr: *mut sqlite3 }
//     impl BorrowedDatabase:
//         fn sqlite3_errmsg() -> *const i8:
//             unsafe { sqlite3_errmsg(self.repr) }
//
// Rendered beside `R`, once, with the origin resource of the first item that
// borrows R; Sema refuses a second item borrowing R from another resource
// (one borrowed type, one origin type). "" when no item borrows R.
fn facade_render_borrowed_type(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32, repr_text: &str, methods: &str) -> str:
    let rname = intern.resolve(pool.get_data0(resource as NodeId))
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_FN)
    for i in 0..items.len():
        let item = items[i]
        let cstart = pool.get_data1(item as NodeId)
        for k in 0..pool.get_data2(item as NodeId):
            let clause = pool.get_extra(cstart + k)
            if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_RETURNS_BORROW:
                continue
            let ops = pool.get_data1(clause as NodeId)
            let res_name = intern.resolve(pool.get_extra(ops))
            if res_name != rname:
                continue
            let decl = facade_render_find_fn(pool, intern, ci, pool.get_data0(item as NodeId))
            if decl == 0:
                continue
            let from = facade_render_param_ref(pool, intern, decl, pool.get_extra(ops + 1))
            let meta = pool.find_fn_meta(decl as NodeId)
            if from < 0 or meta < 0:
                continue
            let origin = facade_render_received(pool, intern, render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(meta), from) as NodeId))
            if origin <= 0:
                continue
            // D134 (§16.2b.6): one borrowed type serves every origin. The
            // origin is a type parameter bound at each call by the value
            // the constructing method hands it (`self`, a parameter, a
            // parent view), so a `Node` borrowed from a `Doc` and one
            // borrowed from an owned `Node` are one `BorrowedNode[_]`, and a
            // borrow taken through a borrow views that borrow (D122).
            let bname = facade_render_borrowed_name(rname)
            var out = "type " ++ bname ++ "[Origin] ephemeral { origin: &Origin, repr: " ++ repr_text ++ " }\n"
            let detach = facade_render_detach_methods(pool, intern, ci, resource, repr_text)
            if methods.len() > 0 or detach.len() > 0:
                out = out ++ "impl[Origin] " ++ bname ++ "[Origin]:\n" ++ methods ++ detach
            // D134 (§16.2b.6): a detached value is owned — its Drop runs the
            // resource's destroyer — and dependent on the origin it was taken
            // out of, which it holds a view of, as a `borrows` child does.
            if detach.len() > 0:
                let dname = facade_render_detached_name(rname)
                let drop_decl = facade_render_drop_decl(pool, intern, ci, resource)
                let drop_call = facade_render_call(pool, intern, drop_decl, facade_render_repr_arg(pool, intern, drop_decl, repr_text, "self.repr", false))
                out = out ++ "type " ++ dname ++ "[Origin] ephemeral { origin: &Origin, repr: " ++ repr_text ++ ", live: bool }\n"
                out = out ++ "impl[Origin] Drop for " ++ dname ++ "[Origin]:\n    move fn drop():\n        if self.live: " ++ drop_call ++ "\n"
                if methods.len() > 0:
                    out = out ++ "impl[Origin] " ++ dname ++ "[Origin]:\n" ++ methods
            return out
    ""

fn facade_render_detached_name(name: &str): "Detached" ++ name

// The resource's `drop` operation's declaration, or 0.
fn facade_render_drop_decl(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32) -> i32:
    let cstart = pool.get_data1(resource as NodeId)
    for k in 1..pool.get_data2(resource as NodeId) + 1:
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) == FACADE_CLAUSE_DROP:
            return facade_render_find_fn(pool, intern, ci, pool.get_extra(pool.get_data1(clause as NodeId)))
    0

// D134 (§16.2b.6): every `detaches param N` item whose param N receives
// this resource, as a `move fn` of the borrowed view: the C call runs over
// the view's handle, and the handle leaves as an owned `Detached<R>` that
// views the same origin. The item is not a lend and renders nowhere else.
fn facade_render_detach_methods(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32, repr_text: &str):
    var out = ""
    let repr = facade_render_unalias(pool, intern, repr_text)
    let rname = intern.resolve(pool.get_data0(resource as NodeId))
    let dname = facade_render_detached_name(rname)
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_FN)
    for item in items:
        let li = facade_render_lend_item(pool, intern, ci, item)
        if li.detaches == 0 or li.decl == 0:
            continue
        let decl = li.decl
        let from = facade_render_param_ref(pool, intern, decl, li.detaches)
        if from != 0:
            continue
        let meta = pool.find_fn_meta(decl as NodeId)
        if meta < 0 or facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(meta), 0) as NodeId)) != repr:
            continue
        let fname = intern.resolve(pool.get_data0(decl as NodeId))
        let mname = facade_render_present(pool, intern, ci, resource, fname)
        let repr_arg = facade_render_repr_arg(pool, intern, decl, repr_text, "self.repr", false)
        if repr_arg.len() == 0:
            continue
        let bridge = facade_render_bridge(pool, intern, decl, 1, -1, "")
        if not bridge.ok:
            continue
        let call_args = if bridge.args.len() > 0: repr_arg ++ ", " ++ bridge.args else: repr_arg
        out = out ++ "    move fn " ++ mname ++ "(" ++ bridge.params ++ ") -> " ++ dname ++ "[Origin]:\n" ++ facade_render_indent(bridge.prologue, "        ") ++ "        " ++ facade_render_call(pool, intern, decl, call_args) ++ "\n        " ++ dname ++ " { origin: self.origin, repr: self.repr, live: true }\n"
    out

fn facade_render_borrowed_name(name: &str): "Borrowed" ++ name

fn facade_render_is_resource_name(pool: &AstPool, intern: &InternPool, name: &str) -> bool:
    for item in facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE):
        if intern.resolve(pool.get_data0(item as NodeId)) == name: return true
    false

// The one resource whose representation is `repr`; "" when none wraps it
// or several do (the type then names no single resource).
fn facade_render_resource_wrapping(pool: &AstPool, intern: &InternPool, repr: &str) -> str:
    var found = ""
    var n = 0
    for item in facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE):
        if facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.get_extra(pool.get_data1(item as NodeId)) as NodeId)) != repr: continue
        n = n + 1
        found = with_str_clone_ref(intern.resolve(pool.get_data0(item as NodeId)))
    if n == 1: found else: ""

fn facade_render_resources_wrapping(pool: &AstPool, intern: &InternPool, repr: &str):
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE)
    var n = 0
    for item in items:
        let r = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.get_extra(pool.get_data1(item as NodeId)) as NodeId))
        if r == repr: n = n + 1
    n

// ── stage 8: presentation (ruling §53-§55, spec §16.2b.11) ──────────────
//
// Every operation a resource's rendering exposes is spelled on the resource
// type by the naming convention §16.2a already applies to raw imports: the
// C name less the representation's snake-case prefix (`db_count` on
// `Database wraps *mut db` is `d.count()`, `sqlite3_prepare_v2` on `*mut
// sqlite3` is `prepare_v2`) or less the library prefix the struct name
// carries (`sqlite3_step` on `*mut sqlite3_stmt` is `step`,
// facade_render_shorten), or the `rename` an fn item states. A producer
// whose first parameter receives another resource is presented as a method
// of that resource too (`db.prepare(sql)` beside `Statement.prepare(db,
// sql)`, facade_render_receiver_method), and the constructor of a resource
// made from a parent is shortened by the parent's prefix when its own does
// not match. Being wrong here changes a spelling, never a contract (§54:
// "being wrong changes API presentation, not ownership or lifetime
// behavior"), so the convention applies silently.
//
// An ambiguity never guesses (§55: "If automatic grouping is ambiguous,
// method sugar may simply be omitted while the underlying modeled foreign
// operation remains available"): when two operations of one resource
// shorten to one name, or a shortened name is another operation's imported
// or renamed name, the shortened ones keep their imported names, and Sema
// notes the candidates and the `rename` that would settle it (SemaFacade.with
// verify_facade_presentation). A shortened name that is a With keyword, or
// `drop` (the resource's Drop), is likewise not taken. A `rename` is
// explicit and never yields; two renames to one name are an error (Sema).
type FacadeSurface {
    cnames: List[str],      // the C name of each operation presented on the resource ("" for a rendered fixture such as Drop)
    names: List[str],       // the name it is presented under, before ambiguity is settled
    explicit: List[bool],   // renamed, or under its imported name: never yields
    roles: List[str],       // what it is, for the ambiguity note
}

// The name operation `cname` is presented under on `resource`: its
// `rename`, its shortened name when that is unambiguous, else the C name.
fn facade_render_present(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32, cname: &str) -> str:
    let s = facade_render_surface(pool, intern, ci, resource)
    for i in 0..s.cnames.len():
        if s.cnames[i] != cname:
            continue
        let explicit: bool = s.explicit[i]
        if explicit:
            return s.names[i]
        for j in 0..s.cnames.len():
            if j != i and s.names[j] == s.names[i]:
                return cname
        return s.names[i]
    cname

// Why `cname` keeps its imported name on `resource` — the other operations
// its shortened name would also spell, as "'db_get' (a lend method), the
// resource's Drop" — or "" when its presentation is not ambiguous.
fn facade_render_presentation_clash(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32, cname: &str) -> str:
    let s = facade_render_surface(pool, intern, ci, resource)
    for i in 0..s.cnames.len():
        let explicit: bool = s.explicit[i]
        if s.cnames[i] != cname or explicit:
            continue
        var others = ""
        for j in 0..s.cnames.len():
            if j == i or s.names[j] != s.names[i]:
                continue
            let cn = s.cnames[j]
            let role = s.roles[j]
            let shown = if cn.len() == 0: role else: f"'{cn}' ({role})"
            others = others ++ (if others.len() > 0: ", " else: "") ++ shown
        return others
    ""

// The C names of every operation presented on `resource`, each once.
fn facade_render_presented_ops(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32):
    let s = facade_render_surface(pool, intern, ci, resource)
    let out: List[str] = []
    for i in 0..s.cnames.len():
        let cn = s.cnames[i]
        if cn.len() == 0:
            continue
        var seen = false
        for out_item in out:
            if out_item == cn: seen = true
        if not seen:
            out.push(cn)
    out

// Those of them an fn item renames.
fn facade_render_renamed_ops(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32):
    let ops = facade_render_presented_ops(pool, intern, ci, resource)
    let out: List[str] = []
    for op in ops:
        if facade_render_item_rename(pool, intern, op).len() > 0:
            out.push(op)
    out

// The shortened name of `cname` on `resource`, ambiguity aside ("" when no
// prefix matches): what an ambiguity note names as the spelling both
// operations would take.
fn facade_render_shortened(pool: &AstPool, intern: &InternPool, resource: i32, cname: &str):
    facade_render_shorten(cname, facade_render_prefix_names(pool, intern, resource))

// The presented surface of a resource: its constructors (`from`, `init`),
// destroying methods, Drop, text view, hosted lend methods, and the
// producers of other resources its value is the receiver of.
fn facade_render_surface(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32):
    var s = FacadeSurface { cnames: [], names: [], explicit: [], roles: [] }
    let repr_text = render_type_expr(pool, intern, pool.get_extra(pool.get_data1(resource as NodeId)) as NodeId)
    let repr = facade_render_unalias(pool, intern, repr_text)
    let prefixes = facade_render_prefix_names(pool, intern, resource)
    let extra_start = pool.get_data1(resource as NodeId)
    for k in 0..pool.get_data2(resource as NodeId):
        let clause = pool.get_extra(extra_start + 1 + k)
        let kind = pool.get_data0(clause as NodeId)
        let ops = pool.get_data1(clause as NodeId)
        if kind != FACADE_CLAUSE_FROM and kind != FACADE_CLAUSE_INIT and kind != FACADE_CLAUSE_DESTROYS:
            continue
        let cname = intern.resolve(pool.get_extra(ops))
        let names = prefixes.clone()
        if kind == FACADE_CLAUSE_FROM:
            // A resource made from a parent: the parent's prefix too.
            let decl = facade_render_find_fn(pool, intern, ci, pool.get_extra(ops))
            let parent = if decl != 0: facade_render_receiver(pool, intern, decl) else: 0
            if parent > 0:
                let more = facade_render_prefix_names(pool, intern, parent)
                for more_item in more:
                    names.push(more_item)
        let role = if kind == FACADE_CLAUSE_DESTROYS: "a destroying method" else: "a constructor"
        s = facade_render_surface_add(s, cname, names, facade_render_item_rename(pool, intern, cname), role)
    s = facade_render_surface_push(s, "", "drop", true, "the resource's Drop")
    if facade_render_is_c_string_ptr(repr):
        s = facade_render_surface_push(s, "", facade_render_text_view_name(), true, "the text view")
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_FN)
    for item in items:
        let li = facade_render_lend_item(pool, intern, ci, item)
        if not facade_render_lend_hosted(pool, intern, li, resource, repr):
            continue
        let cname = intern.resolve(pool.get_data0(li.decl as NodeId))
        var rename = ""
        if li.rename != 0: rename = intern.resolve(li.rename)
        s = facade_render_surface_add(s, cname, prefixes, rename, "a lend method")
    for item in items:
        let cb = facade_render_callback_item(pool, intern, ci, item)
        if not facade_render_callback_hosted(pool, intern, cb, resource, repr):
            continue
        let cname = intern.resolve(pool.get_data0(cb.decl as NodeId))
        var rename = ""
        if cb.rename != 0: rename = intern.resolve(cb.rename)
        s = facade_render_surface_add(s, cname, prefixes, rename, "a callback method")
    let resources = facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE)
    for ri in 0..resources.len():
        let other = resources[ri]
        if other == resource:
            continue
        let ostart = pool.get_data1(other as NodeId)
        for k in 0..pool.get_data2(other as NodeId):
            let clause = pool.get_extra(ostart + 1 + k)
            if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_FROM:
                continue
            let psym = pool.get_extra(pool.get_data1(clause as NodeId))
            let decl = facade_render_find_fn(pool, intern, ci, psym)
            if decl == 0 or facade_render_receiver(pool, intern, decl) != resource:
                continue
            let child = intern.resolve(pool.get_data0(other as NodeId))
            let cname = intern.resolve(psym)
            s = facade_render_surface_add(s, cname, prefixes, facade_render_item_rename(pool, intern, cname), f"the producer of '{child}'")
    s

fn facade_render_surface_add(s0: FacadeSurface, cname: &str, prefixes: &List[str], rename: &str, role: &str) -> FacadeSurface:
    if rename.len() > 0:
        return facade_render_surface_push(s0, cname, rename, true, role)
    let short = facade_render_shorten(cname, prefixes)
    if short.len() == 0:
        return facade_render_surface_push(s0, cname, cname, true, role)
    facade_render_surface_push(s0, cname, short, false, role)

fn facade_render_surface_push(s0: FacadeSurface, cname: &str, name: &str, explicit: bool, role: &str):
    let s = s0
    s.cnames.push(cname)
    s.names.push(name)
    s.explicit.push(explicit)
    s.roles.push(role)
    s

// The struct names a resource's operations may be shortened by: the
// representation as the facade spells it and as c_import declares it
// beneath its aliases (zlib's `z_streamp` names `z_stream`).
fn facade_render_prefix_names(pool: &AstPool, intern: &InternPool, resource: i32):
    let spelled = render_type_expr(pool, intern, pool.get_extra(pool.get_data1(resource as NodeId)) as NodeId)
    let out: List[str] = []
    let a = facade_render_struct_name(spelled)
    if a.len() > 0:
        out.push(a)
    let b = facade_render_struct_name(facade_render_unalias(pool, intern, spelled))
    if b.len() > 0 and (out.len() == 0 or out[0] != b):
        out.push(b)
    // A struct tag written with a leading underscore (`struct _xmlDoc`,
    // the C convention beside `typedef … xmlDoc`) names the same prefixes
    // as the typedef: `xmlDocGetRootElement` is `get_root_element` on
    // either spelling.
    for i in 0..out.len():
        var bare = out[i]
        while bare.starts_with("_"): bare = bare.slice(1, bare.len())
        if bare.len() > 0 and bare != out[i] and not out.contains(bare): out.push(bare)
    out

// The struct name beneath one level of pointer, or "" for a shape with no
// name to shorten by (a C string, a pointer to a pointer, `void *`).
fn facade_render_struct_name(text: &str) -> str:
    var t = text
    if t.starts_with("*mut "): t = t.slice(5, t.len())
    else if t.starts_with("*const "): t = t.slice(7, t.len())
    if t.starts_with("*") or t.starts_with("[") or t.starts_with("fn(") or t == "c_void" or t == "i8" or t == "c_char" or t == "u8":
        return ""
    t

// `cname` less the longest matching prefix (§16.2a: the struct name in
// snake case, `GHashTable` → `g_hash_table_`, or case-insensitively as
// `Struct_`), or "" when none matches, the remainder is not an identifier,
// or it is a With keyword or `drop`.
//
// The library prefix (#1610): a C library names its types and its
// functions under one prefix, and an operation of a resource carries the
// library's, not the struct's — `sqlite3_step(sqlite3_stmt *)`,
// `curl_easy_perform(CURL *)`, `inflate(z_streamp)`. So each snake-case
// component prefix of the struct name is tried too (`sqlite3_stmt` →
// `sqlite3_`; `g_hash_table` → `g_hash_`, `g_`), and the longest matching
// prefix wins. Being wrong here changes a spelling (§54), and a clash
// between two operations still fails closed (facade_render_present).
// `cname` in snake case (`xmlDocGetRootElement` → `xml_doc_get_root_element`);
// a snake-case name is itself.
fn facade_render_snake_name(cname: &str) -> str:
    let s = ci_compute_snake_prefix(cname)
    if s.ends_with("_") and not cname.ends_with("_"): s.slice(0, s.len() - 1) else: s

fn facade_render_shorten(cname: &str, names: &List[str]) -> str:
    var best = ""
    // A camel-case C name (libxml2's `xmlDocGetRootElement` on `xmlDoc`)
    // is read in snake case, so the same prefixes shorten it:
    // `xml_doc_get_root_element` less `xml_doc_` is `get_root_element`,
    // `xmlFirstElementChild` on `xmlNode` less the library's `xml_` is
    // `first_element_child`. A name already in snake case is unchanged.
    let csnake = facade_render_snake_name(cname)
    for name in names:
        let sname = name
        let snake = ci_compute_snake_prefix(sname)
        var m = ci_strip_snake_prefix(cname, snake)
        if m.len() == 0 and csnake != cname:
            m = ci_strip_snake_prefix(csnake, snake)
        if m.len() == 0:
            m = ci_strip_struct_prefix(cname, sname)
        if m.len() > 0 and (best.len() == 0 or m.len() < best.len()):
            best = m
        // `snake` ends with the `_` that closes the struct name; every
        // earlier `_` closes a library prefix.
        var end = snake.len() - 1
        while end > 0:
            end = end - 1
            if snake[end] != '_':
                continue
            var lib = ci_strip_snake_prefix(cname, snake.slice(0, end + 1))
            if lib.len() == 0 and csnake != cname:
                lib = ci_strip_snake_prefix(csnake, snake.slice(0, end + 1))
            if lib.len() > 0 and (best.len() == 0 or lib.len() < best.len()):
                best = lib
    if best.len() == 0 or keyword_lookup(best) >= 0:
        return ""
    let c0 = best[0]
    if not ((c0 >= 'a' and c0 <= 'z') or (c0 >= 'A' and c0 <= 'Z') or c0 == '_'):
        return ""
    best

// The `rename` an fn item states for the C function `cname`, or "".
fn facade_render_item_rename(pool: &AstPool, intern: &InternPool, cname: &str) -> str:
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_FN)
    for i in 0..items.len():
        let item = items[i]
        let have = intern.resolve(pool.get_data0(item as NodeId))
        if have != cname:
            continue
        let cstart = pool.get_data1(item as NodeId)
        for k in 0..pool.get_data2(item as NodeId):
            let clause = pool.get_extra(cstart + k)
            if pool.get_data0(clause as NodeId) == FACADE_CLAUSE_RENAME:
                let renamed = intern.resolve(pool.get_extra(pool.get_data1(clause as NodeId)))
                return renamed
    ""

// The resource an operation's first parameter receives — one resource a
// borrow `&P` can hand to C (facade_render_received_arg) — or 0: the
// receiver of `db.prepare(sql)`.
fn facade_render_receiver(pool: &AstPool, intern: &InternPool, decl: i32) -> i32:
    let meta = pool.find_fn_meta(decl as NodeId)
    if meta < 0 or pool.fn_meta_param_count(meta) == 0:
        return 0
    // D214: a first parameter the contract fixes is the facade's argument,
    // not a receiver (a producer's absent parent, `param 0 fixed null`).
    if facade_render_fixed_literal(pool, intern, decl, 0).len() > 0: return 0
    let p0 = render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(meta), 0) as NodeId)
    let res = facade_render_received_param(pool, intern, decl, 0, p0)
    if res <= 0 or facade_render_received_arg(pool, intern, res, p0, "self").len() == 0:
        return 0
    res

// A producer received through a parent, presented as a method of the parent
// (ruling §54: `sqlite3_prepare_v2(db, …)` "may be presented as
// `db.prepare(...)`"), delegating to the constructor so the two spellings
// share one body:
//
//     impl Database:
//         fn prepare(sql: &str) -> Result[Statement, StatementError]: Statement.prepare(self, sql)
//
// `slot` is the out parameter withheld from the constructor (-1 for a direct
// return). Sema puts the constructor's declared dependency summary on this
// method too (apply_facade_dependency_effects).
// Whether an fn item describes `decl` and states `of <resource>` for the
// resource named `name`.
fn facade_render_item_states_of(pool: &AstPool, intern: &InternPool, decl: i32, name: &str) -> bool:
    let cname = intern.resolve(pool.get_data0(decl as NodeId))
    for item in facade_render_all_items(pool, NodeKind.NK_FACADE_FN):
        if intern.resolve(pool.get_data0(item as NodeId)) != cname: continue
        let cstart = pool.get_data1(item as NodeId)
        for k in 0..pool.get_data2(item as NodeId):
            let clause = pool.get_extra(cstart + k)
            if pool.get_data0(clause as NodeId) == FACADE_CLAUSE_OF and intern.resolve(pool.get_extra(pool.get_data1(clause as NodeId))) == name: return true
    false

// Whether an fn item states a clause of `kind` (an item's clauses start at
// its first extra; a resource's follow its representation).
fn facade_render_item_has_clause(pool: &AstPool, item: i32, kind: i32) -> bool:
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        if pool.get_data0(pool.get_extra(cstart + k) as NodeId) == kind: return true
    false

fn facade_render_receiver_method(pool: &AstPool, intern: &InternPool, ci: &List[i32], child: i32, producer: i32, slot: i32, ctor: &str, result: &str) -> str:
    let parent = facade_render_receiver(pool, intern, producer)
    // A producer made from its own resource (libxml2's `xmlDictCreateSub(xmlDict *)`)
    // is its constructor alone: the receiver method would be a second
    // definition of the same name on the same type.
    if parent <= 0 or parent == child:
        return ""
    // D214: a producer has one home, chosen by `of`. An fn item that states
    // `of` the produced type makes it that type's constructor, and no parent
    // method is generated; `of` the parent, or none, leaves it the parent's.
    if facade_render_item_states_of(pool, intern, producer, intern.resolve(pool.get_data0(child as NodeId))): return ""
    let pname = intern.resolve(pool.get_data0(parent as NodeId))
    let cname = intern.resolve(pool.get_data0(producer as NodeId))
    let mname = facade_render_present(pool, intern, ci, parent, cname)
    let (params, _) = facade_render_params_but(pool, intern, producer, 1, slot, "")
    let meta = pool.find_fn_meta(producer as NodeId)
    let start = pool.fn_meta_param_start(meta)
    var args = "self"
    for pi in 1..pool.fn_meta_param_count(meta):
        // A fixed argument (D64) is the constructor's literal, not a
        // parameter the receiver method forwards.
        if pi != slot and facade_render_fixed_literal(pool, intern, producer, pi).len() == 0:
            args = args ++ ", " ++ facade_render_param_name(pool, intern, start, pi)
    let child_name = intern.resolve(pool.get_data0(child as NodeId))
    "impl " ++ pname ++ ":\n    fn " ++ mname ++ "(" ++ params ++ ") -> " ++ result ++ ": " ++ child_name ++ "." ++ ctor ++ "(" ++ args ++ ")\n"

// Whether `cname` is an operation some resource clause names (`from`,
// `init`, `preinit`, `drop`, `destroys`): an fn item describing one adds
// facts to that operation and is not a lend method beside its constructor.
fn facade_render_is_resource_op(pool: &AstPool, intern: &InternPool, cname: &str) -> bool:
    let resources = facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE)
    for resource in resources:
        let res = resource
        let extra_start = pool.get_data1(res as NodeId)
        for k in 0..pool.get_data2(res as NodeId):
            let clause = pool.get_extra(extra_start + 1 + k)
            let kind = pool.get_data0(clause as NodeId)
            if kind != FACADE_CLAUSE_FROM and kind != FACADE_CLAUSE_INIT and kind != FACADE_CLAUSE_PREINIT and kind != FACADE_CLAUSE_DROP and kind != FACADE_CLAUSE_DESTROYS:
                continue
            let have = intern.resolve(pool.get_extra(pool.get_data1(clause as NodeId)))
            if have == cname:
                return true
    false

// An fn item read as a lend: its declaration (0 when none), its `of` and
// `rename`, whether it states nothing stronger than a lend, and what it
// returns borrowed.
type FacadeLendItem {
    decl: i32,
    of_sym: i32,
    of_param: i32,           // D243: `of R(param N)` param ref node, or 0 for param 0
    rename: i32,
    lends: bool,
    borrow_res: i32,
    borrow_from: i32,
    borrow_parent: i32,      // `returns borrow R from parent R of param N` (D85 §16.2b.6): R's symbol, or 0
    text_view: bool,
    valid_on_failed: bool,   // rendered on `Failed<R>` too (#1612)
    bridged: bool,           // states a buffer pairing, a fixed argument or an `ok` (D64)
    variadic: i32,           // the `variadic param … selected by …` clause (D66 §16.2b.5), or 0
    present_cases: i32,      // the `present cases [stripping PREFIX]` clause (D242 §16.2b.5), or 0
    record_view: bool,       // `returns borrow T from …` for an imported record T (D66 §16.2b.6): borrow_res is T
    text_free: i32,          // `text return, owned, freed by F` (D122 §16.2b.8): F's symbol, or 0
    text_bytes: bool,        // `text return bytes` (D134 §16.2b.8): owned bytes even under a `text utf8` facade
    detaches: i32,           // `detaches param N` (D134 §16.2b.6): the param ref, or 0
}

// Whether the fn item states a variadic contract.
fn facade_item_is_variadic(pool: &AstPool, item: i32) -> bool:
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        if pool.get_data0(pool.get_extra(cstart + k) as NodeId) == FACADE_CLAUSE_VARIADIC: return true
    false

fn facade_render_lend_item(pool: &AstPool, intern: &InternPool, ci: &List[i32], item: i32) -> FacadeLendItem:
    let li = FacadeLendItem { decl: 0, of_sym: 0, of_param: 0, rename: 0, lends: true, borrow_res: 0, borrow_from: 0, borrow_parent: 0, text_view: false, valid_on_failed: false, bridged: false, variadic: 0, present_cases: 0, record_view: false, text_free: 0, text_bytes: false, detaches: 0 }
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        let kind = pool.get_data0(clause as NodeId)
        let ops = pool.get_data1(clause as NodeId)
        if kind == FACADE_CLAUSE_OF:
            li.of_sym = pool.get_extra(ops)
            if pool.get_data2(clause as NodeId) >= 2: li.of_param = pool.get_extra(ops + 1)
        else if kind == FACADE_CLAUSE_RENAME: li.rename = pool.get_extra(ops)
        else if kind == FACADE_CLAUSE_VARIADIC: li.variadic = clause
        else if kind == FacadeVariadicPresentClause.PresentCases as i32: li.present_cases = clause
        else if kind == FACADE_CLAUSE_RETURNS_BORROW:
            li.borrow_res = pool.get_extra(ops)
            li.borrow_from = pool.get_extra(ops + 1)
            li.borrow_parent = pool.get_extra(ops + 3)
            if intern.resolve(li.borrow_res) == "CStr":
                li.text_view = true
                li.borrow_res = 0
            // A name no resource carries is an imported record's (D66;
            // Sema verifies that): a view of the record, not `Borrowed<R>`.
            else if not facade_render_resource_named(pool, intern, intern.resolve(li.borrow_res)):
                li.record_view = true
        else if kind == FACADE_CLAUSE_RETURNS_STATIC:
            // `returns static CStr` (ruling §40): a text view of static
            // storage, no origin to keep it inside.
            if render_type_expr(pool, intern, pool.get_extra(ops) as NodeId) == "CStr": li.text_view = true
            else: li.lends = false
        else if kind == FACADE_CLAUSE_VALID_ON_FAILED: li.valid_on_failed = true
        // D122 (§16.2b.8): the returned text is new, owned, released with F.
        else if kind == FACADE_CLAUSE_TEXT_RETURN: li.text_free = pool.get_extra(ops)
        else if kind == FACADE_CLAUSE_TEXT_BYTES: li.text_bytes = true
        else if kind == FACADE_CLAUSE_DETACHES: li.detaches = pool.get_extra(ops)
        // A buffer pairing, a fixed argument and the status contract of a
        // copied-back length (D64) describe the lend's presented call
        // (facade_render_bridge); they make nothing stronger than a lend.
        // D102: `nullable param N` on a function-pointer parameter presents
        // `Option` of it through the bridge (facade_render_bridge_param).
        else if facade_clause_bridges(kind): li.bridged = true
        // §16.2b.5: `consumes param N` (without `destroyed_by`) on a lend
        // method transfers ownership of a non-receiver resource parameter into
        // the receiver (cJSON_AddItemToObject, yaml_emitter_emit).
        else if kind == FACADE_CLAUSE_CONSUMES and pool.get_extra(ops + 1) == 0: li.bridged = true
        // `callback_thread any` beside a variadic contract speaks of a case's
        // callback (§16.2b.10): Sema checks the userdata at the pair's setter.
        else if kind == FACADE_CLAUSE_CALLBACK_THREAD and facade_item_is_variadic(pool, item): {}
        else if kind != FACADE_CLAUSE_LEND and kind != FACADE_CLAUSE_PRESERVES and kind != FACADE_CLAUSE_CALLBACKS_NONE: li.lends = false
    if not li.lends:
        return li
    let cname = intern.resolve(pool.get_data0(item as NodeId))
    if facade_render_is_resource_op(pool, intern, cname):
        li.lends = false
        return li
    li.decl = facade_render_find_fn(pool, intern, ci, pool.get_data0(item as NodeId))
    li

// D243: the parameter index that receives the host resource (0 unless `of R(param N)`).
fn facade_render_lend_at(pool: &AstPool, intern: &InternPool, li: &FacadeLendItem) -> i32:
    if li.of_param == 0 or li.decl == 0: 0 else: facade_render_param_ref(pool, intern, li.decl, li.of_param)

// Whether the lend item is a method of `resource` (whose unaliased
// representation is `repr`): its hosted parameter takes the representation —
// a pointer resource's handle, or an in-place resource's storage by address
// — and the resource is the one its `of` names, or the only one wrapping
// the representation (§16.2b.3; an unassigned item on a representation
// several resources wrap is Sema's error, verify_facade_assignments).
fn facade_render_lend_hosted(pool: &AstPool, intern: &InternPool, li: &FacadeLendItem, resource: i32, repr: &str) -> bool:
    if not li.lends or li.decl == 0 or facade_render_param_count(pool, li.decl) == 0:
        return false
    let at = facade_render_lend_at(pool, intern, li)
    if at < 0 or at >= facade_render_param_count(pool, li.decl):
        return false
    // A parameter a `buffer` clause pairs is that buffer, never a
    // receiver (Sema: facade_param_receives draws the same line).
    if facade_render_buffer_of(pool, intern, li.decl, at).0 == at:
        return false
    // A function that consumes its own receiver is a destroyer, not a lend.
    if facade_render_param_consumed(pool, intern, li.decl, at):
        return false
    let meta = pool.find_fn_meta(li.decl as NodeId)
    let p0 = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(meta), at) as NodeId))
    let in_place = not repr.starts_with("*") and facade_render_has_clause(pool, resource, FACADE_CLAUSE_INIT)
    if repr.starts_with("*"):
        if p0 != repr and not facade_render_const_of(p0, repr):
            return false
    else if in_place:
        if p0 != "*mut " ++ repr and p0 != "*const " ++ repr:
            return false
    else:
        // A by-value token is never recognized by its type (`int` is an
        // `Fd` and every other integer): only the item's own `of` makes the
        // operation its method, taking the token by value or by address
        // (#1669; Sema: facade_by_value_of_host).
        if p0 != repr and p0 != "*mut " ++ repr and p0 != "*const " ++ repr:
            return false
        return li.of_sym != 0 and intern.resolve(li.of_sym) == intern.resolve(pool.get_data0(resource as NodeId))
    if li.of_sym != 0:
        let of_name = intern.resolve(li.of_sym)
        let rname = intern.resolve(pool.get_data0(resource as NodeId))
        return of_name == rname
    facade_render_resources_wrapping(pool, intern, repr) == 1

// Every item of `kind` in every facade block of the compilation: a program's
// facade may describe an operation of a resource another block declares
// (its own `fn telldir` lending the toolchain libc facade's `CDir`).
// The facade items of one kind, scanned once per pool (the same index
// discipline as facade_render_alias_index): every presentation question
// asks for them, per operation of every resource.
var g_facade_items_pool: i64 = 0
var g_facade_items: HashMap[i32, List[i32], Minted] = [:]

fn facade_render_all_items(pool: &AstPool, kind: NodeKind):
    if g_facade_items_pool != pool.shape():
        g_facade_items_pool = pool.shape()
        g_facade_items = [:]
    let key = kind as i32
    if not g_facade_items.contains(key): g_facade_items.insert(key, facade_render_scan_items(pool, kind))
    let out: List[i32] = []
    if let Some(items) = g_facade_items.get(key):
        for item in items: out.push(item)
    out

fn facade_render_scan_items(pool: &AstPool, kind: NodeKind):
    let out: List[i32] = []
    for di in 0..pool.decl_count():
        let decl = pool.get_decl(di)
        if pool.kind(decl) != NodeKind.NK_C_FACADE:
            continue
        let extra_start = pool.get_data1(decl)
        for i in 0..pool.get_data2(decl):
            let item = pool.get_extra(extra_start + i)
            if pool.kind(item as NodeId) != kind:
                continue
            // An fn item repeating an earlier one of its block is refused by
            // Sema ("described twice"); it renders nothing, so the refusal
            // is the only error. (A second presentation is not a repeat: it
            // names its own declaration, facade_render_presentation_aliases.)
            var repeat = false
            if kind == NodeKind.NK_FACADE_FN:
                for k in 0..i:
                    let earlier = pool.get_extra(extra_start + k)
                    if pool.kind(earlier as NodeId) == kind and pool.get_data0(earlier as NodeId) == pool.get_data0(item as NodeId): repeat = true
            if not repeat: out.push(item)
    out

// Also returns what the resource's projection asks of the facade's one
// error type, when the facade states one (facade_render_shared_error_type).
fn facade_render_resource(pool: &AstPool, intern: &InternPool, ci: &List[i32], item: i32, methods: &str, plain_methods: &str, failed_methods: &str) -> (str, FacadeErrorUse):
    let name = intern.resolve(pool.get_data0(item as NodeId))
    let shared = facade_render_shared_error(pool, intern, item)
    let shared_message = shared.len() > 0 and facade_render_shared_message(pool, item)
    let extra_start = pool.get_data1(item as NodeId)
    let clause_count = pool.get_data2(item as NodeId)
    let repr_text = render_type_expr(pool, intern, pool.get_extra(extra_start) as NodeId)
    let producers: List[i32] = []
    let out_refs: List[i32] = []   // parallel to producers; 0 for a direct return
    // The `borrows` and `independent` clauses are read by
    // facade_render_item_deps, the one dependency derivation.
    var drop_fn: i32 = 0
    // §31.8.6: `drop g` where `g` is a function-pointer global, not a function.
    var drop_global: i32 = 0
    var init_fn: i32 = 0
    let init_fns = []
    let init_clauses = []
    var preinit_fn: i32 = 0
    // `ok C1, C2, …` (§16.2b.4): every listed status is success.
    let ok_syms: List[i32] = []
    var movable = false
    var abandon_fn: i32 = 0
    let destroyers: List[i32] = []
    // §31.8.6: `destroys g` where `g` is a function-pointer global.
    let destroy_globals = []
    for k in 0..clause_count:
        let clause = pool.get_extra(extra_start + 1 + k)
        let kind = pool.get_data0(clause as NodeId)
        let ops = pool.get_data1(clause as NodeId)
        if kind == FACADE_CLAUSE_FROM:
            producers.push(facade_render_find_fn(pool, intern, ci, pool.get_extra(ops)))
            out_refs.push(pool.get_extra(ops + 1))
        else if kind == FACADE_CLAUSE_INIT:
            // Several initializers are several constructors; `init_fn` is
            // the first, for what is true of the resource (it is in place).
            let found = facade_render_find_fn(pool, intern, ci, pool.get_extra(ops))
            if init_fn == 0: init_fn = found
            init_fns.push(found)
            init_clauses.push(clause)
        else if kind == FACADE_CLAUSE_PREINIT:
            preinit_fn = facade_render_find_fn(pool, intern, ci, pool.get_extra(ops))
        else if kind == FACADE_CLAUSE_OK:
            for oi in 0..pool.get_data2(clause as NodeId): ok_syms.push(pool.get_extra(ops + oi))
        else if kind == FACADE_CLAUSE_MOVABLE:
            movable = true
        else if kind == FACADE_CLAUSE_DROP:
            drop_fn = facade_render_find_fn(pool, intern, ci, pool.get_extra(ops))
            if drop_fn == 0: drop_global = pool.get_extra(ops)
        else if kind == FACADE_CLAUSE_ABANDON:
            abandon_fn = facade_render_find_fn(pool, intern, ci, pool.get_extra(ops))
        else if kind == FACADE_CLAUSE_DESTROYS:
            let destroyer = facade_render_find_fn(pool, intern, ci, pool.get_extra(ops))
            if destroyer != 0: destroyers.push(destroyer)
            else if facade_render_global_fn_shape(pool, intern, pool.get_extra(ops)).0.len() > 0: destroy_globals.push(pool.get_extra(ops))
            else: destroyers.push(0)
    // An in-place resource is pinned unless the facade says `movable` (D54):
    // its representation lives in a Box cell the value owns, so the value
    // moves and the address does not.
    let pinned = init_fn != 0 and not movable
    // A name that is not a declaration, a resource with no `drop` (a
    // producer with nothing to destroy it; `destroys` operations alone would
    // leak a value dropped while live), a destroyer that takes neither the
    // representation nor a pointer to it: Sema's facade diagnostics name the
    // resource; nothing is rendered.
    // The call a drop through a global makes; "" when the name is no such
    // global, or the resource is in place (the global takes the pointer the
    // resource is).
    let global_drop = if drop_fn == 0: facade_render_drop_call(pool, intern, name, 0, drop_global, repr_text, "self.repr", pinned, "            ") else: ""
    if drop_fn == 0 and global_drop.len() == 0:
        // D246: a borrow-only child resource (no producer, init, drop, or
        // destroyer) renders only `Borrowed<R>[Origin]` with its `lend` methods.
        if producers.len() == 0 and init_fns.len() == 0 and destroyers.len() == 0 and destroy_globals.len() == 0:
            return (facade_render_borrowed_type(pool, intern, ci, item, repr_text, plain_methods), facade_render_no_error_use())
        return ("", facade_render_no_error_use())
    // D209: each takes the representation at the parameter its clause
    // names; a drop with other parameters calls through its helper, which
    // exists only when every one of them is fixed or discarded.
    for destroyer in destroyers:
        if destroyer == 0 or facade_render_repr_arg_at(pool, intern, destroyer, facade_render_destroyer_at(pool, intern, item, destroyer), repr_text, "self.repr", pinned).len() == 0:
            return ("", facade_render_no_error_use())
    if drop_fn != 0 and facade_render_repr_arg_at(pool, intern, drop_fn, facade_render_destroyer_at(pool, intern, item, drop_fn), repr_text, "self.repr", pinned).len() == 0:
        return ("", facade_render_no_error_use())
    if drop_fn != 0 and facade_render_param_count(pool, drop_fn) != 1 and facade_render_drop_helper(pool, intern, ci, item).len() == 0:
        return ("", facade_render_no_error_use())
    // Stage 6 (spec §16.2b.6, ruling §26-§30): what each producer's result
    // depends on. A producer whose received resources the renderer cannot
    // hand to C, or whose parent no one resource wraps, renders nothing;
    // Sema names it.
    let deps = facade_render_item_deps(pool, intern, ci, item)
    if not deps.ok:
        return ("", facade_render_no_error_use())
    let field = if pinned: "Box[" ++ repr_text ++ "]" else: repr_text
    // Stage 9 (ruling §45, spec §16.2b.9): userdata a callback method
    // retains is kept by the resource — each value in its own Box cell,
    // handed to C as the pointer, and released after the resource is
    // destroyed (facade_render_callback_methods) — in two parallel Vecs:
    // the cells and the one destroy fn per cell that knows its type.
    let keeps = facade_render_resource_keeps_userdata(pool, intern, ci, item, facade_render_unalias(pool, intern, repr_text))
    let keep_fields = if keeps: ", retained_ptrs: List[*mut c_void], retained_frees: List[extern \"C\" fn(*mut c_void) -> Unit]" else: ""
    let keep_init = if keeps: "retained_ptrs: List.new(), retained_frees: List.new(), " else: ""
    // A dependent resource is an ephemeral struct carrying a view of each
    // parent (the plan's `ephemeral { parent: &P, repr }`): the ordinary
    // origin and ephemeral-value analysis (§21.1, §22) then keeps it from
    // outliving, or being stored past, what it depends on, drops it before
    // its parents, and refuses a parent's move or destruction while it lives.
    // No reference count or generation check is added (ruling §29).
    var out = if deps.slot_res.len() > 0: "type " ++ name ++ " ephemeral { " ++ facade_render_dep_fields(pool, intern, deps) ++ "repr: " ++ field ++ ", live: bool" ++ keep_fields ++ " }\n" else: "type " ++ name ++ " { repr: " ++ field ++ ", live: bool" ++ keep_fields ++ " }\n"
    if drop_fn != 0 or global_drop.len() > 0:
        let drop_call = facade_render_drop_call(pool, intern, name, drop_fn, drop_global, repr_text, "self.repr", pinned, "            ")
        // `abandon <fn>` (§16.2b.9): the `callbacks none` abandonment path
        // runs before the destroyer on a drop path whose callback pair is
        // not proven callback-free. A spurious call costs one call and a
        // missed one is unsafe, so the rendering runs it on every drop;
        // MIR proves the pair state at every other callback-capable
        // operation (MirForeignPairs.with).
        // `abandon f(param N)`, or one whose other parameters are fixed or
        // discarded: the call is the helper's (facade_render_abandon_helper).
        let abandon_at = if abandon_fn != 0: facade_render_destroyer_at(pool, intern, item, abandon_fn) else: 0
        let abandon_placed = abandon_fn != 0 and (abandon_at != 0 or facade_render_param_count(pool, abandon_fn) > 1)
        if abandon_placed and facade_render_abandon_helper(pool, intern, item, abandon_fn).len() > 0:
            let abandon_call = "unsafe { " ++ facade_render_abandon_helper_name(name) ++ "(" ++ facade_render_repr_arg_at(pool, intern, abandon_fn, abandon_at, repr_text, "self.repr", pinned) ++ ") }"
            out = out ++ "impl Drop for " ++ name ++ ":\n    move fn drop():\n        if self.live:\n            " ++ abandon_call ++ "\n            " ++ drop_call ++ "\n"
        else if abandon_fn != 0 and facade_render_param_count(pool, abandon_fn) == 1 and facade_render_repr_arg(pool, intern, abandon_fn, repr_text, "self.repr", pinned).len() > 0:
            let abandon_call = facade_render_call(pool, intern, abandon_fn, facade_render_repr_arg(pool, intern, abandon_fn, repr_text, "self.repr", pinned))
            out = out ++ "impl Drop for " ++ name ++ ":\n    move fn drop():\n        if self.live:\n            " ++ abandon_call ++ "\n            " ++ drop_call ++ "\n"
        else:
            out = out ++ "impl Drop for " ++ name ++ ":\n    move fn drop():\n        if self.live:\n            " ++ drop_call ++ "\n"
        if keeps:
            // The retaining origin never outlives what it retains (§25):
            // the destroyer has run; now the retained values are released.
            out = out ++ "        for facade_i in 0..self.retained_ptrs.len():\n            let facade_free = self.retained_frees[facade_i]\n            facade_free(self.retained_ptrs[facade_i])\n"
    // D198 (§16.2b.3): a field of a by-value or in-place resource's record is
    // read through the resource (`image.width`). Field lookup follows this
    // `Deref` to the record; nothing is assigned through it, and the record
    // itself is `.repr`, under the raw C rules.
    if facade_render_is_record(pool, intern, repr_text):
        out = out ++ "impl Deref[" ++ repr_text ++ "] for " ++ name ++ ":\n    fn deref() -> &" ++ repr_text ++ ": " ++ (if pinned: "self.repr.as_ref()" else: "&self.repr") ++ "\n"
    // A destroyer through a global takes the pointer the resource is.
    if destroy_globals.len() > 0 and (pinned or not repr_text.starts_with("*")): return ("", facade_render_no_error_use())
    if destroyers.len() > 0 or destroy_globals.len() > 0 or methods.len() > 0:
        out = out ++ "impl " ++ name ++ ":\n" ++ methods
        for destroyer in destroyers:
            let d = destroyer
            let dname = facade_render_present(pool, intern, ci, item, intern.resolve(pool.get_data0(d as NodeId)))
            // D209: `destroys f(param N)` hands the resource at N; the
            // other parameters are the method's, fixed or discarded.
            let at = facade_render_destroyer_at(pool, intern, item, d)
            if at != 0 or facade_render_fixes_or_discards(pool, intern, d):
                let placed = facade_render_bridge(pool, intern, d, 0, at, facade_render_repr_arg_at(pool, intern, d, at, repr_text, "self.repr", pinned))
                if placed.ok: out = out ++ "    move fn " ++ dname ++ "(" ++ placed.params ++ ")" ++ facade_render_return(pool, intern, d) ++ ":\n" ++ facade_render_indent(placed.prologue, "        ") ++ "        self.live = false\n        " ++ facade_render_call(pool, intern, d, placed.args) ++ "\n"
                continue
            let (params, args) = facade_render_params(pool, intern, d, 1)
            let repr_arg = facade_render_repr_arg(pool, intern, d, repr_text, "self.repr", pinned)
            let call_args = if args.len() > 0: repr_arg ++ ", " ++ args else: repr_arg
            out = out ++ "    move fn " ++ dname ++ "(" ++ params ++ ")" ++ facade_render_return(pool, intern, d) ++ ":\n        self.live = false\n        " ++ facade_render_call(pool, intern, d, call_args) ++ "\n"
        for hook in destroy_globals:
            let hname = intern.resolve(hook)
            let (_, result, _) = facade_render_global_fn_shape(pool, intern, hook)
            let call = facade_render_call_through_global(pool, intern, hook, "self.repr", "        ", name ++ ": 'destroys " ++ hname ++ "', but " ++ hname ++ " is NULL (§31.11)")
            out = out ++ "    move fn " ++ facade_render_present(pool, intern, ci, item, hname) ++ "()" ++ (if result.len() > 0: " " ++ result else: "") ++ ":\n        self.live = false\n        " ++ call ++ "\n"
    // `ok CONST` projects every status-returning producer — an out-parameter
    // producer or the in-place `init` — onto `Result[R, <R>Error]`
    // (facade_render_error_type); only out-parameter production can still
    // produce on failure, so only it adds the failed-state resource.
    // `Failed` also carries the library's text when every producer that
    // can fail is received through a parent stating `message` (ruling
    // Amendment 3): one error type, one shape.
    var status_type = ""
    var failed_state = false
    var init_has_ok = false
    var with_message = true
    if ok_syms.len() > 0:
        for pi in 0..producers.len():
            let ret = if producers[pi] != 0 and out_refs[pi] != 0: facade_render_return(pool, intern, producers[pi]) else: ""
            if ret.len() > 0:
                failed_state = true
                if facade_render_producer_message_call(pool, intern, ci, producers[pi]).len() == 0: with_message = false
                if status_type.len() == 0:
                    status_type = ret.slice(4, ret.len())
    // An initializer under `ok`, the resource's or its own, projects onto
    // the same error type.
    var status_k = -1
    for status_init in init_fns:
        status_k += 1
        if status_init == 0 or (ok_syms.len() == 0 and pool.get_data2(init_clauses[status_k] as NodeId) < 2): continue
        let ret = facade_render_return(pool, intern, status_init)
        if ret.len() > 0:
            init_has_ok = true
            status_type = ret.slice(4, ret.len())
            with_message = false
    if not failed_state: with_message = false
    // #3121 (§16.2b.4): a consuming same-type pointer producer with
    // `null status CONST` returns `Result[R, E]` whose `FailedWithResource`
    // carries `R` back in a good state.
    var consuming_good = false
    var consuming_status_type = ""
    if facade_render_unalias(pool, intern, repr_text).starts_with("*"):
        var pi: isize = -1
        for prod in producers:
            pi += 1
            if prod == 0 or out_refs[pi] != 0: continue
            let (cidx, nstat) = facade_render_consuming_same_producer(pool, intern, item, prod)
            if cidx >= 0 and nstat != 0:
                consuming_good = true
                if consuming_status_type.len() == 0:
                    consuming_status_type = facade_render_status_const_type(pool, intern, nstat)
    if status_type.len() == 0 and consuming_good:
        status_type = consuming_status_type
    // The generated error never owns a dependent child (ruling §18: the
    // error "may" own the failure-state resource "where required" — an
    // error escapes scopes, a dependent value cannot). A dependent
    // resource's failure that still produced is destroyed at once in the
    // constructor (facade_render_out_producer) and its error carries no
    // `FailedWithResource`.
    let dependent = deps.slot_res.len() > 0
    let good_in_error = consuming_good and not failed_state and not dependent
    if status_type.len() > 0:
        out = out ++ facade_render_error_type(pool, intern, name, repr_text, status_type, failed_state, failed_state and not dependent, good_in_error, failed_state or init_has_ok, drop_fn, drop_global, failed_methods, with_message, shared.len() > 0)
    // Borrowed returns of this resource (ruling §26): `Borrowed<R>`.
    out = out ++ facade_render_borrowed_type(pool, intern, ci, item, repr_text, plain_methods)
    for pi in 0..producers.len():
        let producer = producers[pi]
        if producer == 0:
            continue
        // The constructor's presented name (§16.2b.11): the C name less the
        // resource's prefix, or the parent's for a resource made from one.
        let pname = facade_render_present(pool, intern, ci, item, intern.resolve(pool.get_data0(producer as NodeId)))
        let made_deps = facade_render_dep_values(pool, intern, deps, pi as i32, producer) ++ keep_init
        if out_refs[pi] != 0:
            let slot = facade_render_param_ref(pool, intern, producer, out_refs[pi])
            if slot < 0:
                continue
            // Under the shared error each producer reads its own text, when
            // it has one: the variant's shape is the facade's, not this
            // resource's.
            let message_call = if with_message or shared_message: facade_render_producer_message_call(pool, intern, ci, producer) else: ""
            let (ctor, result) = facade_render_out_producer(pool, intern, name, repr_text, producer, pname, slot, ok_syms, made_deps, drop_fn, drop_global, message_call, shared, shared_message)
            out = out ++ ctor ++ facade_render_receiver_method(pool, intern, ci, item, producer, slot, pname, result)
            continue
        let bridge = facade_render_bridge(pool, intern, producer, 0, -1, "")
        let params = bridge.params
        let args = bridge.args
        // D122 (§16.2b.8): a paired buffer's pointer and count are the
        // bridge's prologue locals, made before the call.
        let pro = facade_render_indent(bridge.prologue, "    ")
        let call = facade_render_call(pool, intern, producer, args)
        var result = name
        if facade_render_unalias(pool, intern, repr_text).starts_with("*"):
            let (cidx, nstat) = facade_render_consuming_same_producer(pool, intern, item, producer)
            if cidx >= 0 and nstat != 0:
                // #3121 (§16.2b.4): a consuming same-type pointer producer
                // presents `move fn <name>(...) -> Result[R, E]`, returning
                // the input intact in `FailedWithResource` when C returns NULL.
                let taken = facade_render_param_names(pool, intern, producer)
                let prev_var = facade_render_fresh("prev", taken)
                let next_var = facade_render_fresh("next", taken)
                let cbridge = facade_render_bridge(pool, intern, producer, 0, cidx, prev_var)
                let cpro = facade_render_indent(cbridge.prologue, "        ")
                let ccall = facade_render_call(pool, intern, producer, cbridge.args)
                let err = if failed_state: facade_render_fn_error_name(pname) else if shared.len() > 0: shared else: facade_render_error_name(name)
                let variant = if failed_state: "FailedWithResource" else: facade_render_failed_with_name(name, shared.len() > 0)
                if failed_state:
                    let st = facade_render_status_const_type(pool, intern, nstat)
                    out = out ++ "error " ++ err ++ " =\n    | FailedWithResource(status: " ++ st ++ ", resource: " ++ name ++ ")\n"
                let const_text = intern.resolve(nstat)
                out = out ++ "impl " ++ name ++ ":\n    move fn " ++ pname ++ "(" ++ cbridge.params ++ ") -> Result[" ++ name ++ ", " ++ err ++ "]:\n" ++ cpro ++ "        let " ++ prev_var ++ " = self.repr\n        self.live = false\n        let " ++ next_var ++ " = " ++ ccall ++ "\n        if " ++ next_var ++ " == null: return Err(" ++ err ++ "." ++ variant ++ "(" ++ const_text ++ ", " ++ name ++ " { " ++ keep_init ++ "repr: " ++ prev_var ++ ", live: true }))\n        Ok(" ++ name ++ " { " ++ keep_init ++ "repr: " ++ next_var ++ ", live: true })\n"
                continue
            // Unknown nullability is nullable, never silently non-null
            // (§16.2b.8): a pointer producer yields `Option[R]`, and a NULL
            // produced nothing — no Drop is armed over it (§16.2b.4). The
            // facade's `from` is the trusted evidence that a non-null return
            // is the produced resource (§16.2b.4, ruling §19).
            // §31.8.2: `from F, nonnull` presents `R`; a NULL return is a
            // contract failure naming the producer.
            let cname = intern.resolve(pool.get_data0(producer as NodeId))
            let nonnull = facade_render_produced_field(pool, intern, item, cname).0 == "nonnull"
            if not nonnull: result = "Option[" ++ name ++ "]"
            let repr = facade_render_fresh("repr", facade_render_param_names(pool, intern, producer))
            let value = name ++ " { " ++ made_deps ++ "repr: " ++ repr ++ ", live: true }"
            let produced = "fn " ++ name ++ "." ++ pname ++ "(" ++ params ++ ") -> " ++ result ++ ":\n" ++ pro ++ "    let " ++ repr ++ " = " ++ call ++ "\n"
            if nonnull: out = out ++ produced ++ "    if " ++ repr ++ " == null: panic(\"" ++ cname ++ ": the contract states 'from " ++ cname ++ ", nonnull', and C returned NULL (§31.8.2)\")\n    " ++ value ++ "\n"
            else: out = out ++ produced ++ "    if " ++ repr ++ " == null: None else: Some(" ++ value ++ ")\n"
        else:
            // §16.2b.4: a by-value producer states the field whose NULL
            // means nothing was produced, checked when the call returns:
            // `nullable field` presents `Option[R]`; `nonnull field`
            // presents `R`, and a NULL there is a contract failure.
            let cname = intern.resolve(pool.get_data0(producer as NodeId))
            // A `nonnull` with no field on a by-value producer is Sema's
            // error (§31.8.2); the rendering states no check for it.
            let (stated_mode, field_path) = facade_render_produced_field(pool, intern, item, cname)
            let field_mode = if field_path.len() == 0: "" else: stated_mode
            let repr = facade_render_fresh("repr", facade_render_param_names(pool, intern, producer))
            let value = name ++ " { " ++ made_deps ++ "repr: " ++ (if field_mode.len() == 0: call else: repr) ++ ", live: true }"
            if field_mode == "nullable": result = "Option[" ++ name ++ "]"
            let head = "fn " ++ name ++ "." ++ pname ++ "(" ++ params ++ ") -> " ++ result ++ ":\n" ++ pro
            if field_mode.len() == 0: out = out ++ head ++ "    " ++ value ++ "\n"
            else:
                let produced = head ++ "    let " ++ repr ++ " = " ++ call ++ "\n"
                if field_mode == "nullable": out = out ++ produced ++ "    if " ++ repr ++ "." ++ field_path ++ " == null: None else: Some(" ++ value ++ ")\n"
                else: out = out ++ produced ++ "    if " ++ repr ++ "." ++ field_path ++ " == null: panic(\"" ++ cname ++ ": the facade states 'nonnull field " ++ field_path ++ "', and C returned it NULL (§16.2b.4)\")\n    " ++ value ++ "\n"
        out = out ++ facade_render_receiver_method(pool, intern, ci, item, producer, -1, pname, result)
    var k = -1
    for each_init in init_fns:
        k += 1
        if each_init == 0: continue
        let iname = facade_render_present(pool, intern, ci, item, intern.resolve(pool.get_data0(each_init as NodeId)))
        // The initializer's own `ok` when it states one; the resource's
        // otherwise.
        let init_oks = facade_render_init_oks(pool, init_clauses[k], ok_syms)
        let ctor = facade_render_init(pool, intern, name, repr_text, each_init, iname, preinit_fn, init_oks, pinned, facade_render_dep_values(pool, intern, deps, facade_dep_init(k), each_init) ++ keep_init, shared, shared_message)
        if ctor.len() == 0:
            return ("", facade_render_no_error_use())
        out = out ++ ctor
    // An out-parameter producer under `ok` (failed_state) can report
    // `NothingProduced`, a dependent one too; only an owner's failure keeps
    // the resource.
    (out, FacadeErrorUse { status_type: status_type, failed_with: failed_state and not dependent, failed_with_good: good_in_error, nothing_produced: failed_state })

// ── stage 6: dependency (ruling §26-§30, spec §16.2b.6) ─────────────────
//
// A producer that receives modeled resources produces a resource dependent
// on them unless the facade states otherwise (§16.2b.6: "unknown
// independence means dependency"): `independent` says the resource depends
// on nothing it was made from, and `borrows param N` names exactly the
// parameters a producer's result depends on (the producer stated before the
// clause, a `from` or the `init`). Every received resource — a parent or
// not — is presented to the constructor as a borrow `&P` of the resource
// that wraps its representation, and handed to C as `p.repr`; the raw
// representation is never a constructor parameter. SemaFacade.with
// facade_producer_parents makes the same classification from the
// signatures; the two agree, or Sema's net (verify_facade_dependency_shape)
// is loud.

// The owner index of the in-place `init` among a resource's producers (a
// `from` is its index).
pub const FACADE_DEP_INIT: i32 = -1

// A resource may state several `init` clauses, each a constructor (Eric,
// 2026-11-21). The first is FACADE_DEP_INIT; the k-th after it is -10 - k,
// clear of every `from` index and of the "none yet" marker -2.
fn facade_dep_init(k: isize) -> i32: if k == 0: FACADE_DEP_INIT else: -10 - (k as i32)
fn facade_dep_is_init(owner: i32) -> bool: owner == FACADE_DEP_INIT or owner <= -11
fn facade_dep_init_index(owner: i32) -> i32: if owner == FACADE_DEP_INIT: 0 else: -10 - owner

// The success statuses an `init` clause is compared with: the ones it
// states for itself (`init f(self), ok K`, the operands after the
// function), else the resource's.
fn facade_render_init_oks(pool: &AstPool, clause: i32, resource_oks: &List[i32]):
    let out = []
    let ops = pool.get_data1(clause as NodeId)
    for k in 1..pool.get_data2(clause as NodeId): out.push(pool.get_extra(ops + k))
    if out.len() == 0:
        for status in resource_oks: out.push(status)
    out

// A resource's parents: one entry per (owner, parameter) the owner's result
// depends on, with the resource item wrapping that parameter's
// representation and the parent slot it fills; the slots are the view
// fields the rendered type carries, one per parent a producer can have (a
// resource type with two producers depending on two Databases carries two).
type FacadeDeps {
    ok: bool,
    owners: List[i32],
    params: List[i32],
    resources: List[i32],
    slots: List[i32],
    slot_res: List[i32],
    slot_optional: List[bool],
}

// The dependencies of resource `item` as its clauses state them: the one
// derivation both the resource's own type (facade_render_resource) and a
// parent borrow of it (facade_render_parent_field) read.
fn facade_render_item_deps(pool: &AstPool, intern: &InternPool, ci: &List[i32], item: i32):
    let extra_start = pool.get_data1(item as NodeId)
    let producers: List[i32] = []
    let out_refs: List[i32] = []
    let borrow_refs: List[i32] = []
    let borrow_owners: List[i32] = []
    var last_producer: i32 = -2
    var independent = false
    let inits = []
    var preinit_fn: i32 = 0
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(extra_start + 1 + k)
        let kind = pool.get_data0(clause as NodeId)
        let ops = pool.get_data1(clause as NodeId)
        if kind == FACADE_CLAUSE_FROM:
            producers.push(facade_render_find_fn(pool, intern, ci, pool.get_extra(ops)))
            out_refs.push(pool.get_extra(ops + 1))
            last_producer = (producers.len() - 1) as i32
        else if kind == FACADE_CLAUSE_BORROWS:
            borrow_refs.push(pool.get_extra(ops))
            borrow_owners.push(last_producer)
        else if kind == FACADE_CLAUSE_INDEPENDENT:
            independent = true
        else if kind == FACADE_CLAUSE_INIT:
            last_producer = facade_dep_init(inits.len())
            inits.push(facade_render_find_fn(pool, intern, ci, pool.get_extra(ops)))
        else if kind == FACADE_CLAUSE_PREINIT:
            preinit_fn = facade_render_find_fn(pool, intern, ci, pool.get_extra(ops))
    facade_render_deps(pool, intern, item, producers, out_refs, inits, preinit_fn, borrow_refs, borrow_owners, independent)

// D85 (§16.2b.6): the field of resource `item` that holds its parent named
// `parent` — the one view a parent borrow is read from. "" unless exactly
// one slot holds that parent and every producer fills it (Sema refuses the
// other shapes first: verify_facade_parent_borrow).
fn facade_render_parent_field(pool: &AstPool, intern: &InternPool, ci: &List[i32], item: i32, parent: &str) -> str:
    let deps = facade_render_item_deps(pool, intern, ci, item)
    if not deps.ok:
        return ""
    var found: i32 = -1
    for si in 0..deps.slot_res.len():
        if intern.resolve(pool.get_data0(deps.slot_res[si] as NodeId)) == parent:
            if found >= 0:
                return ""
            found = si as i32
    if found < 0 or deps.slot_optional[found]:
        return ""
    facade_render_slot_field(deps, found)

// #3121 (§16.2b.4): when `producer` is a direct-return producer whose fn
// item states `consumes param N` (without `destroyed_by`) for a parameter
// receiving resource `item`, returns `(N, null_status_sym)`; else `(-1, 0)`.
fn facade_render_consuming_same_producer(pool: &AstPool, intern: &InternPool, item: i32, producer: i32) -> (i32, i32):
    let fn_item = facade_render_fn_item(pool, intern, producer)
    if fn_item == 0: return (-1, 0)
    let meta = pool.find_fn_meta(producer as NodeId)
    if meta < 0: return (-1, 0)
    let start = pool.fn_meta_param_start(meta)
    var consume_idx: i32 = -1
    var null_status: i32 = 0
    let cstart = pool.get_data1(fn_item as NodeId)
    for k in 0..pool.get_data2(fn_item as NodeId):
        let clause = pool.get_extra(cstart + k)
        let kind = pool.get_data0(clause as NodeId)
        let ops = pool.get_data1(clause as NodeId)
        if kind == FACADE_CLAUSE_CONSUMES and pool.get_extra(ops + 1) == 0:
            let pi = facade_render_param_ref(pool, intern, producer, pool.get_extra(ops))
            if pi >= 0 and pi < pool.fn_meta_param_count(meta):
                let ptext = render_type_expr(pool, intern, pool.fn_param_type(start, pi) as NodeId)
                if facade_render_received(pool, intern, ptext) == item:
                    consume_idx = pi
        else if kind == FacadeStatusClause.NullStatus as i32:
            null_status = pool.get_extra(ops)
    (consume_idx, null_status)

// The declared With type of an imported status constant, or `c_int` for an
// untyped constant or integer literal.
fn facade_render_status_const_type(pool: &AstPool, intern: &InternPool, sym: i32) -> str:
    let want = intern.resolve(sym)
    for di in 0..pool.decl_count():
        let decl = pool.get_decl(di)
        let type_node = facade_render_global_type_node(pool, decl as i32)
        if type_node != 0 and intern.resolve(pool.get_data0(decl)) == want:
            let ty = render_type_expr(pool, intern, type_node as NodeId)
            if ty.len() > 0: return ty
    "c_int"

fn facade_render_deps(pool: &AstPool, intern: &InternPool, item: i32, producers: &List[i32], out_refs: &List[i32], inits: &List[i32], preinit_fn: i32, borrow_refs: &List[i32], borrow_owners: &List[i32], independent: bool) -> FacadeDeps:
    let deps = FacadeDeps { ok: true, owners: [], params: [], resources: [], slots: [], slot_res: [], slot_optional: [] }
    // Every owner: each `from`, then the `init`.
    let owners: List[i32] = []
    let decls: List[i32] = []
    let firsts: List[i32] = []
    let skips: List[i32] = []
    for pi in 0..producers.len():
        if producers[pi] == 0:
            continue
        owners.push(pi as i32)
        decls.push(producers[pi])
        firsts.push(0)
        skips.push(if out_refs[pi] != 0: facade_render_param_ref(pool, intern, producers[pi], out_refs[pi]) else: -1)
    var init_k = -1
    for each_init in inits:
        init_k += 1
        if each_init == 0: continue
        owners.push(facade_dep_init(init_k))
        decls.push(each_init)
        firsts.push(1)
        skips.push(-1)
        // A resource the in-place resource depends on is received by its
        // `init`; preinit only constructs storage (Sema names a preinit that
        // receives one).
        if preinit_fn != 0 and facade_render_receives_any(pool, intern, preinit_fn, 0, -1):
            deps.ok = false
            return deps
    for oi in 0..owners.len():
        let owner = owners[oi]
        let decl = decls[oi]
        let meta = pool.find_fn_meta(decl as NodeId)
        if meta < 0:
            continue
        let start = pool.fn_meta_param_start(meta)
        // Every received resource must be presentable, parent or not.
        for pi in firsts[oi]..pool.fn_meta_param_count(meta):
            if pi == skips[oi]:
                continue
            // Match SemaFacade.facade_param_receives: a parameter paired as a
            // buffer, fixed to a literal, or discarded never receives a resource.
            if facade_render_buffer_of(pool, intern, decl, pi).0 == pi or facade_render_fixed_literal(pool, intern, decl, pi).len() > 0 or facade_render_discarded(pool, intern, decl, pi):
                continue
            let ptext = render_type_expr(pool, intern, pool.fn_param_type(start, pi) as NodeId)
            let res = facade_render_received_param(pool, intern, decl, pi, ptext)
            if res < 0 or (res > 0 and facade_render_received_arg(pool, intern, res, ptext, "p").len() == 0):
                deps.ok = false
                return deps
        if independent:
            continue
        var stated = false
        for bi in 0..borrow_refs.len():
            if borrow_owners[bi] != owner:
                continue
            stated = true
            let pi = facade_render_param_ref(pool, intern, decl, borrow_refs[bi])
            let res = if pi >= 0: facade_render_received_param(pool, intern, decl, pi, render_type_expr(pool, intern, pool.fn_param_type(start, pi) as NodeId)) else: 0
            if res <= 0:
                deps.ok = false
                return deps
            deps.owners.push(owner)
            deps.params.push(pi)
            deps.resources.push(res)
        if stated:
            continue
        for pi in firsts[oi]..pool.fn_meta_param_count(meta):
            if pi == skips[oi]:
                continue
            // #3121: a consumed same-type parameter transfers ownership,
            // never a parent borrow.
            if skips[oi] < 0 and facade_render_consuming_same_producer(pool, intern, item, decl).0 == pi: continue
            // D214 / §16.2b.8: a fixed, discarded, or buffer-paired parameter
            // receives no parent resource.
            if facade_render_buffer_of(pool, intern, decl, pi).0 == pi or facade_render_fixed_literal(pool, intern, decl, pi).len() > 0 or facade_render_discarded(pool, intern, decl, pi): continue
            let res = facade_render_received_param(pool, intern, decl, pi, render_type_expr(pool, intern, pool.fn_param_type(start, pi) as NodeId))
            if res > 0:
                deps.owners.push(owner)
                deps.params.push(pi)
                deps.resources.push(res)
    // Slots: the k-th parent of resource P an owner has fills the k-th slot
    // of P; a slot some owner leaves empty is optional.
    for di in 0..deps.owners.len():
        var seen = 0
        for dj in 0..di:
            if deps.owners[dj] == deps.owners[di] and deps.resources[dj] == deps.resources[di]:
                seen = seen + 1
        var slot: i32 = -1
        var k = 0
        for si in 0..deps.slot_res.len():
            if deps.slot_res[si] == deps.resources[di]:
                if k == seen:
                    slot = si as i32
                    break
                k = k + 1
        if slot < 0:
            slot = deps.slot_res.len() as i32
            deps.slot_res.push(deps.resources[di])
            deps.slot_optional.push(false)
        deps.slots.push(slot)
    for si in 0..deps.slot_res.len():
        for oi in 0..owners.len():
            var filled = false
            for di in 0..deps.owners.len():
                if deps.owners[di] == owners[oi] and deps.slots[di] == si:
                    filled = true
            if not filled:
                deps.slot_optional[si] = true
    deps

// A parent slot's field: `parent` when the type carries one, else
// `parent_<k>`.
fn facade_render_slot_field(deps: &FacadeDeps, si: i32) -> str: if deps.slot_res.len() == 1: "parent" else: f"parent_{si}"

// `parent: &Database, ` — each slot a view of its parent, `Option` when
// some producer has no parent to put there.
fn facade_render_dep_fields(pool: &AstPool, intern: &InternPool, deps: &FacadeDeps):
    var out = ""
    for si in 0..deps.slot_res.len():
        let pname = intern.resolve(pool.get_data0(deps.slot_res[si] as NodeId))
        let optional: bool = deps.slot_optional[si]
        let ty = if optional: "Option[&" ++ pname ++ "]" else: "&" ++ pname
        out = out ++ facade_render_slot_field(deps, si as i32) ++ ": " ++ ty ++ ", "
    out

// `parent: db, ` — what owner `owner` puts in each slot: the parameter that
// received the parent (a `&P` in the constructor), or `None`.
fn facade_render_dep_values(pool: &AstPool, intern: &InternPool, deps: &FacadeDeps, owner: i32, decl: i32) -> str:
    var out = ""
    let meta = pool.find_fn_meta(decl as NodeId)
    if meta < 0:
        return out
    let start = pool.fn_meta_param_start(meta)
    for si in 0..deps.slot_res.len():
        var value = "None"
        for di in 0..deps.owners.len():
            if deps.owners[di] == owner and deps.slots[di] == si:
                let pname = facade_render_param_name(pool, intern, start, deps.params[di])
                let optional: bool = deps.slot_optional[si]
                value = if optional: "Some(" ++ pname ++ ")" else: pname
        out = out ++ facade_render_slot_field(deps, si as i32) ++ ": " ++ value ++ ", "
    out

// The resource whose representation a parameter of type `ptext` receives:
// a pointer resource's handle, or an in-place resource's storage by address
// (or by value — never presentable while pinned), or — never presentable —
// a pointer to a pointer resource's handle. A by-value token is not
// recognized by its type: `int` is an `Fd` and every other integer alike, so
// a parameter of that type is not taken to be the resource (Sema's
// facade_param_takes_resource draws the same line). 0 when none; -1 when
// several resources wrap it, since the facade has not assigned it
// (§16.2b.3, Sema names the candidates).
fn facade_render_received_param(pool: &AstPool, intern: &InternPool, decl: i32, pi: i32, ptext: &str) -> i32:
    let res = facade_render_received(pool, intern, ptext)
    if res != -1: return res
    let fn_item = facade_render_fn_item(pool, intern, decl)
    if fn_item != 0:
        let cstart = pool.get_data1(fn_item as NodeId)
        for k in 0..pool.get_data2(fn_item as NodeId):
            let clause = pool.get_extra(cstart + k)
            if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_OF: continue
            let ops = pool.get_data1(clause as NodeId)
            let of_sym = pool.get_extra(ops)
            let of_at = if pool.get_data2(clause as NodeId) >= 2: facade_render_param_ref(pool, intern, decl, pool.get_extra(ops + 1)) else: 0
            if of_at == pi:
                let want = intern.resolve(of_sym)
                for ritem in facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE):
                    if intern.resolve(pool.get_data0(ritem as NodeId)) == want: return ritem
    -1

fn facade_render_received(pool: &AstPool, intern: &InternPool, ptext: &str) -> i32:
    let p = facade_render_unalias(pool, intern, ptext)
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE)
    var found: i32 = 0
    for item in items:
        let res = item
        let repr = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.get_extra(pool.get_data1(res as NodeId)) as NodeId))
        // A by-value token is recognized by its type when it is a record:
        // `int` is an `Fd` only where an `of` says so (#1669), but a C
        // record a resource wraps is that resource wherever it is passed
        // (§16.2b.3: one resource per representation).
        if not repr.starts_with("*") and not facade_render_has_clause(pool, res, FACADE_CLAUSE_INIT) and not facade_render_is_record(pool, intern, repr):
            continue
        if p == repr or p == "*mut " ++ repr or p == "*const " ++ repr or facade_render_const_of(p, repr):
            if found != 0:
                return -1
            found = res
    found

fn facade_render_receives_any(pool: &AstPool, intern: &InternPool, decl: i32, first: i32, skip: i32) -> bool:
    let meta = pool.find_fn_meta(decl as NodeId)
    if meta < 0:
        return false
    let start = pool.fn_meta_param_start(meta)
    for pi in first..pool.fn_meta_param_count(meta):
        // A fixed parameter is the facade's argument, received from nobody
        // (D214: a parent fixed to null leaves the product independent).
        if pi != skip and facade_render_fixed_literal(pool, intern, decl, pi).len() == 0 and facade_render_received(pool, intern, render_type_expr(pool, intern, pool.fn_param_type(start, pi) as NodeId)) != 0:
            return true
    false

// How a constructor hands the received resource `place` (a `&P`) to a C
// parameter of type `ptext`: `place.repr` for the representation itself,
// the cell's address for a pinned in-place resource, `&raw const
// place.repr` for a movable one read through a const pointer. "" for a
// shape a borrow cannot present — a pointer to a pointer resource's handle
// (C could replace it), a pinned representation by value (a copy of storage
// whose address the library may keep), a movable one through `*mut` (a
// write through a shared borrow): Sema names it.
fn facade_render_received_arg(pool: &AstPool, intern: &InternPool, res: i32, ptext: &str, place: &str) -> str:
    let p = facade_render_unalias(pool, intern, ptext)
    let repr = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.get_extra(pool.get_data1(res as NodeId)) as NodeId))
    let in_place = facade_render_has_clause(pool, res, FACADE_CLAUSE_INIT)
    let pinned = in_place and not facade_render_has_clause(pool, res, FACADE_CLAUSE_MOVABLE)
    if p == repr:
        return if pinned: "" else: place ++ ".repr"
    if facade_render_const_of(p, repr):
        return place ++ ".repr as " ++ p
    if repr.starts_with("*"):
        return ""
    if pinned:
        return if p.starts_with("*mut "): place ++ ".repr.as_mut_ptr()" else: place ++ ".repr.as_ptr()"
    if p.starts_with("*const "):
        return "&raw const " ++ place ++ ".repr"
    ""

// The in-place constructor (ruling §13, spec §16.2b.4): storage first — the
// representation's ordinary zeroed construction `Repr {}` (every field of an
// imported struct carries its zero default; ruling §67 consumes that rule)
// or the `preinit` operation's result — then the C initializer over a
// pointer to it. A void init yields `R`. A status-returning init without
// `ok` yields `(status, R)`: the status is uninterpreted (§16.2b.4), the
// facade's `init` is the production evidence, and the status is handed back
// unread.
//
// With `ok CONST` the result is the Result projection (Eric, 2026-09-23, on
// #1426), `Result[R, <R>Error]`, where `<R>Error` has the one variant
// `Failed(status)` (a failed init produced nothing — §16.2b.3: "Drop is armed
// only when initialization establishes production"). A failed init returns
// `Err` before the storage becomes an `R`, so no `R` — armed or not — ever
// holds storage C did not initialize, and no destroyer can reach it. The
// storage is then dropped as ordinary With storage: for a pinned resource
// that is the one path on which the Box cell is freed with no destruction
// call, because nothing was produced to destroy (ruling §13.2: "the foreign
// destructor does not run … ordinary With storage cleanup still occurs").
//
// Pinned (the default, D54): the storage is a Box cell the value owns, so
// the cell exists — with its one address — from the construction of R,
// before `live`; every pointer handed to C points into it; and on drop the
// destruction operation runs in R's own Drop before the field's Drop frees
// the cell (the cell outlives the C state, never the reverse).
//
//     fn R.init(<preinit args>, <init args after self>) -> Result[R, RError]:
//         var repr = Box.new(Repr {})                     // or Box.new(preinit(<preinit args>))
//         let status = init(repr.as_mut_ptr(), <args>)
//         if status != OK: return Err(RError.Failed(status))   // the cell is freed; no destroyer
//         Ok(R { repr: repr, live: true })
//
// `movable`: the same over a by-value field — `var repr = Repr {}` and
// `init(&raw mut repr, <args>)`.
//
// The constructor is named after the C initializer under its presented name
// `iname` (§16.2b.11, facade_render_present: `Counter.init` for
// `counter_init` on `Counter`, `Stream.inflateInit` where no prefix matches,
// or its `rename`).
fn facade_render_init(pool: &AstPool, intern: &InternPool, name: &str, repr_text: &str, init_fn: i32, iname: &str, preinit_fn: i32, ok_syms: &List[i32], pinned: bool, deps: &str, shared: &str, shared_message: bool) -> str:
    // The storage and status locals are spelled apart from every parameter
    // the constructor takes (preinit's, then init's).
    var taken = facade_render_param_names(pool, intern, init_fn)
    if preinit_fn != 0:
        taken = taken ++ ", " ++ facade_render_param_names(pool, intern, preinit_fn)
    let repr = facade_render_fresh("repr", taken)
    let status = facade_render_fresh("status", taken)
    let storage_arg = facade_render_repr_arg(pool, intern, init_fn, repr_text, repr, pinned)
    if storage_arg.len() == 0 or storage_arg == repr:
        return ""
    let (iparams, iargs) = facade_render_params(pool, intern, init_fn, 1)
    var params = iparams
    // §16.2b.3: in-place storage begins as `Representation.zeroed()`.
    var storage = repr_text ++ ".zeroed()"
    if preinit_fn != 0:
        let (pparams, pargs) = facade_render_params(pool, intern, preinit_fn, 0)
        if pparams.len() > 0:
            params = if params.len() > 0: pparams ++ ", " ++ params else: pparams
        storage = facade_render_call(pool, intern, preinit_fn, pargs)
    if pinned: storage = "Box.new(" ++ storage ++ ")"
    let ret = facade_render_return(pool, intern, init_fn)
    let call_args = if iargs.len() > 0: storage_arg ++ ", " ++ iargs else: storage_arg
    let call = facade_render_call(pool, intern, init_fn, call_args)
    let out = "fn " ++ name ++ "." ++ iname ++ "(" ++ params ++ ")"
    let made = name ++ " { " ++ deps ++ "repr: " ++ repr ++ ", live: true }"
    if ret.len() == 0:
        if ok_syms.len() > 0:
            return ""
        return out ++ " -> " ++ name ++ ":\n    var " ++ repr ++ " = " ++ storage ++ "\n    " ++ call ++ "\n    " ++ made ++ "\n"
    let status_type = ret.slice(4, ret.len())
    if ok_syms.len() == 0:
        return out ++ " -> (" ++ status_type ++ ", " ++ name ++ "):\n    var " ++ repr ++ " = " ++ storage ++ "\n    let " ++ status ++ " = " ++ call ++ "\n    (" ++ status ++ ", " ++ made ++ ")\n"
    let err = if shared.len() > 0: shared else: facade_render_error_name(name)
    let failed_args = if shared_message: status ++ ", \"\"" else: status
    out ++ " -> Result[" ++ facade_render_ok_type(intern, ok_syms, status_type, name) ++ ", " ++ err ++ "]:\n    var " ++ repr ++ " = " ++ storage ++ "\n    let " ++ status ++ " = " ++ call ++ "\n    if " ++ facade_render_not_ok(intern, ok_syms, status) ++ ": return Err(" ++ err ++ ".Failed(" ++ failed_args ++ "))\n    Ok(" ++ facade_render_ok_value(intern, ok_syms, status, made) ++ ")\n"

// D245 (§16.2b.4): one status failure test — `status < C` for `ok >= C`,
// `status != C` for `ok C`.
fn facade_render_status_test(status: &str, ok_text: &str) -> str:
    if ok_text.starts_with(">="): status ++ " < " ++ ok_text.slice(2, ok_text.len())
    else: status ++ " != " ++ ok_text

// Whether `ok` matches more than one value (a list `ok C1, C2` or a lower
// bound `ok >= C`), so the `Ok` side carries the matched status.
fn facade_render_ok_carries_status(intern: &InternPool, ok_syms: &List[i32]) -> bool:
    if ok_syms.len() > 1: return true
    ok_syms.len() == 1 and intern.resolve(ok_syms[0]).starts_with(">=")

// The failure test of `ok C1, C2, …` or `ok >= C` over the status local
// (§16.2b.4, ruling Amendment 1, D245): any listed constant or bound is
// success, so failure is none of them.
fn facade_render_not_ok(intern: &InternPool, ok_syms: &List[i32], status: &str):
    var out = ""
    for k in 0..ok_syms.len():
        out = out ++ (if k > 0: " and " else: "") ++ facade_render_status_test(status, intern.resolve(ok_syms[k]))
    out

// What the `Ok` side carries (§16.2b.4): the produced value — and, when
// `ok` lists several success statuses or a lower bound `>= C`, the status
// that matched beside it, as `(status, R)`: the order of the pair the facade
// renders without `ok` (`(status, Option[R])`, an in-place `(status, R)`).
// One exact success status needs no carrying: it is the constant.
fn facade_render_ok_type(intern: &InternPool, ok_syms: &List[i32], status_type: &str, name: &str) -> str:
    if facade_render_ok_carries_status(intern, ok_syms): "(" ++ status_type ++ ", " ++ name ++ ")" else: name

fn facade_render_ok_value(intern: &InternPool, ok_syms: &List[i32], status: &str, made: &str) -> str:
    if facade_render_ok_carries_status(intern, ok_syms): "(" ++ status ++ ", " ++ made ++ ")" else: made

// An out-parameter producer's constructor (ruling §16, spec §16.2b.4). The
// physical commitment: initialize the slot to NULL, call, inspect the slot —
// non-null is a produced resource whose ownership begins at once, null is
// none. That is production, not success. With no status convention the
// status is uninterpreted and handed back unread beside it, so a failed call
// that still produced (a failed `sqlite3_open` hands back a handle that must
// be closed, ruling §18) yields `Some(R)`, whose Drop runs the destroyer
// exactly once:
//
//     fn R.p(<params but the slot>) -> (S, Option[R]):
//         var slot: Repr = null
//         let status = unsafe { p(<args>, &raw mut slot, <args>) }
//         (status, if slot == null: None else: Some(R { repr: slot, live: true }))
//
// With `ok CONST` the result is the Result projection instead (Eric,
// 2026-09-23, on #1426) — one call surface per production form, and the
// low-level pair is not rendered beside it. Every combination of status and
// slot stays distinct:
//
//     fn R.p(<params but the slot>) -> Result[R, RError]:
//         var slot: Repr = null
//         let status = unsafe { p(<args>, &raw mut slot, <args>) }
//         if status != OK:
//             if slot == null: return Err(RError.Failed(status))
//             return Err(RError.FailedWithResource(status, FailedR { repr: slot }))
//         if slot == null: return Err(RError.NothingProduced(status))
//         Ok(R { repr: slot, live: true })
//
// `ok C1, C2, …` lists several success statuses (§16.2b.4, ruling
// Amendment 1): any is success (`status != C1 and status != C2` is failure),
// and `Ok` carries the one that matched beside the value —
// `Result[(S, R), RError]`, `Ok((status, R { … }))` (facade_render_ok_type).
//
// "Status OK, nothing produced" violates the C contract the facade states
// (`ok` says what success is; a success that produced nothing is not one it
// can hand back as an `R`), and it is its own variant: `Failed` with an OK
// status would read as a contradiction. A failure that produced is owned by
// the error (FailedWithResource), whose Drop destroys it exactly once.
//
// A producer returning nothing yields `Option[R]`. The locals are spelled
// apart from the parameters (facade_render_fresh). The constructor is
// `R.<pname>`, the producer's presented name (§16.2b.11: `Database.open`
// for `sqlite3_open`, or its `rename`). Returns the constructor and its
// result type, which the receiver method repeats.
// `shared` is the facade's one error type, or "" for `<R>Error`; with it,
// `shared_message` says its `Failed` carries a message even where this
// producer reads none.
fn facade_render_out_producer(pool: &AstPool, intern: &InternPool, name: &str, repr_text: &str, producer: i32, pname: &str, slot: i32, ok_syms: &List[i32], deps: &str, drop_fn: i32, drop_global: i32, message_call: &str, shared: &str, shared_message: bool) -> (str, str):
    let taken = facade_render_param_names(pool, intern, producer)
    let slot_var = facade_render_fresh("slot", taken)
    let bridge = facade_render_bridge(pool, intern, producer, 0, slot, "&raw mut " ++ slot_var)
    let params = bridge.params
    let args = bridge.args
    let call = facade_render_call(pool, intern, producer, args)
    let made = name ++ " { " ++ deps ++ "repr: " ++ slot_var ++ ", live: true }"
    let head = "fn " ++ name ++ "." ++ pname ++ "(" ++ params ++ ")"
    // D122 (§16.2b.8): a paired buffer's locals come before the slot.
    let null_slot = facade_render_indent(bridge.prologue, "    ") ++ "    var " ++ slot_var ++ ": " ++ repr_text ++ " = null\n"
    let ret = facade_render_return(pool, intern, producer)
    if ret.len() == 0:
        let result = "Option[" ++ name ++ "]"
        return (head ++ " -> " ++ result ++ ":\n" ++ null_slot ++ "    " ++ call ++ "\n    if " ++ slot_var ++ " == null: None else: Some(" ++ made ++ ")\n", result)
    let status = facade_render_fresh("status", taken)
    let status_type = ret.slice(4, ret.len())
    if ok_syms.len() == 0:
        let result = "(" ++ status_type ++ ", Option[" ++ name ++ "])"
        return (head ++ " -> " ++ result ++ ":\n" ++ null_slot ++ "    let " ++ status ++ " = " ++ call ++ "\n    (" ++ status ++ ", if " ++ slot_var ++ " == null: None else: Some(" ++ made ++ "))\n", result)
    let err = if shared.len() > 0: shared else: facade_render_error_name(name)
    let result = "Result[" ++ facade_render_ok_type(intern, ok_syms, status_type, name) ++ ", " ++ err ++ "]"
    var out = head ++ " -> " ++ result ++ ":\n" ++ null_slot ++ "    let " ++ status ++ " = " ++ call ++ "\n"
    out = out ++ "    if " ++ facade_render_not_ok(intern, ok_syms, status) ++ ":\n"
    // The text is read first: destroying what a failure produced is another
    // call into the library, which may overwrite it.
    var failed_args = status
    if message_call.len() > 0:
        let text = facade_render_fresh("facade_text", taken)
        let message = facade_render_fresh("facade_message", taken)
        out = out ++ "        let " ++ message ++ ": str = match " ++ message_call ++ ":\n            Some(" ++ text ++ ") => " ++ text ++ ".to_str_lossy()\n            None => \"\"\n"
        failed_args = status ++ ", " ++ message
    else if shared_message:
        failed_args = status ++ ", \"\""
    out = out ++ "        if " ++ slot_var ++ " == null: return Err(" ++ err ++ ".Failed(" ++ failed_args ++ "))\n"
    if deps.len() > 0:
        // A dependent resource: the generated error never owns a child
        // (see facade_render_error_type), so a failure that still produced
        // is destroyed here, exactly once, and reported as `Failed`.
        out = out ++ "        " ++ facade_render_drop_call(pool, intern, name, drop_fn, drop_global, repr_text, slot_var, false, "        ") ++ "\n        return Err(" ++ err ++ ".Failed(" ++ failed_args ++ "))\n"
    else:
        out = out ++ "        return Err(" ++ err ++ "." ++ facade_render_failed_with_name(name, shared.len() > 0) ++ "(" ++ status ++ ", " ++ facade_render_failed_name(name) ++ " { repr: " ++ slot_var ++ " }))\n"
    out = out ++ "    if " ++ slot_var ++ " == null: return Err(" ++ err ++ ".NothingProduced(" ++ status ++ "))\n"
    (out ++ "    Ok(" ++ facade_render_ok_value(intern, ok_syms, status, made) ++ ")\n", result)

// The names the Result projection renders beside a resource `R`: its error
// type and the type of a resource a failed producer still produced. Sema
// (SemaFacade.with facade_generated_type_names) refuses a program in which
// either name already denotes another type.
fn facade_render_error_name(name: &str): name ++ "Error"
fn facade_render_failed_name(name: &str): "Failed" ++ name

// ── one error type per facade (§16.2b.4, D97, #2179) ────────────────────
//
// `c facade sqlite error SqliteError:` states one error for every fallible
// operation the facade presents: each producer and status operation under
// `ok` returns `Result[_, SqliteError]`, and the block declares it once
// (facade_render_shared_error_type) in place of each `<R>Error` and
// `<Fn>Error`:
//
//     error SqliteError =
//         | Failed(status: c_int, message: str)
//         | FailedWithDatabase(status: c_int, resource: FailedDatabase)
//         | NothingProduced(status: c_int)
//
// `Failed` carries `message` when a resource of the facade names its
// failure text; an operation whose resource names none reports "".
// `FailedWith<R>` is one variant per resource whose failed producer can
// still produce it, and `NothingProduced` exists when an out-parameter
// producer is projected.

// The facade's one error type for an item of it, or "".
fn facade_render_shared_error(pool: &AstPool, intern: &InternPool, item: i32) -> str:
    let sym = facade_item_error_sym(pool, item)
    if sym == 0: return ""
    let name = intern.resolve(sym)
    name

// Whether the shared error's `Failed` carries `message: str`.
fn facade_render_shared_message(pool: &AstPool, item: i32): facade_render_names_message(pool, facade_of_item(pool, item))

// Whether a resource of the facade names its failure text.
fn facade_render_names_message(pool: &AstPool, facade: i32) -> bool:
    if facade == 0: return false
    let extra_start = pool.get_data1(facade as NodeId)
    for k in 0..pool.get_data2(facade as NodeId):
        let resource = pool.get_extra(extra_start + k)
        if pool.kind(resource as NodeId) == NodeKind.NK_FACADE_RESOURCE and facade_render_has_clause(pool, resource, FACADE_CLAUSE_MESSAGE): return true
    false

// The `FailedWith<R>` variant a failure that still produced `R` is
// reported as: `FailedWithResource` of `<R>Error`, or the shared error's
// own variant for `R`.
fn facade_render_failed_with_name(name: &str, shared: bool) -> str: if shared: "FailedWith" ++ name else: "FailedWithResource"

// The error a presented operation's `ok` projection returns, and whether
// its `Failed` must carry an empty message (the shared error has one and
// the operation's resource names no text).
fn facade_render_op_error(pool: &AstPool, intern: &InternPool, decl: i32, presented: &str) -> (str, bool):
    let item = facade_render_fn_item(pool, intern, decl)
    let shared = if item != 0: facade_render_shared_error(pool, intern, item) else: ""
    if shared.len() == 0: return (facade_render_fn_error_name(presented), false)
    (shared, facade_render_shared_message(pool, item))

// What one resource's projection asks of the shared error.
type FacadeErrorUse {
    status_type: str,
    failed_with: bool,
    failed_with_good: bool,
    nothing_produced: bool,
}

fn facade_render_no_error_use() -> FacadeErrorUse: FacadeErrorUse { status_type: "", failed_with: false, failed_with_good: false, nothing_produced: false }

// The shared error's declaration: the variants the facade's resources ask
// for, over the status type every `ok` reads (Sema refuses two). "" when
// nothing the facade presents states `ok`.
fn facade_render_shared_error_type(pool: &AstPool, intern: &InternPool, ci: &List[i32], facade: i32, names: &List[str], uses: &List[FacadeErrorUse]) -> str:
    let sym = facade_error_sym(pool, facade)
    if sym == 0: return ""
    var status_type = ""
    var nothing_produced = false
    for each_use in uses:
        if status_type.len() == 0: status_type = each_use.status_type
        if each_use.nothing_produced: nothing_produced = true
    if status_type.len() == 0:
        let extra_start = pool.get_data1(facade as NodeId)
        for k in 0..pool.get_data2(facade as NodeId):
            let item = pool.get_extra(extra_start + k)
            if status_type.len() > 0 or pool.kind(item as NodeId) != NodeKind.NK_FACADE_FN:
                continue
            let decl = facade_render_find_fn(pool, intern, ci, pool.get_data0(item as NodeId))
            let ret = if decl != 0 and (facade_render_fn_oks(pool, intern, decl).len() > 0 or facade_render_fn_ok(pool, intern, decl) != 0): facade_render_return(pool, intern, decl) else: ""
            if ret.len() > 0: status_type = ret.slice(4, ret.len())
    if status_type.len() == 0: return ""
    let message = if facade_render_names_message(pool, facade): ", message: str" else: ""
    var out = "error " ++ intern.resolve(sym) ++ " =\n    | Failed(status: " ++ status_type ++ message ++ ")\n"
    for k in 0..uses.len():
        if uses[k].failed_with:
            out = out ++ "    | " ++ facade_render_failed_with_name(names[k], true) ++ "(status: " ++ status_type ++ ", resource: " ++ facade_render_failed_name(names[k]) ++ ")\n"
        else if uses[k].failed_with_good:
            out = out ++ "    | " ++ facade_render_failed_with_name(names[k], true) ++ "(status: " ++ status_type ++ ", resource: " ++ names[k] ++ ")\n"
    if nothing_produced:
        out = out ++ "    | NothingProduced(status: " ++ status_type ++ ")\n"
    out

// `<R>Error` (Eric, 2026-09-23, on #1426): an `error` declaration, so it
// composes with §10.9 (`error AppError from DatabaseError`) and gets the
// generated Error/Debug/Display.
//
//     error DatabaseError =
//         | Failed(status: S)
//         | FailedWithResource(status: S, resource: FailedDatabase)
//         | NothingProduced(status: S)
//
// `FailedWithResource` and `NothingProduced` exist only when an
// out-parameter producer is projected, and `FailedWithResource` only when
// the resource is not dependent (a dependent one is destroyed in the
// constructor instead, ruling §18); a failed in-place init produced
// nothing, and a successful one produced, so its error type is `Failed`
// alone.
//
// The resource a failed producer still produced is `Failed<R>`, not `R`: the
// failure state admits only the operations the facade marks `valid on
// failed` (stage 12b, #1612; spec §16.2b.4) — the lends and text views of
// `R` so marked, rendered here over the same `repr` field under the names
// they have on `R` — and otherwise only raw access to its representation
// under the raw C rules: no destroyers, no callbacks, no unmarked lend. Its
// Drop runs the facade's `drop` exactly once: dropping the error, or
// whatever took the resource out of it, destroys it.
//
//     type FailedDatabase { repr: *mut sqlite3 }
//     impl Drop for FailedDatabase:
//         move fn drop():
//             unsafe { sqlite3_close(self.repr) }
//     impl FailedDatabase:
//         fn errmsg() -> Option[CStr]: …                 // `valid on failed`
// Under the facade's one error type (`shared`) only `Failed<R>` is
// rendered here; the error is the block's (facade_render_shared_error_type).
fn facade_render_error_type(pool: &AstPool, intern: &InternPool, name: &str, repr_text: &str, status_type: &str, out_param: bool, failed_state: bool, failed_good: bool, has_failed: bool, drop_fn: i32, drop_global: i32, failed_methods: &str, with_message: bool, shared: bool) -> str:
    let err = facade_render_error_name(name)
    var out = ""
    if failed_state:
        let failed = facade_render_failed_name(name)
        out = "type " ++ failed ++ " { repr: " ++ repr_text ++ " }\nimpl Drop for " ++ failed ++ ":\n    move fn drop():\n        " ++ facade_render_drop_call(pool, intern, name, drop_fn, drop_global, repr_text, "self.repr", false, "        ") ++ "\n"
        if failed_methods.len() > 0:
            out = out ++ "impl " ++ failed ++ ":\n" ++ failed_methods
    if shared: return out
    out = out ++ "error " ++ err ++ " =\n"
    if has_failed:
        out = out ++ "    | Failed(status: " ++ status_type ++ (if with_message: ", message: str" else: "") ++ ")\n"
    if failed_state:
        out = out ++ "    | FailedWithResource(status: " ++ status_type ++ ", resource: " ++ facade_render_failed_name(name) ++ ")\n"
    else if failed_good:
        out = out ++ "    | FailedWithResource(status: " ++ status_type ++ ", resource: " ++ name ++ ")\n"
    if out_param:
        out = out ++ "    | NothingProduced(status: " ++ status_type ++ ")\n"
    out

fn facade_render_has_clause(pool: &AstPool, resource: i32, kind: i32) -> bool:
    let extra_start = pool.get_data1(resource as NodeId)
    for k in 0..pool.get_data2(resource as NodeId):
        if pool.get_data0(pool.get_extra(extra_start + 1 + k) as NodeId) == kind:
            return true
    false

// The declaring node of a function the facade names, by text: a c_import
// translation and the facade may hold the same name under different symbols.
// A facade describes imported declarations (§16.2b.13), so a c_import one
// (`ci[di]`) wins over a same-named With declaration elsewhere in the
// compilation — std.libc's hand-written `fclose(*mut c_void)` is not the
// `fclose(FILE *)` the program imported.
fn facade_render_find_fn(pool: &AstPool, intern: &InternPool, ci: &List[i32], sym: i32) -> i32:
    let want = intern.resolve(sym)
    facade_render_fn_index(pool, intern, ci)
    let imported: i32 = g_facade_fn_ci_decl.get(want) ?? 0
    if imported != 0: return imported
    g_facade_fn_any_decl.get(want) ?? 0

// The call that destroys the representation at `place`: the `drop`
// function's, or the one through the function-pointer global `drop` names
// (§31.8.6), which takes the pointer the resource is. `indent` is that of
// the line the call starts on. "" when there is neither.
fn facade_render_drop_call(pool: &AstPool, intern: &InternPool, name: &str, drop_fn: i32, drop_global: i32, repr_text: &str, place: &str, pinned: bool, indent: &str) -> str:
    // D209: with other parameters fixed or discarded the call is the
    // helper's (facade_render_drop_helper).
    if facade_render_drop_needs_helper(pool, intern, name, drop_fn):
        let resource = facade_render_resource_item(pool, intern, name)
        return "unsafe { " ++ facade_render_drop_helper_name(name) ++ "(" ++ facade_render_repr_arg_at(pool, intern, drop_fn, facade_render_destroyer_at(pool, intern, resource, drop_fn), repr_text, place, pinned) ++ ") }"
    if drop_fn != 0: return facade_render_call(pool, intern, drop_fn, facade_render_repr_arg(pool, intern, drop_fn, repr_text, place, pinned))
    if drop_global == 0 or pinned or not repr_text.starts_with("*"): return ""
    let hook = intern.resolve(drop_global)
    facade_render_call_through_global(pool, intern, drop_global, place, indent, name ++ ": 'drop " ++ hook ++ "', but " ++ hook ++ " is NULL (§31.11)")

fn facade_render_param_count(pool: &AstPool, decl: i32) -> i32:
    let meta = pool.find_fn_meta(decl as NodeId)
    if meta < 0: 0 else: pool.fn_meta_param_count(meta)

// How `place` (the representation) is handed to an operation's first
// parameter: the value itself (`db_close(db *)` over `*mut db`, `tok_unload(Tok)`
// over `Tok`), the value cast to a `void *` parameter (`free`) that accepts
// every object pointer representation (ruling §61 under C's conversion rule;
// Sema verifies it in facade_void_ptr_accepts; With converts a `*const T` to
// `*mut c_void` only explicitly), or its address for the in-place shape
// (`inflateEnd(z_stream *)` over `z_stream`) — the cell's address when the
// resource is pinned, where a by-value parameter has nothing to receive.
// Empty when the parameter is none of these — Sema names it.
fn facade_render_repr_arg(pool: &AstPool, intern: &InternPool, decl: i32, repr_text: &str, place: &str, pinned: bool): facade_render_repr_arg_at(pool, intern, decl, 0, repr_text, place, pinned)

// The same for the parameter a destroyer states it receives the resource in
// (D209: `drop f(param N)`, `destroys f(param N)`).
fn facade_render_repr_arg_at(pool: &AstPool, intern: &InternPool, decl: i32, at: i32, repr_text: &str, place: &str, pinned: bool) -> str:
    let meta = pool.find_fn_meta(decl as NodeId)
    if meta < 0 or pool.fn_meta_param_count(meta) <= at:
        return ""
    let p0 = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(meta), at) as NodeId))
    let repr = facade_render_unalias(pool, intern, repr_text)
    if p0 == repr: return if pinned: "" else: place
    if facade_render_const_of(p0, repr): return place ++ " as " ++ p0
    if (p0 == "*mut c_void" or p0 == "*const c_void") and repr.starts_with("*"): return place ++ " as " ++ p0
    if p0 == "*mut " ++ repr: return if pinned: place ++ ".as_mut_ptr()" else: "&raw mut " ++ place
    if p0 == "*const " ++ repr: return if pinned: place ++ ".as_ptr()" else: "&raw const " ++ place
    ""

// C converts a `T *` to a `const T *` on its own: a `*const T` parameter
// receives a `*mut T` handle (Sema: facade_param_matches_repr).
fn facade_render_const_of(p: &str, repr: &str): repr.starts_with("*mut ") and not facade_render_is_c_string_ptr(repr) and p == "*const " ++ repr.slice(5, repr.len())

// A type spelled through `type` aliases, chased to the spelling beneath
// (zlib's `z_streamp` is `*mut z_stream`): the same text comparison Sema's
// resolve_alias makes on TypeIds, so the renderer and the verifier agree on
// which operation takes the representation.
// ── the pool's declaration index ─────────────────────────────────────────
//
// The renderer and Sema's facade checks ask the same two questions of the
// pool thousands of times per item: which type declaration is the alias
// named `t`, and which declaration is the function named `f`. Over a
// facade `with get` writes for libxml2 (fourteen headers, 27k
// declarations, hundreds of items) a scan per question was 45 s per Sema
// pass. One scan per pool answers both; the index is keyed on the pool's
// identity and size, so a pool the comptime transform grew is scanned
// again.
var g_facade_alias_pool: i64 = 0
var g_facade_alias_targets: HashMap[str, str] = [:]
var g_facade_fn_pool: i64 = 0
var g_facade_fn_ci: isize = -1
var g_facade_fn_ci_decl: HashMap[str, i32] = [:]
var g_facade_fn_any_decl: HashMap[str, i32] = [:]

fn facade_render_alias_index(pool: &AstPool, intern: &InternPool):
    if g_facade_alias_pool == pool.shape(): return
    g_facade_alias_pool = pool.shape()
    g_facade_alias_targets = [:]
    for di in 0..pool.decl_count():
        let decl = pool.get_decl(di)
        if pool.kind(decl) != NodeKind.NK_TYPE_DECL or pool.get_data2(decl) % 8 != TypeDeclKind.Alias as i32: continue
        let name = intern.resolve(pool.get_data0(decl))
        // The first declaration of a name is the one the scan found.
        if not g_facade_alias_targets.contains(name): g_facade_alias_targets.insert(name, render_type_expr(pool, intern, pool.get_extra(pool.get_data1(decl)) as NodeId))

// `ci` is the frontend's c_import origin per declaration: the same list
// at every call for one pool, so its length is the key's third part.
fn facade_render_fn_index(pool: &AstPool, intern: &InternPool, ci: &List[i32]):
    if g_facade_fn_pool == pool.shape() and g_facade_fn_ci == ci.len(): return
    g_facade_fn_pool = pool.shape()
    g_facade_fn_ci = ci.len()
    g_facade_fn_ci_decl = [:]
    g_facade_fn_any_decl = [:]
    for di in 0..pool.decl_count():
        let decl = pool.get_decl(di)
        let kind = pool.kind(decl)
        if kind != NodeKind.NK_EXTERN_FN and kind != NodeKind.NK_FN_DECL: continue
        let name = intern.resolve(pool.get_data0(decl))
        if not g_facade_fn_any_decl.contains(name): g_facade_fn_any_decl.insert(name, decl as i32)
        if di < ci.len() and ci[di] != 0 and not g_facade_fn_ci_decl.contains(name): g_facade_fn_ci_decl.insert(name, decl as i32)

fn facade_render_unalias(pool: &AstPool, intern: &InternPool, text: &str) -> str:
    // A pointer's pointee is chased too (a header's `DIR *` translates to
    // `*mut __dirstream` where the facade names `*mut DIR`), as Sema's
    // facade_same_type compares them.
    if text.starts_with("*mut "):
        return "*mut " ++ facade_render_unalias(pool, intern, text.slice(5, text.len()))
    if text.starts_with("*const "):
        return "*const " ++ facade_render_unalias(pool, intern, text.slice(7, text.len()))
    var t = text
    facade_render_alias_index(pool, intern)
    for _ in 0..16:
        let target: str = g_facade_alias_targets.get(t) ?? ""
        // `type _IO_FILE = opaque` declares a distinct opaque type, not an
        // alias of `void`: stop at its name. A true alias of `c_void` —
        // `typedef void CURL;` translates to `type CURL = c_void` — is
        // chased through, as Sema's resolve_alias chases it: `*mut CURL` is
        // the `*mut c_void` the translated declarations spell (D66).
        if target.len() == 0 or target == "opaque":
            // D155/D156: a C integer alias is a builtin, not a declared
            // alias; `wraps c_int` meets c_import's `i32` at the fixed
            // spelling. `c_char` alone stays symbolic: it is the spelling
            // both sides use, and the one a help prints.
            let fixed = if t == "c_char": "" else: c_alias_fixed_spelling(t)
            return if fixed.len() > 0: fixed else: t
        if target.starts_with("*"):
            return facade_render_unalias(pool, intern, target)
        t = target
    t

// `(<params>, <args>)` of the declaration's parameters from index `skip`:
// c_import spells a C parameter `p` as `__param_p` so no C name collides
// with a With keyword; the resource spells it as the header does.
fn facade_render_params(pool: &AstPool, intern: &InternPool, decl: i32, skip: i32): facade_render_params_but(pool, intern, decl, skip, -1, "")

// The same with parameter `slot` withheld from `<params>` and passed as
// `slot_arg` in `<args>`: an out-parameter producer's slot is the
// constructor's own local, never the caller's (§16.2b.4).
//
// A parameter that receives another resource's representation is presented
// as a borrow of that resource, `p: &P`, and handed to C as `p.repr` (stage
// 6, facade_render_received_arg): a safe surface never takes the raw handle
// of a modeled resource, which could be one already destroyed. A shape a
// borrow cannot present stays as C declares it (a producer with one renders
// nothing — facade_render_deps).
fn facade_render_params_but(pool: &AstPool, intern: &InternPool, decl: i32, skip: i32, slot: i32, slot_arg: &str) -> (str, str):
    let bridge = facade_render_bridge(pool, intern, decl, skip, slot, slot_arg)
    (bridge.params, bridge.args)

// ── D64: buffer pairing and fixed arguments (§16.2b.8, §16.2b.11) ──────
//
// The presented call's parameters, arguments and the prologue that makes
// them: a fixed argument (`param N fixed <literal>`) leaves the parameter
// list and its literal is passed; a buffer pairing (`buffer param P len
// param L`) presents P and L as one `[]u8` — `[]mut u8` for `capacity …
// inout` — passing the slice's pointer (null for an empty slice) and its
// byte length; an inout capacity is a local the bridge initializes to the
// slice's length and hands C the address of (`cap_var`), so the caller's
// slice is never modified (D64). The body around the call is
// facade_render_bridge_body. `ok` is false when a clause names a parameter
// the declaration does not have — Sema's error — and the item renders
// nothing.
type FacadeBridge {
    ok: bool,
    params: str,
    args: str,
    prologue: str,     // lines, each newline-terminated, unindented
    cap_var: str,      // the inout capacity local, or ""
    cap_type: str,     // its C integer type
    cap_of: str,       // the []mut u8 parameter it is the capacity of
    cap_unit: str,     // bytes or elements, for a bounds diagnostic
    fills: str,        // D198: the locals `fills param N` passed zeroed, comma-separated, or ""
    fill_types: str,   // their record types, comma-separated
    generics: str,     // D246: extra owner type params for borrow-only resource params, comma-separated
}

// The fn item describing the C function the declaration `decl` names, in
// any facade block, or 0.
fn facade_render_fn_item(pool: &AstPool, intern: &InternPool, decl: i32) -> i32:
    let want = intern.resolve(pool.get_data0(decl as NodeId))
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_FN)
    for item in items:
        if intern.resolve(pool.get_data0(item as NodeId)) == want:
            return item
    0

// The literal `param N fixed <literal>` binds to parameter `pi`, as source
// text, or "" when the parameter is not fixed.
fn facade_render_fixed_literal(pool: &AstPool, intern: &InternPool, decl: i32, pi: i32) -> str:
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0:
        return ""
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_FIXED:
            continue
        let ops = pool.get_data1(clause as NodeId)
        if facade_render_param_ref(pool, intern, decl, pool.get_extra(ops)) != pi:
            continue
        let start = pool.fn_meta_param_start(pool.find_fn_meta(decl as NodeId))
        return facade_render_fixed_value(pool, intern, pool.get_extra(ops + 1), render_type_expr(pool, intern, pool.fn_param_type(start, pi) as NodeId))
    ""

// D209 (§16.2b.11): whether `param N discarded` names parameter `pi`.
fn facade_render_discarded(pool: &AstPool, intern: &InternPool, decl: i32, pi: i32) -> bool:
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0: return false
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) == FACADE_CLAUSE_DISCARDED and facade_render_param_ref(pool, intern, decl, pool.get_extra(pool.get_data1(clause as NodeId))) == pi: return true
    false

// Whether the function's item fixes or discards a parameter.
fn facade_render_fixes_or_discards(pool: &AstPool, intern: &InternPool, decl: i32) -> bool:
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0: return false
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let kind = pool.get_data0(pool.get_extra(cstart + k) as NodeId)
        if kind == FACADE_CLAUSE_FIXED or kind == FACADE_CLAUSE_DISCARDED: return true
    false

// D209 (§31): the parameter of `decl` that receives `resource` when a
// `drop` or `destroys` clause of the resource names it; the first otherwise.
fn facade_render_destroyer_at(pool: &AstPool, intern: &InternPool, resource: i32, decl: i32) -> i32:
    let fname = intern.resolve(pool.get_data0(decl as NodeId))
    let cstart = pool.get_data1(resource as NodeId)
    for k in 1..pool.get_data2(resource as NodeId) + 1:
        let clause = pool.get_extra(cstart + k)
        let kind = pool.get_data0(clause as NodeId)
        if kind != FACADE_CLAUSE_DROP and kind != FACADE_CLAUSE_DESTROYS and kind != FACADE_CLAUSE_ABANDON: continue
        let ops = pool.get_data1(clause as NodeId)
        if pool.get_data2(clause as NodeId) < 2 or pool.get_extra(ops + 1) == 0 or intern.resolve(pool.get_extra(ops)) != fname: continue
        let at = facade_render_param_ref(pool, intern, decl, pool.get_extra(ops + 1))
        return if at < 0: 0 else: at
    0

// The resource item named `name`, or 0.
fn facade_render_resource_item(pool: &AstPool, intern: &InternPool, name: &str) -> i32:
    for item in facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE):
        if intern.resolve(pool.get_data0(item as NodeId)) == name: return item
    0

// Whether `Drop` reaches the `drop` function through a helper: the
// resource is not its only parameter, so the others are fixed or discarded
// and the call has lines of its own.
fn facade_render_drop_needs_helper(pool: &AstPool, intern: &InternPool, name: &str, drop_fn: i32) -> bool:
    let resource = facade_render_resource_item(pool, intern, name)
    resource != 0 and drop_fn != 0 and (facade_render_destroyer_at(pool, intern, resource, drop_fn) != 0 or facade_render_param_count(pool, drop_fn) > 1)

fn facade_render_drop_helper_name(name: &str): "__with_facade_drop_" ++ name

fn facade_render_abandon_helper_name(name: &str): "__with_facade_abandon_" ++ name

// `fn __with_facade_abandon_<R>(facade_repr: <the parameter's type>)`: the
// call the abandonment path makes when `abandon f(param N)` passes the
// resource at N and the contract fixes or discards every other parameter.
// "" when the shape is one Sema names.
fn facade_render_abandon_helper(pool: &AstPool, intern: &InternPool, resource: i32, abandon_fn: i32) -> str:
    let name = intern.resolve(pool.get_data0(resource as NodeId))
    let at = facade_render_destroyer_at(pool, intern, resource, abandon_fn)
    let bridge = facade_render_bridge(pool, intern, abandon_fn, 0, at, "facade_repr")
    if not bridge.ok or bridge.params.len() > 0: return ""
    "unsafe fn " ++ facade_render_abandon_helper_name(name) ++ "(facade_repr: " ++ facade_render_param_type(pool, intern, abandon_fn, at) ++ "):\n" ++ facade_render_indent(bridge.prologue, "    ") ++ "    " ++ facade_render_call(pool, intern, abandon_fn, bridge.args) ++ "\n"

// `fn __with_facade_drop_<R>(facade_repr: <the parameter's type>)`: the
// call `Drop` makes when `drop f(param N)` passes the resource at N and the
// contract fixes or discards every other parameter. "" when no helper is
// needed, or the shape is one Sema names.
fn facade_render_drop_helper(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32) -> str:
    let name = intern.resolve(pool.get_data0(resource as NodeId))
    let drop_fn = facade_render_drop_decl(pool, intern, ci, resource)
    if not facade_render_drop_needs_helper(pool, intern, name, drop_fn): return ""
    let at = facade_render_destroyer_at(pool, intern, resource, drop_fn)
    let bridge = facade_render_bridge(pool, intern, drop_fn, 0, at, "facade_repr")
    if not bridge.ok or bridge.params.len() > 0: return ""
    "unsafe fn " ++ facade_render_drop_helper_name(name) ++ "(facade_repr: " ++ facade_render_param_type(pool, intern, drop_fn, at) ++ "):\n" ++ facade_render_indent(bridge.prologue, "    ") ++ "    " ++ facade_render_call(pool, intern, drop_fn, bridge.args) ++ "\n"

// D102 (§16.2b.8): whether `nullable param N` names parameter `pi` of the
// declaration, in its fn item.
fn facade_render_param_is_nullable(pool: &AstPool, intern: &InternPool, decl: i32, pi: i32) -> bool:
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0:
        return false
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_NULLABLE:
            continue
        if facade_render_param_ref(pool, intern, decl, pool.get_extra(pool.get_data1(clause as NodeId))) == pi:
            return true
    false

fn facade_render_literal(pool: &AstPool, node: i32) -> str:
    let kind = pool.kind(node as NodeId)
    if kind == NodeKind.NK_NULL_LIT: return "null"
    if kind == NodeKind.NK_BOOL_LIT: return if pool.get_data0(node as NodeId) != 0: "true" else: "false"
    if kind == NodeKind.NK_INT_LIT: return f"{pool.int_lit_value(node as NodeId)}"
    if kind == NodeKind.NK_UNARY and pool.get_data0(node as NodeId) == UnaryOp.UOP_NEGATE: return "-" ++ facade_render_literal(pool, pool.get_data1(node as NodeId))
    ""

// `fixed NAME` passes the header's constant; `fixed sizeof(T)` passes the
// type's size as the parameter's integer type (Sema checked that it fits).
fn facade_render_fixed_value(pool: &AstPool, intern: &InternPool, node: i32, ptype: &str) -> str:
    let kind = pool.kind(node as NodeId)
    if kind == NodeKind.NK_IDENT: return intern.resolve(pool.get_data0(node as NodeId))
    if kind == NodeKind.NK_GROUPED: return "sizeof[" ++ intern.resolve(pool.get_data0(pool.get_data0(node as NodeId) as NodeId)) ++ "]() as " ++ ptype
    facade_render_literal(pool, node)

// The buffer pairing parameter `pi` takes part in: (the pointer parameter,
// the length parameter, inout), or (-1, -1, 0).
fn facade_render_buffer_of(pool: &AstPool, intern: &InternPool, decl: i32, pi: i32) -> (i32, i32, i32, i32):
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0:
        return (-1, -1, 0, 0)
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_BUFFER:
            continue
        let ops = pool.get_data1(clause as NodeId)
        let p = facade_render_param_ref(pool, intern, decl, pool.get_extra(ops))
        let l = facade_render_param_ref(pool, intern, decl, pool.get_extra(ops + 1))
        if p == pi or l == pi:
            return (p, l, pool.get_extra(ops + 2), pool.get_extra(ops + 3))
    (-1, -1, 0, 0)

fn facade_render_param_consumed(pool: &AstPool, intern: &InternPool, decl: i32, pi: i32) -> bool:
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0: return false
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_CONSUMES: continue
        let ops = pool.get_data1(clause as NodeId)
        if pool.get_extra(ops + 1) != 0: continue
        if facade_render_param_ref(pool, intern, decl, pool.get_extra(ops)) == pi: return true
    false

fn facade_render_empty_bridge() -> FacadeBridge:
    FacadeBridge { ok: true, params: "", args: "", prologue: "", cap_var: "", cap_type: "", cap_of: "", cap_unit: "", fills: "", fill_types: "", generics: "" }

fn facade_render_is_borrow_only_resource(pool: &AstPool, resource: i32) -> bool:
    not facade_item_is_handle(pool, resource) and not facade_render_has_clause(pool, resource, FACADE_CLAUSE_FROM) and not facade_render_has_clause(pool, resource, FACADE_CLAUSE_INIT) and not facade_render_has_clause(pool, resource, FACADE_CLAUSE_DROP) and not facade_render_has_clause(pool, resource, FACADE_CLAUSE_DESTROYS)

// One parameter's projection, shared by ordinary and callback operations.
// Clauses compose here: there is only one derivation of a buffer's slice,
// pointer, count conversion, and copy-back storage.
fn facade_render_bridge_param(pool: &AstPool, intern: &InternPool, decl: i32, pi: i32) -> FacadeBridge:
    let b = facade_render_empty_bridge()
    let meta = pool.find_fn_meta(decl as NodeId)
    let start = pool.fn_meta_param_start(meta)
    let taken = facade_render_param_names(pool, intern, decl)
    let fixed = facade_render_fixed_literal(pool, intern, decl, pi)
    let pname = facade_render_param_name(pool, intern, start, pi)
    let ptype = render_type_expr(pool, intern, pool.fn_param_type(start, pi) as NodeId)
    if facade_render_discarded(pool, intern, decl, pi):
        // D209: scratch storage C writes and nobody reads.
        let pointer = facade_render_unalias(pool, intern, ptype)
        if not pointer.starts_with("*mut "):
            b.ok = false
            return b
        let pointee = pointer.slice(5, pointer.len())
        let local = facade_render_fresh(pname ++ "_discarded", taken)
        let zero = if pointee.starts_with("*"): "null" else if pointee == "f32" or pointee == "f64": "0.0" else if pointee == "bool": "false" else: "0 as " ++ pointee
        b.prologue = "var " ++ local ++ ": " ++ pointee ++ " = " ++ zero ++ "\n"
        b.args = "&raw mut " ++ local
        return b
    if fixed.len() > 0:
        // D102: a function-pointer parameter is non-null; `fixed null` is
        // the facade's claim that C takes NULL there, so the absent pointer
        // crosses as `None` under the with-abi.md §3 guarantee.
        if fixed == "null" and facade_render_unalias(pool, intern, ptype).contains("fn("):
            let raw = facade_render_callback_raw_type(facade_render_unalias(pool, intern, ptype))
            let local = facade_render_fresh(pname ++ "_none", taken)
            b.prologue = "let " ++ local ++ ": Option[" ++ raw ++ "] = None\n"
            b.args = "unsafe { transmute[" ++ raw ++ "](" ++ local ++ ") }"
            return b
        b.args = fixed
        return b
    let (bp, bl, mode, elements) = facade_render_buffer_of(pool, intern, decl, pi)
    let writable = mode != 0
    let inout = mode == 1
    if bp < 0 and bl >= 0 or bl < 0 and bp >= 0:
        b.ok = false
        return b
    if bp == pi:
        let ptr_type = facade_render_unalias(pool, intern, ptype)
        let element = if elements == 0: "u8" else: if ptr_type.starts_with("*const "): ptr_type.slice(7, ptr_type.len()) else: if ptr_type.starts_with("*mut "): ptr_type.slice(5, ptr_type.len()) else: ""
        if element.len() == 0:
            b.ok = false
            return b
        let slicety = (if writable: "[]mut " else: "[]") ++ element
        let addr = if writable: "&raw mut " ++ pname ++ "[0]" else: "&raw const " ++ pname ++ "[0]"
        let local = facade_render_fresh(pname ++ "_ptr", taken)
        b.prologue = "let " ++ local ++ ": " ++ ptype ++ " = if " ++ pname ++ ".len() == 0: null else: " ++ addr ++ " as " ++ ptype ++ "\n"
        b.params = pname ++ ": " ++ slicety
        b.args = local
        return b
    if bl == pi:
        let bname = facade_render_param_name(pool, intern, start, bp)
        let unaliased = facade_render_unalias(pool, intern, ptype)
        if inout and not unaliased.starts_with("*mut "):
            b.ok = false
            return b
        let count_type = if not inout: ptype else: unaliased.slice(5, unaliased.len())
        let count = facade_render_fresh(bname ++ "_count", taken)
        let fname = intern.resolve(pool.get_data0(decl as NodeId))
        let unit = if elements != 0: "elements" else: "bytes"
        b.prologue = (if not inout: "let " else: "var ") ++ count ++ ": " ++ count_type ++ " = " ++ bname ++ ".len() as " ++ count_type ++ "\n"
        b.prologue = b.prologue ++ "if " ++ count ++ " < 0 or " ++ count ++ " as u64 != " ++ bname ++ ".len() as u64: panic(\"" ++ fname ++ ": buffer count in " ++ unit ++ " does not fit the C count type (§16.2b.8)\")\n"
        b.args = (if not inout: "" else: "&raw mut ") ++ count
        if inout:
            b.cap_var = count
            b.cap_type = count_type
            b.cap_of = bname
            b.cap_unit = unit
        return b
    // D198 (§16.2b.5, §16.2b.11): a value record. `reads param N` is a `&T`
    // argument; `updates param N` is a `mut` parameter (D172), whose place
    // the callee writes.
    let value_record = facade_render_value_record_kind(pool, intern, decl, pi)
    if value_record.len() > 0:
        let pointer = facade_render_unalias(pool, intern, ptype)
        let record = if pointer.starts_with("*const "): pointer.slice(7, pointer.len()) else: if pointer.starts_with("*mut "): pointer.slice(5, pointer.len()) else: ""
        if record.len() == 0:
            b.ok = false
            return b
        if value_record == "reads" and facade_render_param_is_nullable(pool, intern, decl, pi):
            // `nullable param N` composes with `reads`: `Option[&T]`, and
            // `None` crosses as NULL (§16.2b.5).
            let local = facade_render_fresh(pname ++ "_ptr", taken)
            let present = facade_render_fresh(pname ++ "_present", taken)
            b.prologue = "let " ++ local ++ ": " ++ ptype ++ " = match " ++ pname ++ ":\n    Some(" ++ present ++ ") => " ++ present ++ " as " ++ ptype ++ "\n    None => null\n"
            b.params = pname ++ ": Option[&" ++ record ++ "]"
            b.args = local
        else if value_record == "reads":
            b.params = pname ++ ": &" ++ record
            b.args = "(" ++ pname ++ " as " ++ ptype ++ ")"
        else if value_record == "fills":
            // The parameter leaves the list: With passes a zero-initialized T
            // (`T.zeroed()` for a record, `false` for `bool`, `0 as T` for a
            // scalar; D198/D244) and the filled value joins what the operation
            // presents (facade_render_bridge_body).
            let local = facade_render_fresh(pname ++ "_filled", taken)
            let zero = if facade_render_is_record(pool, intern, record): record ++ ".zeroed()" else if record == "bool": "false" else: "0 as " ++ record
            b.prologue = "var " ++ local ++ ": " ++ record ++ " = " ++ zero ++ "\n"
            b.args = "(&raw mut " ++ local ++ " as " ++ ptype ++ ")"
            b.fills = local
            b.fill_types = record
        else:
            b.params = "mut " ++ pname ++ ": " ++ record
            b.args = "(&raw mut " ++ pname ++ " as " ++ ptype ++ ")"
        return b
    // D122 (§16.2b.8): `text param N` — input text of any C character
    // type takes a `str`, copied to a NUL-terminated temporary for the
    // call; an interior NUL is refused as §16.3c refuses it for `const
    // char *`, since C would read it as the end.
    if facade_render_param_is_text(pool, intern, decl, pi) and not facade_render_param_is_nullable(pool, intern, decl, pi):
        let fname = intern.resolve(pool.get_data0(decl as NodeId))
        let local = facade_render_fresh(pname ++ "_text", taken)
        b.prologue = "let " ++ local ++ " = " ++ pname ++ ".to_cstring().expect(\"" ++ fname ++ ": the text has an interior NUL byte, which C would read as its end (§16.3c)\")\n"
        b.params = pname ++ ": &str"
        b.args = "(" ++ local ++ ".as_cstr().ptr() as " ++ ptype ++ ")"
        return b
    var shown = if ptype == "*const i8" or ptype == "*const c_char": "&str" else: ptype
    var arg = pname
    // D121 step 6 (§16.2b.8): `nullable param N` on a C string (or `text
    // param N`) presents `Option[&str]`; the text crosses as a NUL-terminated
    // temporary that outlives the call, None as NULL (libxml2's optional encoding).
    if (shown == "&str" or facade_render_param_is_text(pool, intern, decl, pi)) and facade_render_param_is_nullable(pool, intern, decl, pi):
        let fname = intern.resolve(pool.get_data0(decl as NodeId))
        let local = facade_render_fresh(pname ++ "_text", taken)
        let ptr = facade_render_fresh(pname ++ "_ptr", taken)
        b.prologue = "let " ++ local ++ " = match " ++ pname ++ ":\n    Some(s) => Some(s.to_cstring().expect(\"" ++ fname ++ ": the text has an interior NUL byte, which C would read as its end (§16.3c)\"))\n    None => None\nlet " ++ ptr ++ ": " ++ ptype ++ " = match &" ++ local ++ ":\n    Some(t) => t.as_cstr().ptr() as " ++ ptype ++ "\n    None => null\n"
        b.params = pname ++ ": Option[&str]"
        b.args = ptr
        return b
    let res = facade_render_received_param(pool, intern, decl, pi, ptype)
    if res > 0:
        if facade_render_param_consumed(pool, intern, decl, pi):
            let rname = intern.resolve(pool.get_data0(res as NodeId))
            let local = facade_render_fresh(pname ++ "_consumed", taken)
            var c_arg = facade_render_received_arg(pool, intern, res, ptype, local)
            if c_arg.len() == 0 and facade_render_unalias(pool, intern, ptype).starts_with("*mut "):
                c_arg = "&raw mut " ++ local ++ ".repr"
            if c_arg.len() > 0:
                b.prologue = "var " ++ local ++ " = " ++ pname ++ "\n" ++ local ++ ".live = false\n"
                b.params = pname ++ ": " ++ rname
                b.args = c_arg
                return b
        let received = facade_render_received_arg(pool, intern, res, ptype, pname)
        if received.len() > 0:
            let rname = intern.resolve(pool.get_data0(res as NodeId))
            if facade_render_is_borrow_only_resource(pool, res):
                let gp = f"__FO{pi}"
                b.generics = gp
                shown = "&" ++ facade_render_borrowed_name(rname) ++ "[" ++ gp ++ "]"
            else:
                shown = "&" ++ rname
            arg = received
    else:
        // D122/D187 (§16.2b.6): a pointer to an imported record the facade
        // hands out as a view (`xmlNode *cur` beside `xmlNode *parent`)
        // receives the `&T` view; C gets the record's address, as a
        // record-view method's `self` crosses (facade_render_record_view_methods).
        let unaliased = facade_render_unalias(pool, intern, ptype)
        let pointee = if unaliased.starts_with("*mut "): unaliased.slice(5, unaliased.len()).to_owned() else: if unaliased.starts_with("*const "): unaliased.slice(7, unaliased.len()).to_owned() else: ""
        let handled = facade_render_handle_callback_type(pool, intern, ptype)
        if pointee.len() > 0 and facade_render_record_view_names(pool, intern, 0).contains(pointee):
            shown = "&" ++ pointee
            arg = if unaliased.starts_with("*const "): "(&raw const *" ++ pname ++ ")" else: "(&raw const *" ++ pname ++ " as " ++ unaliased ++ ")"
        else if handled != ptype:
            shown = handled
            arg = "transmute[" ++ facade_render_callback_raw_type(facade_render_unalias(pool, intern, ptype)) ++ "](" ++ pname ++ ")"
        // D102 (§16.2b.8): `nullable param N` on a function-pointer
        // parameter presents `Option` of it; the value crosses as the C
        // pointer it is (with-abi.md §3), NULL for None.
        else if facade_render_param_is_nullable(pool, intern, decl, pi) and facade_render_unalias(pool, intern, ptype).contains("fn("):
            let raw = facade_render_callback_raw_type(facade_render_unalias(pool, intern, ptype))
            let local = facade_render_fresh(pname ++ "_raw", taken)
            b.prologue = "let " ++ local ++ ": " ++ raw ++ " = unsafe { transmute[" ++ raw ++ "](" ++ pname ++ ") }\n"
            shown = "Option[" ++ ptype ++ "]"
            arg = local
    b.params = pname ++ ": " ++ shown
    b.args = arg
    b

fn facade_render_append_bridge(initial: FacadeBridge, part: &FacadeBridge):
    let b = initial
    if not part.ok: b.ok = false
    if part.params.len() > 0:
        if b.params.len() > 0: b.params = b.params ++ ", "
        b.params = b.params ++ part.params
    if part.args.len() > 0:
        if b.args.len() > 0: b.args = b.args ++ ", "
        b.args = b.args ++ part.args
    b.prologue = b.prologue ++ part.prologue
    if part.cap_var.len() > 0:
        b.cap_var = part.cap_var
        b.cap_type = part.cap_type
        b.cap_of = part.cap_of
        b.cap_unit = part.cap_unit
    if part.fills.len() > 0:
        b.fills = if b.fills.len() > 0: b.fills ++ ", " ++ part.fills else: with_str_clone_ref(part.fills)
        b.fill_types = if b.fill_types.len() > 0: b.fill_types ++ ", " ++ part.fill_types else: with_str_clone_ref(part.fill_types)
    if part.generics.len() > 0:
        b.generics = if b.generics.len() > 0: b.generics ++ ", " ++ part.generics else: with_str_clone_ref(part.generics)
    b

fn facade_render_bridge(pool: &AstPool, intern: &InternPool, decl: i32, skip: i32, slot: i32, slot_arg: &str) -> FacadeBridge:
    var b = facade_render_empty_bridge()
    let meta = pool.find_fn_meta(decl as NodeId)
    if meta < 0:
        return b
    for pi in skip..pool.fn_meta_param_count(meta):
        if pi == slot:
            if b.args.len() > 0: b.args = b.args ++ ", "
            b.args = b.args ++ slot_arg
            continue
        let part = facade_render_bridge_param(pool, intern, decl, pi)
        b = facade_render_append_bridge(b, part)
    b

// Each line of `text` prefixed with `indent`.
fn facade_render_indent(text: &str, indent: &str):
    var out = ""
    var start = 0
    while start < text.len():
        var end = start
        while end < text.len() and text[end] != '\n': end = end + 1
        out = out ++ indent ++ text.slice(start, end) ++ "\n"
        start = end + 1
    out

// The lines around the presented call `call` (D64, §16.2b.8), each indented
// by `indent`, and the rendered return type. Without an inout capacity the
// call is the body, returning what C returns. With one, the length C wrote
// back is bounds-checked against the capacity before it becomes a With
// value, and presented as the `usize` result — on success only: under the
// item's `ok CONST` the status is read first and a failure is
// `Err(<Fn>Error.Failed(status))`; an operation returning nothing always
// succeeded. A length beyond the capacity is C breaking its contract, and
// a runtime failure naming the operation and the length, never a trust.
// The lines that return a failed status as `<Fn>Error.Failed`. With a
// `message` on the hosting resource (ruling Amendment 3) the error also
// carries the library's text, an owned copy read before anything else is
// called on the resource.
// `empty_message`: the shared error's `Failed` carries a message and this
// operation's resource names none.
fn facade_render_failed(err: &str, status: &str, failed: &str, message_call: &str, taken: &str, indent: &str, empty_message: bool) -> str:
    if message_call.len() == 0:
        return indent ++ "if " ++ failed ++ ": return Err(" ++ err ++ ".Failed(" ++ status ++ (if empty_message: ", \"\"" else: "") ++ "))\n"
    let text = facade_render_fresh("facade_text", taken)
    let message = facade_render_fresh("facade_message", taken)
    var out = indent ++ "if " ++ failed ++ ":\n"
    out = out ++ indent ++ "    let " ++ message ++ ": str = match " ++ message_call ++ ":\n"
    out = out ++ indent ++ "        Some(" ++ text ++ ") => " ++ text ++ ".to_str_lossy()\n"
    out = out ++ indent ++ "        None => \"\"\n"
    out ++ indent ++ "    return Err(" ++ err ++ ".Failed(" ++ status ++ ", " ++ message ++ "))\n"

fn facade_render_bridge_body(pool: &AstPool, intern: &InternPool, decl: i32, b: &FacadeBridge, call: &str, presented: &str, indent: &str, message_call: &str) -> (str, str):
    // D198 (§16.2b.5, §16.2b.11): the records `fills` clauses name join
    // what the operation presents, under the status rule of §16.2b.4. No
    // `ok`: the status is uninterpreted, so the result is `(status, T)`,
    // or `T` when C returns nothing. One `ok` constant: `Result[T, E]`.
    // Several: the matched status is a value, `Result[(status, T), E]`.
    if b.fills.len() > 0 and b.cap_var.len() == 0:
        let several = b.fills.contains(", ")
        let filled = if several: "(" ++ b.fills ++ ")" else: with_str_clone_ref(b.fills)
        let filled_type = if several: "(" ++ b.fill_types ++ ")" else: with_str_clone_ref(b.fill_types)
        let returned = facade_render_return(pool, intern, decl)
        let status_type = if returned.len() > 4: returned.slice(4, returned.len()) else: ""
        let fill_oks = facade_render_fn_oks(pool, intern, decl)
        let fill_status = facade_render_fresh("status", facade_render_param_names(pool, intern, decl))
        if fill_oks.len() == 0:
            if status_type.len() == 0 or status_type == "Unit":
                return (" -> " ++ filled_type, indent ++ call ++ "\n" ++ indent ++ filled ++ "\n")
            return (" -> (" ++ status_type ++ ", " ++ b.fill_types ++ ")", indent ++ "let " ++ fill_status ++ " = " ++ call ++ "\n" ++ indent ++ "(" ++ fill_status ++ ", " ++ b.fills ++ ")\n")
        let (fill_err, fill_empty_message) = facade_render_op_error(pool, intern, decl, presented)
        let fill_failed = facade_render_not_ok(intern, fill_oks, fill_status)
        let fill_checked = indent ++ "let " ++ fill_status ++ " = " ++ call ++ "\n" ++ facade_render_failed(fill_err, fill_status, fill_failed, message_call, facade_render_param_names(pool, intern, decl), indent, fill_empty_message)
        if not facade_render_ok_carries_status(intern, fill_oks):
            return (" -> Result[" ++ filled_type ++ ", " ++ fill_err ++ "]", fill_checked ++ indent ++ filled ++ "\n")
        return (" -> Result[(" ++ status_type ++ ", " ++ b.fill_types ++ "), " ++ fill_err ++ "]", fill_checked ++ indent ++ "(" ++ fill_status ++ ", " ++ b.fills ++ ")\n")
    if b.cap_var.len() == 0:
        // A status-returning operation under `ok` (ruling Amendment 3, D245,
        // §16.2b.4): `Result[T, <Fn>Error]`. One exact constant: the status is
        // the whole return, so `T` is `Unit`. Several or `>= C`: `T` is the
        // status that matched.
        let oks = facade_render_fn_oks(pool, intern, decl)
        if oks.len() == 0:
            return (facade_render_return(pool, intern, decl), indent ++ call ++ "\n")
        let (op_err, empty_message) = facade_render_op_error(pool, intern, decl, presented)
        let op_status = facade_render_fresh("status", facade_render_param_names(pool, intern, decl))
        let failed = facade_render_not_ok(intern, oks, op_status)
        let checked = indent ++ "let " ++ op_status ++ " = " ++ call ++ "\n" ++ facade_render_failed(op_err, op_status, failed, message_call, facade_render_param_names(pool, intern, decl), indent, empty_message)
        if not facade_render_ok_carries_status(intern, oks):
            return (" -> Result[Unit, " ++ op_err ++ "]", checked ++ indent ++ "()\n")
        let status_type = facade_render_return(pool, intern, decl)
        return (" -> Result[" ++ status_type.slice(4, status_type.len()) ++ ", " ++ op_err ++ "]", checked ++ indent ++ op_status ++ "\n")
    let ok_sym = facade_render_fn_ok(pool, intern, decl)
    let check = indent ++ "if " ++ b.cap_var ++ " < 0 or " ++ b.cap_var ++ " as u64 > " ++ b.cap_of ++ ".len() as u64: panic(f\"" ++ presented ++ ": C reported {" ++ b.cap_var ++ "} " ++ b.cap_unit ++ " written into a buffer of {" ++ b.cap_of ++ ".len()} " ++ b.cap_unit ++ " (§16.2b.8)\")\n"
    let result = indent ++ b.cap_var ++ " as usize\n"
    if ok_sym == 0:
        return (" -> usize", indent ++ call ++ "\n" ++ check ++ result)
    let (err, empty_message) = facade_render_op_error(pool, intern, decl, presented)
    let status = facade_render_fresh("status", facade_render_param_names(pool, intern, decl))
    var body = indent ++ "let " ++ status ++ " = " ++ call ++ "\n"
    body = body ++ facade_render_failed(err, status, facade_render_status_test(status, intern.resolve(ok_sym)), message_call, facade_render_param_names(pool, intern, decl), indent, empty_message)
    (" -> Result[usize, " ++ err ++ "]", body ++ check ++ result)

// Every constant of the `ok` an fn item states for the declaration; none
// for a variadic contract, whose `ok` is its setter's success edge and
// leaves the presentation as it is (§16.2b.5).
fn facade_render_fn_oks(pool: &AstPool, intern: &InternPool, decl: i32) -> List[i32]:
    let oks: List[i32] = []
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0:
        return oks
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        if pool.get_data0(pool.get_extra(cstart + k) as NodeId) == FACADE_CLAUSE_VARIADIC: return oks
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) == FACADE_CLAUSE_OK:
            for ci in 0..pool.get_data2(clause as NodeId): oks.push(pool.get_extra(pool.get_data1(clause as NodeId) + ci))
    oks

// The `ok CONST` an fn item states for the declaration, or 0.
fn facade_render_fn_ok(pool: &AstPool, intern: &InternPool, decl: i32) -> i32:
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0:
        return 0
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) == FACADE_CLAUSE_OK:
            return pool.get_extra(pool.get_data1(clause as NodeId))
    0

// The rendered name of a free operation presented under its C name.
fn facade_render_bridge_name(cname: &str): "__with_facade_" ++ cname

// `<Fn>Error`: the error type of a presented operation's `ok` projection,
// named after its presented name (`compress` → `CompressError`).
fn facade_render_fn_error_name(presented: &str) -> str:
    if presented.len() == 0: return "Error"
    // A snake_case presented name is CamelCased (`exec_with` →
    // `ExecWithError`); a name with capitals of its own keeps them
    // (`BZ2_bzBuffToBuffCompress`).
    var snake = true
    for i in 0..presented.len():
        if presented[i] >= 'A' and presented[i] <= 'Z': snake = false
    if not snake:
        return presented.slice(0, 1).to_upper() ++ presented.slice(1, presented.len()) ++ "Error"
    var out = ""
    for part in presented.split("_"):
        if part.len() > 0: out = out ++ part.slice(0, 1).to_upper() ++ part.slice(1, part.len())
    out ++ "Error"

// ── D210 (§16.2b.8): a buffer paired with fields of the resource's record ──
//
//     fn deflate
//         lend
//         buffer field next_in remaining field avail_in
//         buffer field next_out remaining field avail_out
//
// presents `d.deflate(next_in: []u8, next_out: []mut u8, flush) -> DeflateStep`.
// The wrapper stores each slice's pointer and length in the two fields,
// calls, reads back what remains, and clears the fields: no pointer into
// the program's slice stays in the record between calls. An empty slice is
// a non-null pointer with count 0 (deflate rejects a null next_out). A
// slice longer than the count field holds is passed in part, and the
// result says how much moved.

// The (pointer field, count field) names an fn item pairs, flat.
fn facade_render_field_buffers(pool: &AstPool, intern: &InternPool, decl: i32) -> List[str]:
    let out = []
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0: return out
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_BUFFER_FIELD: continue
        let ops = pool.get_data1(clause as NodeId)
        out.push(intern.resolve(pool.get_extra(ops)))
        out.push(intern.resolve(pool.get_extra(ops + 1)))
    out

// Whether the pairing of pointer field `field` lets C write through it: the
// field is a pointer to writable bytes and the clause does not end in
// `reads`.
fn facade_render_field_buffer_writable(pool: &AstPool, intern: &InternPool, decl: i32, record: &str, field: &str) -> bool:
    if not facade_render_unalias(pool, intern, facade_render_record_field_type(pool, intern, record, field)).starts_with("*mut "): return false
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0: return true
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_BUFFER_FIELD: continue
        let ops = pool.get_data1(clause as NodeId)
        if intern.resolve(pool.get_extra(ops)) == field: return pool.get_extra(ops + 2) == 0
    true

// The declared type of `field` in the record `record`, or "".
fn facade_render_record_field_type(pool: &AstPool, intern: &InternPool, record: &str, field: &str) -> str:
    for di in 0..pool.decl_count():
        let decl = pool.get_decl(di)
        if pool.kind(decl) != NodeKind.NK_TYPE_DECL or intern.resolve(pool.get_data0(decl)) != record: continue
        let start = pool.get_data1(decl)
        for fi in 0..pool.get_extra(start):
            if intern.resolve(pool.get_extra(start + 1 + fi * 3)) == field: return render_type_expr(pool, intern, pool.get_extra(start + 1 + fi * 3 + 1) as NodeId)
    ""

// Whether every pairing names two fields of the record: a shape the
// rendering cannot serve renders nothing, and Sema names it
// (verify_facade_field_buffers).
fn facade_render_field_buffers_ok(pool: &AstPool, intern: &InternPool, decl: i32) -> bool:
    let record = facade_render_field_buffer_record(pool, intern, decl)
    if record.len() == 0: return false
    for field in facade_render_field_buffers(pool, intern, decl):
        if facade_render_record_field_type(pool, intern, record, field).len() == 0: return false
    true

// The record the operation's first parameter points at.
fn facade_render_field_buffer_record(pool: &AstPool, intern: &InternPool, decl: i32) -> str:
    let p0 = facade_render_unalias(pool, intern, facade_render_param_type(pool, intern, decl, 0))
    if p0.starts_with("*mut "): p0.slice(5, p0.len()) else: ""

// The result record's count fields, one per pairing: what C read from an
// input buffer is `consumed`, what it wrote to an output buffer `produced`;
// with several of a kind each carries its pointer field's name.
fn facade_render_step_fields(pool: &AstPool, intern: &InternPool, decl: i32):
    let pairs = facade_render_field_buffers(pool, intern, decl)
    let record = facade_render_field_buffer_record(pool, intern, decl)
    var inputs = 0
    var outputs = 0
    var k = 0
    while k < pairs.len():
        if facade_render_field_buffer_writable(pool, intern, decl, record, pairs[k]): outputs += 1 else: inputs += 1
        k += 2
    let names = []
    k = 0
    while k < pairs.len():
        let writable = facade_render_field_buffer_writable(pool, intern, decl, record, pairs[k])
        let word = if writable: "produced" else: "consumed"
        names.push(if (if writable: outputs else: inputs) == 1: word else: pairs[k] ++ "_" ++ word)
        k += 2
    names

// `deflate` returns a `DeflateStep`; an operation already named `step`
// returns its resource's (`Stream.step` a `StreamStep`).
fn facade_render_step_name(host: &str, presented: &str) -> str:
    let err = facade_render_fn_error_name(presented)
    let camel = err.slice(0, err.len() - 5)
    if camel.ends_with("Step"): host ++ camel else: camel ++ "Step"

// The record a field-paired operation returns, declared beside its
// resource. It carries the status when the status is a value: no `ok`
// (uninterpreted) or several (the one that matched), §16.2b.4.
fn facade_render_step_type(pool: &AstPool, intern: &InternPool, decl: i32, host: &str, presented: &str) -> str:
    let names = facade_render_step_fields(pool, intern, decl)
    if names.len() == 0 or not facade_render_field_buffers_ok(pool, intern, decl): return ""
    let ret = facade_render_return(pool, intern, decl)
    var out = "type " ++ facade_render_step_name(host, presented) ++ " { "
    if ret.len() > 4 and facade_render_fn_oks(pool, intern, decl).len() != 1: out = out ++ "status: " ++ ret.slice(4, ret.len()) ++ ", "
    var first = true
    for name in names:
        out = out ++ (if first: "" else: ", ") ++ name ++ ": usize"
        first = false
    out ++ " }\n"

fn facade_render_field_buffer_method(pool: &AstPool, intern: &InternPool, decl: i32, host: &str, head: &str, mname: &str, repr_arg: &str, bridge: &FacadeBridge, message_call: &str) -> str:
    let pairs = facade_render_field_buffers(pool, intern, decl)
    let names = facade_render_step_fields(pool, intern, decl)
    let record = facade_render_field_buffer_record(pool, intern, decl)
    let taken = facade_render_param_names(pool, intern, decl)
    let rec = facade_render_fresh("facade_record", taken)
    let scratch = facade_render_fresh("facade_scratch", taken)
    let status = facade_render_fresh("status", taken)
    let i8s = "        "
    let i12 = "            "
    var params = ""
    var takes = ""
    var store = ""
    var read = ""
    var clear = ""
    var check = ""
    var fields = ""
    var k = 0
    while k < pairs.len():
        let p = pairs[k]
        let n = pairs[k + 1]
        let ptype = facade_render_record_field_type(pool, intern, record, p)
        let ctype = facade_render_record_field_type(pool, intern, record, n)
        let writable = facade_render_field_buffer_writable(pool, intern, decl, record, p)
        let raw = if writable: "&raw mut " else: "&raw const "
        let take = p ++ "_take"
        let left = p ++ "_left"
        let at = p ++ "_at"
        params = params ++ (if params.len() > 0: ", " else: "") ++ p ++ (if writable: ": []mut u8" else: ": []u8")
        // The largest part of the slice the count field can state.
        takes = takes ++ i8s ++ "var " ++ take ++ ": usize = " ++ p ++ ".len() as usize\n"
        takes = takes ++ i8s ++ "while (" ++ take ++ " as " ++ ctype ++ ") < (0 as " ++ ctype ++ ") or (" ++ take ++ " as " ++ ctype ++ ") as usize != " ++ take ++ ": " ++ take ++ " = " ++ take ++ " / 2\n"
        takes = takes ++ i8s ++ "let " ++ at ++ ": " ++ ptype ++ " = if " ++ p ++ ".len() == 0: " ++ raw ++ scratch ++ " as " ++ ptype ++ " else: " ++ raw ++ p ++ "[0] as " ++ ptype ++ "\n"
        store = store ++ i12 ++ "(*" ++ rec ++ ")." ++ p ++ " = " ++ at ++ "\n" ++ i12 ++ "(*" ++ rec ++ ")." ++ n ++ " = " ++ take ++ " as " ++ ctype ++ "\n"
        read = read ++ i8s ++ "let " ++ left ++ " = unsafe { (*" ++ rec ++ ")." ++ n ++ " } as usize\n"
        clear = clear ++ i12 ++ "(*" ++ rec ++ ")." ++ p ++ " = null\n" ++ i12 ++ "(*" ++ rec ++ ")." ++ n ++ " = 0 as " ++ ctype ++ "\n"
        check = check ++ i8s ++ "if " ++ left ++ " > " ++ take ++ ": panic(\"" ++ mname ++ ": C left more in " ++ n ++ " than it was given\")\n"
        fields = fields ++ (if fields.len() > 0: ", " else: "") ++ names[k / 2] ++ ": " ++ take ++ " - " ++ left
        k += 2
    if bridge.params.len() > 0: params = params ++ ", " ++ bridge.params
    let call = facade_render_call(pool, intern, decl, if bridge.args.len() > 0: rec ++ ", " ++ bridge.args else: with_str_clone_ref(rec))
    let ret = facade_render_return(pool, intern, decl)
    let oks = facade_render_fn_oks(pool, intern, decl)
    let step = facade_render_step_name(host, mname)
    var body = facade_render_indent(bridge.prologue, i8s)
    body = body ++ i8s ++ "var " ++ scratch ++ ": u8 = 0\n" ++ i8s ++ "let " ++ rec ++ " = " ++ repr_arg ++ "\n" ++ takes
    body = body ++ i8s ++ "unsafe:\n" ++ store
    body = body ++ i8s ++ (if ret.len() > 4: "let " ++ status ++ " = " else: "") ++ call ++ "\n"
    body = body ++ read ++ i8s ++ "unsafe:\n" ++ clear ++ check
    let value = step ++ " { " ++ (if ret.len() > 4 and oks.len() != 1: "status: " ++ status ++ ", " else: "") ++ fields ++ " }"
    if oks.len() == 0: return head ++ mname ++ "(" ++ params ++ ") -> " ++ step ++ ":\n" ++ body ++ i8s ++ value ++ "\n"
    let (err, empty_message) = facade_render_op_error(pool, intern, decl, mname)
    var failed = ""
    for ok_const in oks:
        failed = failed ++ (if failed.len() > 0: " and " else: "") ++ status ++ " != " ++ intern.resolve(ok_const)
    body = body ++ facade_render_failed(err, status, failed, message_call, taken, i8s, empty_message)
    head ++ mname ++ "(" ++ params ++ ") -> Result[" ++ step ++ ", " ++ err ++ "]:\n" ++ body ++ i8s ++ value ++ "\n"

// The error type an inout operation under `ok` returns: `Failed` alone —
// nothing is produced, so there is no resource to own.
fn facade_render_fn_error_type(pool: &AstPool, intern: &InternPool, decl: i32, presented: &str, with_message: bool) -> str:
    let ret = facade_render_return(pool, intern, decl)
    let item = facade_render_fn_item(pool, intern, decl)
    if ret.len() == 0 or (item != 0 and facade_item_error_sym(pool, item) != 0):
        return ""
    "error " ++ facade_render_fn_error_name(presented) ++ " =\n    | Failed(status: " ++ ret.slice(4, ret.len()) ++ (if with_message: ", message: str" else: "") ++ ")\n"

// The free operations a facade block presents (D64): each fn item stating a
// buffer pairing or a fixed argument whose first parameter takes no
// resource's representation is rendered as an ordinary function — under
// its `rename`, or, presented under the C name, as `__with_facade_<name>`,
// which a call to the C name reaches wherever the rendering is visible
// (SemaFacade.with facade_bridge_redirect). The raw declaration stays what C
// declared: the bridge's own body calls it, and a module that imports the
// header without the facade has the raw operation, under the raw rules.
//
//     error CompressError =
//         | Failed(status: c_int)
//     fn __with_facade_compress(dest: []mut u8, source: []u8) -> Result[usize, CompressError]:
//         let dest_ptr: *mut Bytef = if dest.len() == 0: null else: &raw mut dest[0] as *mut Bytef
//         var capacity: uLongf = dest.len() as uLongf
//         let source_ptr: *const Bytef = if source.len() == 0: null else: &raw const source[0] as *const Bytef
//         let status = unsafe { compress(dest_ptr, &raw mut capacity, source_ptr, (source.len() as uLong)) }
//         if status != Z_OK: return Err(CompressError.Failed(status))
//         if capacity > dest.len() as uLongf: panic(...)
//         capacity as usize
fn facade_render_free_ops(pool: &AstPool, intern: &InternPool, ci: &List[i32], facade: i32):
    var out = facade_render_callback_ops(pool, intern, ci, 0, facade)
    let extra_start = pool.get_data1(facade as NodeId)
    let resources = facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE)
    for i in 0..pool.get_data2(facade as NodeId):
        let item = pool.get_extra(extra_start + i)
        if pool.kind(item as NodeId) != NodeKind.NK_FACADE_FN:
            continue
        let li = facade_render_lend_item(pool, intern, ci, item)
        if not li.lends or li.decl == 0 or li.text_view or (li.borrow_res != 0 and not li.record_view):
            continue
        if not li.bridged and li.variadic == 0 and not li.record_view and li.text_free == 0:
            continue
        var hosted = false
        for resource in resources:
            let repr = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.get_extra(pool.get_data1(resource as NodeId)) as NodeId))
            if facade_render_lend_hosted(pool, intern, li, resource, repr):
                hosted = true
        let views = facade_render_record_view_names(pool, intern, 0)
        for vi in 0..views.len():
            if facade_render_lend_hosted_by_record(pool, intern, li, views[vi]):
                hosted = true
        if hosted:
            continue
        let decl = li.decl
        let cname = intern.resolve(pool.get_data0(decl as NodeId))
        let presented = intern.resolve(if li.rename != 0: li.rename else: pool.get_data0(decl as NodeId))
        let bridge = facade_render_bridge(pool, intern, decl, 0, -1, "")
        if not bridge.ok:
            continue
        let base = if li.rename != 0: presented else: facade_render_bridge_name(cname)
        if li.variadic != 0:
            // One function per case (D66, §16.2b.5), `<base>__<CONST>`;
            // a call to the presented name is retargeted to the case
            // (SemaFacade.with facade_variadic_redirect_free). Under `ok`
            // (D242, #3128) every case presents a `Result`; under `present
            // cases` each case also renders a typed per-option function.
            if facade_render_fn_ok(pool, intern, decl) != 0: out = out ++ facade_render_fn_error_type(pool, intern, decl, presented, false)
            out = out ++ facade_render_variadic_cases(pool, intern, decl, li.variadic, li.present_cases, "fn ", base, presented, "", 0, "    ", "", "")
            continue
        if li.record_view:
            let view = facade_render_record_view_type(pool, intern, decl)
            if view.len() == 0:
                continue
            let handle = facade_render_fresh("repr", facade_render_param_names(pool, intern, decl))
            out = out ++ "fn " ++ base ++ "(" ++ bridge.params ++ ") -> Option[" ++ view ++ "]:\n" ++ facade_render_indent(bridge.prologue, "    ") ++ "    let " ++ handle ++ " = " ++ facade_render_call(pool, intern, decl, bridge.args) ++ "\n    if " ++ handle ++ " == null: None else: Some(unsafe { " ++ handle ++ " as " ++ view ++ " })\n"
            continue
        if li.text_free != 0:
            let rendered_text = if li.rename != 0: presented else: facade_render_bridge_name(cname)
            let text_ret = facade_render_text_return(pool, intern, ci, decl, facade_render_call(pool, intern, decl, bridge.args), li.text_free, facade_render_text_utf8(pool) and not li.text_bytes, "    ", facade_render_indent(bridge.prologue, "    "))
            if text_ret.len() > 0: out = out ++ "fn " ++ rendered_text ++ "(" ++ bridge.params ++ ")" ++ text_ret
            continue
        if facade_render_fn_oks(pool, intern, decl).len() > 0:
            out = out ++ facade_render_fn_error_type(pool, intern, decl, presented, false)
        let rendered = if li.rename != 0: presented else: facade_render_bridge_name(cname)
        let (result, body) = facade_render_bridge_body(pool, intern, decl, bridge, facade_render_call(pool, intern, decl, bridge.args), presented, "    ", "")
        out = out ++ "fn " ++ rendered ++ "(" ++ bridge.params ++ ")" ++ result ++ ":\n" ++ facade_render_indent(bridge.prologue, "    ") ++ body
    out

// Whether a facade block of the compilation declares a resource `name`.
fn facade_render_resource_named(pool: &AstPool, intern: &InternPool, name: &str) -> bool:
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE)
    for item in items:
        if intern.resolve(pool.get_data0(item as NodeId)) == name:
            return true
    false

// The rendered name of one case of a variadic contract (D66, §16.2b.5):
// `<base>__<CONST>`, the base being the presented method name, or the free
// operation's rendered name (`__with_facade_<name>`, or its `rename`).
fn facade_render_variadic_case_name(base: &str, sel: &str): base ++ "__" ++ sel

// One method or function per case of a `variadic param N selected by
// param P:` contract (D66, spec §16.2b.5). The declaration stays variadic:
// each case's rendering calls it with the C parameters before the variadic
// position as the bridge renders them — the selector stays a parameter, so
// the call Sema retargets keeps its argument list — and the variadic
// argument typed as the case states it: an integer C type is passed as
// that type, `str` as a call-scoped NUL-terminated copy (§16.3c: an
// interior NUL is a contract violation, reported by name, never
// truncated). For `curl_easy_setopt` on `Easy`:
//
//     fn setopt__CURLOPT_NOSIGNAL(option: CURLoption, value: c_long) -> CURLcode:
//         unsafe { curl_easy_setopt(self.repr, option, value) }
//     fn setopt__CURLOPT_URL(option: CURLoption, value: &str) -> CURLcode:
//         let value_c = match value.to_cstring():
//             Ok(c) => c
//             Err(_) => panic("…")
//         unsafe { curl_easy_setopt(self.repr, option, value_c.as_cstr().ptr()) }
// Whether a variadic contract states a `fills` case (D235): its function
// then presents a `Result`, and its error type is rendered.
fn facade_render_variadic_fills(pool: &AstPool, clause: i32) -> bool:
    let cops = pool.get_data1(clause as NodeId)
    for k in 0..pool.get_data2(clause as NodeId) - 2:
        if pool.get_extra(pool.get_data1(pool.get_extra(cops + 2 + k) as NodeId) + 7) != 0: return true
    false

// D242 (§16.2b.5, #3128): the per-option name `present cases [stripping PREFIX]`
// derives from a case selector constant: strip leading `prefix` when present,
// then lowercase ASCII.
fn facade_render_presented_case_name(sel: &str, prefix: &str) -> str:
    let stripped = if prefix.len() > 0 and sel.starts_with(prefix): sel.slice(prefix.len(), sel.len()) else: with_str_clone_ref(sel)
    stripped.to_lower()

fn facade_render_valid_case_name(name: &str) -> bool:
    if name.len() == 0: return false
    let first = name[0]
    (first >= 'a' and first <= 'z') or (first >= 'A' and first <= 'Z') or first == '_'

// Every presented name already taken on `resource` other than `exclude_cname`
// (plus `drop` and `repr`), comma-delimited for collision checks.
fn facade_render_surface_blocked_names(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32, exclude_cname: &str) -> str:
    let s = facade_render_surface(pool, intern, ci, resource)
    var out = "drop, repr, "
    var i: isize = -1
    for cn in s.cnames:
        i += 1
        if cn == exclude_cname: continue
        let shown = if cn.len() == 0: s.names[i] else: facade_render_present(pool, intern, ci, resource, cn)
        if shown.len() > 0: out = out ++ shown ++ ", "
    out

// The return type and call lines of one non-`fills` variadic case: raw C return
// when the fn item states no `ok`, `Result[Unit, E]` when it states `ok CONST`
// (D242, #3128, §16.2b.5).
fn facade_render_variadic_call_body(pool: &AstPool, intern: &InternPool, decl: i32, call_args: &str, ok_name: &str, err: &str, empty_message: bool, message_call: &str, taken: &str, indent: &str) -> (str, str):
    if ok_name.len() == 0:
        return (facade_render_return(pool, intern, decl), indent ++ facade_render_call(pool, intern, decl, call_args) ++ "\n")
    let status = facade_render_fresh("status", taken)
    let body = indent ++ "let " ++ status ++ " = " ++ facade_render_call(pool, intern, decl, call_args) ++ "\n" ++ facade_render_failed(err, status, status ++ " != " ++ ok_name, message_call, taken, indent, empty_message) ++ indent ++ "()\n"
    (" -> Result[Unit, " ++ err ++ "]", body)

fn facade_render_one_variadic_case(pool: &AstPool, intern: &InternPool, decl: i32, case_node: i32, sel: &str, method_name: &str, ud_method_name: &str, head: &str, base: &str, repr_arg: &str, skip: i32, sel_param: i32, indent: &str, bridge: &FacadeBridge, ud_bridge: &FacadeBridge, ok_name: &str, err: &str, empty_message: bool, message_call: &str, taken: &str) -> str:
    let ops = pool.get_data1(case_node as NodeId)
    let ty = render_type_expr(pool, intern, pool.get_extra(ops + 1) as NodeId)
    let value = facade_render_fresh("value", taken)
    var params = with_str_clone_ref(bridge.params)
    if params.len() > 0: params = params ++ ", "
    var args = with_str_clone_ref(bridge.args)
    if args.len() > 0: args = args ++ ", "
    var pro = with_str_clone_ref(bridge.prologue)
    if pool.get_extra(ops + 7) != 0:
        // `case K: fills T` (D235, §16.2b.5): With passes the address of
        // a zeroed `T` and presents the value, under the function's `ok`.
        if ok_name.len() == 0: return ""
        let zero = if facade_render_is_record(pool, intern, ty): ty ++ ".zeroed()" else: "0 as " ++ ty
        let status = facade_render_fresh("status", taken)
        let filled = (if repr_arg.len() > 0: repr_arg ++ ", " else: "") ++ args ++ "&raw mut " ++ value
        return head ++ method_name ++ "(" ++ bridge.params ++ ") -> Result[" ++ ty ++ ", " ++ err ++ "]:\n" ++ facade_render_indent(pro, indent) ++ indent ++ "var " ++ value ++ ": " ++ ty ++ " = " ++ zero ++ "\n" ++ indent ++ "let " ++ status ++ " = " ++ facade_render_call(pool, intern, decl, filled) ++ "\n" ++ facade_render_failed(err, status, status ++ " != " ++ ok_name, message_call, taken, indent, empty_message) ++ indent ++ value ++ "\n"
    if pool.get_extra(ops + 2) != 0:
        // A callback case (D66 §16.2b.5, §16.2b.9) and its implied userdata
        // setter, both generic in `U`, `mut fn`.
        if repr_arg.len() == 0: return ""
        let raw_cb = facade_render_callback_raw_type(facade_render_unalias(pool, intern, ty))
        let typed_cb = facade_render_callback_type(pool, intern, raw_cb)
        if typed_cb.len() == 0: return ""
        let mhead = head.replace("fn ", "mut fn ")
        var out = ""
        if method_name.len() > 0:
            let cb_args = repr_arg ++ ", " ++ args ++ "transmute[" ++ raw_cb ++ "](" ++ value ++ ")"
            let (cb_ret, cb_body) = facade_render_variadic_call_body(pool, intern, decl, cb_args, ok_name, err, empty_message, message_call, taken, indent)
            out = out ++ mhead ++ method_name ++ "[U](" ++ params ++ value ++ ": " ++ typed_cb ++ ")" ++ cb_ret ++ ":\n" ++ facade_render_indent(pro, indent) ++ cb_body
        if ud_method_name.len() > 0 and ud_bridge.ok:
            var ud_params = with_str_clone_ref(ud_bridge.params)
            if ud_params.len() > 0: ud_params = ud_params ++ ", "
            var ud_args_pre = with_str_clone_ref(ud_bridge.args)
            if ud_args_pre.len() > 0: ud_args_pre = ud_args_pre ++ ", "
            let ud_args = repr_arg ++ ", " ++ ud_args_pre ++ value ++ " as *const U as *mut c_void"
            let (ud_ret, ud_body) = facade_render_variadic_call_body(pool, intern, decl, ud_args, ok_name, err, empty_message, message_call, taken, indent)
            out = out ++ mhead ++ ud_method_name ++ "[U](" ++ ud_params ++ value ++ ": &U)" ++ ud_ret ++ ":\n" ++ facade_render_indent(ud_bridge.prologue, indent) ++ ud_body
        return out
    if pool.get_extra(ops + 4) != 0:
        // A retained pointer case (D194, §16.2b.5; #3120 `&R`).
        if repr_arg.len() == 0: return ""
        let mhead = head.replace("fn ", "mut fn ")
        let referent = if ty.starts_with("&"): ty.slice(1, ty.len()) else: ty
        let length_ref = pool.get_extra(ops + 5)
        params = params ++ value ++ ": " ++ ty
        if length_ref == 0:
            let ptr_expr = if referent == "CStr": value ++ ".ptr()" else if facade_render_is_resource_name(pool, intern, referent): value ++ ".repr" else: value ++ ".as_cstr().ptr()"
            args = args ++ ptr_expr
            let (rret, rbody) = facade_render_variadic_call_body(pool, intern, decl, repr_arg ++ ", " ++ args, ok_name, err, empty_message, message_call, taken, indent)
            return mhead ++ method_name ++ "(" ++ params ++ ")" ++ rret ++ ":\n" ++ facade_render_indent(pro, indent) ++ rbody
        if ok_name.len() == 0 or pool.get_data0(length_ref as NodeId) != FACADE_PARAM_REF_NAME: return ""
        let length_sel = intern.resolve(pool.get_data1(length_ref as NodeId))
        let length_ty = render_type_expr(pool, intern, pool.get_extra(ops + 6) as NodeId)
        let bytes = facade_render_fresh(value ++ "_bytes", taken)
        let count = facade_render_fresh(value ++ "_count", taken)
        let rc = facade_render_fresh(value ++ "_rc", taken)
        let ptr = facade_render_fresh(value ++ "_ptr", taken)
        let length_bridge = facade_render_bridge(pool, intern, decl, skip, sel_param, length_sel)
        let length_args = if length_bridge.args.len() > 0: length_bridge.args ++ ", " else: ""
        pro = pro ++ "let " ++ bytes ++ " = " ++ (if referent == "str": value ++ ".as_bytes()" else: value) ++ "\n"
        pro = pro ++ "let " ++ count ++ ": " ++ length_ty ++ " = " ++ bytes ++ ".len() as " ++ length_ty ++ "\n"
        pro = pro ++ "if " ++ count ++ " < 0 or " ++ count ++ " as u64 != " ++ bytes ++ ".len() as u64: panic(\"" ++ base ++ "(" ++ sel ++ "): the byte count does not fit " ++ length_sel ++ "'s C type (§16.2b.8)\")\n"
        pro = pro ++ "let " ++ rc ++ " = " ++ facade_render_call(pool, intern, decl, repr_arg ++ ", " ++ length_args ++ count) ++ "\n"
        pro = pro ++ facade_render_failed(err, rc, rc ++ " != " ++ ok_name, message_call, taken, "", empty_message)
        pro = pro ++ "let " ++ ptr ++ ": *const c_void = if " ++ bytes ++ ".len() == 0: null else: &raw const " ++ bytes ++ "[0] as *const c_void\n"
        args = args ++ ptr
        let (sret, sbody) = facade_render_variadic_call_body(pool, intern, decl, repr_arg ++ ", " ++ args, ok_name, err, empty_message, message_call, taken, indent)
        return mhead ++ method_name ++ "(" ++ params ++ ")" ++ sret ++ ":\n" ++ facade_render_indent(pro, indent) ++ sbody
    if ty == "str":
        let cs = value ++ "_c"
        params = params ++ value ++ ": &str"
        pro = pro ++ "let " ++ cs ++ " = match " ++ value ++ ".to_cstring():\n    Ok(c) => c\n    Err(_) => panic(\"" ++ base ++ "(" ++ sel ++ "): the text has an interior NUL, which a C string cannot carry (§16.3c)\")\n"
        args = args ++ cs ++ ".as_cstr().ptr()"
    else:
        params = params ++ value ++ ": " ++ ty
        args = args ++ value
    let call_args = if repr_arg.len() > 0: repr_arg ++ ", " ++ args else: args
    let (vret, vbody) = facade_render_variadic_call_body(pool, intern, decl, call_args, ok_name, err, empty_message, message_call, taken, indent)
    head ++ method_name ++ "(" ++ params ++ ")" ++ vret ++ ":\n" ++ facade_render_indent(pro, indent) ++ vbody

fn facade_render_variadic_cases(pool: &AstPool, intern: &InternPool, decl: i32, clause: i32, present_cases: i32, head: &str, base: &str, presented: &str, repr_arg: &str, skip: i32, indent: &str, message_call: &str, blocked_names: &str) -> str:
    var out = ""
    let cops = pool.get_data1(clause as NodeId)
    let case_count = pool.get_data2(clause as NodeId) - 2
    let sel_param = facade_render_param_ref(pool, intern, decl, pool.get_extra(cops + 1))
    let taken = facade_render_param_names(pool, intern, decl)
    let ok = facade_render_fn_ok(pool, intern, decl)
    let ok_name = if ok != 0: intern.resolve(ok) else: ""
    let (err, empty_message) = if ok != 0: facade_render_op_error(pool, intern, decl, presented) else: ("", false)
    let prefix = if present_cases != 0 and pool.get_extra(pool.get_data1(present_cases as NodeId)) != 0: intern.resolve(pool.get_extra(pool.get_data1(present_cases as NodeId))) else: ""
    var emitted_presented = ", " ++ base ++ ", " ++ blocked_names
    for k in 0..case_count:
        let case_node = pool.get_extra(cops + 2 + k)
        let ops = pool.get_data1(case_node as NodeId)
        let sel = intern.resolve(pool.get_extra(ops))
        let bridge = facade_render_bridge(pool, intern, decl, skip, -1, "")
        if not bridge.ok:
            continue
        var ud_sel = ""
        if pool.get_extra(ops + 2) != 0:
            let ud_ref = pool.get_extra(ops + 3)
            if ud_ref == 0 or pool.get_data0(ud_ref as NodeId) != FACADE_PARAM_REF_NAME:
                continue
            ud_sel = intern.resolve(pool.get_data1(ud_ref as NodeId))
        let ud_case_name = if ud_sel.len() > 0: facade_render_variadic_case_name(base, ud_sel) else: ""
        out = out ++ facade_render_one_variadic_case(pool, intern, decl, case_node, sel, facade_render_variadic_case_name(base, sel), ud_case_name, head, base, repr_arg, skip, sel_param, indent, bridge, bridge, ok_name, err, empty_message, message_call, taken)
        if present_cases != 0 and sel_param >= 0:
            let pname = facade_render_presented_case_name(sel, prefix)
            var emit_p = ""
            if facade_render_valid_case_name(pname) and not emitted_presented.contains(", " ++ pname ++ ", "):
                emitted_presented = emitted_presented ++ pname ++ ", "
                emit_p = pname
            var emit_ud = ""
            if ud_sel.len() > 0:
                let ud_pname = facade_render_presented_case_name(ud_sel, prefix)
                if facade_render_valid_case_name(ud_pname) and not emitted_presented.contains(", " ++ ud_pname ++ ", "):
                    emitted_presented = emitted_presented ++ ud_pname ++ ", "
                    emit_ud = ud_pname
            if emit_p.len() > 0 or emit_ud.len() > 0:
                let p_bridge = facade_render_bridge(pool, intern, decl, skip, sel_param, sel)
                let ud_bridge = if emit_ud.len() > 0: facade_render_bridge(pool, intern, decl, skip, sel_param, ud_sel) else: facade_render_empty_bridge()
                if p_bridge.ok:
                    out = out ++ facade_render_one_variadic_case(pool, intern, decl, case_node, sel, emit_p, emit_ud, head, base, repr_arg, skip, sel_param, indent, p_bridge, ud_bridge, ok_name, err, empty_message, message_call, taken)
    out

// D194: the bridge's argument list with the selector argument (the
// variadic clause's `selected by param P`) replaced by `constant`, for the
// length call of a sized retained case. `args` lists the C parameters
// before the variadic position as the bridge renders them, `skip` of them
// (the receiver) left out.
fn facade_render_replace_selector(pool: &AstPool, intern: &InternPool, clause: i32, args: &str, skip: i32, constant: &str):
    let sel_ref = pool.get_extra(pool.get_data1(clause as NodeId) + 1)
    let parts = args.split(", ")
    if pool.get_data0(sel_ref as NodeId) == FACADE_PARAM_REF_INDEX:
        let digits = intern.resolve(pool.get_data1(sel_ref as NodeId))
        var idx = 0
        for ch in digits.bytes(): idx = idx * 10 + (ch - '0')
        let at = idx - skip
        if at >= 0 and at < parts.len(): parts[at] = constant
    else:
        let name = intern.resolve(pool.get_data1(sel_ref as NodeId))
        for i in 0..parts.len():
            if parts[i] == name: parts[i] = constant
    var out = ""
    for part in parts:
        if part.len() == 0: continue
        out = out ++ part ++ ", "
    out

// The view type a `returns borrow T from …` record view presents (D66,
// §16.2b.6): `&T` for a declaration returning `T *` or `const T *`, or ""
// when the return is not a pointer (Sema's error names it).
fn facade_render_record_view_type(pool: &AstPool, intern: &InternPool, decl: i32) -> str:
    let meta = pool.find_fn_meta(decl as NodeId)
    if meta < 0:
        return ""
    let ret = pool.fn_meta_ret(meta)
    if ret == 0:
        return ""
    let u = facade_render_unalias(pool, intern, render_type_expr(pool, intern, ret as NodeId))
    if u.starts_with("*mut "): return "&" ++ u.slice(5, u.len())
    if u.starts_with("*const "): return "&" ++ u.slice(7, u.len())
    ""

// The C parameter's name as a With parameter: less the translation's
// `__param_` mark, and escaped as the c_import wrappers escape it — an
// uppercase-initial name (sqlite3_column_name's `N`) is a pattern in a
// parameter list, so it is spelled `p_N` (ci_escape_param_name).
fn facade_render_param_name(pool: &AstPool, intern: &InternPool, start: i32, pi: i32):
    let pname = intern.resolve(pool.fn_param_name(start, pi))
    let bare: str = if pname.starts_with("__param_"): pname.slice(8, pname.len()) else: pname
    ci_escape_param_name(bare)

// Every parameter name of the declaration, ", "-separated.
fn facade_render_param_names(pool: &AstPool, intern: &InternPool, decl: i32) -> str:
    let meta = pool.find_fn_meta(decl as NodeId)
    var names = ""
    if meta < 0:
        return names
    let start = pool.fn_meta_param_start(meta)
    for pi in 0..pool.fn_meta_param_count(meta):
        if pi > 0:
            names = names ++ ", "
        names = names ++ facade_render_param_name(pool, intern, start, pi)
    names

// A local the rendering binds, spelled so it is none of `taken` (the
// constructor's parameter names, ", "-separated): With refuses shadowing, and
// a C parameter may well be named `repr`, `status` or `slot`.
fn facade_render_fresh(base: &str, taken: &str):
    let names = ", " ++ taken ++ ", "
    var name = base
    while names.contains(", " ++ name ++ ", "):
        name = name ++ "_"
    name

// The parameter index a facade `param` reference names (`param N`,
// `param name`, `param type T`), or -1: Sema's facade_resolve_param resolves
// the same reference against the signature and reports a miss.
fn facade_render_param_ref(pool: &AstPool, intern: &InternPool, decl: i32, ref_node: i32) -> i32:
    let meta = pool.find_fn_meta(decl as NodeId)
    if meta < 0 or ref_node == 0:
        return -1
    let count = pool.fn_meta_param_count(meta)
    let start = pool.fn_meta_param_start(meta)
    let rk = pool.get_data0(ref_node as NodeId)
    if rk == FACADE_PARAM_REF_INDEX:
        let digits = intern.resolve(pool.get_data1(ref_node as NodeId))
        var idx = 0
        for i in 0..digits.len():
            idx = idx * 10 + (digits[i] - '0') as i32
        return if idx < count: idx else: -1
    if rk == FACADE_PARAM_REF_NAME:
        let want = intern.resolve(pool.get_data1(ref_node as NodeId))
        for pi in 0..count:
            if facade_render_param_name(pool, intern, start, pi) == want:
                return pi
        return -1
    let want = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.get_data1(ref_node as NodeId) as NodeId))
    var found: i32 = -1
    var matches = 0
    for pi in 0..count:
        if facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.fn_param_type(start, pi) as NodeId)) == want:
            matches = matches + 1
            found = pi
    if matches == 1: found else: -1

fn facade_render_return(pool: &AstPool, intern: &InternPool, decl: i32) -> str:
    let meta = pool.find_fn_meta(decl as NodeId)
    if meta < 0:
        return ""
    let ret = pool.fn_meta_ret(meta)
    if ret == 0:
        return ""
    let text = render_type_expr(pool, intern, ret as NodeId)
    if text == "Unit":
        return ""
    " -> " ++ text

// The call, inside `unsafe { }` exactly when the callee is raw: a translated
// inline body that c_import marked `unsafe fn`, a variadic, or a pointer in
// its signature other than a `const char *` input (SemaDecl.with
// ci_function_requires_raw_abi, read here off the AST). A resource never
// lifts the raw C name (SemaFacade.with facade_covers_param): its rendering is
// the safe surface, and an `unsafe` block with nothing unsafe in it is an
// error, so the two classifications must agree — a disagreement is loud.
fn facade_render_call(pool: &AstPool, intern: &InternPool, decl: i32, args: &str):
    let fname = intern.resolve(pool.get_data0(decl as NodeId))
    let call = fname ++ "(" ++ args ++ ")"
    "unsafe { " ++ call ++ " }"

// Whether `text` names a record (a struct or union declaration): the
// representation of a by-value or in-place resource whose fields a program
// reads. A pointer, an integer token (`Fd wraps c_int`) or an opaque type
// has none.
fn facade_render_is_record(pool: &AstPool, intern: &InternPool, text: &str) -> bool:
    let t = facade_render_unalias(pool, intern, text)
    if t.starts_with("*") or t.starts_with("[") or t.starts_with("&"): return false
    for di in 0..pool.decl_count():
        let decl = pool.get_decl(di)
        if pool.kind(decl) != NodeKind.NK_TYPE_DECL or intern.resolve(pool.get_data0(decl)) != t: continue
        let sub = pool.get_data2(decl) % 8
        return (sub == TypeDeclKind.Struct as i32 or sub == TypeDeclKind.Union as i32) and pool.get_extra(pool.get_data1(decl)) > 0
    false

// ── stage 9: callbacks (ruling §44-§47, spec §16.2b.9) ──────────────────
//
// A callback contract — an fn item that retains a callback or its userdata
// (`retains param N by param 0`), consumes userdata with a destroy callback
// (`consumes param N destroyed_by param M`), types a callback's userdata
// (`callback param N userdata param M`), or says `callback_thread any` — is
// a method of the resource its first parameter receives, generic in the
// userdata type `U` when the item names a userdata. For
//
//     int db_exec(db *d, db_cb cb, void *ud, int n);        // db_cb: int (*)(void *, int)
//     fn db_exec
//         callback param 1 userdata param 2
//
// the userdata is borrowed for the call (§44) and the callback receives it
// typed — captureless (§12.4: C receives the code pointer alone), so a
// closure's state lives in `U`:
//
//     fn exec[U](cb: extern "C" fn(&U, c_int) -> c_int, ud: &U, n: c_int) -> c_int:
//         unsafe { db_exec(self.repr, transmute[extern "C" fn(*mut c_void, c_int) -> c_int](cb), ud as *const U as *mut c_void, n) }
//
// Retained userdata (`retains param 2 by param 0`) is owned by the resource
// until it is destroyed (§45): boxed, handed to C as the cell's pointer,
// and released by the resource's Drop after its destroyer ran, through a
// destroy fn that knows `U` (a captureless closure over the type parameter):
//
//     mut fn register[U](cb: extern "C" fn(&U, c_int) -> c_int, app: U) -> c_int:
//         let facade_cell = Box.new(app)
//         let facade_ptr = facade_cell.into_raw() as *mut c_void
//         let facade_free: extern "C" fn(*mut c_void) -> Unit = facade_q => { let facade_b = (facade_q as *mut U) as Box[U]; drop(facade_b) }
//         self.retained_ptrs.push(facade_ptr)
//         self.retained_frees.push(facade_free)
//         unsafe { db_register(self.repr, transmute[…](cb), facade_ptr) }
//
// Consumed userdata (`consumes param 1 destroyed_by param 2`) moves into C
// (§24): boxed, handed over, and the destroy callback the contract names is
// withheld from the method — the compiler supplies the one that knows `U`.
// With never destroys it; C does, through that callback, exactly once:
//
//     fn set_owned[U](owned: U) -> c_int:
//         let facade_cell = Box.new(owned)
//         let facade_free: extern "C" fn(*mut c_void) -> Unit = …
//         unsafe { db_set_owned(self.repr, facade_cell.into_raw() as *mut c_void, facade_free) }
//
// A callback parameter the item does not pair with a userdata keeps C's
// type; a `void *` the item does not name stays `*mut c_void`. Reentrancy
// (§47) is by construction: the callback holds no captures, and reaches
// the userdata as `&U` — a read view for the call, or of a value the
// resource owns. What the generic method cannot state — under
// `callback_thread any` the userdata is Send and Sync (§51) — Sema checks
// at each call (SemaFacade.with facade_check_callback_arg). The rendered
// locals are spelled `facade_*` and apart from the C parameters: a local
// named `free` would resolve to libc's.
//
// D76 (§16.2b.9, ruling Amendment 2): a callback C passes no userdata
// parameter reaches its registration through an accessor of the handle it
// is passed (`sqlite3_user_data(ctx)`). `user_data from <fn> as &U` states
// that accessor, and the compiler generates the wrapper: each callback that
// receives the accessor's handle is presented as its C type with the handle
// in place of the representation, a `callback param N argv param A paired
// with argc param C as &[H]` vector as the one `&[H]`, and `&U` last:
//
//     fn sqlite3_create_function_v2
//         consumes param 4 destroyed_by param 8
//         callback param xFunc argv param 2 paired with argc param 1 as &[Value]
//         user_data from sqlite3_user_data as &U
//
//     fn create_function_v2[U](…, pApp: U, xFunc: extern "C" fn(Context, &[]Value, &U) -> Unit, …) -> c_int:
//         let facade_p5: *mut c_void = unsafe { transmute[*mut c_void](xFunc) }
//         let facade_cell = Box.new((pApp, facade_p5))
//         let facade_ptr = facade_cell.into_raw() as *mut c_void
//         let facade_free: extern "C" fn(*mut c_void) -> Unit = …   // frees the Box of the tuple
//         let facade_w5: extern "C" fn(*mut sqlite3_context, c_int, *mut *mut sqlite3_value) -> Unit = (facade_a0, facade_a1, facade_a2) => {
//             let facade_d = unsafe { sqlite3_user_data(facade_a0) } as *const (U, *mut c_void)
//             if facade_a1 < 0: panic(…)
//             let facade_s: __with_facade_slice_Value = unsafe { transmute[…]((facade_a2 as *const Value, facade_a1 as usize)) }
//             let facade_g: extern "C" fn(Context, &[]Value, &U) -> Unit = unsafe { transmute[…]((*facade_d).1) }
//             facade_g(Context { repr: facade_a0 }, &facade_s, unsafe { &(*facade_d).0 })
//         }
//         let facade_c5: extern "C" fn(*mut sqlite3_context, …) -> Unit = if facade_p5 == null: null else: facade_w5
//         unsafe { sqlite3_create_function_v2(self.repr, …, facade_ptr, facade_c5, …, facade_free) }
//
// The box the userdata already lived in carries the program's callbacks
// beside it, as the code pointers they are (captureless, §12.4). A handle
// is one pointer and `Value` is laid out as `*mut sqlite3_value`, so the
// vector C passes is the slice's storage as it stands; a slice is `(ptr,
// len)` (§4.8a). The slice and `&U` are views the callback holds for its
// invocation only: `[]Value` is ephemeral and `&U` a borrow, so neither can
// be stored past it (the ordinary analysis, §5, §22). The userdata itself
// moves into the box C keeps, so it owns what it holds: an ephemeral one is
// refused there as `Box.new` of one is (§5.1). A C function pointer that is
// null stays null: the wrapper is installed only for a callback the program
// gave.

type FacadeCallbackItem {
    decl: i32,        // 0 when the item is not a callback contract
    of_sym: i32,
    rename: i32,
    userdata: i32,    // the userdata parameter (C index), or -1
    callback: i32,    // the callback parameter paired with cbi, or -1
    destroy: i32,     // the destroy callback a `consumes … destroyed_by` names (withheld), or -1
    retained: bool,
    consumed: bool,
    nullable: bool,   // the paired callback is `nullable` (#1618): `Option[extern "C" fn(&U, …)]`, its userdata `Option[&U]`
    user_data_fn: i32,       // D76: `user_data from <fn> as &U` — the accessor's symbol, or 0
    argv_cb: List[i32],       // D76: each `callback param N argv param A paired with argc param C as &[H]` — N …
    argv_index: List[i32],    // … A …
    argc_index: List[i32],    // … C …
    argv_type: List[str],     // … and the presented type's text (parallel)
}

// A `param N` reference by position, or -1 (the index form is the only one
// a callback's own parameters take; Sema refuses the others).
fn facade_render_index_ref(pool: &AstPool, intern: &InternPool, ref_node: i32) -> i32:
    if ref_node == 0 or pool.get_data0(ref_node as NodeId) != FACADE_PARAM_REF_INDEX:
        return -1
    let digits = intern.resolve(pool.get_data1(ref_node as NodeId))
    var idx = 0
    for i in 0..digits.len():
        idx = idx * 10 + (digits[i] - '0') as i32
    idx

fn facade_render_callback_item(pool: &AstPool, intern: &InternPool, ci: &List[i32], item: i32) -> FacadeCallbackItem:
    let cbi = FacadeCallbackItem { decl: 0, of_sym: 0, rename: 0, userdata: -1, callback: -1, destroy: -1, retained: false, consumed: false, nullable: false, user_data_fn: 0, argv_cb: [], argv_index: [], argc_index: [], argv_type: [] }
    let cname = intern.resolve(pool.get_data0(item as NodeId))
    if facade_render_is_resource_op(pool, intern, cname):
        return cbi
    let decl = facade_render_find_fn(pool, intern, ci, pool.get_data0(item as NodeId))
    if decl == 0:
        return cbi
    var is_callback = false
    var nullable_pi = -1
    let nullable_pis: List[i32] = []
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        let kind = pool.get_data0(clause as NodeId)
        let ops = pool.get_data1(clause as NodeId)
        if kind == FACADE_CLAUSE_OF: cbi.of_sym = pool.get_extra(ops)
        else if kind == FACADE_CLAUSE_RENAME: cbi.rename = pool.get_extra(ops)
        // A fixed argument (D64) leaves the presented signature; the
        // parameter loop below passes its literal (facade_render_fixed_literal).
        else if kind == FACADE_CLAUSE_LEND or kind == FACADE_CLAUSE_PRESERVES or kind == FACADE_CLAUSE_FIXED or kind == FACADE_CLAUSE_BUFFER or kind == FACADE_CLAUSE_VALUE_RECORD or kind == FACADE_CLAUSE_TEXT_PARAM or kind == FACADE_CLAUSE_DISCARDED or kind == FACADE_CLAUSE_OK or kind == FACADE_CLAUSE_CALLBACKS_NONE: continue
        else if kind == FACADE_CLAUSE_NULLABLE:
            // The paired callback's nullability is the pair's (an absent
            // callback takes its userdata with it); any other function-pointer
            // parameter the clause names is presented as `Option` by the
            // parameter bridge (D102, facade_render_bridge_param).
            let npi = facade_render_param_ref(pool, intern, decl, pool.get_extra(ops))
            if npi < 0:
                return cbi
            nullable_pis.push(npi)
        else if kind == FACADE_CLAUSE_CALLBACK_THREAD: is_callback = is_callback or not facade_item_is_variadic(pool, item)
        else if kind == FACADE_CLAUSE_CALLBACK: is_callback = true
        else if kind == FACADE_CLAUSE_CALLBACK_USERDATA:
            let cb = facade_render_param_ref(pool, intern, decl, pool.get_extra(ops))
            let ud = facade_render_param_ref(pool, intern, decl, pool.get_extra(ops + 1))
            if cb < 0 or ud < 0 or (cbi.userdata >= 0 and cbi.userdata != ud) or (cbi.callback >= 0 and cbi.callback != cb):
                return cbi
            cbi.userdata = ud
            cbi.callback = cb
            is_callback = true
        else if kind == FACADE_CLAUSE_RETAINS:
            let a = facade_render_param_ref(pool, intern, decl, pool.get_extra(ops))
            let by = facade_render_param_ref(pool, intern, decl, pool.get_extra(ops + 1))
            if a < 0 or by != 0:
                return cbi
            let ptext = facade_render_param_type(pool, intern, decl, a)
            if facade_render_is_userdata_type(pool, intern, ptext):
                if cbi.userdata >= 0 and cbi.userdata != a:
                    return cbi
                cbi.userdata = a
                cbi.retained = true
                is_callback = true
            else if facade_render_is_callable_type(facade_render_unalias(pool, intern, ptext)):
                is_callback = true
            else:
                return cbi
        else if kind == FACADE_CLAUSE_CONSUMES:
            let a = facade_render_param_ref(pool, intern, decl, pool.get_extra(ops))
            let by_ref = pool.get_extra(ops + 1)
            if by_ref == 0:
                return cbi
            let by = facade_render_param_ref(pool, intern, decl, by_ref)
            if a < 0 or by < 0 or (cbi.userdata >= 0 and cbi.userdata != a) or not facade_render_is_userdata_type(pool, intern, facade_render_param_type(pool, intern, decl, a)):
                return cbi
            cbi.userdata = a
            cbi.destroy = by
            cbi.consumed = true
            is_callback = true
        else if kind == FACADE_CLAUSE_CALLBACK_ARGV:
            let cb = facade_render_param_ref(pool, intern, decl, pool.get_extra(ops))
            let a = facade_render_index_ref(pool, intern, pool.get_extra(ops + 1))
            let n = facade_render_index_ref(pool, intern, pool.get_extra(ops + 2))
            if cb < 0 or a < 0 or n < 0:
                return cbi
            cbi.argv_cb.push(cb)
            cbi.argv_index.push(a)
            cbi.argc_index.push(n)
            cbi.argv_type.push(render_type_expr(pool, intern, pool.get_extra(ops + 3) as NodeId))
            is_callback = true
        else if kind == FACADE_CLAUSE_USER_DATA:
            cbi.user_data_fn = pool.get_extra(ops)
            is_callback = true
        else:
            return cbi
    if not is_callback or (cbi.retained and cbi.consumed):
        return cbi
    for k in 0..nullable_pis.len():
        if nullable_pis[k] == cbi.callback: nullable_pi = nullable_pis[k]
    if nullable_pi >= 0:
        if cbi.retained or cbi.consumed:
            return cbi
        cbi.nullable = true
    // The generated wrapper reaches the program's callbacks through the box
    // the userdata lives in (Sema names each shape it cannot serve,
    // verify_facade_wrapped_callbacks).
    if (cbi.user_data_fn != 0 and not cbi.retained and not cbi.consumed) or (cbi.argv_cb.len() > 0 and cbi.user_data_fn == 0):
        return cbi
    cbi.decl = decl
    cbi

// Whether the callback item is a method of `resource` (whose unaliased
// representation is `repr`): the lend rule (facade_render_lend_hosted).
fn facade_render_callback_hosted(pool: &AstPool, intern: &InternPool, cbi: &FacadeCallbackItem, resource: i32, repr: &str) -> bool:
    if cbi.decl == 0:
        return false
    let li = FacadeLendItem { decl: cbi.decl, of_sym: cbi.of_sym, of_param: 0, rename: cbi.rename, lends: true, borrow_res: 0, borrow_from: 0, borrow_parent: 0, text_view: false, valid_on_failed: false, bridged: false, variadic: 0, present_cases: 0, record_view: false, text_free: 0, text_bytes: false, detaches: 0 }
    facade_render_lend_hosted(pool, intern, li, resource, repr)

// Whether some callback method of `resource` retains userdata: the
// resource carries the retained cells.
fn facade_render_resource_keeps_userdata(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32, repr: &str) -> bool:
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_FN)
    for item in items:
        let cbi = facade_render_callback_item(pool, intern, ci, item)
        if cbi.retained and facade_render_callback_hosted(pool, intern, cbi, resource, repr):
            return true
    false

fn facade_render_param_type(pool: &AstPool, intern: &InternPool, decl: i32, pi: i32):
    let meta = pool.find_fn_meta(decl as NodeId)
    render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(meta), pi) as NodeId)

// A `void *` no resource wraps: a userdata slot.
fn facade_render_is_userdata_type(pool: &AstPool, intern: &InternPool, ptext: &str) -> bool:
    let p = facade_render_unalias(pool, intern, ptext)
    (p == "*mut c_void" or p == "*const c_void") and facade_render_received(pool, intern, ptext) == 0

fn facade_render_is_callable_type(text: &str):
    text.starts_with("fn(") or text.starts_with("extern \"C\" fn(") or text.starts_with("unsafe extern \"C\" fn(")

// The C callback type less `unsafe` — what the typed callback is
// transmuted to (a safe extern fn passes where C declares an unsafe one).
fn facade_render_callback_raw_type(text: &str) -> str:
    if text.starts_with("unsafe "): text.slice(7, text.len()) else: text

// A callable type's text split at its parameter list: the text through the
// opening parenthesis, each top-level parameter, and the rest from the
// matching closing parenthesis. ("", [], "") when there is no list.
fn facade_render_callable_parts(raw: &str) -> (str, List[str], str):
    let parts: List[str] = []
    let open = raw.find("(")
    if open < 0:
        return ("", parts, "")
    // The parameter list ends at the parenthesis matching the first.
    var depth = 0
    var close: i64 = -1
    var i = open
    while i < raw.len():
        if raw[i] == '(': depth = depth + 1
        else if raw[i] == ')':
            depth = depth - 1
            if depth == 0:
                close = i
                break
        i = i + 1
    if close < 0:
        return ("", parts, "")
    let params = raw.slice(open + 1, close)
    // Split at top-level commas.
    var start = 0
    depth = 0
    var k = 0
    while k < params.len():
        if params[k] == '(' or params[k] == '[': depth = depth + 1
        else if params[k] == ')' or params[k] == ']': depth = depth - 1
        else if params[k] == ',' and depth == 0:
            parts.push(params.slice(start, k).trim().to_owned())
            start = k + 1
        k = k + 1
    if params.trim().len() > 0:
        parts.push(params.slice(start, params.len()).trim().to_owned())
    (raw.slice(0, open + 1), parts, raw.slice(close, raw.len()))

// The typed callback: the C signature with its one `void *` parameter —
// where the userdata arrives — spelled `&U`. "" when the signature has
// none or several (Sema refuses the pairing).
fn facade_render_callback_type(pool: &AstPool, intern: &InternPool, text: &str) -> str:
    let (head, parts, tail) = facade_render_callable_parts(facade_render_callback_raw_type(text))
    if head.len() == 0:
        return ""
    var slots = 0
    var out = ""
    for pi in 0..parts.len():
        let p = facade_render_unalias(pool, intern, parts[pi])
        var shown = parts[pi]
        if p == "*mut c_void" or p == "*const c_void":
            slots = slots + 1
            shown = "&U"
        out = out ++ (if pi > 0: ", " else: "") ++ shown
    if slots != 1:
        return ""
    head ++ out ++ tail

// ── D76: the generated wrapper (see the section comment) ────────────────

// The alias a handle's slice is transmuted through: `[]H` cannot be
// spelled as a call's type argument.
fn facade_render_slice_alias(hname: &str): "__with_facade_slice_" ++ hname

// Whether some `callback … argv … as &[H]` clause presents a vector of the
// handle named `hname`.
fn facade_render_handle_sliced(pool: &AstPool, intern: &InternPool, hname: &str) -> bool:
    for item in facade_render_all_items(pool, NodeKind.NK_FACADE_FN):
        let start = pool.get_data1(item as NodeId)
        for k in 0..pool.get_data2(item as NodeId):
            let clause = pool.get_extra(start + k)
            if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_CALLBACK_ARGV:
                continue
            let ty = render_type_expr(pool, intern, pool.get_extra(pool.get_data1(clause as NodeId) + 3) as NodeId)
            if ty == "&[]" ++ hname or ty == "[]" ++ hname:
                return true
    false

// The callbacks (C indices) the wrapper serves: every callable parameter
// but the destroy callback whose own parameters include the accessor's
// handle representation `hrepr` (Sema: facade_contract_wrapped_callbacks).
fn facade_render_wrapped_callbacks(pool: &AstPool, intern: &InternPool, cbi: &FacadeCallbackItem, hrepr: &str) -> List[i32]:
    let out: List[i32] = []
    if cbi.user_data_fn == 0 or hrepr.len() == 0:
        return out
    let meta = pool.find_fn_meta(cbi.decl as NodeId)
    for pi in 0..pool.fn_meta_param_count(meta):
        if pi == cbi.destroy:
            continue
        let raw = facade_render_callback_raw_type(facade_render_unalias(pool, intern, facade_render_param_type(pool, intern, cbi.decl, pi)))
        if not facade_render_is_callable_type(raw):
            continue
        let (head, parts, _) = facade_render_callable_parts(raw)
        if head.len() == 0:
            continue
        var hits = 0
        for part in parts:
            if facade_render_unalias(pool, intern, part) == hrepr: hits = hits + 1
        if hits == 1:
            out.push(pi)
    out

// The argv clause stated for callback `pi`, or -1.
fn facade_render_argv_of(cbi: &FacadeCallbackItem, pi: i32) -> i32:
    for k in 0..cbi.argv_cb.len():
        if cbi.argv_cb[k] == pi:
            return k as i32
    -1

// The presented type of a wrapped callback whose C type is `raw`: each
// handle representation as its handle, the argument vector and its count
// as the stated slice, and `&U` last.
fn facade_render_wrapped_type(pool: &AstPool, intern: &InternPool, cbi: &FacadeCallbackItem, pi: i32, raw: &str) -> str:
    let (head, parts, tail) = facade_render_callable_parts(raw)
    if head.len() == 0:
        return ""
    let k = facade_render_argv_of(cbi, pi)
    var out = ""
    var n = 0
    for j in 0..parts.len():
        if k >= 0 and j == cbi.argc_index[k]:
            continue
        var shown = parts[j]
        if k >= 0 and j == cbi.argv_index[k]:
            shown = cbi.argv_type[k]
        else:
            let handle = facade_render_handle_for(pool, intern, facade_render_unalias(pool, intern, parts[j]))
            if handle.len() > 0: shown = handle
        out = out ++ (if n > 0: ", " else: "") ++ shown
        n = n + 1
    head ++ out ++ (if n > 0: ", " else: "") ++ "&U" ++ tail

// The wrapper C calls for wrapped callback `pi` (C type `raw`, presented as
// `shown`), in the local `wname`: it reads the registration's box through
// the accessor, builds the slice when an argv clause states one, and calls
// the program's callback — slot `slot` of the box — with the handles, the
// slice and `&U`. Each line is prefixed with `indent`.
fn facade_render_wrapper(pool: &AstPool, intern: &InternPool, ci: &List[i32], cbi: &FacadeCallbackItem, pi: i32, raw: &str, shown: &str, cell_type: &str, slot: i32, wname: &str, taken: &str, indent: &str) -> str:
    let (head, parts, _) = facade_render_callable_parts(raw)
    let acc_decl = facade_render_find_fn(pool, intern, ci, cbi.user_data_fn)
    if head.len() == 0 or acc_decl == 0:
        return ""
    let hrepr = facade_render_unalias(pool, intern, facade_render_param_type(pool, intern, acc_decl, 0))
    let fname = intern.resolve(pool.get_data0(cbi.decl as NodeId))
    let d = facade_render_fresh("facade_d", taken)
    let s = facade_render_fresh("facade_s", taken)
    let g = facade_render_fresh("facade_g", taken)
    let names: List[str] = []
    var params = ""
    var h = -1
    for j in 0..parts.len():
        let a = facade_render_fresh(f"facade_a{j}", taken)
        names.push(a)
        params = params ++ (if j > 0: ", " else: "") ++ a
        if facade_render_unalias(pool, intern, parts[j]) == hrepr: h = j as i32
    if h < 0:
        return ""
    let inner = indent ++ "    "
    var body = indent ++ "let " ++ wname ++ ": " ++ raw ++ " = (" ++ params ++ ") => {\n"
    body = body ++ inner ++ "let " ++ d ++ " = " ++ facade_render_call(pool, intern, acc_decl, names[h]) ++ " as *const " ++ cell_type ++ "\n"
    let k = facade_render_argv_of(cbi, pi)
    // A position the callback does not have renders nothing: the checker
    // refuses it ("param 7 does not exist"), where indexing here panicked.
    if k >= 0 and (cbi.argc_index[k] >= names.len() or cbi.argv_index[k] >= names.len()): return ""
    if k >= 0:
        let argc = names[cbi.argc_index[k]]
        let argv = names[cbi.argv_index[k]]
        let list_type = cbi.argv_type[k]
        let hname = if list_type.starts_with("&[]"): list_type.slice(3, list_type.len()) else: list_type.slice(2, list_type.len())
        let alias = facade_render_slice_alias(hname)
        body = body ++ inner ++ "if " ++ argc ++ " < 0: panic(\"" ++ fname ++ ": C passed a callback a negative count for its argument vector (§16.2b.9)\")\n"
        body = body ++ inner ++ "let " ++ s ++ ": " ++ alias ++ " = unsafe { transmute[" ++ alias ++ "]((" ++ argv ++ " as *const " ++ hname ++ ", " ++ argc ++ " as usize)) }\n"
    body = body ++ inner ++ "let " ++ g ++ ": " ++ shown ++ " = unsafe { transmute[" ++ shown ++ "]((*" ++ d ++ ")." ++ f"{slot}" ++ ") }\n"
    var args = ""
    var n = 0
    for j in 0..parts.len():
        if k >= 0 and j == cbi.argc_index[k]:
            continue
        var arg = names[j]
        if k >= 0 and j == cbi.argv_index[k]:
            arg = (if cbi.argv_type[k].starts_with("&"): "&" else: "") ++ s
        else:
            let handle = facade_render_handle_for(pool, intern, facade_render_unalias(pool, intern, parts[j]))
            if handle.len() > 0: arg = handle ++ " { repr: " ++ names[j] ++ " }"
        args = args ++ (if n > 0: ", " else: "") ++ arg
        n = n + 1
    args = args ++ (if n > 0: ", " else: "") ++ "unsafe { &(*" ++ d ++ ").0 }"
    body = body ++ inner ++ g ++ "(" ++ args ++ ")\n"
    body ++ indent ++ "}\n"

// Every callback method of `resource` (see the section comment).
fn facade_render_callback_methods(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32):
    facade_render_callback_ops(pool, intern, ci, resource, 0)

// A callback contract has the same bridge whether presentation supplies a
// receiver or a free function. Only the receiver and indentation differ.
fn facade_render_callback_ops(pool: &AstPool, intern: &InternPool, ci: &List[i32], resource: i32, facade: i32) -> str:
    let hosted = resource != 0
    let repr_text = if hosted: render_type_expr(pool, intern, pool.get_extra(pool.get_data1(resource as NodeId)) as NodeId) else: ""
    let repr = facade_render_unalias(pool, intern, repr_text)
    let in_place = hosted and not repr.starts_with("*") and facade_render_has_clause(pool, resource, FACADE_CLAUSE_INIT)
    if hosted and not repr.starts_with("*") and not in_place:
        return ""
    let pinned = in_place and not facade_render_has_clause(pool, resource, FACADE_CLAUSE_MOVABLE)
    let skip = (hosted) as i32
    let indent = if hosted: "        " else: "    "
    var out = ""
    let items: List[i32] = []
    if hosted:
        for item in facade_render_all_items(pool, NodeKind.NK_FACADE_FN): items.push(item)
    else:
        let start = pool.get_data1(facade as NodeId)
        for i in 0..pool.get_data2(facade as NodeId):
            let item = pool.get_extra(start + i)
            if pool.kind(item as NodeId) == NodeKind.NK_FACADE_FN: items.push(item)
    for item in items:
        let cbi = facade_render_callback_item(pool, intern, ci, item)
        if cbi.decl == 0:
            continue
        if hosted:
            if not facade_render_callback_hosted(pool, intern, cbi, resource, repr): continue
        else:
            var has_host = false
            for res in facade_render_all_items(pool, NodeKind.NK_FACADE_RESOURCE):
                let rtext = render_type_expr(pool, intern, pool.get_extra(pool.get_data1(res as NodeId)) as NodeId)
                if facade_render_callback_hosted(pool, intern, cbi, res, facade_render_unalias(pool, intern, rtext)): has_host = true
            if has_host or cbi.retained: continue
        let decl = cbi.decl
        let meta = pool.find_fn_meta(decl as NodeId)
        let fname = intern.resolve(pool.get_data0(decl as NodeId))
        let mname = if hosted: facade_render_present(pool, intern, ci, resource, fname) else: if cbi.rename != 0: intern.resolve(cbi.rename) else: facade_render_bridge_name(fname)
        let repr_arg = if hosted: facade_render_repr_arg(pool, intern, decl, repr_text, "self.repr", pinned) else: ""
        if hosted and repr_arg.len() == 0:
            continue
        let taken = facade_render_param_names(pool, intern, decl)
        let cell = facade_render_fresh("facade_cell", taken)
        let ptr = facade_render_fresh("facade_ptr", taken)
        let free = facade_render_fresh("facade_free", taken)
        let q = facade_render_fresh("facade_q", taken)
        let b = facade_render_fresh("facade_b", taken)
        let ncb = facade_render_fresh("facade_cb", taken)
        let nud = facade_render_fresh("facade_ud", taken)
        let nf = facade_render_fresh("facade_f", taken)
        let nu = facade_render_fresh("facade_u", taken)
        let generic = cbi.userdata >= 0
        let kept = cbi.retained or cbi.consumed
        let start = pool.fn_meta_param_start(meta)
        // D76: the callbacks a generated wrapper serves, and the box that
        // carries them beside the userdata (see the D76 section comment).
        var wrapped: List[i32] = []
        if cbi.user_data_fn != 0:
            let acc_decl = facade_render_find_fn(pool, intern, ci, cbi.user_data_fn)
            if acc_decl == 0 or not generic or not kept:
                continue
            wrapped = facade_render_wrapped_callbacks(pool, intern, cbi, facade_render_unalias(pool, intern, facade_render_param_type(pool, intern, acc_decl, 0)))
            if wrapped.len() == 0:
                continue
        var cell_type = "U"
        if wrapped.len() > 0:
            cell_type = "(U"
            for _ in 0..wrapped.len(): cell_type = cell_type ++ ", *mut c_void"
            cell_type = cell_type ++ ")"
        let wrapped_names: List[str] = []
        let wrapped_raw: List[str] = []
        let wrapped_shown: List[str] = []
        var cb_type = ""
        if cbi.callback >= 0:
            cb_type = facade_render_callback_type(pool, intern, facade_render_param_type(pool, intern, decl, cbi.callback))
            if cb_type.len() == 0:
                continue
            // A parameter C passes as a handle's representation is the
            // handle (§16.2b.9).
            cb_type = facade_render_handle_callback_type(pool, intern, cb_type)
        var bridge = facade_render_empty_bridge()
        bridge.args = repr_arg
        var ud_name = ""
        var cb_name = ""
        for pi in skip..pool.fn_meta_param_count(meta):
            if pi == cbi.destroy:
                let destroy_part = facade_render_empty_bridge()
                destroy_part.args = free
                bridge = facade_render_append_bridge(bridge, destroy_part)
                continue
            if wrapped.contains(pi):
                let wname = facade_render_param_name(pool, intern, start, pi)
                let raw = facade_render_callback_raw_type(facade_render_unalias(pool, intern, facade_render_param_type(pool, intern, decl, pi)))
                let wshown = facade_render_wrapped_type(pool, intern, cbi, pi, raw)
                let wrapped_part = facade_render_empty_bridge()
                wrapped_part.ok = wshown.len() > 0
                // D102 (§16.2b.8): `nullable param N` presents a wrapped
                // callback as `Option` of its shape; `None` reaches C as NULL
                // through the code-pointer transmute below.
                wrapped_part.params = wname ++ ": " ++ (if facade_render_param_is_nullable(pool, intern, decl, pi): "Option[" ++ wshown ++ "]" else: wshown)
                wrapped_part.args = facade_render_fresh(f"facade_c{pi}", taken)
                bridge = facade_render_append_bridge(bridge, wrapped_part)
                wrapped_names.push(wname)
                wrapped_raw.push(raw)
                wrapped_shown.push(wshown)
                continue
            if pi != cbi.userdata and pi != cbi.callback:
                let part = facade_render_bridge_param(pool, intern, decl, pi)
                bridge = facade_render_append_bridge(bridge, part)
                continue
            let pname = facade_render_param_name(pool, intern, start, pi)
            let ptype = facade_render_param_type(pool, intern, decl, pi)
            var shown = if ptype == "*const i8" or ptype == "*const c_char": "&str" else: ptype
            var arg = pname
            if pi == cbi.userdata:
                ud_name = pname
                if kept:
                    shown = "U"
                    arg = ptr
                else if cbi.nullable:
                    // A nullable callback's userdata (#1618): absent with
                    // it — `Option[&U]`, NULL to C for None.
                    shown = "Option[&U]"
                    arg = nud
                else:
                    shown = "&U"
                    arg = pname ++ " as *const U as " ++ facade_render_unalias(pool, intern, ptype)
            else if pi == cbi.callback:
                cb_name = pname
                if cbi.nullable:
                    // `nullable param N` on the paired callback (ruling
                    // §43, spec §16.2b.8): `Option` of the typed callback,
                    // NULL to C for None.
                    shown = "Option[" ++ cb_type ++ "]"
                    arg = ncb
                else:
                    shown = cb_type
                    arg = "transmute[" ++ facade_render_callback_raw_type(facade_render_unalias(pool, intern, ptype)) ++ "](" ++ pname ++ ")"
            let callback_part = facade_render_empty_bridge()
            callback_part.params = pname ++ ": " ++ shown
            callback_part.args = arg
            bridge = facade_render_append_bridge(bridge, callback_part)
        if not bridge.ok:
            continue
        let call = facade_render_call(pool, intern, decl, bridge.args)
        let (ret, call_body) = facade_render_bridge_body(pool, intern, decl, bridge, call, mname, indent, if hosted: facade_render_message_call(pool, intern, ci, resource) else: "")
        let shown_ret = if not hosted and ret.len() == 0: " -> Unit" else: ret
        let head = (if not hosted: "fn " else: if cbi.retained: "    mut fn " else: "    fn ") ++ mname ++ (if generic: "[U]" else: "") ++ "(" ++ bridge.params ++ ")" ++ shown_ret ++ ":\n"
        var body = facade_render_indent(bridge.prologue, indent)
        var wrapped_failed = false
        if cbi.nullable:
            // The pair is present or absent together (Sema checks each
            // call, SemaCheck.with check_method_call): each maps to its C
            // value, NULL for None.
            let raw_cb = facade_render_callback_raw_type(facade_render_unalias(pool, intern, facade_render_param_type(pool, intern, decl, cbi.callback)))
            let ud_type = facade_render_unalias(pool, intern, facade_render_param_type(pool, intern, decl, cbi.userdata))
            // D102 (with-abi.md §3): `Option[extern "C" fn]` is the nullable
            // pointer, so the value itself crosses; a `None => null` would
            // put a null in the non-null type.
            body = body ++ indent ++ "let " ++ ncb ++ ": " ++ raw_cb ++ " = unsafe { transmute[" ++ raw_cb ++ "](" ++ cb_name ++ ") }\n"
            // The userdata by transmute, not `as *const U as …`: with no
            // callback `U` is Unit, and a cast to `*const Unit` traps
            // codegen (#1626), which a pointer-to-pointer transmute of the
            // same representation does not.
            body = body ++ indent ++ "let " ++ nud ++ ": " ++ ud_type ++ " = match " ++ ud_name ++ ":\n" ++ indent ++ "    Some(" ++ nu ++ ") => unsafe { transmute[" ++ ud_type ++ "](" ++ nu ++ ") }\n" ++ indent ++ "    None => null\n"
        if generic and kept:
            let ud_type = facade_render_unalias(pool, intern, facade_render_param_type(pool, intern, decl, cbi.userdata))
            // The program's callbacks ride in the box as code pointers.
            var boxed = ud_name
            for wi in 0..wrapped.len():
                let p = facade_render_fresh(f"facade_p{wrapped[wi]}", taken)
                body = body ++ indent ++ "let " ++ p ++ ": *mut c_void = unsafe { transmute[*mut c_void](" ++ wrapped_names[wi] ++ ") }\n"
                boxed = boxed ++ ", " ++ p
            if wrapped.len() > 0: boxed = "(" ++ boxed ++ ")"
            body = body ++ indent ++ "let " ++ cell ++ " = Box.new(" ++ boxed ++ ")\n"
            body = body ++ indent ++ "let " ++ ptr ++ " = " ++ cell ++ ".into_raw() as " ++ ud_type ++ "\n"
            body = body ++ indent ++ "let " ++ free ++ ": extern \"C\" fn(*mut c_void) -> Unit = " ++ q ++ " => { let " ++ b ++ " = (" ++ q ++ " as *mut " ++ cell_type ++ ") as Box[" ++ cell_type ++ "]; drop(" ++ b ++ ") }\n"
            if cbi.retained:
                body = body ++ "        self.retained_ptrs.push(" ++ ptr ++ " as *mut c_void)\n        self.retained_frees.push(" ++ free ++ ")\n"
            // Each wrapper, installed only for a callback the program gave:
            // C's null stays null.
            for wi in 0..wrapped.len():
                let pi = wrapped[wi]
                let w = facade_render_fresh(f"facade_w{pi}", taken)
                let wrapper = facade_render_wrapper(pool, intern, ci, cbi, pi, wrapped_raw[wi], wrapped_shown[wi], cell_type, (wi + 1) as i32, w, taken, indent)
                // Nothing is rendered rather than a method with no wrapper
                // (Sema's net names the method that did not render).
                if wrapper.len() == 0:
                    wrapped_failed = true
                body = body ++ wrapper
                // D102: the absent callback is `None`, crossing as the C
                // pointer under the with-abi.md §3 guarantee; the non-null
                // type holds no null.
                body = body ++ indent ++ "let " ++ facade_render_fresh(f"facade_c{pi}", taken) ++ ": " ++ wrapped_raw[wi] ++ " = unsafe { transmute[" ++ wrapped_raw[wi] ++ "](if " ++ facade_render_fresh(f"facade_p{pi}", taken) ++ " == null: None else: Some(" ++ w ++ ")) }\n"
        if wrapped_failed:
            continue
        // A hosted operation's error type is declared beside its resource
        // (facade_render_hosted_fn_errors).
        if not hosted and facade_render_fn_oks(pool, intern, decl).len() > 0:
            out = out ++ facade_render_fn_error_type(pool, intern, decl, mname, false)
        out = out ++ head ++ body ++ call_body ++ "\n"
    out

// The shape of the declaration a c_import translation made under `name`:
// whether there is one, and its return and first parameter types with
// aliases chased ("" when absent). The toolchain libc facade
// (compiler/LibcFacade.with) describes only declarations of libc's own shape.
fn facade_render_import_shape(pool: &AstPool, intern: &InternPool, ci: &List[i32], name: &str) -> (bool, str, str):
    for di in 0..pool.decl_count():
        if di >= ci.len() or ci[di] == 0:
            continue
        let decl = pool.get_decl(di)
        let kind = pool.kind(decl)
        if kind != NodeKind.NK_EXTERN_FN and kind != NodeKind.NK_FN_DECL:
            continue
        let have = intern.resolve(pool.get_data0(decl))
        if have != name:
            continue
        let meta = pool.find_fn_meta(decl)
        if meta < 0:
            return (true, "", "")
        let ret = pool.fn_meta_ret(meta)
        let ret_text = if ret == 0: "Unit" else: facade_render_unalias(pool, intern, render_type_expr(pool, intern, ret as NodeId))
        var p0 = ""
        if pool.fn_meta_param_count(meta) > 0:
            p0 = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(meta), 0) as NodeId))
        return (true, ret_text, p0)
    (false, "", "")

// ── record-view hosts (D122, spec §16.2b.6) ──────────────────────────────
//
// "A borrow through a borrow is a borrow of the same origin." An imported
// record T that a `returns borrow T` clause names, and that no resource
// wraps a pointer to, is a view type: libxml2's node, always borrowed from
// the document. Its operations — the fn items whose first parameter is
// `*mut T` / `*const T` — are rendered as methods of `T` on the `&T` view
// (`n.first_child()`, `n.tag()`), handing C the view's address; a
// `returns borrow T2 from param 0` among them yields `Option[&T2]` whose
// origin is self's origin (Sema's declared summary,
// SemaFacade.with verify_facade_record_return), so the root, its first child
// and the child's next sibling are one type borrowed from the document.

// The record names the fn items of `facade` (every block when `facade` is
// 0) borrow that no resource carries: the view types to host.
fn facade_render_record_view_names(pool: &AstPool, intern: &InternPool, facade: i32):
    let out: List[str] = []
    let items = if facade != 0: facade_render_block_items(pool, facade, NodeKind.NK_FACADE_FN) else: facade_render_all_items(pool, NodeKind.NK_FACADE_FN)
    for i in 0..items.len():
        let item = items[i]
        let cstart = pool.get_data1(item as NodeId)
        for k in 0..pool.get_data2(item as NodeId):
            let clause = pool.get_extra(cstart + k)
            if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_RETURNS_BORROW:
                continue
            let name = intern.resolve(pool.get_extra(pool.get_data1(clause as NodeId)))
            if name == "CStr" or facade_render_resource_named(pool, intern, name) or out.contains(name):
                continue
            if facade_render_resources_wrapping(pool, intern, "*mut " ++ name) > 0:
                continue
            out.push(name)
    out

// The fn items of one facade block of `kind`.
fn facade_render_block_items(pool: &AstPool, facade: i32, kind: NodeKind):
    let out: List[i32] = []
    let extra_start = pool.get_data1(facade as NodeId)
    for i in 0..pool.get_data2(facade as NodeId):
        let item = pool.get_extra(extra_start + i)
        if pool.kind(item as NodeId) == kind:
            out.push(item)
    out

// Whether the lend item is a method of the record view `rname`: its first
// parameter is a pointer to the record, a buffer clause does not pair it,
// no resource wraps that pointer, and its `of` (when stated) names the
// record.
fn facade_render_lend_hosted_by_record(pool: &AstPool, intern: &InternPool, li: &FacadeLendItem, rname: &str) -> bool:
    if not li.lends or li.decl == 0 or facade_render_param_count(pool, li.decl) == 0:
        return false
    if facade_render_buffer_of(pool, intern, li.decl, 0).0 == 0:
        return false
    let meta = pool.find_fn_meta(li.decl as NodeId)
    let p0 = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(meta), 0) as NodeId))
    if p0 != "*mut " ++ rname and p0 != "*const " ++ rname:
        return false
    if facade_render_resources_wrapping(pool, intern, "*mut " ++ rname) > 0:
        return false
    li.of_sym == 0 or intern.resolve(li.of_sym) == rname

// The record view `rname` whose pointer the item's first parameter takes,
// or "": the host of a method rendered on the view.
fn facade_render_record_host(pool: &AstPool, intern: &InternPool, ci: &List[i32], item: i32) -> str:
    let li = facade_render_lend_item(pool, intern, ci, item)
    let names = facade_render_record_view_names(pool, intern, 0)
    for name in names:
        if facade_render_lend_hosted_by_record(pool, intern, li, name):
            return name
    ""

// The presented name of `cname` on the record view `rname`: the item's
// `rename`, else the C name less the record's prefix (§16.2a, as a
// resource's operations shorten), else the C name.
fn facade_render_present_record(pool: &AstPool, intern: &InternPool, rname: &str, cname: &str) -> str:
    let renamed = facade_render_item_rename(pool, intern, cname)
    if renamed.len() > 0:
        return renamed
    let names: List[str] = []
    names.push(rname.to_owned())
    let short = facade_render_shorten(cname, names)
    if short.len() > 0: short else: cname.to_owned()

// The methods of the record view `rname`, rendered inside `impl <rname>:`.
fn facade_render_record_view_methods(pool: &AstPool, intern: &InternPool, ci: &List[i32], rname: &str):
    var out = ""
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_FN)
    for item in items:
        let li = facade_render_lend_item(pool, intern, ci, item)
        if not facade_render_lend_hosted_by_record(pool, intern, li, rname):
            continue
        // A borrowed resource or a variadic contract through a record view
        // is not ruled; Sema names it (verify_facade_record_host).
        if (li.borrow_res != 0 and not li.record_view) or li.variadic != 0:
            continue
        let decl = li.decl
        let meta = pool.find_fn_meta(decl as NodeId)
        let fname = intern.resolve(pool.get_data0(decl as NodeId))
        let mname = facade_render_present_record(pool, intern, rname, fname)
        let p0 = facade_render_unalias(pool, intern, render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(meta), 0) as NodeId))
        // `self` is the `&T` view; C takes the record's address.
        let repr_arg = if p0.starts_with("*const "): "(&raw const *self)" else: "(&raw const *self as *mut " ++ rname ++ ")"
        let bridge = facade_render_bridge(pool, intern, decl, 1, -1, "")
        if not bridge.ok:
            continue
        let params = bridge.params
        let args = bridge.args
        let pro = facade_render_indent(bridge.prologue, "        ")
        let call_args = if args.len() > 0: repr_arg ++ ", " ++ args else: repr_arg
        let head = "    fn "
        if li.text_view:
            let handle = facade_render_fresh("repr", facade_render_param_names(pool, intern, decl))
            out = out ++ head ++ mname ++ "(" ++ params ++ ") -> Option[CStr]:\n" ++ pro ++ "        let " ++ handle ++ " = " ++ facade_render_call(pool, intern, decl, call_args) ++ "\n        if " ++ handle ++ " == null: None else: Some(unsafe { CStr.from_ptr(" ++ handle ++ " as *const c_char) })\n"
            continue
        if li.record_view:
            let view = facade_render_record_view_type(pool, intern, decl)
            if view.len() == 0:
                continue
            let handle = facade_render_fresh("repr", facade_render_param_names(pool, intern, decl))
            out = out ++ head ++ mname ++ "(" ++ params ++ ") -> Option[" ++ view ++ "]:\n" ++ pro ++ "        let " ++ handle ++ " = " ++ facade_render_call(pool, intern, decl, call_args) ++ "\n        if " ++ handle ++ " == null: None else: Some(unsafe { " ++ handle ++ " as " ++ view ++ " })\n"
            continue
        if li.text_free != 0:
            let text_ret = facade_render_text_return(pool, intern, ci, decl, facade_render_call(pool, intern, decl, call_args), li.text_free, facade_render_text_utf8(pool) and not li.text_bytes, "        ", pro)
            if text_ret.len() > 0: out = out ++ head ++ mname ++ "(" ++ params ++ ")" ++ text_ret
            continue
        let (ret, body) = facade_render_bridge_body(pool, intern, decl, bridge, facade_render_call(pool, intern, decl, call_args), mname, "        ", "")
        out = out ++ head ++ mname ++ "(" ++ params ++ ")" ++ ret ++ ":\n" ++ pro ++ body
    out

// ── text parameters and owned text returns (D122, spec §16.2b.8) ────────

// D198: the word of the value-record clause that names parameter `pi`
// (`reads`, `fills` or `updates`, §16.2b.5), or "".
fn facade_render_value_record_kind(pool: &AstPool, intern: &InternPool, decl: i32, pi: i32) -> str:
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0:
        return ""
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        let kind = pool.get_data0(clause as NodeId)
        if kind == FACADE_CLAUSE_VALUE_RECORD and facade_render_param_ref(pool, intern, decl, pool.get_extra(pool.get_data1(clause as NodeId))) == pi:
            return intern.resolve(pool.get_extra(pool.get_data1(clause as NodeId) + 1))
    ""

// Whether `text param N` names parameter `pi` of the declaration, in its
// fn item: input text of any C character type, taking a `str`.

fn facade_render_param_is_text(pool: &AstPool, intern: &InternPool, decl: i32, pi: i32) -> bool:
    let item = facade_render_fn_item(pool, intern, decl)
    if item == 0:
        return false
    let cstart = pool.get_data1(item as NodeId)
    for k in 0..pool.get_data2(item as NodeId):
        let clause = pool.get_extra(cstart + k)
        if pool.get_data0(clause as NodeId) != FACADE_CLAUSE_TEXT_PARAM:
            continue
        if facade_render_param_ref(pool, intern, decl, pool.get_extra(pool.get_data1(clause as NodeId))) == pi:
            return true
    false

// `text return, owned, freed by F`: the result type and body of a
// rendering whose C call is `call`. The returned pointer is new text the
// caller owns: its bytes are copied out (unknown encoding is bytes,
// §16.2b.2 — `Option[List[u8]]` until a return is proved or declared
// UTF-8), F releases the pointer on the same path, NULL is None.
// D134 (§16.2b.8): whether the facade declares `text utf8` — a top-level
// item of the block, found as every facade item is.
fn facade_render_text_utf8(pool: &AstPool) -> bool:
    let items = facade_render_all_items(pool, NodeKind.NK_FACADE_CLAUSE)
    for item in items:
        if pool.get_data0(item as NodeId) == FACADE_CLAUSE_TEXT_UTF8: return true
    false

// The release of `repr` through an imported global holding a function
// pointer (`freed by xmlFree`: libxml2's `xmlFreeFunc xmlFree`, which the
// program may have set), or "" when no such global is imported. A nullable
// pointer that is NULL at the call is the library breaking its contract: a
// failure naming the C function, nothing repaired (D134).
// The declared type of a C global, as a type node: an imported one (`extern
// var`), or one the header defines (a file-scope `static`, translated as a
// module `var` with its type). 0 for any other declaration.
fn facade_render_global_type_node(pool: &AstPool, decl: i32) -> i32:
    if pool.kind(decl as NodeId) == NodeKind.NK_EXTERN_VAR: return pool.get_data1(decl as NodeId)
    if pool.kind(decl as NodeId) != NodeKind.NK_LET_DECL: return 0
    let slot = pool.get_data2(decl as NodeId) / 16
    if slot == 0: 0 else: pool.get_extra(slot - 1)

fn facade_render_release_through_var(pool: &AstPool, intern: &InternPool, decl: i32, free_sym: i32, repr: &str, indent: &str):
    let fname = intern.resolve(pool.get_data0(decl as NodeId))
    let want = intern.resolve(free_sym)
    facade_render_call_through_global(pool, intern, free_sym, repr, indent, fname ++ ": 'freed by " ++ want ++ "', but " ++ want ++ " is NULL (§16.2b.8)")

// A call through the function-pointer global `free_sym` with `repr` as its
// one argument (§31.8.6): the pointer is read at the call, never cached,
// and a NULL is the contract failure `failure` (§31.11). "" when no
// imported global of that name holds a function pointer.
fn facade_render_call_through_global(pool: &AstPool, intern: &InternPool, free_sym: i32, repr: &str, indent: &str, failure: &str) -> str:
    let want = intern.resolve(free_sym)
    let (ptype, _, nullable) = facade_render_global_fn_shape(pool, intern, free_sym)
    if ptype.len() == 0: return ""
    // §31.4: a call through a function pointer is raw.
    let through = "unsafe { f(" ++ repr ++ " as " ++ ptype ++ ") }"
    if not nullable: return "let f = " ++ want ++ "\n" ++ indent ++ through
    "match " ++ want ++ ":\n" ++ indent ++ "    Some(f) => " ++ through ++ "\n" ++ indent ++ "    None => panic(\"" ++ failure ++ "\")"

// The function type the imported global `sym` holds: its parameter list as
// written, its result ("" for none), and whether the pointer may be NULL.
// An empty parameter list text with no such global.
fn facade_render_global_fn_shape(pool: &AstPool, intern: &InternPool, sym: i32) -> (str, str, bool):
    let want = intern.resolve(sym)
    for di in 0..pool.decl_count():
        let vdecl = pool.get_decl(di)
        let type_node = facade_render_global_type_node(pool, vdecl as i32)
        if type_node == 0 or intern.resolve(pool.get_data0(vdecl)) != want: continue
        var ty = render_type_expr(pool, intern, type_node as NodeId)
        let nullable = ty.starts_with("Option[") and ty.ends_with("]")
        if nullable: ty = ty.slice(7, ty.len() - 1)
        let open = ty.find("fn(")
        if open < 0: return ("", "", false)
        var depth = 0
        var close = open + 2
        while close < ty.len():
            if ty[close] == '(': depth = depth + 1
            else if ty[close] == ')':
                depth = depth - 1
                if depth == 0: break
            close = close + 1
        if close >= ty.len(): return ("", "", false)
        let result = ty.slice(close + 1, ty.len()).trim()
        return (ty.slice(open + 3, close).to_owned(), if result == "-> Unit": "" else: result.to_owned(), nullable)
    ("", "", false)

fn facade_render_text_return(pool: &AstPool, intern: &InternPool, ci: &List[i32], decl: i32, call: &str, free_sym: i32, utf8: bool, indent: &str, prologue: &str) -> str:
    let taken = facade_render_param_names(pool, intern, decl)
    let repr = facade_render_fresh("repr", taken)
    let text = facade_render_fresh("text", taken)
    let at = facade_render_fresh("at", taken)
    let byte = facade_render_fresh("byte", taken)
    let fdecl = facade_render_find_fn(pool, intern, ci, free_sym)
    let release = if fdecl != 0:
        let fmeta = pool.find_fn_meta(fdecl as NodeId)
        let ftype = render_type_expr(pool, intern, pool.fn_param_type(pool.fn_meta_param_start(fmeta), 0) as NodeId)
        facade_render_call(pool, intern, fdecl, repr ++ " as " ++ ftype)
    else:
        facade_render_release_through_var(pool, intern, decl, free_sym, repr, indent)
    // No release, no text: the item is left out, and Sema's `freed by`
    // check names what the clause failed to name (never a placeholder).
    if release.len() == 0:
        return ""
    if utf8:
        // `text utf8` (D134): the bytes are validated at the boundary and
        // copied into a `str`; a return that is not UTF-8 is the library
        // breaking its declared contract, a failure that names the C
        // function, nothing repaired.
        let fname = intern.resolve(pool.get_data0(decl as NodeId))
        let view = facade_render_fresh("view", taken)
        var out = " -> Option[str]:\n" ++ prologue
        out = out ++ indent ++ "let " ++ repr ++ " = " ++ call ++ "\n"
        out = out ++ indent ++ "if " ++ repr ++ " == null: return None\n"
        out = out ++ indent ++ "let " ++ view ++ " = unsafe { CStr.from_ptr(" ++ repr ++ " as *const c_char) }\n"
        out = out ++ indent ++ "let " ++ text ++ " = match " ++ view ++ ".to_str():\n"
        out = out ++ indent ++ "    Ok(ok) => ok.to_owned()\n"
        out = out ++ indent ++ "    Err(.InvalidAt(" ++ at ++ ")) => panic(f\"" ++ fname ++ ": the facade declares its text UTF-8, but the text returned is not UTF-8 at byte {" ++ at ++ "} (§16.2b.8)\")\n"
        out = out ++ indent ++ release ++ "\n"
        out = out ++ indent ++ "Some(" ++ text ++ ")\n"
        return out
    var out = " -> Option[List[u8]]:\n" ++ prologue
    out = out ++ indent ++ "let " ++ repr ++ " = " ++ call ++ "\n"
    out = out ++ indent ++ "if " ++ repr ++ " == null: return None\n"
    out = out ++ indent ++ "var " ++ text ++ ": List[u8] = List.new()\n"
    out = out ++ indent ++ "var " ++ at ++ ": i64 = 0\n"
    out = out ++ indent ++ "while true:\n"
    out = out ++ indent ++ "    let " ++ byte ++ " = unsafe { *((" ++ repr ++ " as i64 + " ++ at ++ ") as *const u8) }\n"
    out = out ++ indent ++ "    if " ++ byte ++ " == 0: break\n"
    out = out ++ indent ++ "    " ++ text ++ ".push(" ++ byte ++ ")\n"
    out = out ++ indent ++ "    " ++ at ++ " = " ++ at ++ " + 1\n"
    out = out ++ indent ++ release ++ "\n"
    out = out ++ indent ++ "Some(" ++ text ++ ")\n"
    out
