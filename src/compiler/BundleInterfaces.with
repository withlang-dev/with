// D39 bundle interfaces (wo_bundles.md, decisions.md D39): the `.wi`
// registry.
//
// A bundle's interface file holds one `module <canonical path>` line per
// bundle module, each followed by that module's declarations in interface
// flavor (bodyless functions, initializer-less storage). `--link-bundle
// <prefix>` registers `<prefix>.wi` here before the frontend resolves any
// import (Compilation.load_link_bundles); batch C3 registers the compiler's
// embedded bundle interfaces the same way. The resolver consults the registry
// BEFORE the embedded stdlib and the filesystem
// (EmbeddedStdlib.embedded_std_resolve_path, ModuleSource.module_source_read),
// so a bundle-provided module keeps its canonical
// `<embedded-std>/std/<corpus>/<name>.with` path and only its text changes.
use compiler.SourceExt
use std.collections.HashMap
use std.crypto.sha256
use rt.rt_core
use FnAbi

var g_bundle_interface_texts: HashMap[str, str] = [:]
var g_bundle_interface_packages: HashMap[str, str] = [:]
var g_bundle_registering_package = ""

// sha256 hex of a text — the manifest's `interface-sha` (the .wi bytes) and
// the fingerprint (the canonical declaration rows).
fn bundle_text_sha256(text: &str) -> str:
    let digest: [32]u8 = [0 as u8; 32]
    sha256_hash_str(text, &raw mut digest[0] as *mut u8)
    sha256_hex(&digest[0] as *const u8)

// `--bundle-corpus <rel>` names the module `<embedded-std>/<rel>.with` or the
// directory `<embedded-std>/<rel>/` — `std/engines/pcre2` is pcre2's corpus, `std/wi_demo`
// the one-module demo.
fn bundle_corpus_contains(corpus: &str, canonical_path: &str) -> bool:
    if corpus.len() == 0:
        return false
    // A tree bundle may name several directories, comma-separated.
    for base in bundle_corpus_base(corpus).split(","):
        if source_ext_is_source(canonical_path) and source_ext_stem(canonical_path) == base or canonical_path.starts_with(base ++ "/"): return true
    false

// The tree a corpus lives in: the runtime's (D30 R3, `rt`) is
// `<embedded-rt>/rt`, every migrated corpus's `<embedded-std>/<rel>`, and a
// tree bundle's (`tree:<dir>`, #3351) the directory itself, canonical.
fn bundle_corpus_base(corpus: &str) -> str:
    if corpus == "rt": "<embedded-rt>/rt" else if bundle_corpus_is_tree(corpus): corpus.slice(5, corpus.len()) else: "<embedded-std>/" ++ corpus

// #3351: `--bundle-corpus tree:<dir>` bundles the modules of a directory of
// one checkout (the compiler's own `src/`). It is never embedded or chosen
// on demand: a program names it with `--link-bundle`, so the program knows
// at compile time that it links it, and runs its initializer before its own
// (a migrated corpus's object runs none, D38 Level 0).
fn bundle_corpus_is_tree(corpus: &str) -> bool: corpus.starts_with("tree:")

// The initializers of the tree bundles this compile links (`init <symbol>`
// in each manifest), in `--link-bundle` order.
var g_bundle_init_symbols: List[str] = []

fn bundle_register_init_symbol(symbol: &str):
    if not g_bundle_init_symbols.contains(symbol): g_bundle_init_symbols.push(symbol.to_owned())

fn bundle_init_symbols() -> List[str]: g_bundle_init_symbols.clone()

// An owner two modules of one unit both declare is `Owner$m$<path hash>` in
// Sema (SemaDecl). A module's link names and its interface section carry
// the module already, and name the owner as a unit that sees one of the two
// modules does: plain.
fn bundle_name_without_module_identity(name: &str) -> str:
    let at = name.find("$m$")
    if at < 0: return name ++ ""
    var end = at + 3
    while end < name.len() and (name[end] == '-' or (name[end] >= '0' and name[end] <= '9')): end = end + 1
    name.slice(0, at) ++ name.slice(end, name.len())

// #3351: the initializer a tree bundle's object defines, named from the
// corpus directory as a module's functions are from its path.
fn bundle_init_symbol(corpus: &str) -> str: fn_abi_module_link_prefix(bundle_corpus_base(corpus)) ++ "bundle_init"

// `<embedded-std>/std/engines/pcre2/defs.with` → `std.engines.pcre2.defs`, `<embedded-rt>/rt/rt_core.with`
// → `rt.rt_core`; "" for any other path.
fn bundle_module_dotted_name(canonical_path: &str) -> str:
    let prefix = if canonical_path.starts_with("<embedded-rt>/"): "<embedded-rt>/" else: "<embedded-std>/"
    if not canonical_path.starts_with(prefix) or not source_ext_is_source(canonical_path):
        return ""
    let rel = canonical_path.slice(prefix.len(), canonical_path.len() - source_ext_len(canonical_path))
    var out = ""
    for i in 0..rel.len():
        out = out ++ (if rel[i] == '/': "." else: rel.slice(i, i + 1))
    out

// A tree bundle's module as its tree imports it: `<dir>/compiler/Link.with` of
// corpus directory `<dir>` is `compiler.Link`; "" outside the corpus.
fn bundle_tree_module_dotted_name(corpus: &str, canonical_path: &str) -> str:
    if not source_ext_is_source(canonical_path): return ""
    for base in bundle_corpus_base(corpus).split(","):
        if canonical_path.starts_with(base ++ "/"): return canonical_path.slice(base.len() + 1, canonical_path.len() - source_ext_len(canonical_path)).replace("/", ".")
    ""

// The `module <path>` section paths of an interface file, in file order.
fn bundle_interface_section_paths(wi_text: &str) -> List[str]:
    let out: List[str] = []
    var start: i64 = 0
    while start < wi_text.len():
        var end = start
        while end < wi_text.len() and wi_text[end] != '\n':
            end = end + 1
        let line = wi_text.slice(start, end)
        if line.starts_with("module "):
            out.push(bundle_interface_trim(line.slice(7, line.len())))
        start = end + 1
    out

// The interface section registered for a canonical module path; "" when the
// path is not bundle-provided.
fn bundle_interface_text(path: &str) -> str:
    let found = g_bundle_interface_texts.get(bundle_interface_key(path))
    if found.is_none():
        return ""
    with_str_clone_ref(found.unwrap())

// A tree bundle's sections are named by canonical file paths (#3351), and
// the resolver hands a file module's path as it found it (`src/Sema.with`):
// once a tree section is registered, a file path is looked up canonical.
var g_bundle_tree_sections: bool = false

fn bundle_interface_key(path: &str) -> str:
    if not g_bundle_tree_sections or path.starts_with("<"): path ++ "" else: codegen_canonical_module_path(path)

// A path some registered interface names as a section, even an empty one
// (a bundle root `bundle.with` holds only `use` lines).
fn bundle_interface_registered(path: &str) -> bool:
    g_bundle_interface_texts.contains(bundle_interface_key(path))

fn bundle_interface_trim(s: &str) -> str:
    var a: i64 = 0
    var b = s.len()
    while a < b and (s[a] == ' ' or s[a] == '\t'):
        a = a + 1
    while b > a and (s[b - 1] == ' ' or s[b - 1] == '\t' or s[b - 1] == '\r'):
        b = b - 1
    with_str_clone_ref(s.slice(a, b))

fn bundle_interfaces_register_section(path: &str, text: &str):
    if not path.starts_with("<"): g_bundle_tree_sections = true
    g_bundle_interface_texts.insert(with_str_clone_ref(path), with_str_clone_ref(text))
    if g_bundle_registering_package.len() > 0: g_bundle_interface_packages.insert(with_str_clone_ref(path), with_str_clone_ref(g_bundle_registering_package))

// A package bundle's modules are one package: the bundle's. The source of
// a bundled package need not exist, so its `with.toml` cannot say so.
fn bundle_interfaces_register_package_wi(package: &str, wi_text: &str) -> isize:
    g_bundle_registering_package = with_str_clone_ref(package)
    let count = bundle_interfaces_register_wi(wi_text)
    g_bundle_registering_package = ""
    count

/// The package of the bundle that provides the module at `path`, or "".
fn bundle_interface_package(path: &str) -> str:
    let found = g_bundle_interface_packages.get(bundle_interface_key(path))
    if found.is_some(): found.unwrap() else: ""

// Register every `module <path>` section of an interface file. Returns the
// section count so a file with none is a loud error at the caller.
fn bundle_interfaces_register_wi(wi_text: &str) -> isize:
    var count = 0
    var section_path = ""
    var section_start: i64 = 0
    var start: i64 = 0
    while start < wi_text.len():
        var end = start
        while end < wi_text.len() and wi_text[end] != '\n':
            end = end + 1
        let line = wi_text.slice(start, end)
        if line.starts_with("module "):
            if section_path.len() > 0:
                bundle_interfaces_register_section(section_path, wi_text.slice(section_start, start))
                count = count + 1
            section_path = bundle_interface_trim(line.slice(7, line.len()))
            section_start = end + 1
        start = end + 1
    if section_path.len() > 0:
        let tail = if section_start < wi_text.len(): wi_text.slice(section_start, wi_text.len()) else: ""
        bundle_interfaces_register_section(section_path, tail)
        count = count + 1
    count
