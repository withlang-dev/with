// `with fix-ceremony` — remove ceremony the compiler can prove unnecessary
// (#3061; CLAUDE.md "Ceremony is a design defect"). The census counts; this
// rewrites. Every rewrite rests on a fact Sema recorded while it checked the
// program (Sema.with `ceremony_*`), never on the text's shape:
//
//   annotation   `let x: T = e` where `e`'s type is `T` and the initializer
//                is typed without the annotation's demand: `: T` goes.
//   var          a `var` whose binding is never assigned again and never
//                passed to a `mut` parameter (§3.8a): `let`.
//
//   with fix-ceremony --report <entry.with>     # every rewrite, by file and line
//   with fix-ceremony --apply  <entry.with>     # write them; the entry is checked
//                                            # again and a file that no longer
//                                            # checks is restored
//   --exclude <path-prefix>                  # leave those files alone
//   --std                                    # rewrite lib/std too (never a migrated corpus, D112)
//
// A std file reached through the embedded prelude is never rewritten here:
// the entry's own files and the files on disk it imports are.
use std.process
use std.collections.HashMap
use std.builtins.eprint
use compiler.Compilation
use Diagnostic
use Ast
use Sema
use SemaTypes
use rt.rt_core

type CeremonyEdit {
    path: str,
    start: i32,
    end: i32,
    replacement: str,
    what: str,
}

// An initializer typed without the annotation's demand (§4.3c, D93, D22):
// a read of a place, a string, a cast (its type is written), a call of a
// non-generic function, and operators over those. A literal, a collection
// literal, a comprehension, a variant shorthand, `None`/`Some`, an `if` or
// `match`, a closure and a generic call take their type from the demand, so
// the annotation may be what types them; they are left alone.
fn cf_demand_free(sema: &Sema, pool: &AstPool, node: i32) -> bool:
    if node == 0: return false
    let kind = pool.kind(node)
    // A bare `None` (an ident that names a variant) takes its enum from the demand.
    if kind == NodeKind.NK_IDENT: return not sema.variant_lookup.contains(pool.get_data0(node))
    if kind == NodeKind.NK_FIELD_ACCESS or kind == NodeKind.NK_INDEX or kind == NodeKind.NK_CAST or kind == NodeKind.NK_STRING_LIT or kind == NodeKind.NK_FSTRING: return true
    if kind == NodeKind.NK_UNARY: return cf_demand_free(sema, pool, pool.get_data1(node))
    if kind == NodeKind.NK_BINARY: return cf_demand_free(sema, pool, pool.get_data1(node)) and cf_demand_free(sema, pool, pool.get_data2(node))
    if kind == NodeKind.NK_CALL:
        let callee = sema.comp_resolved.get(node) ?? 0
        if callee == 0: return false
        return sema.generic_fn_node_for_symbol(callee) == 0
    false

// The `(` at `open` groups an expression, as against opening a call's or an
// index's argument list: nothing of a name, a `)` or a `]` precedes it.
fn cf_paren_is_grouping(text: &str, open: i32) -> bool:
    var i = open - 1
    while i >= 0 and (text[i] == ' ' or text[i] == '\t'): i = i - 1
    if i < 0: return true
    let c = text[i]
    not ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == ')' or c == ']')

// The names a diagnostic quotes in backticks.
fn cf_quoted_names(message: &str) -> List[str]:
    let parts = message.split("`")
    [p for (i, p) in parts.enumerate() if i % 2 == 1 and p.len() > 0]

// The byte just before `at` that is a colon, skipping blanks: where a
// `let x: T` annotation begins.
fn cf_colon_before(text: &str, at: i32) -> i32:
    var i = at - 1
    while i >= 0 and (text[i] == ' ' or text[i] == '\t'): i = i - 1
    if i >= 0 and text[i] == ':': i else: -1

// Where the ` ->` before a return type starts: the first blank before the
// arrow, so the signature closes up. -1 when the type is not after an arrow.
fn cf_arrow_before(text: &str, at: i32) -> i32:
    var i = at - 1
    while i >= 0 and (text[i] == ' ' or text[i] == '\t'): i = i - 1
    if i < 1 or text[i] != '>' or text[i - 1] != '-': return -1
    i = i - 2
    while i >= 0 and (text[i] == ' ' or text[i] == '\t'): i = i - 1
    i + 1

fn cf_line_of(text: &str, at: i32) -> i32:
    var line = 1
    for i in 0..at:
        if text[i] == '\n': line = line + 1
    line

fn cf_excluded(path: &str, excludes: &List[str]) -> bool:
    for prefix in excludes:
        if path.starts_with(prefix): return true
    false

// A path the tool may rewrite: a file on disk, not the embedded std.
fn cf_rewritable(path: &str, excludes: &List[str], std_too: bool) -> bool:
    // A migrated corpus is never edited (D112); the standard library only on
    // request (a program's entry reaches it compiled from source under a
    // :dev stage1).
    if path.starts_with("lib/std/engines/") or path.starts_with("test/corpora/") or path.contains("/lib/std/engines/"): return false
    if not std_too and (path.starts_with("lib/std/") or path.contains("/lib/std/")): return false
    path.len() > 0 and not path.starts_with("<") and not cf_excluded(path, excludes) and with_fs_read_file(path).len() > 0

// A line's indentation, in bytes.
fn cf_indent_at(text: &str, line_start: i32):
    var i = line_start
    while i < text.len() and (text[i] == ' ' or text[i] == '\t'): i = i + 1
    i - line_start

// The byte ranges this target did not check: a `comptime if` or `comptime
// match` line, the lines indented under it, and the `else` arms that follow
// at its indentation. The transform keeps one arm and Sema never sees the
// others, so a fact of the form "nothing else uses this name" does not
// cover them: another platform's arm may. Each range is [start, end).
fn cf_unchecked_ranges(text: &str) -> List[i32]:
    let ranges = []
    var at = 0
    while at < text.len():
        var eol = at
        while eol < text.len() and text[eol] != '\n': eol = eol + 1
        let line = text.slice(at, eol)
        if line.contains("comptime if ") or line.contains("comptime match "):
            let indent = cf_indent_at(text, at)
            var end = if eol < text.len(): eol + 1 else: eol
            while end < text.len():
                var next_eol = end
                while next_eol < text.len() and text[next_eol] != '\n': next_eol = next_eol + 1
                let next = text.slice(end, next_eol)
                let blank = next.trim().len() == 0
                let next_indent = cf_indent_at(text, end)
                if not blank and next_indent <= indent and not (next_indent == indent and next.trim().starts_with("else")): break
                end = if next_eol < text.len(): next_eol + 1 else: next_eol
            ranges.push(at)
            ranges.push(end)
            at = end
        else:
            at = if eol < text.len(): eol + 1 else: eol
    ranges

fn cf_is_name_byte(c: u8) -> bool: (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'

// Whether `name` is written, as a whole word, in code the target did not check.
fn cf_named_unchecked(text: &str, ranges: &List[i32], name: &str) -> bool:
    if name.len() == 0: return false
    let n = name.len()
    var r = 0
    while r + 1 < ranges.len():
        var i: isize = ranges[r]
        let stop: isize = ranges[r + 1]
        while i + n <= stop:
            if text.slice(i, i + n) == name and (i == 0 or not cf_is_name_byte(text[i - 1])) and (i + n >= text.len() or not cf_is_name_byte(text[i + n])): return true
            i = i + 1
        r = r + 2
    false

// Whether any unchecked code lies inside [start, end).
fn cf_spans_unchecked(ranges: &List[i32], start: i32, end: i32) -> bool:
    var r = 0
    while r + 1 < ranges.len():
        if ranges[r] < end and ranges[r + 1] > start: return true
        r = r + 2
    false

fn cf_collect(sema: &Sema, pool: &AstPool, excludes: &List[str], std_too: bool) -> List[CeremonyEdit]:
    let edits = []
    let texts: HashMap[str, str] = [:]
    let unchecked: HashMap[str, List[i32]] = [:]
    // The initializers of the lets whose written type makes the literal.
    let let_news: HashMap[i32, i32] = [:]
    for (let_node, _) in sema.ceremony_list_news:
        let_news.insert(sema.ceremony_let_values.get(let_node) ?? 0, 1)
    for (node, path) in sema.ceremony_let_paths:
        if not cf_rewritable(path, excludes, std_too): continue
        if not texts.contains(path):
            texts.insert(with_str_clone_ref(path), with_fs_read_file(path))
            unchecked.insert(with_str_clone_ref(path), cf_unchecked_ranges(texts.get(path).unwrap()))
        let text = texts.get(path).unwrap()
        let ranges = unchecked.get(path).unwrap()
        // The census's typed patterns (SemaDiag.with): `.clone()` on a str
        // (D111: a str is a value), an explicit `&x` at a `&T` parameter
        // (§3.8 auto-references), `Some(x)` where an Option is demanded
        // (D103: the demand converts). Each is its inner expression.
        if sema.ceremony_sites.contains(node):
            let pattern = sema.ceremony_sites.get(node).unwrap()
            if pattern == 1:
                let recv = pool.get_data0(pool.get_data0(node))
                edits.push(CeremonyEdit { path: with_str_clone_ref(path), start: pool.get_end(recv), end: pool.get_end(node), replacement: "", what: "`.clone()` on a str: a str is a value (D111)" })
            else if pattern == 2:
                let inner = pool.get_data1(node)
                edits.push(CeremonyEdit { path: with_str_clone_ref(path), start: pool.get_start(node), end: pool.get_start(inner), replacement: "", what: "`&x` at a `&T` parameter auto-references (§3.8)" })
            else if pattern == 3:
                let arg = pool.get_extra(pool.get_data1(node))
                edits.push(CeremonyEdit { path: with_str_clone_ref(path), start: pool.get_start(node), end: pool.get_start(arg), replacement: "", what: "`Some(x)` where an Option is demanded: the demand converts (D103)" })
                edits.push(CeremonyEdit { path: with_str_clone_ref(path), start: pool.get_end(arg), end: pool.get_end(node), replacement: "", what: "the closing paren" })
            continue
        // `for i in 0..xs.len():` whose every use of `i` is `xs[i]` read: the
        // loop iterates the list, and each `xs[i]` is the element.
        if sema.ceremony_index_loop_bases.contains(node):
            let uses = sema.ceremony_loop_uses.get(node) ?? 0
            let index_uses = sema.ceremony_loop_index_uses.get(node) ?? 0
            if uses > 0 and uses == index_uses and not sema.ceremony_loop_written.contains(node) and not cf_spans_unchecked(ranges, pool.get_start(node), pool.get_end(node)):
                let base = sema.ceremony_index_loop_bases.get(node).unwrap()
                let list_name = sema.pool_resolve(pool.get_data0(base))
                let elem = sema.pool_resolve(sema.ceremony_loop_elem_syms.get(node).unwrap())
                let iterable = pool.get_data1(node)
                // `i in 0..xs.len()`: from the counter's name to the range's end.
                var counter_start = pool.get_start(node) + 3
                while counter_start < text.len() and text[counter_start] == ' ': counter_start = counter_start + 1
                edits.push(CeremonyEdit { path: with_str_clone_ref(path), start: counter_start, end: pool.get_end(iterable), replacement: elem ++ " in " ++ list_name, what: "`for i in 0..xs.len()` indexes only `xs`: it iterates the list" })
                for (index_node, owner) in sema.ceremony_loop_index_nodes:
                    if owner == node: edits.push(CeremonyEdit { path: with_str_clone_ref(path), start: pool.get_start(index_node), end: pool.get_end(index_node), replacement: with_str_clone_ref(elem), what: "the element" })
            continue
        // A widening `as` under a demand of its target: the cast goes, the
        // source stays (`x as i64` where an i64 is demanded → `x`).
        if sema.ceremony_widening_casts.contains(node):
            let src = sema.ceremony_widening_casts.get(node).unwrap()
            let cast_start = pool.get_start(node)
            let cast_end = pool.get_end(node)
            // `(x as u32)` written as a shift count or an operand: the parens held
            // the cast, and go with it.
            let wrapped = cast_start > 0 and cast_end < text.len() and text[cast_start - 1] == '(' and text[cast_end] == ')' and cf_paren_is_grouping(text, cast_start - 1)
            let what = "`as " ++ sema.type_name(sema.typed_expr_types.get(node) ?? 0) ++ "` widens where the context already does (§4.2.6)"
            if wrapped: edits.push(CeremonyEdit { path: with_str_clone_ref(path), start: cast_start - 1, end: cast_start, replacement: "", what: with_str_clone_ref(what) })
            edits.push(CeremonyEdit { path: with_str_clone_ref(path), start: pool.get_end(src), end: if wrapped: cast_end + 1 else: cast_end, replacement: "", what: what })
            continue
        // A private function's return type is cf_collect_fn_rets's: it is
        // kept only if the function then infers the same type.
        if sema.ceremony_fn_rets.contains(node): continue
        // A trait impl method's return type that restates the trait's: the
        // arrow and the type go.
        if sema.ceremony_contract_rets.contains(node):
            let arrow = cf_arrow_before(text, pool.get_start(node))
            if arrow >= 0:
                edits.push(CeremonyEdit { path: with_str_clone_ref(path), start: arrow, end: pool.get_end(node), replacement: "", what: "return type `-> " ++ text.slice(pool.get_start(node), pool.get_end(node)) ++ "` restates the trait's" })
            continue
        // The same constructor where a field, an argument, an assignment
        // or a return demands its type.
        if sema.ceremony_demanded_news.contains(node):
            // The initializer of a let with its type written is that let's edit.
            if let_news.contains(node): continue
            let name = sema.pool_resolve(pool.get_data0(pool.get_data0(pool.get_data0(node))))
            let literal = if name == "HashMap": "[:]" else: "[]"
            edits.push(CeremonyEdit { path: with_str_clone_ref(path), start: pool.get_start(node), end: pool.get_end(node), replacement: literal, what: "`" ++ name ++ ".new()` where its type is demanded is `" ++ literal ++ "` (D93)" })
            continue
        // `List.new()` / `HashMap.new()` / `HashSet.new()` as a let's
        // initializer with its type written: the empty literal (D93).
        if sema.ceremony_list_news.contains(node):
            let value = sema.ceremony_let_values.get(node).unwrap()
            let callee = pool.get_data0(value)
            let owner = pool.get_data0(callee)
            let name = sema.pool_resolve(pool.get_data0(owner))
            let literal = if name == "HashMap": "[:]" else: "[]"
            edits.push(CeremonyEdit { path: with_str_clone_ref(path), start: pool.get_start(value), end: pool.get_end(value), replacement: literal, what: "`" ++ name ++ ".new()` under a written type is `" ++ literal ++ "` (D93)" })
        let flags = pool.get_data2(node)
        // The annotation: the type node's span, and the colon before it. A cast
        // initializer whose cast goes keeps the annotation: it is the demand
        // the cast removal relies on (`var h: i64 = base as i64` → `var h: i64 = base`).
        if sema.ceremony_let_annotations.contains(node):
            let ann = sema.resolve_alias(sema.ceremony_let_annotations.get(node).unwrap() as TypeId) as i32
            let value = sema.ceremony_let_values.get(node).unwrap()
            let value_ty = sema.resolve_alias((sema.typed_expr_types.get(value) ?? 0) as TypeId) as i32
            if value_ty != 0 and value_ty == ann and cf_demand_free(sema, pool, value) and not sema.ceremony_widening_casts.contains(value):
                let type_node = sema.ceremony_let_type_nodes.get(node).unwrap()
                let type_start = pool.get_start(type_node)
                let colon = cf_colon_before(text, type_start)
                if colon >= 0:
                    edits.push(CeremonyEdit { path: with_str_clone_ref(path), start: colon, end: pool.get_end(type_node), replacement: "", what: "annotation `: " ++ sema.type_name(ann) ++ "` restates the initializer's type" })
        // `var` never rebound: the keyword at the statement's start.
        if flags % 2 == 1 and not sema.ceremony_rebound_lets.contains(node) and not cf_named_unchecked(text, ranges, sema.pool_resolve(pool.get_data0(node))):
            let start = pool.get_start(node)
            if start + 3 <= text.len() and text.slice(start, start + 3) == "var":
                edits.push(CeremonyEdit { path: with_str_clone_ref(path), start, end: start + 3, replacement: "let", what: "`var` is never rebound: `let`" })
    edits

// #2522 (D183): the narrowing casts of a length, which no rewrite removes:
// dropping one turns a wrap into a range check where it stands, and the
// ruling's fix is the declaration that makes it a conversion at all. Each is
// reported with its line, in two classes: a context of the cast's width
// demands it (a parameter, a field, an annotated binding, a return: that
// declaration is what to move to the length's width), or nothing does (the
// cast alone gives its binding or loop variable that width).
// One line per cast, then the summary line.
fn cf_len_cast_notes(sema: &Sema, pool: &AstPool, excludes: &List[str], std_too: bool):
    let notes = []
    let texts: HashMap[str, str] = [:]
    var demanded = 0
    var setting = 0
    for (node, path) in sema.ceremony_len_cast_paths:
        if not cf_rewritable(path, excludes, std_too): continue
        if not texts.contains(path): texts.insert(with_str_clone_ref(path), with_fs_read_file(path))
        let text = texts.get(path).unwrap()
        let target = sema.type_name(sema.typed_expr_types.get(node) ?? 0)
        let line = cf_line_of(text, pool.get_start(node))
        if (sema.ceremony_len_casts.get(node) ?? 0) == 1:
            demanded = demanded + 1
            notes.push(f"{path}:{line}: len cast: an `{target}` declaration demands it; that declaration is what to widen (D183)")
        else:
            setting = setting + 1
            notes.push(f"{path}:{line}: len cast: nothing demands `{target}` here; without the cast this is the length's own width (D183)")
    notes.push(f"fix-ceremony: {demanded + setting} length cast(s): {demanded} demanded by a declaration, {setting} that set a width nothing asks for")
    notes

// Numbered constants (#3061, item 8): module-level bindings in a row whose
// names share their first word and whose values count up by one. A closed
// set of kinds is an enum, and the enum needs a name only a person can
// give, so this is reported and never rewritten. One line per run of three
// or more.
fn cf_numbered_const_notes(sema: &Sema, pool: &AstPool, excludes: &List[str], std_too: bool):
    let notes = []
    let texts: HashMap[str, str] = [:]
    var run_path = ""
    var run_prefix = ""
    var run_first = ""
    var run_last = ""
    var run_node = 0
    var run_len = 0
    var prev: i64 = -2
    for di in 0..pool.decl_count() + 1:
        var path = ""
        var name = ""
        var value: i64 = -2
        var node = 0
        if di < pool.decl_count():
            node = pool.get_decl(di) as i32
            let init = if pool.kind(node as NodeId) == NodeKind.NK_LET_DECL: pool.get_data1(node as NodeId) else: 0
            if init != 0 and pool.kind(init as NodeId) == NodeKind.NK_INT_LIT:
                path = sema.decl_source_path_for_index(di as i32)
                name = sema.pool_resolve(pool.get_data0(node as NodeId))
                value = pool.int_lit_value(init as NodeId)
        let cut = name.find("_")
        let prefix = if cut > 0: name.slice(0, cut + 1) else: ""
        let continues = run_len > 0 and prefix.len() > 0 and path == run_path and prefix == run_prefix and value == prev + 1
        if continues:
            run_len = run_len + 1
            run_last = name
        else:
            // The line is read from the file only for a run that is reported:
            // a declaration of the embedded standard library has no file here.
            if run_len >= 3 and cf_rewritable(run_path, excludes, std_too):
                if not texts.contains(run_path): texts.insert(with_str_clone_ref(run_path), with_fs_read_file(run_path))
                let run_line = cf_line_of(texts.get(run_path).unwrap(), pool.get_start(run_node as NodeId))
                notes.push(f"{run_path}:{run_line}: {run_len} numbered constants `{run_first}` .. `{run_last}`: a closed set of kinds is an enum; it needs a name (reported, never rewritten)")
            run_len = 0
            if prefix.len() > 0:
                run_path = path
                run_prefix = prefix
                run_first = name
                run_last = name
                run_node = node
                run_len = 1
        prev = value
    notes

// Apply a file's edits from the end back, so earlier offsets stay valid.
fn cf_rewrite(text: &str, edits: &List[CeremonyEdit]):
    let last_first = [e for e in edits]
    last_first.sort_by((a, b) => b.start - a.start)
    var out = with_str_clone_ref(text)
    for e in last_first: out = out.slice(0, e.start) ++ e.replacement ++ out.slice(e.end, out.len())
    out

// #3061 item 1: a private function's written return type that its body
// already has. The edit, the function's name and the declared type's name:
// after the edit is applied the function must infer exactly that type, or the
// annotation is put back (run_ceremony_fix).
type CeremonyFnRet {
    edit: CeremonyEdit,
    fn_name: str,
    type_name: str,
    // The line of the function's header in the file as read.
    first_line: i32,
}

// An edit's line in the file as read: what a second compiler's refusal is
// matched against.
type CeremonyPlace {
    path: str,
    line: i32,
    key: str,
    what: str,
}

// What names an edit among a run's edits: its file and where it starts.
fn cf_edit_key(e: &CeremonyEdit): f"{e.path}:{e.start}"

// The last part of a dotted name: `Type.method` is `method`.
fn cf_bare_name(name: &str):
    let parts = name.split(".")
    with_str_clone_ref(parts[parts.len() - 1])

// One round of the search for the removed return types a program does not
// check without: those of the functions that now infer another type than the
// one they declared, and those of the functions an error names, in its
// message or a label (a caller of a function with no type is refused at the
// call, D43). The keys of the ones not already in `back`.
fn cf_refused_rets(sema: &Sema, diagnostics: &DiagnosticList, rets: &List[CeremonyFnRet], back: &List[str]):
    var said = ""
    for d in diagnostics.items:
        if d.severity != DiagSeverity.Error: continue
        said = said ++ d.message ++ "\n"
        for label in d.labels: said = said ++ label.message ++ "\n"
    let found = []
    for r in rets:
        let key = cf_edit_key(r.edit)
        if back.contains(key): continue
        let inferred = cf_inferred_return(sema, r.fn_name)
        if (inferred.len() > 0 and inferred != r.type_name) or cf_has_word(said, cf_bare_name(r.fn_name)): found.push(key)
    found

// Whether `word` occurs in `text` as a whole name.
fn cf_has_word(text: &str, word: &str) -> bool:
    if word.len() == 0: return false
    var at = text.find(word)
    while at >= 0:
        let end = at + word.len()
        if (at == 0 or not cf_is_name_byte(text[at - 1])) and (end >= text.len() or not cf_is_name_byte(text[end])): return true
        at = text.find(word, at + 1)
    false

// The candidates Sema recorded (note_restated_fn_return), narrowed to the
// ones this tool can show: the tail's type does not come from the
// annotation (cf_demand_free), the body has one result (no `return`), and
// the function does not call itself (an unannotated function's type is its
// body's, and a body that calls itself has none until D143 joins it).
fn cf_collect_fn_rets(sema: &Sema, pool: &AstPool, excludes: &List[str], std_too: bool) -> List[CeremonyFnRet]:
    let found = []
    for (node, tail) in sema.ceremony_fn_rets:
        let path = sema.ceremony_let_paths.get(node) ?? ""
        if not cf_rewritable(path, excludes, std_too) or not cf_demand_free(sema, pool, tail): continue
        let text = with_fs_read_file(path)
        let arrow = cf_arrow_before(text, pool.get_start(node))
        if arrow < 0: continue
        let fn_name = sema.pool_resolve(sema.ceremony_fn_ret_names.get(node) ?? 0)
        let parts = fn_name.split(".")
        let bare = parts[parts.len() - 1]
        let body = text.slice(pool.get_end(node), pool.get_end(tail))
        if cf_has_word(body, "return") or cf_has_word(body, bare): continue
        let written = text.slice(pool.get_start(node), pool.get_end(node))
        found.push(CeremonyFnRet { edit: CeremonyEdit { path: with_str_clone_ref(path), start: arrow, end: pool.get_end(node), replacement: "", what: "return type `-> " ++ written ++ "` restates the body's type" }, fn_name: with_str_clone_ref(fn_name), type_name: sema.type_name(sema.typed_expr_types.get(tail) ?? 0), first_line: cf_line_of(text, arrow) })
    found

// The return type the function named `fn_name` has in `sema`, by name; ""
// when the program has no such function.
fn cf_inferred_return(sema: &Sema, fn_name: &str) -> str:
    let sig = sema.get_sig(sema.pool_lookup_symbol(fn_name))
    if sig < 0: "" else: sema.type_name(sema.sig_return_type(sig))

fn cf_usage(): "usage: with fix-ceremony [--report|--apply] [--std] [--exclude path ...] [--check-with compiler] <entry.with>\n  --report      list every rewrite Sema proves safe, by file and line (the default)\n  --apply       write them; a file that no longer checks is restored\n  --std         rewrite lib/std too (never a migrated corpus)\n  --exclude p   leave files under p alone\n  --check-with c  re-check with compiler c after applying\nrewrites: a redundant binding annotation, a `var` never rebound, a widening cast, `List.new()` / `HashMap.new()` where its type is demanded, an index loop over one list, `.clone()` on a str, `&x` at a `&T` parameter, `Some(x)` where an Option is demanded"

fn run_ceremony_fix() -> i32:
    let argv = args()
    var apply = false
    var std_too = false
    var check_with = ""
    var entry = ""
    let excludes = []
    var i = 2
    while i < argv.len():
        if argv[i] == "--apply": apply = true
        else if argv[i] == "--std": std_too = true
        else if argv[i] == "--report": apply = false
        else if argv[i] == "--check-with" and i + 1 < argv.len():
            i = i + 1
            check_with = argv[i]
        else if argv[i] == "--exclude" and i + 1 < argv.len():
            i = i + 1
            excludes.push(argv[i])
        else if argv[i] == "--help" or argv[i] == "-h":
            print(cf_usage())
            return 0
        // An option this command does not have is not the entry file: it was
        // read as one ("cannot open '--help'").
        else if argv[i].starts_with("-"):
            eprint(f"fix-ceremony: no option `{argv[i]}`\n" ++ cf_usage())
            return 2
        else: entry = argv[i]
        i = i + 1
    if entry.len() == 0:
        print(cf_usage())
        return 2
    let comp = Compilation.init()
    let pool = comp.compile_entry_file(entry)
    if pool.decl_count() == 0 or comp.zcu.diagnostics.has_errors():
        eprint(f"fix-ceremony: {entry} does not check; fix it first")
        return 1
    var edits = cf_collect(comp.zcu.last_sema, pool, excludes, std_too)
    let fn_rets = cf_collect_fn_rets(comp.zcu.last_sema, pool, excludes, std_too)
    for fr in fn_rets: edits.push(fr.edit)
    let paths = []
    for e in edits:
        if not paths.contains(e.path): paths.push(with_str_clone_ref(e.path))
    for path in paths:
        let text = with_fs_read_file(path)
        for e in edits:
            if e.path == path: print(f"{path}:{cf_line_of(text, e.start)}: {e.what}")
    print(f"fix-ceremony: {edits.len()} rewrite(s) in {paths.len()} file(s)")
    if not apply:
        for note in cf_len_cast_notes(comp.zcu.last_sema, pool, excludes, std_too): print(note)
        for note in cf_numbered_const_notes(comp.zcu.last_sema, pool, excludes, std_too): print(note)
    if not apply or edits.len() == 0: return 0
    let originals: HashMap[str, str] = [:]
    for path in paths:
        let text = with_fs_read_file(path)
        originals.insert(with_str_clone_ref(path), with_str_clone_ref(text))
        let mine = [e for e in edits if e.path == path]
        if with_fs_write_file(path, cf_rewrite(text, mine)) != 0:
            eprint(f"fix-ceremony: could not write {path}")
            return 1
    // The proof: the entry still checks with every rewrite in. If not, every
    // rewritten file is restored; the report above says what was tried.
    var again = Compilation.init()
    var pool2 = again.compile_entry_file(entry)
    var rechecks = pool2.decl_count() > 0 and not again.zcu.diagnostics.has_errors()
    // A removed return type is kept only if the function then infers the
    // type it declared. Where the program no longer checks (unannotated
    // functions that call each other have no type to give, D43), the types
    // its refusals point at are put back, round by round, until it checks;
    // then one whose function infers another type is put back too.
    if fn_rets.len() > 0:
        // The removed types the program does not check without, by key.
        let refused = []
        if not rechecks:
            var named = true
            while named and not rechecks:
                // Errors that point at no removed type: every one goes back.
                let more = cf_refused_rets(again.zcu.last_sema, again.zcu.diagnostics, fn_rets, refused)
                named = more.len() > 0
                for key in more: refused.push(key)
                if not named:
                    for r in fn_rets: refused.push(cf_edit_key(r.edit))
                for path in paths:
                    let mine = [e for e in edits if e.path == path and not refused.contains(cf_edit_key(e))]
                    with_fs_write_file(path, cf_rewrite(originals.get(path).unwrap(), mine))
                again = Compilation.init()
                pool2 = again.compile_entry_file(entry)
                rechecks = pool2.decl_count() > 0 and not again.zcu.diagnostics.has_errors()
        let put_back = []
        for r in fn_rets:
            let key = cf_edit_key(r.edit)
            let was_refused = refused.contains(key)
            let inferred = if rechecks and not was_refused: cf_inferred_return(again.zcu.last_sema, r.fn_name) else: ""
            if inferred == r.type_name: continue
            put_back.push(key)
            if was_refused: print(f"{r.edit.path}:{r.first_line}: kept as written: without it `{r.fn_name}` infers another type, or a caller no longer checks")
            else if rechecks: print(f"{r.edit.path}:{r.first_line}: kept as written: without it `{r.fn_name}` returns `{inferred}`, not `{r.type_name}`")
            else: print(f"{r.edit.path}:{r.first_line}: kept as written: the program does not check without the return types removed in this run")
        if put_back.len() > 0:
            edits = [e for e in edits if not put_back.contains(cf_edit_key(e))]
            for path in paths:
                let mine = [e for e in edits if e.path == path]
                with_fs_write_file(path, cf_rewrite(originals.get(path).unwrap(), mine))
            again = Compilation.init()
            pool2 = again.compile_entry_file(entry)
            rechecks = pool2.decl_count() > 0 and not again.zcu.diagnostics.has_errors()
            print(f"fix-ceremony: {put_back.len()} return type(s) kept as written")
    if not rechecks:
        for (path, text) in originals: with_fs_write_file(path, text)
        eprint(f"fix-ceremony: {entry} no longer checks with the rewrites applied; every file restored (a fact the rewriter relied on is wrong — file it)")
        return 1
    // --check-with: a second compiler must accept the result too (the pinned
    // seed, for `src/`: stage1 is its build). A rewrite it refuses is kept as
    // written and reported, line by line, until it checks; a refusal at a
    // line no rewrite touched restores everything.
    if check_with.len() > 0:
        let places = [CeremonyPlace { path: e.path, line: cf_line_of(originals.get(e.path).unwrap(), e.start), key: cf_edit_key(e), what: e.what } for e in edits]
        let refused = []
        let out_path = "out/fix-ceremony-check.out"
        let err_path = "out/fix-ceremony-check.err"
        while true:
            let fin = run_to_files([with_str_clone_ref(check_with), "check", with_str_clone_ref(entry)], out_path, err_path, 0)
            if fin.code == 0: break
            var progress = false
            var last_message = ""
            for line in (with_fs_read_file(err_path)).split("\n"):
                if line.starts_with("error"): last_message = with_str_clone_ref(line)
                if not line.contains("--> "): continue
                let loc = line.split("--> ")[1].split(":")
                if loc.len() < 2: continue
                let epath = loc[0]
                let eline: i32 = loc[1].parse() ?? 0
                // The refusal names a use. When its message quotes a name
                // (`while \`x\` is a live view`, `cannot move out of global \`g\``),
                // the rewrite that caused it is the nearest rewritten line above
                // that mentions the name; otherwise the nearest within a few lines.
                let names = cf_quoted_names(last_message)
                let source_lines = originals.get(epath).unwrap().split("\n")
                var best_line = 0
                for p in places:
                    if p.path != epath or p.line > eline + 1 or p.line <= best_line or refused.contains(p.key): continue
                    let text_at = source_lines[p.line - 1]
                    var mentions = false
                    for name in names:
                        if text_at.contains(name): mentions = true
                    if mentions or (names.len() == 0 and p.line >= eline - 12): best_line = p.line
                if best_line == 0 and names.len() > 0:
                    for p in places:
                        if p.path == epath and p.line <= eline + 1 and p.line >= eline - 12 and p.line > best_line and not refused.contains(p.key): best_line = p.line
                if best_line == 0: continue
                for p in places:
                    if p.path == epath and p.line == best_line and not refused.contains(p.key):
                        refused.push(p.key)
                        progress = true
            if not progress:
                for (path, text) in originals: with_fs_write_file(path, text)
                eprint(f"fix-ceremony: {check_with} refuses {entry} at lines no rewrite touched (see {err_path}); every file restored")
                return 1
            for path in paths:
                let mine = [e for e in edits if e.path == path and not refused.contains(cf_edit_key(e))]
                with_fs_write_file(path, cf_rewrite(originals.get(path).unwrap(), mine))
        for p in places:
            if refused.contains(p.key): print(f"{p.path}:{p.line}: kept as written, {check_with} refuses it: {p.what}")
        if refused.len() > 0: print(f"fix-ceremony: {refused.len()} rewrite(s) kept as written for {check_with}")
    print(f"fix-ceremony: applied; {entry} checks")
    0
