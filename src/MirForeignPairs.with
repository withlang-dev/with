// D66 retained variadic pairs (#1652, spec §16.2b.9 "Pairs configured across
// calls", "Retained borrows"): where a resource's callback pair is proven
// compatible.
//
// Sema decides what each call means to the pair (Sema.with FacadePairOp, keyed
// by the concrete signature MIR records on the call: a setter and the `U`
// its specialization installs, the abandonment path as the reset, a
// destroyer, every other operation as callback-capable unless `callbacks
// none`). This pass decides where: it runs the ForeignPairState.with place flow
// over each lowered body's real CFG — setters, the branches on their status,
// moves, borrows, drops, returns — and reports every operation that could
// invoke an incomplete or incompatible pair, every retained userdata that
// dies or moves while the resource still holds it, and every retaining
// resource that escapes its frame (it is ephemeral until reset or
// destroyed). A helper call that receives the resource is not modeled: it
// is checked as callback-capable and leaves the pair unknown until a reset.
// Nothing here reads a name or an AST spelling; the facts are Sema's tables
// and the MIR itself. Which argument an operation acts on and which one a
// setter retains are Sema's (FacadePairOp.subject_param, retained_param),
// and so are the names a finding gives (D65 phase 5, #2043): this pass
// decides only where along the CFG a state holds.

use Ast
use Diagnostic
use Mir
use Sema
use Span
use ForeignPairState
use std.collections.HashMap
use std.builtins.eprint
use MirCore
use SemaTypes
use rt.rt_core


// One report per violating step: the step's block and span source, and
// what to say.
enum PairsSiteKind: i32:
    Invoke = 1
    Helper = 2
    Expire = 3
    Moved = 4
    Escape = 5
    NonPreserving = 6

type PairsStepSite {
    kind: PairsSiteKind,
    bb: i32,
    stmt: i32,       // the statement, or -1 for the block's terminator
    key: i32,        // the place key the report names
    op: i32,         // the FacadePairOp index, or -1
}
impl Copy for PairsStepSite

fn pairs_place_key(keys: &MirDropStateKeys, place_id: isize) -> i32:
    if place_id < 0 or place_id >= keys.place_key.len():
        return -1
    keys.place_key[place_id]

fn pairs_operand_place(body: &MirBody, operand_id: i32) -> i32:
    if operand_id < 0 or operand_id >= body.operand_kinds.len():
        return -1
    let kind = body.operand_kinds[operand_id]
    if kind == OperandKind.OK_COPY or kind == OperandKind.OK_MOVE:
        return body.operand_d0[operand_id]
    -1

fn pairs_operand_is_move(body: &MirBody, operand_id: i32) -> bool:
    operand_id >= 0 and operand_id < body.operand_kinds.len() and body.operand_kinds[operand_id] == OperandKind.OK_MOVE

// The integer a constant operand carries.
fn pairs_operand_const(body: &MirBody, operand_id: i32) -> (bool, i64):
    if operand_id < 0 or operand_id >= body.operand_kinds.len() or body.operand_kinds[operand_id] != OperandKind.OK_CONSTANT:
        return (false, -1)
    let cid = body.operand_d0[operand_id]
    if cid < 0 or cid >= body.const_kinds.len() or body.const_kinds[cid] != ConstKind.CK_INT:
        return (false, -1)
    var value: i64 = body.const_d0[cid]
    value = value + (body.const_d1[cid] as i64) * 4294967296
    (true, value)

// A place that leaves the frame when written: the return place, or any
// projection (a field of a struct that may outlive the frame; the flow does
// not know, so the conservative answer holds).
fn pairs_place_escapes(body: &MirBody, place_id: i32) -> bool:
    if place_id < 0 or place_id >= body.place_locals.len():
        return false
    body.place_locals[place_id] == 0 or body.place_proj_counts[place_id] != 0

fn pairs_block(action: i32, ty: i32, origin: i32, guard: i32, can_fail: bool, invokes: bool) -> ForeignPairBlock:
    ForeignPairBlock { action, ty, origin, guard, can_fail, preserves_on_failure: false, invokes, slot: -1, releases: 0 }

// D194: a retained pointer setter holds `origin` under `slot`; any pair
// operation may release the slots its contract lists (`until`).
fn pairs_retain_block(slot: i32, origin: i32, guard: i32, releases: i64, invokes: bool):
    ForeignPairBlock { action: FOREIGN_PAIR_RETAIN, ty: 0, origin, guard, can_fail: false, preserves_on_failure: false, invokes, slot, releases }

// A release by an operation with a status (`ok`) is decided on the branch
// that reads it (ForeignPairState.with foreign_pair_on_edge): `guard` is the
// status key, or -1 when the operation cannot fail.
fn pairs_releasing(block: ForeignPairBlock, releases: i64, guard: i32):
    let out = block
    out.releases = releases
    if releases != 0: out.guard = guard
    out

fn pairs_keep(): pairs_block(FOREIGN_PAIR_KEEP, 0, -1, -1, false, false)

fn pairs_step(action: i32, place: i32, source: i32, block: ForeignPairBlock) -> ForeignPairStep:
    ForeignPairStep { action, place, source, contract: block }

fn pairs_site(kind: PairsSiteKind, bb: i32, stmt: i32, key: i32, op: i32) -> PairsStepSite:
    PairsStepSite { kind, bb, stmt, key, op }

// The value a switch's `otherwise` arm stands for when the switch is on a
// boolean condition: the one value the table does not list.
fn pairs_switch_otherwise_value(body: &MirBody, table: i32) -> i64:
    let start = body.switch_table_starts[table]
    let count = body.switch_table_counts[table]
    var has_zero = false
    for i in 0..count:
        if body.switch_table_vals[(start + i)] == 0: has_zero = true
    (has_zero) as i32

fn pairs_list_i32(count: i32, value: i32): [value for _ in 0..count]

fn pairs_list_i64(count: isize, value: i64): [value for _ in 0..count]

// Whether the body can touch a pair at all: some place is a pair resource
// or a reference to one. Everything else is skipped without building keys.
fn pairs_body_relevant(sema: &Sema, body: &MirBody) -> bool:
    for p in 0..body.place_sema_types.len():
        if sema.facade_pair_resource_for_type(body.place_sema_types[p]) >= 0:
            return true
    false

// The per-body facts and the steps built from them, over the drop-state
// place keys (one per local and per projected place MIR named).
type PairsBody {
    keys: MirDropStateKeys,
    // Per key: the pair resource an owned place is, or -1; 1 when the key
    // is a reference to one.
    key_resource: List[i32],
    // A projection through a reference local (`(*h).x`, the receiver of a
    // call on `h: &Handle`) is that local: its key, or -1.
    key_alias: List[i32],
    key_is_ref: List[i32],
    // A reference key's referent key (RK_REF), -2 before any is seen, -1
    // when it is assigned from two places.
    ref_origin: List[i32],
    // 1 for keys a userdata setter retains (the referent of its `&U`
    // argument): their moves and deaths are steps.
    origin_key: List[i32],
    // 1 for retained origins whose type is a facade resource (§16.2b.5,
    // #3120): non-`preserves` operations on them are refused while held.
    origin_is_resource: List[i32],
    // The block of the setter call that retained each origin: where a
    // dying or moving origin is reported.
    origin_bb: List[i32],
    // A local a setter's status was copied into: the status key it stands
    // for in a comparison (-1: none).
    guard_alias: List[i32],
    // Keys holding a setter's status, and the success value each compares
    // against (-1: none). For a `Result` setter (§16.2b.5, #3128), `guard_ok`
    // is the `Ok` discriminant and `guard_err` the `Err` discriminant.
    guard_ok: List[i64],
    guard_err: List[i64],
    // Keys holding `status == OK` / `status != OK` (or `.is_ok()` / `.is_err()`):
    // the guard and the sense.
    cond_guard: List[i32],
    cond_is_eq: List[i32],
    steps: List[ForeignPairStep],
    sites: List[PairsStepSite],
    starts: List[i32],
    counts: List[i32],
    edges: List[ForeignPairEdge],
}

fn pairs_body_new(body: &MirBody) -> PairsBody:
    let keys = mir_drop_state_keys_new(body)
    let width = keys.len() as i32
    PairsBody { keys: keys, key_resource: pairs_list_i32(width, -1), key_alias: pairs_list_i32(width, -1), key_is_ref: pairs_list_i32(width, 0), ref_origin: pairs_list_i32(width, -2), origin_key: pairs_list_i32(width, 0), origin_is_resource: pairs_list_i32(width, 0), origin_bb: pairs_list_i32(width, -1), guard_alias: pairs_list_i32(width, -1), guard_ok: pairs_list_i64(width, -1), guard_err: pairs_list_i64(width, -1), cond_guard: pairs_list_i32(width, -1), cond_is_eq: pairs_list_i32(width, 1), steps: [], sites: [], starts: [], counts: [], edges: [] }

impl PairsBody:
    fn width(): self.key_resource.len()

    fn key_of(place_id: isize) -> i32:
        let raw = pairs_place_key(self.keys, place_id)
        if raw >= 0 and self.key_alias[raw] >= 0: self.key_alias[raw] else: raw

    fn is_resource(key: i32) -> bool: key >= 0 and key < self.width() and self.key_resource[key] >= 0

    fn is_ref(key: i32) -> bool: key >= 0 and key < self.width() and self.key_is_ref[key] != 0

    fn is_origin(key: i32) -> bool: key >= 0 and key < self.width() and self.origin_key[key] != 0

    // The base local of a place key, and its user name when it has one.
    fn key_name(sema: &Sema, body: &MirBody, key: i32) -> str:
        if key < 0 or key >= self.keys.base_local.len():
            return "this value"
        let local = self.keys.base_local[key]
        let sym = if local >= 0 and local < body.local_names.len(): body.local_names[local] else: 0
        if sym != 0:
            return "'" ++ sema.pool_resolve(sym) ++ "'"
        "this value"

    fn resource_name(sema: &Sema, key: i32) -> str:
        var ri: i32 = -1
        if key >= 0 and key < self.width():
            ri = self.key_resource[key]
            if ri < 0 and self.is_ref(key) and self.ref_origin[key] >= 0: ri = self.key_resource[self.ref_origin[key]]
        if ri < 0:
            return "the resource"
        sema.facade_pair_resource_display(ri)

    // The key the argument a userdata setter retains (Sema's
    // FacadePairOp.retained_param, its `&U`) refers to: the referent of the
    // reference when the body took it, else the reference itself (a
    // parameter: its frame bounds the retention here).
    fn userdata_origin(body: &MirBody, call_id: i32, param: i32) -> i32:
        let start = body.call_arg_starts[call_id]
        let count = body.call_arg_counts[call_id]
        if param < 0 or param >= count:
            return -1
        let place = pairs_operand_place(body, body.call_arg_operands[(start + param)])
        let key = self.key_of(place)
        if key < 0:
            return -1
        let origin = self.ref_origin[key]
        if origin >= 0: origin else: key

    mut fn push(step: ForeignPairStep, site: PairsStepSite):
        self.steps.push(step)
        self.sites.push(site)

    mut fn classify(sema: &Sema, body: &MirBody):
        // A projection through a reference local names what the local
        // refers to: its key is the local's, whose targets a BORROW set.
        for p in 0..body.place_sema_types.len():
            let raw = pairs_place_key(self.keys, p as i32)
            if raw < 0 or body.place_proj_counts[p] == 0:
                continue
            let base = body.place_locals[p]
            if base < 0 or base >= body.local_type_ids.len():
                continue
            let base_ty = sema.resolve_alias(body.local_type_ids[base] as TypeId)
            if sema.get_type_kind(base_ty) == TypeKind.TY_REF and sema.facade_pair_resource_for_type(base_ty as i32) >= 0:
                self.key_alias[raw] = base
        for p in 0..body.place_sema_types.len():
            let key = self.key_of(p)
            if key < 0 or self.is_resource(key) or self.is_ref(key) or self.key_alias[pairs_place_key(self.keys, p)] >= 0:
                continue
            let ty = body.place_sema_types[p]
            let ri = sema.facade_pair_resource_for_type(ty)
            if ri < 0:
                continue
            let resolved = sema.resolve_alias(ty as TypeId)
            if sema.get_type_kind(resolved) == TypeKind.TY_REF:
                self.key_is_ref[key] = 1
            else:
                self.key_resource[key] = ri

    mut fn note_ref(dest: i32, src: i32):
        if self.ref_origin[dest] == -2: self.ref_origin[dest] = src
        else if self.ref_origin[dest] != src: self.ref_origin[dest] = -1

    // Pass 1 over the body: referents of references, setter status guards
    // and the userdata origins the setters retain — facts the step builder
    // needs before it sees the statements that use them.
    mut fn prepass(sema: &Sema, body: &MirBody):
        for stmt in 0..body.stmt_count():
            if body.stmt_kind(stmt) != StmtKind.Assign:
                continue
            let dest = self.key_of(body.stmt_data0(stmt))
            let rv = body.stmt_data1(stmt)
            if dest < 0 or rv < 0 or rv >= body.rval_kinds.len():
                continue
            if body.rval_kinds[rv] == RvalueKind.RK_REF:
                self.note_ref(dest, self.key_of(body.rval_d1[rv]))
            else if body.rval_kinds[rv] == RvalueKind.RK_USE:
                // A copied reference names what it copies.
                let op = body.rval_d0[rv]
                let src_place = pairs_operand_place(body, op)
                if src_place >= 0 and not pairs_operand_is_move(body, op):
                    let src = self.key_of(src_place)
                    if src >= 0 and self.ref_origin[src] != -2:
                        self.note_ref(dest, self.ref_origin[src])
        for bb in 0..body.block_count():
            if body.term_kind(bb) != TermKind.TK_CALL:
                continue
            let call_id = body.term_data1(bb)
            if call_id < 0 or call_id >= body.call_sig_indices.len():
                continue
            let opi = sema.facade_pair_op_for_sig(body.call_sig_indices[call_id])
            if opi < 0:
                continue
            let action = sema.facade_pair_ops[opi].action
            let ok = sema.facade_pair_ops[opi].guard_ok
            let dest_place = body.term_data2(bb)
            let dest = self.key_of(dest_place)
            let reads_status = action == FOREIGN_PAIR_CALLBACK or action == FOREIGN_PAIR_USERDATA or action == FOREIGN_PAIR_RETAIN or sema.facade_pair_ops[opi].releases != 0
            if reads_status and ok >= 0 and dest >= 0:
                let dest_ty = if dest_place >= 0 and dest_place < body.place_sema_types.len(): body.place_sema_types[dest_place] else: 0
                if dest_ty != 0 and sema.enum_variant_index_for_type(dest_ty, sema.syms.ok) >= 0 and sema.enum_variant_index_for_type(dest_ty, sema.syms.err) >= 0:
                    self.guard_ok[dest] = sema.enum_variant_discriminant_for_type(dest_ty, sema.syms.ok)
                    self.guard_err[dest] = sema.enum_variant_discriminant_for_type(dest_ty, sema.syms.err)
                else:
                    self.guard_ok[dest] = ok
            if action == FOREIGN_PAIR_USERDATA or action == FOREIGN_PAIR_RETAIN:
                let origin = self.userdata_origin(body, call_id, sema.facade_pair_ops[opi].retained_param)
                if origin >= 0:
                    self.origin_key[origin] = 1
                    self.origin_bb[origin] = bb
                    if action == FOREIGN_PAIR_RETAIN and origin < self.keys.base_local.len():
                        let base_local = self.keys.base_local[origin]
                        if base_local >= 0 and base_local < body.local_type_ids.len() and sema.facade_resource_index_for_type(body.local_type_ids[base_local]) >= 0:
                            self.origin_is_resource[origin] = 1
        // A setter's status or Result bound to a local (`let r = h.set(…)`),
        // moved/copied into a temporary (`?`), or its enum discriminant read
        // (`RK_DISCRIMINANT`): each stands for the call's status in a branch.
        for stmt in 0..body.stmt_count():
            if body.stmt_kind(stmt) != StmtKind.Assign:
                continue
            let dest = self.key_of(body.stmt_data0(stmt))
            let rv = body.stmt_data1(stmt)
            if dest < 0 or rv < 0 or rv >= body.rval_kinds.len():
                continue
            let rk = body.rval_kinds[rv]
            var src: i32 = -1
            if rk == RvalueKind.RK_USE:
                src = self.key_of(pairs_operand_place(body, body.rval_d0[rv]))
            else if rk == RvalueKind.RK_DISCRIMINANT:
                src = self.key_of(body.rval_d0[rv])
            if src < 0:
                continue
            if self.guard_alias[src] >= 0: self.guard_alias[dest] = self.guard_alias[src]
            else if self.guard_ok[src] >= 0: self.guard_alias[dest] = src
        // `status == OK`, `status != OK`, `disc == ok_tag` (`.is_ok()`),
        // `disc == err_tag` (`.is_err()`), and `not cond`: the branch they
        // decide refines the setter's outcome along its edges.
        for stmt in 0..body.stmt_count():
            if body.stmt_kind(stmt) != StmtKind.Assign:
                continue
            let dest = self.key_of(body.stmt_data0(stmt))
            let rv = body.stmt_data1(stmt)
            if dest < 0 or rv < 0 or rv >= body.rval_kinds.len():
                continue
            let rk = body.rval_kinds[rv]
            if rk == RvalueKind.RK_USE:
                let src = self.key_of(pairs_operand_place(body, body.rval_d0[rv]))
                if src >= 0 and self.cond_guard[src] >= 0:
                    self.cond_guard[dest] = self.cond_guard[src]
                    self.cond_is_eq[dest] = self.cond_is_eq[src]
                continue
            if rk == RvalueKind.RK_UN_OP and body.rval_d0[rv] == UnaryOp.UOP_NOT:
                let src = self.key_of(pairs_operand_place(body, body.rval_d1[rv]))
                if src >= 0 and self.cond_guard[src] >= 0:
                    self.cond_guard[dest] = self.cond_guard[src]
                    self.cond_is_eq[dest] = (self.cond_is_eq[src] == 0) as i32
                continue
            if rk != RvalueKind.RK_BIN_OP:
                continue
            let bop = body.rval_d0[rv]
            if bop != BinaryOp.OP_EQ and bop != BinaryOp.OP_NEQ:
                continue
            let lhs = body.rval_d1[rv]
            let rhs = body.rval_d2[rv]
            var guard: i32 = -1
            var value: i64 = -1
            let (rknown, rvalue) = pairs_operand_const(body, rhs)
            let (lknown, lvalue) = pairs_operand_const(body, lhs)
            let lp = pairs_operand_place(body, lhs)
            let rp = pairs_operand_place(body, rhs)
            if lp >= 0 and rknown:
                guard = self.key_of(lp)
                value = rvalue
            else if rp >= 0 and lknown:
                guard = self.key_of(rp)
                value = lvalue
            if guard >= 0 and self.guard_alias[guard] >= 0: guard = self.guard_alias[guard]
            if guard < 0 or self.guard_ok[guard] < 0:
                continue
            if self.guard_ok[guard] == value:
                self.cond_guard[dest] = guard
                self.cond_is_eq[dest] = (bop == BinaryOp.OP_EQ) as i32
            else if self.guard_err[guard] >= 0 and self.guard_err[guard] == value:
                self.cond_guard[dest] = guard
                self.cond_is_eq[dest] = (bop == BinaryOp.OP_NEQ) as i32

    // A moved operand: a resource's state moves with it (and escapes with
    // it into the return place or a projection); a retained origin cannot
    // move.
    mut fn move_operand(body: &MirBody, operand_id: i32, dest_place: i32, bb: i32, stmt: i32):
        if not pairs_operand_is_move(body, operand_id):
            return
        let src = self.key_of(pairs_operand_place(body, operand_id))
        if src < 0:
            return
        if self.is_resource(src):
            if dest_place >= 0 and pairs_place_escapes(body, dest_place):
                self.push(pairs_step(FOREIGN_STEP_ESCAPE, src, -1, pairs_keep()), pairs_site(PairsSiteKind.Escape, bb, stmt, src, -1))
            let dest = self.key_of(dest_place)
            if dest >= 0:
                self.push(pairs_step(FOREIGN_STEP_MOVE, dest, src, pairs_keep()), pairs_site(PairsSiteKind.Moved, bb, stmt, src, -1))
        if self.is_origin(src):
            self.push(pairs_step(FOREIGN_STEP_EXPIRE, src, -1, pairs_keep()), pairs_site(PairsSiteKind.Moved, bb, stmt, src, -1))

    mut fn destroy(sema: &Sema, key: i32, bb: i32, stmt: i32):
        let invokes = sema.facade_pair_drop_invokes(self.key_resource[key])
        self.push(pairs_step(FOREIGN_STEP_APPLY, key, -1, pairs_block(FOREIGN_PAIR_DESTROY, 0, -1, -1, false, invokes)), pairs_site(PairsSiteKind.Invoke, bb, stmt, key, -1))

    mut fn build_stmt(sema: &Sema, body: &MirBody, bb: i32, stmt: i32):
        let kind = body.stmt_kind(stmt)
        if kind == StmtKind.Drop:
            let key = self.key_of(body.stmt_data0(stmt))
            if self.is_resource(key): self.destroy(sema, key, bb, stmt)
            // A dropped origin (a capturing callable or retained resource
            // ends by a drop, not only by its storage dying) dies here.
            if self.is_origin(key):
                self.push(pairs_step(FOREIGN_STEP_EXPIRE, key, -1, pairs_keep()), pairs_site(PairsSiteKind.Expire, bb, stmt, key, -1))
            return
        if kind == StmtKind.StorageDead:
            let key = body.stmt_data0(stmt)
            if self.is_origin(key):
                self.push(pairs_step(FOREIGN_STEP_EXPIRE, key, -1, pairs_keep()), pairs_site(PairsSiteKind.Expire, bb, stmt, key, -1))
            return
        if kind != StmtKind.Assign:
            return
        let dest_place = body.stmt_data0(stmt)
        let dest = self.key_of(dest_place)
        let rv = body.stmt_data1(stmt)
        if dest < 0 or rv < 0 or rv >= body.rval_kinds.len():
            return
        let rk = body.rval_kinds[rv]
        if rk == RvalueKind.RK_USE:
            let op = body.rval_d0[rv]
            if pairs_operand_is_move(body, op):
                self.move_operand(body, op, dest_place, bb, stmt)
            else:
                let src = self.key_of(pairs_operand_place(body, op))
                if self.is_ref(src) and self.is_ref(dest):
                    self.push(pairs_step(FOREIGN_STEP_BORROW, dest, src, pairs_keep()), pairs_site(PairsSiteKind.Moved, bb, stmt, src, -1))
            return
        if rk == RvalueKind.RK_REF:
            let src = self.key_of(body.rval_d1[rv])
            if (self.is_resource(src) or self.is_ref(src)) and self.is_ref(dest):
                self.push(pairs_step(FOREIGN_STEP_BORROW, dest, src, pairs_keep()), pairs_site(PairsSiteKind.Moved, bb, stmt, src, -1))
            return
        if rk == RvalueKind.RK_AGGREGATE:
            let fields = body.rval_d1[rv]
            if fields < 0 or fields >= body.agg_field_starts.len():
                return
            let start = body.agg_field_starts[fields]
            let count = body.agg_field_counts[fields]
            for fi in 0..count:
                // A resource moved into an aggregate leaves its own place;
                // the aggregate's place is the flow's conservative escape.
                let op = body.agg_field_operands[(start + fi)]
                if not pairs_operand_is_move(body, op):
                    continue
                let src = self.key_of(pairs_operand_place(body, op))
                if self.is_resource(src):
                    self.push(pairs_step(FOREIGN_STEP_ESCAPE, src, -1, pairs_keep()), pairs_site(PairsSiteKind.Escape, bb, stmt, src, -1))
                    self.push(pairs_step(FOREIGN_STEP_MOVE, dest, src, pairs_keep()), pairs_site(PairsSiteKind.Moved, bb, stmt, src, -1))
                if self.is_origin(src):
                    self.push(pairs_step(FOREIGN_STEP_EXPIRE, src, -1, pairs_keep()), pairs_site(PairsSiteKind.Moved, bb, stmt, src, -1))

    // A resource born from a call's result (a constructor, `unwrap`, a
    // helper that returns one): the foreign defaults, a compatible pair.
    mut fn create_result(body: &MirBody, bb: i32):
        let dest = self.key_of(body.term_data2(bb))
        if self.is_resource(dest):
            self.push(pairs_step(FOREIGN_STEP_APPLY, dest, -1, pairs_block(FOREIGN_PAIR_CREATE, 0, -1, -1, false, false)), pairs_site(PairsSiteKind.Invoke, bb, -1, dest, -1))

    mut fn build_call(sema: &Sema, body: &MirBody, bb: i32):
        self.build_call_args(sema, body, bb)
        self.create_result(body, bb)

    // §16.2b.5 (#3120): while a resource is held as a retained borrow, any
    // call that receives it (borrowed or moved) without `preserves` is
    // refused. `skip_arg` exempts the retaining setter's own retained
    // argument so a second handle may share the same resource.
    mut fn check_retained_resource_args(sema: &Sema, body: &MirBody, bb: i32, start: i32, count: i32, sig: i32, skip_arg: i32):
        for ai in 0..count:
            if ai == skip_arg: continue
            let operand = body.call_arg_operands[(start + ai)]
            let key = self.key_of(pairs_operand_place(body, operand))
            if key < 0: continue
            let origin = if self.ref_origin[key] >= 0: self.ref_origin[key] else: key
            if origin < 0 or origin >= self.origin_is_resource.len() or self.origin_is_resource[origin] == 0: continue
            if pairs_operand_is_move(body, operand):
                self.push(pairs_step(FOREIGN_STEP_EXPIRE, origin, -1, pairs_keep()), pairs_site(PairsSiteKind.Moved, bb, -1, origin, -1))
            else if not sema.facade_sig_preserves_param(sig, ai):
                self.push(pairs_step(FOREIGN_STEP_EXPIRE, origin, -1, pairs_keep()), pairs_site(PairsSiteKind.NonPreserving, bb, -1, origin, sig))

    mut fn build_call_args(sema: &Sema, body: &MirBody, bb: i32):
        let call_id = body.term_data1(bb)
        if call_id < 0 or call_id >= body.call_arg_starts.len():
            return
        let start = body.call_arg_starts[call_id]
        let count = body.call_arg_counts[call_id]
        let sig = if call_id < body.call_sig_indices.len(): body.call_sig_indices[call_id] else: -1
        let opi = sema.facade_pair_op_for_sig(sig)
        if opi >= 0 and count > 0:
            let action = sema.facade_pair_ops[opi].action
            let ok = sema.facade_pair_ops[opi].guard_ok
            let u_tid = sema.facade_pair_ops[opi].userdata_tid
            let invokes = sema.facade_pair_ops[opi].invokes != 0
            let subject = sema.facade_pair_ops[opi].subject_param
            if subject < 0 or subject >= count:
                return
            let skip_arg = if action == FOREIGN_PAIR_RETAIN: sema.facade_pair_ops[opi].retained_param else: -1
            self.check_retained_resource_args(sema, body, bb, start, count, sig, skip_arg)
            let recv = self.key_of(pairs_operand_place(body, body.call_arg_operands[(start + subject)]))
            if recv < 0:
                return
            let dest = self.key_of(body.term_data2(bb))
            let releases = sema.facade_pair_ops[opi].releases
            let guard = if ok >= 0: dest else: -1
            if action == FOREIGN_PAIR_RETAIN:
                // D194: the setter's storage argument is held under its slot
                // whatever the status (a failed setter may have stored it);
                // the slot's previous storage is released on the success
                // edge only.
                let origin = self.userdata_origin(body, call_id, sema.facade_pair_ops[opi].retained_param)
                self.push(pairs_step(FOREIGN_STEP_APPLY, recv, -1, pairs_retain_block(sema.facade_pair_ops[opi].slot, origin, guard, releases, invokes)), pairs_site(PairsSiteKind.Invoke, bb, -1, recv, opi))
            else if action == FOREIGN_PAIR_CALLBACK or action == FOREIGN_PAIR_USERDATA:
                let origin = if action == FOREIGN_PAIR_USERDATA: self.userdata_origin(body, call_id, sema.facade_pair_ops[opi].retained_param) else: -1
                self.push(pairs_step(FOREIGN_STEP_APPLY, recv, -1, pairs_releasing(pairs_block(action, u_tid, origin, guard, true, invokes), releases, guard)), pairs_site(PairsSiteKind.Invoke, bb, -1, recv, opi))
            else:
                self.push(pairs_step(FOREIGN_STEP_APPLY, recv, -1, pairs_releasing(pairs_block(action, 0, -1, -1, false, invokes), releases, guard)), pairs_site(PairsSiteKind.Invoke, bb, -1, recv, opi))
            return
        // Not a pair operation: a resource handed to it may be invoked and
        // changed in any way (checked as callback-capable, then unknown
        // until a reset); a resource moved into it is checked and gone; a
        // retained origin moved into it dies here; a retained resource passed
        // to an operation not marked `preserves` is refused.
        self.check_retained_resource_args(sema, body, bb, start, count, sig, -1)
        for ai in 0..count:
            let operand = body.call_arg_operands[(start + ai)]
            let key = self.key_of(pairs_operand_place(body, operand))
            if key < 0:
                continue
            if self.is_resource(key) and pairs_operand_is_move(body, operand):
                self.push(pairs_step(FOREIGN_STEP_APPLY, key, -1, pairs_block(FOREIGN_PAIR_DESTROY, 0, -1, -1, false, true)), pairs_site(PairsSiteKind.Helper, bb, -1, key, -1))
            else if self.is_resource(key) or self.is_ref(key):
                self.push(pairs_step(FOREIGN_STEP_APPLY, key, -1, pairs_block(FOREIGN_PAIR_UNKNOWN, 0, -1, -1, false, true)), pairs_site(PairsSiteKind.Helper, bb, -1, key, -1))
            if self.is_origin(key) and self.origin_is_resource[key] == 0 and pairs_operand_is_move(body, operand):
                self.push(pairs_step(FOREIGN_STEP_EXPIRE, key, -1, pairs_keep()), pairs_site(PairsSiteKind.Moved, bb, -1, key, -1))

    mut fn build_edges(body: &MirBody, bb: i32):
        let kind = body.term_kind(bb)
        let d0 = body.term_data0(bb)
        let d1 = body.term_data1(bb)
        let d2 = body.term_data2(bb)
        let d3 = body.term_data3(bb)
        if kind == TermKind.TK_GOTO:
            self.edges.push(ForeignPairEdge { from: bb, to: d0, guard: -1, succeeded: true })
        else if kind == TermKind.TK_CALL:
            self.edges.push(ForeignPairEdge { from: bb, to: d3, guard: -1, succeeded: true })
        else if kind == TermKind.TK_DROP_AND_GOTO:
            self.edges.push(ForeignPairEdge { from: bb, to: d1, guard: -1, succeeded: true })
        else if kind == TermKind.TK_SWITCH_INT:
            var guard: i32 = -1
            var is_eq = true
            var direct_disc = false
            let cond = self.key_of(pairs_operand_place(body, d0))
            if cond >= 0 and self.cond_guard[cond] >= 0:
                guard = self.cond_guard[cond]
                is_eq = self.cond_is_eq[cond] != 0
            else if cond >= 0:
                let raw_g = if self.guard_alias[cond] >= 0: self.guard_alias[cond] else: cond
                if raw_g >= 0 and self.guard_ok[raw_g] >= 0:
                    guard = raw_g
                    direct_disc = true
            if d1 >= 0 and d1 < body.switch_table_starts.len():
                let start = body.switch_table_starts[d1]
                let count = body.switch_table_counts[d1]
                if direct_disc:
                    let ok_val = self.guard_ok[guard]
                    let err_val = self.guard_err[guard]
                    var ok_in_table = false
                    var err_in_table = false
                    for i in 0..count:
                        let value = body.switch_table_vals[(start + i)]
                        if value == ok_val: ok_in_table = true
                        if err_val >= 0 and value == err_val: err_in_table = true
                        self.edges.push(ForeignPairEdge { from: bb, to: body.switch_table_targets[(start + i)], guard, succeeded: value == ok_val })
                    if ok_in_table:
                        self.edges.push(ForeignPairEdge { from: bb, to: d2, guard, succeeded: false })
                    else if err_val >= 0 and err_in_table:
                        self.edges.push(ForeignPairEdge { from: bb, to: d2, guard, succeeded: true })
                    else:
                        self.edges.push(ForeignPairEdge { from: bb, to: d2, guard: -1, succeeded: true })
                else:
                    for i in 0..count:
                        let value = body.switch_table_vals[(start + i)]
                        let succeeded = if guard < 0: true else: (value != 0) == is_eq
                        self.edges.push(ForeignPairEdge { from: bb, to: body.switch_table_targets[(start + i)], guard, succeeded })
                    let other = pairs_switch_otherwise_value(body, d1)
                    let succeeded = if guard < 0: true else: (other != 0) == is_eq
                    self.edges.push(ForeignPairEdge { from: bb, to: d2, guard, succeeded })
            else:
                self.edges.push(ForeignPairEdge { from: bb, to: d2, guard: -1, succeeded: true })

    mut fn build(sema: &Sema, body: &MirBody):
        for bb in 0..body.block_count():
            let first = self.steps.len() as i32
            let stmt_start = body.bb_stmt_starts[bb]
            let stmt_count = body.bb_stmt_counts[bb]
            for si in 0..stmt_count:
                self.build_stmt(sema, body, bb, stmt_start + si)
            let kind = body.term_kind(bb)
            if kind == TermKind.TK_CALL:
                self.build_call(sema, body, bb)
            else if kind == TermKind.TK_DROP_AND_GOTO:
                let key = self.key_of(body.term_data0(bb))
                if self.is_resource(key): self.destroy(sema, key, bb, -1)
                if self.is_origin(key):
                    self.push(pairs_step(FOREIGN_STEP_EXPIRE, key, -1, pairs_keep()), pairs_site(PairsSiteKind.Expire, bb, -1, key, -1))
            self.starts.push(first)
            self.counts.push((self.steps.len() - first) as i32)
            self.build_edges(body, bb)

fn pairs_site_span(ast: &AstPool, body: &MirBody, pb: &PairsBody, site: PairsStepSite) -> (i32, i32):
    // A retained origin that dies or moves is reported at the setter that
    // retained it: the death is a generated drop with no source of its own.
    if (site.kind == PairsSiteKind.Expire or site.kind == PairsSiteKind.Moved) and site.key >= 0 and site.key < pb.origin_bb.len() and pb.origin_bb[site.key] >= 0:
        let retained_at = pb.origin_bb[site.key]
        if body.term_kind(retained_at) == TermKind.TK_CALL:
            let node = body.call_ast_node(body.term_data1(retained_at))
            if node != 0:
                let s = ast.get_start(node)
                let e = ast.get_end(node)
                if e > s: return (s, e)
    var start: i32 = 0
    if site.stmt >= 0 and site.stmt < body.stmt_spans.len():
        start = body.stmt_spans[site.stmt]
    else if site.bb >= 0 and site.bb < body.bb_term_spans.len():
        start = body.bb_term_spans[site.bb]
        if body.term_kind(site.bb) == TermKind.TK_CALL:
            let node = body.call_ast_node(body.term_data1(site.bb))
            if node != 0:
                let s = ast.get_start(node)
                let e = ast.get_end(node)
                if e > s: return (s, e)
    if start < 0: start = 0
    (start, start + 1)

fn pairs_op_name(sema: &Sema, op: i32) -> str:
    if op < 0:
        return "destroying it"
    sema.facade_pair_op_display(op)

// A finding, reported by compiler/Compilation.with in the body's own file.
type PairsFinding {
    fn_sym: i32,
    start: i32,
    end: i32,
    message: str,
    note: str,
    help: str,
}

fn pairs_describe(ast: &AstPool, sema: &Sema, body: &MirBody, pb: &PairsBody, site: PairsStepSite) -> PairsFinding:
    let (start, end) = pairs_site_span(ast, body, pb, site)
    // A dying or moving origin names the resource that retained it: the
    // subject of the setter that did.
    var named = site.key
    if (site.kind == PairsSiteKind.Expire or site.kind == PairsSiteKind.Moved or site.kind == PairsSiteKind.NonPreserving) and site.key >= 0 and site.key < pb.origin_bb.len() and pb.origin_bb[site.key] >= 0:
        let call_id = body.term_data1(pb.origin_bb[site.key])
        let opi = if call_id >= 0 and call_id < body.call_sig_indices.len(): sema.facade_pair_op_for_sig(body.call_sig_indices[call_id]) else: -1
        let subject = if opi >= 0: sema.facade_pair_ops[opi].subject_param else: -1
        if subject >= 0 and call_id < body.call_arg_starts.len() and subject < body.call_arg_counts[call_id]:
            named = pb.key_of(pairs_operand_place(body, body.call_arg_operands[body.call_arg_starts[call_id] + subject]))
    let resource = pb.resource_name(sema, named)
    // What the resource holds the origin as: a retained pointer case's
    // storage (D194), named by its setter, or its callback userdata.
    var held_as = "callback userdata"
    if (site.kind == PairsSiteKind.Expire or site.kind == PairsSiteKind.Moved or site.kind == PairsSiteKind.NonPreserving) and site.key >= 0 and site.key < pb.origin_bb.len() and pb.origin_bb[site.key] >= 0:
        let call_id = body.term_data1(pb.origin_bb[site.key])
        let opi = if call_id >= 0 and call_id < body.call_sig_indices.len(): sema.facade_pair_op_for_sig(body.call_sig_indices[call_id]) else: -1
        if opi >= 0 and sema.facade_pair_ops[opi].action == FOREIGN_PAIR_RETAIN: held_as = "the storage " ++ sema.facade_pair_op_display(opi) ++ " set"
    if site.kind == PairsSiteKind.NonPreserving:
        let callee_name = if site.op >= 0 and site.op < sema.sig_names.len(): "'" ++ sema.pool_resolve(sema.sig_names[site.op]) ++ "'" else: "this operation"
        return PairsFinding { fn_sym: body.fn_sym, start, end, message: pb.key_name(sema, body, site.key) ++ " cannot be passed to " ++ callee_name ++ " while " ++ resource ++ " holds a retained borrow of it (§16.2b.5, §16.2b.9)", note: "operations not marked 'preserves' may mutate or invalidate the borrowed resource", help: "release the retention or reset/destroy " ++ resource ++ " first, or mark " ++ callee_name ++ " 'preserves' in its contract if C does not mutate or invalidate it" }
    if site.kind == PairsSiteKind.Invoke:
        return PairsFinding { fn_sym: body.fn_sym, start, end, message: pairs_op_name(sema, site.op) ++ " may invoke the callback pair of " ++ resource ++ ", and on this path the pair is not proven compatible (§16.2b.9)", note: "a callback set without its userdata, a setter whose failure was not handled, or a helper call that may have changed the pair leaves it unproven", help: "set both the callback and its userdata, handle the setter's Result (for example with '?') or branch on its status against its 'ok' constant, or run the resource's abandonment path first" }
    if site.kind == PairsSiteKind.Helper:
        return PairsFinding { fn_sym: body.fn_sym, start, end, message: "passing " ++ resource ++ " to a call the facade does not describe while its callback pair is not proven compatible; the callee may invoke it (§16.2b.9)", note: "", help: "complete the pair or run the abandonment path before the call" }
    if site.kind == PairsSiteKind.Expire or site.kind == PairsSiteKind.Moved:
        let what = if site.kind == PairsSiteKind.Expire: "dies" else: "moves"
        return PairsFinding { fn_sym: body.fn_sym, start, end, message: pb.key_name(sema, body, site.key) ++ " " ++ what ++ " while " ++ resource ++ " still holds it as " ++ held_as ++ " (§16.2b.9)", note: "", help: "keep it alive until the retention is released or the resource is reset or destroyed, or reset the resource first" }
    PairsFinding { fn_sym: body.fn_sym, start, end, message: resource ++ " holds a retained borrow and cannot be returned or stored; it is ephemeral until the retention is released, or the resource reset or destroyed (§16.2b.9)", note: "", help: "release the retention or run the abandonment path first, or keep the resource in this frame" }

// WITH_DUMP_PAIR_FLOW=1: every fact the flow ran on, for one body — the
// pair operations Sema registered, each call's recorded signature and the
// operation it matched, the steps per block, the edges with their guard
// refinement, and the violating steps.
fn pairs_dump(sema: &Sema, body: &MirBody, pb: &PairsBody, flow: &ForeignPairPlaceFlow):
    eprint(f"pair-flow fn {sema.pool_resolve(body.fn_sym)} keys={pb.width()} steps={pb.steps.len()} edges={pb.edges.len()}")
    for oi in 0..sema.facade_pair_ops.len():
        let op = &sema.facade_pair_ops[oi]
        eprint(f"  op{oi} action={op.action} resource={sema.pool_resolve(sema.facade_resources[op.resource].name)} slot={op.slot} u={op.userdata_tid} ok={op.guard_ok} invokes={op.invokes}")
    for bb in 0..body.block_count():
        if body.term_kind(bb) == TermKind.TK_CALL:
            let call_id = body.term_data1(bb)
            let sig = if call_id >= 0 and call_id < body.call_sig_indices.len(): body.call_sig_indices[call_id] else: -1
            eprint(f"  bb{bb} call sig={sig} op={sema.facade_pair_op_for_sig(sig)} dest_key={pb.key_of(body.term_data2(bb))}")
        for si in pb.starts[bb]..pb.starts[bb] + pb.counts[bb]:
            let s = &pb.steps[si]
            let c = &s.contract
            eprint(f"  bb{bb} step{si} kind={s.action} place={s.place}:{pb.key_name(sema, body, s.place)} source={s.source} op={c.action} ty={c.ty} origin={c.origin} guard={c.guard} can_fail={c.can_fail} invokes={c.invokes} site={pb.sites[si].kind as i32} tyname={sema.type_name(c.ty)}")
    for ei in 0..pb.edges.len():
        let e = &pb.edges[ei]
        eprint(f"  edge bb{e.from}->bb{e.to} guard={e.guard} succeeded={e.succeeded}")
    for vi in 0..flow.violations.len():
        eprint(f"  violation step{flow.violations[vi]}")

// The module's findings, collected body by body.
type PairsReport {
    findings: List[PairsFinding],
}

impl PairsReport:
    mut fn check_body(ast: &AstPool, sema: &Sema, body: &MirBody):
        if body.block_count() <= 0 or not pairs_body_relevant(sema, body):
            return
        let pb = pairs_body_new(body)
        pb.classify(sema, body)
        pb.prepass(sema, body)
        pb.build(sema, body)
        // Entry: parameters carry a pair the caller proved compatible (its
        // own flow checks that at the call); every other place is absent.
        let width = pb.width()
        let entry = foreign_pair_places(width as i32)
        for li in 1..(body.n_params + 1):
            if li < width and (pb.is_resource(li) or pb.is_ref(li)):
                entry.values[li] = foreign_pair_initial(false)
        let flow = foreign_pair_place_flow(pb.starts, pb.counts, pb.steps, pb.edges, entry)
        if pairs_dump_enabled():
            pairs_dump(sema, body, pb, flow)
        let reported_starts: List[i32] = []
        let reported_kinds: List[i32] = []
        for vi in 0..flow.violations.len():
            let si = flow.violations[vi]
            let site = pb.sites[si]
            let (start, _) = pairs_site_span(ast, body, pb, site)
            var seen = false
            for ri in 0..reported_starts.len():
                if reported_starts[ri] == start and reported_kinds[ri] == site.kind as i32: seen = true
            if seen:
                continue
            reported_starts.push(start)
            reported_kinds.push(site.kind as i32)
            self.findings.push(pairs_describe(ast, sema, body, pb, site))
            if pairs_dump_enabled():
                let last = self.findings.len() - 1
                eprint(f"  finding {self.findings[last].start}..{self.findings[last].end}: {self.findings[last].message}")

fn pairs_dump_enabled() -> bool: with_getenv_str("WITH_DUMP_PAIR_FLOW").len() > 0

// Every body of the module, after lowering and before codegen
// (compiler/Compilation.with run_mir_lower): a module with no callback pair
// costs one table lookup.
fn check_foreign_pairs(mir_mod: &MirModule, ast: &AstPool, sema: &Sema) -> PairsReport:
    let report = PairsReport { findings: [] }
    if sema.facade_pair_ops.len() == 0:
        return report
    for bi in 0..mir_mod.bodies.len():
        report.check_body(ast, sema, mir_mod.bodies[bi])
    report
