// CiFacts — D121 step 4 (§16.2b.15 item 3): the package registry's facts
// file, read for the facade proof engine (CiFacadeDraft.with).
//
// A facts file is a facade fragment in the facade language's own spelling,
// the spelling the draft emits, so a reviewer reads one grammar:
//
//   c facade zlib:
//       resource GzFileS wraps *mut gzFile_s
//           drop gzclose    // zlib.h 1.3.2: "gzclose … deallocates"
//       fn gzopen
//           consumes param 1    // …
//
// Every fact carries its citation after `//`: the source line or document
// that proves it. A fact without one is refused, which is the review rule
// the tool can enforce; the rest of the rule is the pull request. The
// facts are the tier below a proof and the library's own annotations
// (§16.2b.2): the engine applies one only where those said nothing.
//
// Clauses read: on a resource, `from F`, `drop F`, `destroys F`; on a
// function, `consumes param N`, `returns borrow R from param N`, `lend`,
// `nullable param N`, `text param N` and `text return, owned, freed by F`
// (D121 step 6: what a facade states about a parameter or a return that
// neither a proof nor an annotation reaches).
// Anything else in the file is an error naming the line: a registry file
// states facts, and an unreadable line is not silently a non-fact.

use std.fs
use std.string

type FactsEntry {
    pub fn_name: str,
    // Ownership: `owned`, `drop`, `destroys`, `consumes:N`, `borrow:N`,
    // `lend`. Presentation: `nullable:N`, `text_param:N`, `text_return:F`.
    pub kind: str,
    // The C record of the resource a resource fact is stated on, "" for
    // an item fact.
    pub record: str,
    pub cite: str,
}

type Facts {
    pub package: str,
    pub error_name: str,
    pub entries: List[FactsEntry],
    // The citation of a facade-level `text utf8` (D134 §16.2b.8: every
    // text return presents as `Option[str]`, validated at the boundary),
    // "" when the file states none.
    pub utf8_cite: str,
    // The citation of a facade-level `runs threads` (§16.3: the library
    // runs threads of its own), "" when the file states none.
    pub threads_cite: str,
    // D198: carried contract stanzas (by-value resources, rich pointer
    // resources, handles, domains, messages, and carried fn items), in the
    // facade's own spelling with each citation as its provenance, and the
    // functions/records they name. The draft carries the text as written;
    // the facade checker judges it against the header (§16.2b.13).
    pub value_text: str,
    pub value_fns: List[str],
    pub value_res_fns: List[str],
    pub value_resources: List[str],
    pub value_records: List[str],
    pub value_record_names: List[(str, str)],
    // §16.2b.15: the role of a function-pointer field, one per line:
    // `Record.field` and `role|Record|cite`.
    pub field_roles: List[(str, str)],
    // §31.8.1: how the package is configured when it is built from
    // source, one `build|NAME[=value]|cite` or `both|NAME[=value]|cite` per
    // line: `build define` reaches the library's build only, `define` the
    // build and the program's import of its headers.
    pub settings: List[str],
}

/// Whether `kind` is a presentation fact (a parameter's or a return's
/// shape) rather than an ownership fact.
fn facts_is_presentation(kind: &str):
    kind.starts_with("nullable:") or kind.starts_with("text_param:") or kind.starts_with("text_return:") or kind.starts_with("callback:") or kind.starts_with("retains_by:") or kind.starts_with("callback_thread:") or kind.starts_with("variadic:") or kind.starts_with("case:")

impl Facts:
    /// The ownership fact for the C function `name` as `kind|record|cite`,
    /// or "".
    fn of(name: &str) -> str:
        for e in self.entries:
            if e.fn_name == name and not facts_is_presentation(e.kind): return e.kind ++ "|" ++ e.record ++ "|" ++ e.cite
        ""

    /// Drops every fact whose citation names `setting`, and says which:
    /// one `function: clause` (or `field …`) per fact dropped.
    mut fn drop_citing(setting: &str) -> List[str]:
        let dropped = []
        let kept = []
        for e in self.entries:
            if e.cite.contains(setting): dropped.push(e.fn_name ++ ": `" ++ e.kind ++ "`")
            else: kept.push(FactsEntry { fn_name: e.fn_name.to_owned(), kind: e.kind.to_owned(), record: e.record.to_owned(), cite: e.cite.to_owned() })
        self.entries = kept
        var text = ""
        for line in self.value_text.split("\n"):
            if line.contains("// registry: ") and line.slice(line.find("// registry: "), line.len()).contains(setting): dropped.push("`" ++ line.slice(0, line.find("// registry: ")).trim() ++ "`")
            else: text = text ++ line ++ "\n"
        self.value_text = if text.len() > 0: text.slice(0, text.len() - 1).to_owned() else: ""
        let roles = []
        for (field, role) in self.field_roles:
            if facts_cite(role).contains(setting): dropped.push("`field " ++ field ++ "`")
            else: roles.push((field.to_owned(), role.to_owned()))
        self.field_roles = roles
        dropped

    /// Every `reads param N` the file states, as `function:N`.
    fn reads() -> List[str]:
        let out = []
        for e in self.entries:
            if e.kind.starts_with("reads:"): out.push(e.fn_name ++ ":" ++ e.kind.slice(6, e.kind.len()))
        out

    /// The presentation facts for `name`, one `kind|record|cite` per line,
    /// in the file's order; "" when it states none.
    fn presentation(name: &str) -> str:
        var out = ""
        for e in self.entries:
            if e.fn_name == name and facts_is_presentation(e.kind): out = out ++ e.kind ++ "|" ++ e.record ++ "|" ++ e.cite ++ "\n"
        out

/// The name of a setting line (`build|NAME[=value]|cite`).
fn facts_setting_name(setting: &str) -> str:
    let parts = setting.split("|")
    if parts.len() < 2: return ""
    let eq = parts[1].find("=")
    if eq < 0: parts[1].to_owned() else: parts[1].slice(0, eq).to_owned()

/// The `kind` of a fact string `of` gave.
fn facts_kind(fact: &str) -> str:
    let bar = fact.find("|")
    if bar < 0: "" else: fact.slice(0, bar)

/// The record of a fact string `of` gave.
fn facts_record(fact: &str) -> str:
    let parts = fact.split("|")
    if parts.len() < 3: "" else: parts[1]

/// The citation of a fact string `of` gave.
fn facts_cite(fact: &str) -> str:
    let parts = fact.split("|")
    if parts.len() < 3: "" else: parts[2]

fn facts_error(path: &str, line: isize, message: &str): path ++ f":{line}: " ++ message

// `text` split at its `//`: the clause and the citation, trimmed.
fn facts_split_cite(text: &str):
    let at = text.find("//")
    let out: List[str] = []
    if at < 0:
        out.push(text.trim())
        out.push("")
    else:
        out.push(text.slice(0, at).trim())
        out.push(text.slice(at + 2, text.len()).trim())
    out

/// Reads the facts file at `path`.
fn facts_read_file(path: &str) -> Result[Facts, str]:
    let source = match read_file(path):
        Ok(s) => s
        Err(_) => return Err("cannot read " ++ path)
    facts_read(path, source)

fn facts_push_unique(mut list: List[str], name: &str):
    if not list.contains(name): list.push(name.to_owned())

fn facts_flush_fn(mut facts: Facts, fn_name: &str, carry: bool, clauses: &List[str], cites: &List[str], kinds: &List[str]):
    if fn_name.len() == 0 or clauses.len() == 0: return
    if carry:
        facts_push_unique(facts.value_fns, fn_name)
        facts.value_text = facts.value_text ++ "    fn " ++ fn_name ++ "\n"
        var fk: isize = 0
        for cl in clauses:
            let ind = if cl.starts_with("case "): "            " else: "        "
            facts.value_text = facts.value_text ++ ind ++ cl ++ "    // registry: " ++ cites[fk] ++ "\n"
            fk += 1
    else:
        var fk: isize = 0
        for k in kinds:
            facts.entries.push(FactsEntry { fn_name: fn_name.to_owned(), kind: k.to_owned(), record: "", cite: cites[fk].to_owned() })
            fk += 1

fn facts_default_resource_name(record: &str) -> str:
    var camel = ""
    for part in record.split("_"):
        if part.len() == 0: continue
        camel = camel ++ part.slice(0, 1).to_upper() ++ part.slice(1, part.len())
    if camel == record: camel ++ "Handle" else: camel

fn facts_flush_ptr(mut facts: Facts, ptr_header: &str, ptr_name: &str, ptr_record: &str, ptr_carry: bool, ptr_rec_multi: &List[str], named_refs: &List[str], ptr_clauses: &List[str], ptr_fns: &List[str], ptr_kinds: &List[str], ptr_cites: &List[str]):
    if ptr_header.len() == 0: return
    var has_from = false
    for k in ptr_kinds:
        if k == "owned": has_from = true
    let custom_named = has_from and ptr_name != facts_default_resource_name(ptr_record) and named_refs.contains(ptr_name)
    if ptr_carry or ptr_rec_multi.contains(ptr_record) or custom_named or ptr_clauses.len() == 0:
        facts_push_unique(facts.value_resources, ptr_name)
        facts_push_unique(facts.value_records, ptr_record)
        facts.value_record_names.push((ptr_record.to_owned(), ptr_name.to_owned()))
        facts.value_text = facts.value_text ++ "    " ++ ptr_header ++ "\n"
        var pk: isize = 0
        for cl in ptr_clauses:
            if ptr_fns[pk].len() > 0:
                facts_push_unique(facts.value_fns, ptr_fns[pk])
                facts_push_unique(facts.value_res_fns, ptr_fns[pk])
            facts.value_text = facts.value_text ++ "        " ++ cl ++ "    // registry: " ++ ptr_cites[pk] ++ "\n"
            pk += 1
    else:
        var pk: isize = 0
        for fn_name in ptr_fns:
            facts.entries.push(FactsEntry { fn_name: fn_name.to_owned(), kind: ptr_kinds[pk].to_owned(), record: ptr_record.to_owned(), cite: ptr_cites[pk].to_owned() })
            pk += 1

fn facts_read(path: &str, source: str) -> Result[Facts, str]:
    var facts = Facts { package: "", error_name: "", entries: [], utf8_cite: "", threads_cite: "", value_text: "", value_fns: [], value_res_fns: [], value_resources: [], value_records: [], value_record_names: [], field_roles: [], settings: [] }
    var in_value = false
    var in_message = false
    var current_fn = ""
    var in_resource = false
    // Buffer each `fn` stanza until its end so clause order inside one `fn`
    // block never splits its clauses across `facts.entries` and
    // `facts.value_text`.
    var fn_carry = false
    var fn_clauses = []
    var fn_cites = []
    var fn_kinds = []
    // A pointer resource block is buffered until its end so a resource using
    // D209 positioned destroyers (`drop f(param N)`), custom contract clauses
    // (`ok`, `message`, `borrows`, `abandon`, `from f(out param N)`, `thread`),
    // custom resource naming referenced by `of R` / `returns borrow R`, or
    // sharing a C record with another resource in this file is carried
    // verbatim as a named resource stanza, while a single-resource hint stays
    // in `facts.entries`.
    var ptr_header = ""
    var ptr_name = ""
    var ptr_record = ""
    var ptr_carry = false
    var ptr_clauses = []
    var ptr_fns = []
    var ptr_kinds = []
    var ptr_cites = []
    // Records wrapped by more than one pointer resource, and resource names
    // referenced explicitly by `of R` / `returns borrow R` / `case K: &R`.
    let ptr_rec_counts = []
    let ptr_rec_multi = []
    var named_refs = []
    for scan in source.split("\n"):
        let st = scan.trim()
        let sc = facts_split_cite(st)[0]
        if sc.starts_with("resource ") and sc.contains(" wraps *mut "):
            let at = sc.find(" wraps *mut ")
            let rec = sc.slice(at + 12, sc.len()).trim()
            if ptr_rec_counts.contains(rec):
                if not ptr_rec_multi.contains(rec): ptr_rec_multi.push(rec.to_owned())
            else:
                ptr_rec_counts.push(rec.to_owned())
        else if sc.starts_with("of "):
            let ow = sc.fields()
            if ow.len() >= 2:
                let rname = if ow[1].contains("("): ow[1].slice(0, ow[1].find("(")) else: ow[1]
                facts_push_unique(mut named_refs, rname)
        else if sc.starts_with("returns borrow "):
            let bw = sc.fields()
            if bw.len() >= 3 and bw[2] != "CStr":
                facts_push_unique(mut named_refs, bw[2])
        else if sc.starts_with("case ") and sc.contains(": &"):
            let at = sc.find(": &")
            let rest = sc.slice(at + 3, sc.len()).fields()
            if rest.len() >= 1: facts_push_unique(mut named_refs, rest[0])
    var variadic_item = ""
    var record = ""
    var line_no: isize = 0
    for raw in source.split("\n"):
        line_no += 1
        let stripped = raw.trim()
        if stripped.len() == 0 or stripped.starts_with("//"): continue
        // A registry file is headed `c facts NAME:` (or `c facts NAME error E:`).
        let header = if stripped.starts_with("c facts "): "c facts " else if stripped.starts_with("c facade "): "c facade " else: ""
        if header.len() > 0 and stripped.ends_with(":"):
            if facts.package.len() > 0: return Err(facts_error(path, line_no, "a second `c facts` header"))
            let hwords = stripped.slice(header.len(), stripped.len() - 1).trim().fields()
            if hwords.len() == 1:
                facts.package = hwords[0].to_owned()
            else if hwords.len() == 3 and hwords[1] == "error":
                facts.package = hwords[0].to_owned()
                facts.error_name = hwords[2].to_owned()
            else:
                return Err(facts_error(path, line_no, "header is `c facts NAME:` or `c facts NAME error ErrorType:`"))
            continue
        if facts.package.len() == 0: return Err(facts_error(path, line_no, "`c facts NAME:` must come first"))
        let is_top_level = not raw.starts_with("        ")
        let starts_top_item = stripped.starts_with("resource ") or stripped.starts_with("fn ") or (is_top_level and (stripped.starts_with("message ") or stripped.starts_with("handle ") or stripped.starts_with("domain ") or stripped.starts_with("preserves domain ")))
        if starts_top_item:
            facts_flush_fn(mut facts, current_fn, fn_carry, fn_clauses, fn_cites, fn_kinds)
            fn_carry = false
            fn_clauses = []
            fn_cites = []
            fn_kinds = []
            current_fn = ""
            in_message = false
            facts_flush_ptr(mut facts, ptr_header, ptr_name, ptr_record, ptr_carry, ptr_rec_multi, named_refs, ptr_clauses, ptr_fns, ptr_kinds, ptr_cites)
            ptr_header = ""
            ptr_name = ""
            ptr_record = ""
            ptr_carry = false
            ptr_clauses = []
            ptr_fns = []
            ptr_kinds = []
            ptr_cites = []
        if stripped.starts_with("resource "):
            in_resource = true
            in_value = not stripped.contains(" wraps *mut ")
            if in_value:
                // A by-value token (§16.2b.3): `resource R wraps Record`.
                let words = stripped.fields()
                if words.len() != 4 or words[2] != "wraps": return Err(facts_error(path, line_no, "a resource is `resource R wraps *mut record` or `resource R wraps Record`"))
                if words[1] == words[3]: return Err(facts_error(path, line_no, "a by-value resource needs a name of its own: `" ++ words[1] ++ "` is the record's"))
                facts_push_unique(facts.value_resources, words[1])
                facts.value_text = facts.value_text ++ "    " ++ stripped ++ "\n"
                continue
            let at = stripped.find(" wraps *mut ")
            let words = stripped.slice(0, at).fields()
            if words.len() != 2: return Err(facts_error(path, line_no, "a resource is `resource R wraps *mut record` or `resource R wraps Record`"))
            record = stripped.slice(at + 12, stripped.len()).trim()
            if record.len() == 0 or record.contains(" ") or record.contains("|"): return Err(facts_error(path, line_no, "a resource wraps one C record"))
            ptr_header = stripped.to_owned()
            ptr_name = words[1].to_owned()
            ptr_record = record.to_owned()
            continue
        if is_top_level and stripped.starts_with("message "):
            in_resource = false
            in_message = true
            let words = stripped.fields()
            if words.len() != 4 or words[2] != "wraps": return Err(facts_error(path, line_no, "a message is `message Name wraps Record`"))
            facts.value_text = facts.value_text ++ "    " ++ stripped ++ "\n"
            continue
        if stripped.starts_with("fn "):
            current_fn = stripped.slice(3, stripped.len()).trim()
            fn_carry = facts.value_fns.contains(current_fn)
            variadic_item = ""
            in_resource = false
            if current_fn.len() == 0 or current_fn.contains(" "): return Err(facts_error(path, line_no, "an item is `fn NAME`"))
            continue
        let parts = facts_split_cite(stripped)
        let clause = parts[0]
        let cite = parts[1]
        if cite.len() == 0: return Err(facts_error(path, line_no, "a fact needs its citation after `//`: the source line or document that proves it"))
        if cite.contains("|"): return Err(facts_error(path, line_no, "a citation cannot hold `|`"))
        if clause.starts_with("handle "):
            in_resource = false
            let at = clause.find(" wraps *mut ")
            if at < 0: return Err(facts_error(path, line_no, "a handle is `handle Name wraps *mut Record`"))
            let hwords = clause.slice(0, at).fields()
            let hrec = clause.slice(at + 12, clause.len()).trim()
            if hwords.len() != 2 or hrec.len() == 0 or hrec.contains(" "): return Err(facts_error(path, line_no, "a handle is `handle Name wraps *mut Record`"))
            facts_push_unique(facts.value_resources, hwords[1])
            facts_push_unique(facts.value_records, hrec)
            facts.value_record_names.push((hrec.to_owned(), hwords[1].to_owned()))
            facts.value_text = facts.value_text ++ "    " ++ clause ++ "    // registry: " ++ cite ++ "\n"
            continue
        if is_top_level and (clause.starts_with("domain ") or clause.starts_with("preserves domain ")):
            in_resource = false
            facts.value_text = facts.value_text ++ "    " ++ clause ++ "    // registry: " ++ cite ++ "\n"
            continue
        if in_message:
            let mwords = clause.fields()
            if mwords.len() >= 2 and (mwords[0] == "from" or mwords[0] == "release"):
                let mfn = if mwords[1].contains("("): mwords[1].slice(0, mwords[1].find("(")) else: mwords[1]
                facts_push_unique(facts.value_fns, mfn)
                facts_push_unique(facts.value_res_fns, mfn)
            facts.value_text = facts.value_text ++ "        " ++ clause ++ "    // registry: " ++ cite ++ "\n"
            continue
        if clause.starts_with("field "):
            // `field F of R is allocator|reallocator|deallocator|context|callback`
            let words = clause.fields()
            if words.len() != 6 or words[2] != "of" or words[4] != "is" or not (words[5] == "allocator" or words[5] == "reallocator" or words[5] == "deallocator" or words[5] == "context" or words[5] == "callback"): return Err(facts_error(path, line_no, "a field's role is `field F of R is allocator`, `reallocator`, `deallocator`, `context` or `callback`"))
            facts_flush_fn(mut facts, current_fn, fn_carry, fn_clauses, fn_cites, fn_kinds)
            fn_carry = false
            fn_clauses = []
            fn_cites = []
            fn_kinds = []
            in_resource = false
            current_fn = ""
            facts.field_roles.push((words[3] ++ "." ++ words[1], words[5] ++ "|" ++ words[3] ++ "|" ++ cite))
            continue
        if (clause.starts_with("build define ") or clause.starts_with("define ")) and not in_resource and current_fn.len() == 0:
            // `build define NAME[=value]`: the library is built with it, and
            // the program's import of the headers is not (zlib's ZLIB_CONST
            // makes the C compiler check that nothing writes through
            // `next_in`, and must not reach the import, where it would make
            // the header say what the facts state). `define NAME[=value]`:
            // both, for a setting that changes what the headers declare
            // (expat's XML_UNICODE changes XML_Char).
            let build_only = clause.starts_with("build ")
            let setting = clause.slice(if build_only: 13 else: 7, clause.len()).trim()
            let eq = setting.find("=")
            let name = if eq < 0: setting else: setting.slice(0, eq)
            var named = name.len() > 0 and not is_digit(name[0])
            for c in name.bytes():
                if not (is_alnum(c) or c == '_'): named = false
            if not named or setting.contains(" "): return Err(facts_error(path, line_no, "a setting is `build define NAME`, `build define NAME=value`, `define NAME` or `define NAME=value`"))
            for stated in facts.settings:
                if facts_setting_name(stated) == name: return Err(facts_error(path, line_no, "the setting `" ++ name ++ "` is stated twice"))
            facts.settings.push((if build_only: "build" else: "both") ++ "|" ++ setting ++ "|" ++ cite)
            continue
        if clause == "text utf8" and not in_resource and current_fn.len() == 0:
            if facts.utf8_cite.len() > 0: return Err(facts_error(path, line_no, "`text utf8` is stated twice"))
            facts.utf8_cite = cite
            continue
        if clause == "runs threads" and not in_resource and current_fn.len() == 0:
            if facts.threads_cite.len() > 0: return Err(facts_error(path, line_no, "`runs threads` is stated twice"))
            facts.threads_cite = cite
            continue
        if in_resource:
            let words = clause.fields()
            // §16.2b.4: a by-value producer may state the field whose NULL
            // means nothing was produced: `from F, nullable field a.b`.
            if in_value and words.len() == 5 and words[0] == "from" and words[1].ends_with(",") and (words[2] == "nullable" or words[2] == "nonnull") and words[3] == "field":
                let fshort = words[1].slice(0, words[1].len() - 1)
                facts_push_unique(facts.value_fns, fshort)
                facts_push_unique(facts.value_res_fns, fshort)
                facts.value_text = facts.value_text ++ "        " ++ clause ++ "    // registry: " ++ cite ++ "\n"
                continue
            // §31.8.1 (Eric, 2026-11-21, #3173 D): an in-place resource is
            // stated as a contract states it: `init F(self)`, with its own
            // success status when it has one (`init F(self), ok K`), and a
            // resource-level `ok K` for the initializers that state none.
            if in_value and words.len() >= 2 and words[0] == "init":
                let named = if words[1].ends_with(","): words[1].slice(0, words[1].len() - 1) else: words[1]
                if not named.ends_with("(self)") or named.len() <= 6: return Err(facts_error(path, line_no, "an in-place initializer is `init F(self)`, or `init F(self), ok K` with its own success status"))
                if words.len() > 2 and (not words[1].ends_with(",") or words[2] != "ok" or words.len() < 4): return Err(facts_error(path, line_no, "after `init F(self),` state the initializer's own success status: `ok K`"))
                let ishort = named.slice(0, named.len() - 6)
                facts_push_unique(facts.value_fns, ishort)
                facts_push_unique(facts.value_res_fns, ishort)
                facts.value_text = facts.value_text ++ "        " ++ clause ++ "    // registry: " ++ cite ++ "\n"
                continue
            if in_value and words.len() >= 2 and (words[0] == "ok" or words[0] == "message" or words[0] == "borrows" or words[0] == "thread" or words[0] == "requires"):
                facts.value_text = facts.value_text ++ "        " ++ clause ++ "    // registry: " ++ cite ++ "\n"
                continue
            if in_value and (clause == "independent" or clause == "movable"):
                facts.value_text = facts.value_text ++ "        " ++ clause ++ "    // registry: " ++ cite ++ "\n"
                continue
            // Rich pointer resource clauses (`from f(out param N)`, `from f, nonnull`,
            // `abandon f`, `ok ...`, `message f`, `borrows ...`, `independent`,
            // `thread ...`, `requires domain ...`) carry the resource stanza.
            if not in_value and words.len() >= 2 and words[0] == "from" and (words[1].contains("(out") or words[1].ends_with(",")):
                let fn_name = if words[1].contains("("): words[1].slice(0, words[1].find("(")) else: words[1].slice(0, words[1].len() - 1)
                ptr_carry = true
                ptr_clauses.push(clause.to_owned())
                ptr_fns.push(fn_name.to_owned())
                ptr_kinds.push("owned")
                ptr_cites.push(cite.to_owned())
                continue
            if not in_value and words.len() >= 2 and words[0] == "abandon":
                let fn_name = if words[1].contains("("): words[1].slice(0, words[1].find("(")) else: words[1]
                ptr_carry = true
                ptr_clauses.push(clause.to_owned())
                ptr_fns.push(fn_name.to_owned())
                ptr_kinds.push("abandon")
                ptr_cites.push(cite.to_owned())
                continue
            if not in_value and (clause == "independent" or (words.len() >= 2 and (words[0] == "ok" or words[0] == "message" or words[0] == "borrows" or words[0] == "thread" or words[0] == "requires"))):
                ptr_carry = true
                ptr_clauses.push(clause.to_owned())
                ptr_fns.push("")
                ptr_kinds.push("")
                ptr_cites.push(cite.to_owned())
                continue
            // D209: `drop F(param N)` / `destroys F(param N)` on a pointer or by-value resource.
            if words.len() == 3 and (words[0] == "drop" or words[0] == "destroys") and words[1].ends_with("(param") and words[2].ends_with(")") and words[1].len() > 6 and words[2].len() > 1:
                let fn_name = words[1].slice(0, words[1].len() - 6)
                if in_value:
                    facts_push_unique(facts.value_fns, fn_name)
                    facts_push_unique(facts.value_res_fns, fn_name)
                    facts.value_text = facts.value_text ++ "        " ++ clause ++ "    // registry: " ++ cite ++ "\n"
                    continue
                ptr_carry = true
                ptr_clauses.push(clause.to_owned())
                ptr_fns.push(fn_name.to_owned())
                ptr_kinds.push(words[0].to_owned())
                ptr_cites.push(cite.to_owned())
                continue
            if words.len() != 2 or not (words[0] == "from" or words[0] == "drop" or words[0] == "destroys"): return Err(facts_error(path, line_no, "a resource fact is `from F`, `drop F`, `drop F(param N)`, `destroys F` or `destroys F(param N)`; a by-value producer may add `, nullable field F` or `, nonnull field F`"))
            if in_value:
                facts_push_unique(facts.value_fns, words[1])
                facts_push_unique(facts.value_res_fns, words[1])
                facts.value_text = facts.value_text ++ "        " ++ clause ++ "    // registry: " ++ cite ++ "\n"
                continue
            ptr_clauses.push(clause.to_owned())
            ptr_fns.push(words[1].to_owned())
            ptr_kinds.push(if words[0] == "from": "owned" else: words[0].to_owned())
            ptr_cites.push(cite.to_owned())
            continue
        if current_fn.len() == 0: return Err(facts_error(path, line_no, "a fact belongs to a `resource` or an `fn` item"))
        let cwords = clause.fields()
        let is_of_clause = (cwords.len() == 2 and cwords[0] == "of") or (cwords.len() == 3 and cwords[0] == "of" and cwords[1].ends_with("(param") and cwords[2].ends_with(")") and cwords[1].len() > 6 and cwords[2].len() > 1)
        let is_buffer_param = cwords.len() >= 5 and cwords[0] == "buffer" and cwords[1] == "param" and (cwords[3] == "len" or cwords[3] == "capacity")
        let is_discarded = cwords.len() == 3 and cwords[0] == "param" and cwords[2] == "discarded"
        let is_fixed = cwords.len() >= 4 and cwords[0] == "param" and cwords[2] == "fixed"
        let is_ok = cwords.len() >= 2 and cwords[0] == "ok"
        let is_static_cstr = clause == "returns static CStr"
        let is_borrow_cstr = clause.starts_with("returns borrow CStr from param ")
        let is_fills_updates = cwords.len() == 3 and (cwords[0] == "fills" or cwords[0] == "updates" or cwords[0] == "detaches") and cwords[1] == "param"
        let is_contract_clause = (cwords.len() == 2 and cwords[0] == "rename") or clause.starts_with("preserves domain ") or clause.starts_with("preserves param ") or clause == "callbacks none" or clause.starts_with("present cases") or clause == "valid on failed" or clause == "override lend" or clause.starts_with("null status ") or clause.starts_with("establishes domain ") or clause.starts_with("ends domain ") or clause.starts_with("requires domain ") or (clause.starts_with("consumes param ") and clause.contains(" destroyed_by ")) or (clause.starts_with("callback param ") and (clause.contains(" userdata ") or clause.contains(" argv "))) or clause.starts_with("user_data from ") or (clause.starts_with("returns borrow ") and (clause.contains(" from domain ") or clause.contains(" from parent ") or clause.contains(" from params ")))
        if is_of_clause or is_buffer_param or is_discarded or is_fixed or is_ok or is_static_cstr or is_borrow_cstr or is_fills_updates or is_contract_clause:
            fn_carry = true
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("")
        else if clause.starts_with("buffer field ") and clause.contains(" remaining field "):
            // D210: a step function of a by-value resource reads and writes
            // through fields of the record (zlib's `deflate` through
            // `next_in`/`avail_in` and `next_out`/`avail_out`).
            fn_carry = true
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("")
        else if clause == "lend":
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("lend")
        else if clause.starts_with("consumes param "):
            let n = clause.slice(15, clause.len()).trim()
            if n.len() == 0 or n.contains(" "): return Err(facts_error(path, line_no, "`consumes param N` takes a parameter ref"))
            if not is_digit(n[0]): fn_carry = true
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("consumes:" ++ n)
        else if clause.starts_with("returns borrow ") and clause.contains(" from param "):
            let at = clause.find(" from param ")
            let n = clause.slice(at + 12, clause.len()).trim()
            if n.len() == 0 or n.contains(" "): return Err(facts_error(path, line_no, "`returns borrow R from param N` takes a parameter ref"))
            if not is_digit(n[0]): fn_carry = true
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("borrow:" ++ n)
        else if clause.starts_with("nullable param "):
            let n = clause.slice(15, clause.len()).trim()
            if n.len() == 0 or n.contains(" "): return Err(facts_error(path, line_no, "`nullable param N` takes a parameter ref"))
            if not is_digit(n[0]): fn_carry = true
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("nullable:" ++ n)
        else if clause.starts_with("text param "):
            let n = clause.slice(11, clause.len()).trim()
            if n.len() == 0 or n.contains(" "): return Err(facts_error(path, line_no, "`text param N` takes a parameter ref"))
            if not is_digit(n[0]): fn_carry = true
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("text_param:" ++ n)
        else if clause.starts_with("text return"):
            let words = clause.replace(",", " ").fields()
            if words.len() != 6 or words[2] != "owned" or words[3] != "freed" or words[4] != "by": return Err(facts_error(path, line_no, "a text return is `text return, owned, freed by F`"))
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("text_return:" ++ words[5])
        else if clause.starts_with("callback param "):
            // D213: a setter of a `callback` field is described here, since
            // which thread runs the callback is a claim no proof reaches.
            let n = clause.slice(15, clause.len()).trim()
            if n.len() == 0 or not is_digit(n[0]) or n.contains(" "): return Err(facts_error(path, line_no, "`callback param N` takes a parameter index (a callback with a userdata parameter is paired in a contract, not here)"))
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("callback:" ++ n)
        else if clause.starts_with("retains param ") and clause.contains(" by param "):
            let words = clause.fields()
            if words.len() != 6: return Err(facts_error(path, line_no, "`retains param N by param M` takes two parameter refs"))
            if not is_digit(words[2][0]) or not is_digit(words[5][0]): fn_carry = true
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("retains_by:" ++ words[2] ++ ":" ++ words[5])
        else if clause.starts_with("variadic param ") and clause.contains(" selected by param ") and clause.ends_with(":"):
            // §16.2b.5: a variadic function's cases, stated as a contract
            // states them (libcurl's `curl_easy_setopt`): the header line,
            // then one `case K: …` line per selector value, each cited.
            let at = clause.find(" selected by param ")
            let v = clause.slice(15, at).trim()
            let s = clause.slice(at + 19, clause.len() - 1).trim()
            if v.len() == 0 or s.len() == 0 or not is_digit(v[0]): return Err(facts_error(path, line_no, "`variadic param V selected by param S:` takes parameter refs"))
            if not is_digit(s[0]): fn_carry = true
            variadic_item = current_fn
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("variadic:" ++ v ++ ":" ++ s)
        else if clause.starts_with("case "):
            let colon = clause.find(": ")
            if variadic_item != current_fn or colon < 6 or colon + 2 >= clause.len(): return Err(facts_error(path, line_no, "a case is `case K: <what the argument is>`, under the item's `variadic param V selected by param S:`"))
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("case:" ++ clause.slice(5, colon).trim() ++ ":" ++ clause.slice(colon + 2, clause.len()).trim())
        else if clause.starts_with("reads param "):
            // §16.2b.8: the function only reads through this pointer
            // parameter. The platform C library's facts state it for the
            // functions ISO C and POSIX specify that way.
            let n = clause.slice(12, clause.len()).trim()
            if n.len() == 0 or n.contains(" "): return Err(facts_error(path, line_no, "`reads param N` takes a parameter ref"))
            fn_carry = true
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("reads:" ++ n)
        else if clause == "callback_thread any" or clause == "callback_thread registering":
            fn_clauses.push(clause.to_owned())
            fn_cites.push(cite.to_owned())
            fn_kinds.push("callback_thread:" ++ clause.slice(16, clause.len()))
        else: return Err(facts_error(path, line_no, "an item fact is `of R[(param N)]`, `lend`, `buffer param P len|capacity param L [inout] [elements]`, `fills|updates|reads|detaches param N`, `param N discarded`, `param N fixed <lit>`, `ok <CONST>`, `returns static CStr`, `consumes param N`, `returns borrow R from param N`, `nullable param N`, `text param N`, `text return, owned, freed by F`, `callback param N`, `retains param N by param M` or `callback_thread any|registering`"))
    facts_flush_fn(mut facts, current_fn, fn_carry, fn_clauses, fn_cites, fn_kinds)
    facts_flush_ptr(mut facts, ptr_header, ptr_name, ptr_record, ptr_carry, ptr_rec_multi, named_refs, ptr_clauses, ptr_fns, ptr_kinds, ptr_cites)
    if facts.package.len() == 0: return Err(path ++ ": no `c facts NAME:` header")
    Ok(facts)
