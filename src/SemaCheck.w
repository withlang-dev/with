}

fn sema_dyn_trait_method_missing -> SemaDynTraitMethodInfo:
    SemaDynTraitMethodInfo {
        ok: 0,
        method_flags: 0,
        param_start: 0,
        param_count: 0,
        ret_node: 0,
    }

impl Sema:
    mut fn trait_method_effective_return_type(method_flags: i32, ret_node: i32) -> i32:
        var ret_ty = self.ty_void as i32
        if ret_node != 0:
            ret_ty = self.resolve_type_expr(ret_node) as i32
        if ret_ty == 0:
            return 0
        self.fn_signature_return_type(method_flags, ret_ty as TypeId) as i32

