module build.stc

use std.build
use build.corpus
use build.wo
use build.par

// STC (stclib/STC), MIT (its LICENSE ships beside the migration). Phase 3
// of docs/proposals/stdlib_sourcing_plan.md: the macro-migrator campaign.
// The generic pipeline (build/corpora.w) fetches, migrates, checks,
// promotes and bundles it; this module holds the facts, the staging hook
// and the corpus's own lanes: upstream's ctest programs, migrated whole in
// STC's default linkage (every unit carries the library it instantiates).
//
// Two migrations, two linkages. The library proper — strings, views, utf8,
// spans, random, fmt, coroutines: the `src/` units — migrates under
// STC_HEADER, which makes the headers declare and the units define, one
// definition per function, as a library links. The containers are
// templates (`#define T IVec, int` + `#include <stc/vec.h>`), static in
// every unit that instantiates them; the tests instantiate them, so each
// test unit migrates in the default linkage with its own copies, the
// library included, and the `src/` units stay out of that migration (their
// extern definitions would collide with the units' static ones). cregex is
// not migrated: its error path is setjmp/longjmp (`_rcerror`), which has
// no With spelling; With's regex is pcre2 (std.regex).

const STC_REVISION = "fc5c0587974f08dd05f1f714f2f12d3a99fdd9c7"
const STC_SHA256 = "df2925f76604e774a55a0aba71c4c320dc7d2adf42ac2d65d06552bc6ce8db77"

// The checked-in migration of upstream's test units (one migration: the
// units are independent translation units with no globals in common, so
// they share one defs.w). Generated by stc-promote-tests, never hand-edited.
// The programs are a std package for the reason c-algorithms' are: under
// --no-prelude, std.libc reaches c_void through the std tier's view of the
// defs, and a user package cannot provide that.
const STC_TESTS_DIR = "test/corpora/stc"
const STC_TESTS_PACKAGE = "std.engines.stc_testing"
fn stc_tests_package_dir(): "lib/" ++ STC_TESTS_PACKAGE.replace(".", "/")
// The With half of ctest.h (its assertions), beside the generated modules.
const STC_HARNESS_DIR = "test/corpora/stc_harness"

// The library units: every `src/` unit but cregex (setjmp).
fn stc_lib_units() -> List[str]:
    ["cspan", "cstr_core", "cstr_io", "cstr_misc", "cstr_utf8", "csview", "fmt", "random", "stc_core", "utf8_misc"]

// The test units: every `tests/*_test.c` but cregex_test (cregex) and
// main.c (CTEST_MAIN: the section walk and setjmp, replaced by the harness).
fn stc_test_units() -> List[str]:
    ["algorithm_test", "cspan_test", "deque_test", "hmap_test", "list_test", "smap_test", "utf8_test", "vec_test"]

// The test programs the lane compiles and runs.
fn stc_test_programs() -> List[str]:
    ["algorithm_test", "cspan_test", "deque_test", "hmap_test", "list_test", "smap_test", "utf8_test", "vec_test"]

pub fn stc_corpus() -> Corpus:
    Corpus {
        name: "stc", stem: "stc", package: "std.engines.stc",
        corpus_rel: "std/engines/stc", corpus_dir: "lib/std/engines/stc",
        upstream: upstream_github("stc", "stclib/STC", STC_REVISION, STC_SHA256),
        license: "LICENSE",
        // upstream's cstr example is the drift harness: a program over the
        // library proper (no template), never part of the bundle root
        harness: ["replace"], drift_harness: "replace.w", drift_harness_arg: "",
        module_floor: 10, defines: ["STC_HEADER"], excludes: List.new(),
        include_dirs: ["include"], declared_externs: List.new(),
        promote_after: ["stc-promote-tests"], test_lane: "stc-test",
        fresh_test_lanes: ["stc-test-fresh"], extra_generated_dirs: [STC_TESTS_DIR],
        prepare_reference: corpus_no_prepare, stage: stc_stage,
        migrate: corpus_migrate_directory, finish_generated: corpus_no_finish,
        verify_generated: corpus_no_verify, lanes: stc_lanes,
    }

// The headers, beside the staged units as upstream keeps them
// (`src/x.c` includes `../include/stc/x.h`; a program includes `<stc/x.h>`
// through the corpus's include directory).
fn stc_stage_headers(ctx: &ActionCtx, reference: &str, source: &str) -> i32:
    let fs = ctx.fs()
    let base = reference ++ "/include"
    let target = corpus_dirname(source) ++ "/include"
    for path in fs.list_files(base):
        if not path.ends_with(".h") and not path.ends_with(".c"): continue
        let relative = path.slice(base.len() + 1, path.len())
        let destination = target ++ "/" ++ relative
        if fs.mkdir_all(corpus_dirname(destination)) != 0: return corpus_fail(ctx, "cannot create " ++ corpus_dirname(destination))
        if corpus_copy(ctx, path, destination) != 0: return 1
    0

// The library units into `source`: the `src/` units and the staged ucd unit.
fn stc_stage_library(ctx: &ActionCtx, reference: &str, source: &str) -> i32:
    for name in stc_lib_units():
        if corpus_copy(ctx, reference ++ "/src/" ++ name ++ ".c", source ++ "/" ++ name ++ ".c") != 0: return 1
    // The Unicode category tables (`priv/ucd_prv.c`, which cutf8_isalpha and
    // its kin need) are compiled into upstream's cregex unit alone, which is
    // not migrated (setjmp); they are staged as a unit of their own, in the
    // one-line shape of upstream's `src/` units.
    if ctx.fs().write_text(source ++ "/ucd.c", "#include \"../include/stc/common.h\"\n#include \"../include/stc/types.h\"\n#include \"../include/stc/priv/utf8_prv.h\"\n#include \"../include/stc/priv/ucd_prv.c\"\n") != 0: return corpus_fail(ctx, "cannot write the ucd unit")
    0

// The production corpus: the library units and the drift harness.
fn stc_stage(ctx: &ActionCtx, corpus: &Corpus, reference: &str, source: &str) -> i32:
    if stc_stage_headers(ctx, reference, source) != 0: return 1
    if stc_stage_library(ctx, reference, source) != 0: return 1
    corpus_copy(ctx, reference ++ "/examples/strings/replace.c", source ++ "/replace.c")

// The migrate command for one test program: its own staging directory and
// output, project-relative paths. ctest.h bakes `__FILE__` into every
// assertion, so the text carries the path the migrator saw; a relative one is
// the same on every machine (corpus_migrate_argv's absolute paths named this
// worktree).
fn stc_test_migrate_argv(ctx: &ActionCtx, compiler: &str, source: &str, output: &str) -> List[str]:
    var argv: List[str] = List.new()
    argv.push(corpus_abs(ctx, compiler))
    argv.push("migrate")
    argv.push(source)
    argv.push("-o")
    argv.push(output)
    argv.push("--c-target")
    argv.push(corpus_c_model_target())
    argv.push("--c-sysroot")
    argv.push(corpus_abs(ctx, corpus_c_model_dir()))
    argv.push("-I")
    argv.push(source)
    argv.push("-I")
    argv.push(corpus_dirname(source) ++ "/include")
    // A `__FILE__` the unit bakes (stc_core's coroutine.h diagnostics)
    // names the header relative to the program's staging directory, which
    // would differ per program: it is spelled from that directory instead
    // (`../include/stc/coroutine.h`), the same in every program, so the
    // engine modules stay shared.
    argv.push("--macro-prefix-map")
    argv.push(source ++ "/=")
    argv.push("--no-prelude")
    argv.push("--no-c-export")
    argv.push("--prefer-brace")
    argv.push("--width-slice")
    argv.push("8")
    argv.push("--shared-defs")
    argv.push(STC_TESTS_PACKAGE ++ ".defs")
    argv

// ── the runner each test module gains ────────────────────────────
//
// ctest.h registers a test as a `struct ctest` record and CTEST_MAIN walks
// the linker section they sit in. The migrated module keeps the records
// (`var ctest_<suite>_<name>: ctest = ctest { .. }`) and the test bodies
// (`fn ctest_<suite>_<name>_run`); a `main` written from the records calls
// each body in order, a fixture's setup and teardown around it, and exits
// with the harness's failure count. Generated into the migrated module by
// the migrate-tests action, from the module's own text.

fn stc_test_names(text: &str) -> List[str]:
    var names: List[str] = List.new()
    for line in text.split("\n"):
        if not line.starts_with("var ctest_") or not line.contains(": ctest = ctest {"): continue
        let head = line.slice(4, line.len())
        let colon = head.find(":")
        if colon < 0: continue
        names.push(head.slice(0, colon))
    names

// The suite a test belongs to: the record's `ssname` string.
fn stc_test_suite(text: &str, name: &str) -> str:
    for line in text.split("\n"):
        if not line.starts_with("var " ++ name ++ ": ctest = ctest {"): continue
        let key = "ssname: ((\""
        let at = line.find(key)
        if at < 0: return ""
        let rest = line.slice(at + key.len(), line.len())
        let close = rest.find("\"")
        if close < 0: return ""
        return rest.slice(0, close)
    ""

// `TEST_SKIP` registers the test with `skip: 1`; ctest reports it and runs nothing.
fn stc_test_skipped(text: &str, name: &str) -> bool:
    for line in text.split("\n"):
        if line.starts_with("var " ++ name ++ ": ctest = ctest {"): return line.contains(" skip: 1,")
    false

fn stc_fn_is_unsafe(text: &str, name: &str) -> bool:
    text.contains("unsafe fn " ++ name ++ "(")

fn stc_call(text: &str, call: &str, name: &str) -> str:
    if stc_fn_is_unsafe(text, name): "unsafe { " ++ call ++ " }" else: call

fn stc_runner_text(text: &str) -> str:
    var body = "\n// The runner (build/stc.w): every registered test, in order.\npub fn main() -> c_int:\n"
    var count = 0
    for name in stc_test_names(text):
        let suite = stc_test_suite(text, name)
        let short = name.slice(("ctest_" ++ suite ++ "_").len(), name.len())
        if stc_test_skipped(text, name):
            body = body ++ "    print(\"skip " ++ suite ++ "." ++ short ++ "\")\n"
            count = count + 1
            continue
        let run = name ++ "_run"
        let data = name ++ "_data"
        if text.contains("var " ++ data ++ ":"):
            // A fixture test: `TEST_F` passes the suite's data record through
            // setup, the body and teardown.
            let setup = "ctest_" ++ suite ++ "_setup"
            let teardown = "ctest_" ++ suite ++ "_teardown"
            let pointer = "(&raw mut " ++ data ++ " as *mut ctest_" ++ suite ++ "_data)"
            body = body ++ "    " ++ stc_call(text, setup ++ "(" ++ pointer ++ ")", setup) ++ "\n"
            body = body ++ "    " ++ stc_call(text, run ++ "(" ++ pointer ++ ")", run) ++ "\n"
            body = body ++ "    " ++ stc_call(text, teardown ++ "(" ++ pointer ++ ")", teardown) ++ "\n"
        else:
            body = body ++ "    " ++ stc_call(text, run ++ "()", run) ++ "\n"
        body = body ++ "    print(\"ran " ++ suite ++ "." ++ short ++ "\")\n"
        count = count + 1
    if count == 0: return ""
    body ++ "    return ctest_failure_count()\n"

// The migrated unit, with the harness imported and the runner appended.
fn stc_finish_test_module(ctx: &ActionCtx, path: &str) -> i32:
    let fs = ctx.fs()
    let text = fs.read_text(path)
    let runner = stc_runner_text(text)
    if runner.len() == 0: return corpus_fail(ctx, path ++ ": no ctest registration in the migrated unit")
    let defs = "\nuse " ++ STC_TESTS_PACKAGE ++ ".defs\n"
    let imported = text.replace(defs, defs ++ "use " ++ STC_TESTS_PACKAGE ++ ".harness\n")
    if imported == text: return corpus_fail(ctx, path ++ ": the migrated unit does not import the shared defs, where the harness import goes")
    if fs.write_text(path, imported ++ runner) != 0: return corpus_fail(ctx, "cannot write " ++ path)
    0

// One migration of every test unit in STC's default linkage.
// One migration per test program, as c-algorithms' lane: a unit defines
// its containers under its own names (`#define T Intmap ..` is an hmap in
// hmap_test.c and a sorted map in smap_test.c), so two units cannot share
// one defs.w. Each program migrates whole: the test, ctest.h, the library
// units it links (upstream's shared libstc) and the ucd unit. The
// migrations run together (par_run).
pub fn run_stc_migrate_tests_action(ctx: ActionCtx) -> i32:
    let fs = ctx.fs()
    let reference = ctx.inputs()[0]
    let output = ctx.output()
    let scratch = corpus_scratch(ctx)
    let generated = scratch ++ "/generated"
    if corpus_reset_dir(ctx, generated) != 0: return 1
    if stc_stage_headers(ctx, reference, scratch ++ "/source") != 0: return 1
    let migrator = corpus_migrator_arg(ctx)
    if migrator.len() == 0: return corpus_fail(ctx, "a corpus migration names its migrator (corpus_migrating_target)")
    var jobs: List[ParJob] = List.new()
    var labels: List[str] = List.new()
    for name in stc_test_units():
        let source = scratch ++ "/source-" ++ name
        if corpus_reset_dir(ctx, source) != 0: return 1
        if stc_stage_library(ctx, reference, source) != 0: return 1
        if corpus_copy(ctx, reference ++ "/tests/" ++ name ++ ".c", source ++ "/" ++ name ++ ".c") != 0: return 1
        if corpus_copy(ctx, reference ++ "/tests/ctest.h", source ++ "/ctest.h") != 0: return 1
        let test_output = generated ++ "/tests/" ++ name
        if fs.mkdir_all(test_output) != 0: return 1
        let label = "stc-test-" ++ name
        let stdout = corpus_abs(&ctx, scratch ++ "/" ++ label ++ ".stdout")
        let stderr = corpus_abs(&ctx, scratch ++ "/" ++ label ++ ".stderr")
        jobs.push(par_job(stc_test_migrate_argv(&ctx, migrator, source, test_output), stdout, stderr, 1200000))
        labels.push(label)
    let rcs = par_run(&ctx, &jobs, par_width(&jobs))
    for i in 0..rcs.len():
        if rcs[i] != 0: return corpus_fail(ctx, labels[i] ++ f": `migrate` exited {rcs[i]}; see " ++ jobs[i].stderr)
    for name in stc_test_units():
        if stc_finish_test_module(ctx, generated ++ "/tests/" ++ name ++ "/" ++ name ++ ".w") != 0: return 1
    if fs.write_text(generated ++ "/UPSTREAM", STC_REVISION ++ "\nsha256=" ++ STC_SHA256 ++ "\nconfiguration=tests\n") != 0: return 1
    if fs.exists(output) and fs.remove_tree(output) != 0: return corpus_fail(ctx, "cannot replace " ++ output)
    if fs.rename(generated, output) != 0: return corpus_fail(ctx, "cannot publish " ++ output)
    print(f"migrated {stc_test_units().len()} STC test programs into " ++ corpus_abs(ctx, output))
    0

// Promotes the test migration into the tree. Every program's migration
// carries its own copy of the library; those copies are byte-identical
// across programs (the same translation units), so one engine/ is checked
// in and each programs/<name>/ keeps only what differs: the program's
// defs.w (its types and globals) and its test module.
pub fn run_stc_promote_tests_action(ctx: ActionCtx) -> i32:
    let fs = ctx.fs()
    let generated = ctx.inputs()[0] ++ "/tests"
    let final_destination = ctx.output()
    // Assembled beside the tree and published whole once every program's
    // engine copy agreed: a refused promotion leaves the checked-in corpus
    // as it was (one once deleted every program's defs.w before refusing).
    let destination = corpus_scratch(ctx) ++ "/promoted"
    if corpus_reset_dir(ctx, destination) != 0: return 1
    let engine = destination ++ "/engine"
    if fs.mkdir_all(engine) != 0: return corpus_fail(ctx, "cannot create " ++ engine)
    var engine_from = ""
    for name in stc_test_units():
        let program = generated ++ "/" ++ name
        let test_module = name ++ ".w"
        let target = destination ++ "/programs/" ++ name
        if fs.mkdir_all(target) != 0: return corpus_fail(ctx, "cannot create " ++ target)
        for path in fs.list_files(program):
            if not path.ends_with(".w"): continue
            let base = corpus_basename(path)
            if base == "defs.w" or base == test_module:
                if corpus_copy(ctx, path, target ++ "/" ++ base) != 0: return 1
                continue
            let shared = engine ++ "/" ++ base
            if engine_from.len() == 0 or not fs.exists(shared):
                if corpus_copy(ctx, path, shared) != 0: return 1
            else if fs.read_text(shared) != fs.read_text(path):
                return corpus_fail(ctx, "engine module " ++ base ++ " differs between programs " ++ engine_from ++ " and " ++ name ++ "; the shared engine/ layout no longer holds")
        if engine_from.len() == 0: engine_from = name
    if fs.write_text(destination ++ "/UPSTREAM", STC_REVISION ++ "\nsha256=" ++ STC_SHA256 ++ "\nconfiguration=tests\n") != 0: return 1
    if fs.exists(final_destination) and fs.remove_tree(final_destination) != 0: return corpus_fail(ctx, "cannot replace " ++ final_destination)
    if fs.rename(destination, final_destination) != 0: return corpus_fail(ctx, "cannot publish " ++ final_destination)
    print(f"promoted {stc_test_units().len()} STC test programs into " ++ corpus_abs(ctx, final_destination))
    0

// The corpora lane: every test program is assembled into its own module
// tree with the shared engine and the harness, compiled by the release
// binary and run; the harness counts failed assertions and the exit code
// is the count.
pub fn run_stc_test_action(ctx: ActionCtx) -> i32:
    let fs = ctx.fs()
    let compiler = corpus_abs(ctx, ctx.inputs()[0])
    let output = ctx.output()
    if corpus_reset_dir(ctx, output) != 0: return 1
    var report = "upstream=" ++ STC_REVISION ++ "\nconfiguration=tests\n"
    // D112: `fresh=<dir>` runs the fresh migration (each program whole under
    // <dir>/tests/<name>) for the migrator gate; otherwise the promoted
    // programs and their shared engine.
    let fresh = wo_arg_value(ctx.args(), "fresh=")
    for name in stc_test_programs():
        let program_root = output ++ "/" ++ name
        let module_dir = program_root ++ "/" ++ stc_tests_package_dir()
        if fs.mkdir_all(module_dir) != 0: return 1
        if fresh.len() > 0:
            if corpus_copy_w_files(ctx, fresh ++ "/tests/" ++ name, module_dir) != 0: return 1
        else:
            if corpus_copy_w_files(ctx, STC_TESTS_DIR ++ "/engine", module_dir) != 0: return 1
            if corpus_copy_w_files(ctx, STC_TESTS_DIR ++ "/programs/" ++ name, module_dir) != 0: return 1
        if corpus_copy_w_files(ctx, STC_HARNESS_DIR, module_dir) != 0: return 1
        let binary = output ++ "/" ++ name ++ ".bin"
        var compile_args: List[str] = List.new()
        compile_args.push(compiler)
        compile_args.push("build")
        compile_args.push("--no-prelude")
        compile_args.push("-O1")
        compile_args.push(stc_tests_package_dir() ++ "/" ++ name ++ ".w")
        compile_args.push("-o")
        compile_args.push(corpus_abs(ctx, binary))
        let compiled = ctx.process_runner().run_capture_cwd(compile_args, corpus_abs(ctx, binary ++ ".compile.stdout"), corpus_abs(ctx, binary ++ ".compile.stderr"), 600000, corpus_abs(ctx, program_root))
        if compiled.rc != 0: return corpus_fail(ctx, "compile " ++ name ++ f" exited {compiled.rc}\n" ++ fs.read_text(binary ++ ".compile.stderr"))
        // #2230: name what runs before it runs.
        if corpus_provenance(ctx, output, binary) != 0: return 1
        var argv: List[str] = List.new()
        argv.push(corpus_abs(ctx, binary))
        let result = ctx.process_runner().run_capture(argv, corpus_abs(ctx, binary ++ ".stdout"), corpus_abs(ctx, binary ++ ".stderr"), 300000)
        if result.rc != 0: return corpus_fail(ctx, name ++ f" exited {result.rc}\n" ++ result.stdout ++ result.stderr)
        report = report ++ "PASS " ++ name ++ "\n"
        print("PASS " ++ name)
    if fs.write_text(output ++ "/report.txt", report) != 0: return 1
    print("upstream=" ++ STC_REVISION ++ " " ++ f"{stc_test_programs().len()} programs passed")
    0

// Every checked-in test module and the harness are inputs: an edit re-runs
// the lane.
fn stc_with_test_inputs(target: Target, ctx: &BuildCtx) -> Target:
    var out = target
    for dir in [STC_TESTS_DIR, STC_HARNESS_DIR]:
        for path in ctx.fs().list_files(dir):
            if path.ends_with(".w"): out = out.input(path)
    out

fn stc_lanes(out: Build, ctx: &BuildCtx, corpus: &Corpus, release_compiler: &str) -> Build:
    var graph = out
    var migrate_tests = target_new(.Action, "stc-migrate-tests", "").output("out/stc_tests_migrated")
    migrate_tests.action = run_stc_migrate_tests_action
    migrate_tests = migrate_tests.input(corpus.upstream.reference).dep("stc-prepare-reference")
    migrate_tests = migrate_tests.write_scope("out/tmp/action-scratch/stc-migrate-tests")
    migrate_tests = corpus_migrating_target(migrate_tests, release_compiler)
    graph = graph.add_target(migrate_tests)
    var promote_tests = target_new(.Action, "stc-promote-tests", "").output(STC_TESTS_DIR)
    promote_tests.action = run_stc_promote_tests_action
    promote_tests = promote_tests.input("out/stc_tests_migrated").dep("stc-migrate-tests")
    graph = graph.add_target(promote_tests)
    var tests = target_new(.Action, "stc-test", "").output("out/corpus/stc-test")
    tests.action = run_stc_test_action
    tests = tests.input(release_compiler).dep("build")
    tests = stc_with_test_inputs(tests, ctx)
    graph = graph.add_target(tests)
    // D112: the same programs from a fresh migration, for the migrator gate.
    var fresh = target_new(.Action, "stc-test-fresh", "").output("out/corpus/stc-test-fresh")
    fresh.action = run_stc_test_action
    fresh = fresh.input(release_compiler).input("out/stc_tests_migrated").arg("fresh=out/stc_tests_migrated")
    fresh = fresh.dep("build").dep("stc-migrate-tests")
    fresh = stc_with_test_inputs(fresh, ctx)
    graph.add_target(fresh)
