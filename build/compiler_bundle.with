module build.compiler_bundle

// The compiler's own modules as a tree bundle (#3351, wo_bundles.md "Tree
// bundles"): `src/` and the generated `out/gen/compiler/` compiled once by
// the release compiler into <dir>/compiler.{o,wi,manifest}. A test that says
// `use Sema` then reads the interface and links the object
// (`with test --link-bundle <dir>/compiler`) instead of checking, lowering
// and generating every body of the compiler: 34 s of Sema for a 31-line
// test became 1 s.
//
// The root is written here, one `use` per module of the tree. The emitted
// interface is checked against the source's declaration fingerprint, as a
// .wo build and the runtime bundle check theirs.

use std.build
use std.process
use build.wo

fn cb_fail(ctx: &ActionCtx, message: &str) -> i32:
    ctx.diagnostics().error(ctx.target_name() ++ ": " ++ message)

fn cb_abs(root: &str, path: &str) -> str:
    if path.len() > 0 and path[0] == '/': path ++ "" else: root ++ "/" ++ path

fn cb_run(ctx: &ActionCtx, label: &str, argv: &List[str]) -> ToolProcessResult:
    let root = ctx.project_info().project_root()
    let capture_dir = "out/command/" ++ ctx.target_name()
    let env = process_env().set("WITH_OUT_DIR", cb_abs(root, "out"))
    ctx.process_runner().run_capture_with_env(argv, cb_abs(root, capture_dir ++ "/" ++ label ++ ".stdout"), cb_abs(root, capture_dir ++ "/" ++ label ++ ".stderr"), ctx.timeout(), env)

fn cb_first_line(text: &str) -> str:
    var end: i64 = 0
    while end < text.len() and text[end] != '\n' and text[end] != '\r':
        end = end + 1
    text.slice(0, end)

// One `use` per module of `src/`, in path order: `src/compiler/Link.with` is
// `compiler.Link`. The two files with a `main` are the compiler's own roots.
fn cb_root_text(ctx: &ActionCtx) -> str:
    let uses = []
    for path in ctx.fs().list_files("src"):
        if not path.ends_with(".with") or path == "src/main.with" or path == "src/bootstrap_main.with": continue
        let line = "use " ++ path.slice(4, path.len() - 5).replace("/", ".") ++ "\n"
        var at = uses.len()
        uses.push(line)
        while at > 0 and uses[at - 1] > line:
            uses[at] = uses[at - 1]
            at = at - 1
        uses[at] = line
    var text = "// Generated by with build (compiler-bundle): the compiler's modules\n// (build/compiler_bundle.with).\n"
    for line in uses: text = text ++ line
    text

// args: compiler=<path> dir=<dir>.
pub fn run_compiler_bundle_action(ctx: ActionCtx) -> i32:
    let args = ctx.args()
    let compiler = wo_arg_value(args, "compiler=")
    let dir = wo_arg_value(args, "dir=")
    if compiler.len() == 0 or dir.len() == 0:
        return cb_fail(ctx, "requires compiler= and dir= arguments")
    let fs = ctx.fs()
    let root = ctx.project_info().project_root()
    let capture_dir = "out/command/" ++ ctx.target_name()
    if fs.mkdir_all(dir) != 0 or fs.mkdir_all(capture_dir) != 0:
        return cb_fail(ctx, "could not create " ++ dir)
    let root_path = dir ++ "/root.with"
    if fs.write_text(root_path, cb_root_text(ctx)) != 0:
        return cb_fail(ctx, "could not write " ++ root_path)
    let corpus = "tree:" ++ cb_abs(root, "src") ++ "," ++ cb_abs(root, "out/gen")
    let obj = dir ++ "/compiler.o"
    let wi = dir ++ "/compiler.wi"
    let manifest = dir ++ "/compiler.manifest"
    let fp_source = dir ++ "/compiler.fp"
    let fp_wi = dir ++ "/compiler.wi.fp"
    let built = cb_run(ctx, "build", &[cb_abs(root, compiler), "build", cb_abs(root, root_path), "--emit-obj", "--bundle-corpus", corpus, "--emit-bundle-interface", cb_abs(root, wi), "--emit-bundle-manifest", cb_abs(root, manifest), "--bundle-fingerprint", cb_abs(root, fp_source), "-O1", "-o", cb_abs(root, obj)])
    if built.rc != 0:
        return cb_fail(ctx, f"compiler bundle build failed with exit code {built.rc}; captures under {capture_dir}\n" ++ built.stderr)
    if not fs.exists(obj) or not fs.exists(wi) or not fs.exists(manifest) or not fs.exists(fp_source):
        return cb_fail(ctx, "compiler bundle build wrote no object, interface, manifest or fingerprint under " ++ dir)
    // D39: the interface reproduces the source's declarations exactly (the
    // second fingerprint pass, out of process).
    let checked = cb_run(ctx, "check-wi", &[cb_abs(root, compiler), "check", cb_abs(root, wi), "--bundle-corpus", corpus, "--bundle-fingerprint", cb_abs(root, fp_wi)])
    if checked.rc != 0:
        return cb_fail(ctx, f"check of the compiler bundle's interface failed with exit code {checked.rc}; captures under {capture_dir}\n" ++ checked.stderr)
    let source_fp = cb_first_line(fs.read_text(fp_source))
    let wi_fp = cb_first_line(fs.read_text(fp_wi))
    if source_fp.len() != 64 or source_fp != wi_fp:
        return cb_fail(ctx, "fingerprint of the compiler bundle's interface (" ++ wi_fp ++ ") differs from the source fingerprint (" ++ source_fp ++ "); diff " ++ fp_source ++ ".tsv against " ++ fp_wi ++ ".tsv")
    0

// #3401 (package-bundles.md): an importer reads a package's
// interface, never its bodies, and the interface records what was inferred.
// The fixture package test/package_bundle/lib leaves a return type, a
// view's origins, a stored parameter and a callable's single invocation to
// inference; each program under test/package_bundle/app is checked against
// the package's source and against its interface alone. Both must give the
// outcome the program's first line states, and the interface must reproduce
// the source's declaration fingerprint.
//
// The fixture is copied under <dir> so a program's `use shapes` finds the
// package's `lib/` from there, as it does in a project.
// args: compiler=<path> dir=<dir>.
pub fn run_package_interface_check_action(ctx: ActionCtx) -> i32:
    let args = ctx.args()
    let compiler = wo_arg_value(args, "compiler=")
    let dir = wo_arg_value(args, "dir=")
    if compiler.len() == 0 or dir.len() == 0:
        return cb_fail(ctx, "requires compiler= and dir= arguments")
    let fs = ctx.fs()
    let root = ctx.project_info().project_root()
    let fixture = "test/package_bundle"
    // A run starts from an empty directory: a file an earlier run left (a
    // fixture under its old name) is not this run's.
    let _stale = fs.remove_tree(dir)
    if fs.mkdir_all(dir ++ "/lib") != 0 or fs.mkdir_all(dir ++ "/app") != 0 or fs.mkdir_all(dir ++ "/bundle") != 0 or fs.mkdir_all("out/command/" ++ ctx.target_name()) != 0:
        return cb_fail(ctx, "could not create " ++ dir)
    let programs = []
    for path in fs.list_files(fixture):
        // The fixture library is a package of its own: its `with.toml` goes
        // with it, so a call from a program crosses a package boundary.
        if not path.ends_with(".with") and not path.ends_with("/with.toml"): continue
        let rel = path.slice(fixture.len() + 1, path.len())
        if fs.write_text(dir ++ "/" ++ rel, fs.read_text(path)) != 0:
            return cb_fail(ctx, "could not write " ++ dir ++ "/" ++ rel)
        if rel.starts_with("app/"): programs.push(rel)
    if programs.len() == 0:
        return cb_fail(ctx, "no program under " ++ fixture ++ "/app")
    let root_path = dir ++ "/bundle/root.with"
    if fs.write_text(root_path, "use shapes\n") != 0:
        return cb_fail(ctx, "could not write " ++ root_path)
    let corpus = "tree:" ++ cb_abs(root, dir ++ "/lib")
    let prefix = dir ++ "/bundle/shapes"
    let built = cb_run(ctx, "build", &[cb_abs(root, compiler), "build", cb_abs(root, root_path), "--emit-obj", "--bundle-corpus", corpus, "--emit-bundle-interface", cb_abs(root, prefix ++ ".wi"), "--emit-bundle-manifest", cb_abs(root, prefix ++ ".manifest"), "--bundle-fingerprint", cb_abs(root, prefix ++ ".fp"), "-O1", "-o", cb_abs(root, prefix ++ ".o")])
    if built.rc != 0:
        return cb_fail(ctx, f"the package's bundle build failed with exit code {built.rc}\n" ++ built.stderr)
    let checked = cb_run(ctx, "check-wi", &[cb_abs(root, compiler), "check", cb_abs(root, prefix ++ ".wi"), "--bundle-corpus", corpus, "--bundle-fingerprint", cb_abs(root, prefix ++ ".wi.fp")])
    if checked.rc != 0:
        return cb_fail(ctx, f"check of the package's interface failed with exit code {checked.rc}\n" ++ checked.stderr)
    let source_fp = cb_first_line(fs.read_text(prefix ++ ".fp"))
    let wi_fp = cb_first_line(fs.read_text(prefix ++ ".wi.fp"))
    if source_fp.len() != 64 or source_fp != wi_fp:
        return cb_fail(ctx, "the interface's fingerprint (" ++ wi_fp ++ ") differs from the source's (" ++ source_fp ++ "); diff " ++ prefix ++ ".fp.tsv against " ++ prefix ++ ".wi.fp.tsv")
    var wrong = 0
    for rel in programs:
        let path = dir ++ "/" ++ rel
        let first = cb_first_line(fs.read_text(path))
        let wants_ok = first == "//! expect: ok"
        let fragment = if first.starts_with("//! expect-error: "): first.slice(18, first.len()) else: ""
        if not wants_ok and fragment.len() == 0:
            return cb_fail(ctx, rel ++ ": its first line is neither `//! expect: ok` nor `//! expect-error: <text>`")
        let label = rel.slice(4, rel.len() - 5)
        let from_source = cb_run(ctx, label ++ ".source", &[cb_abs(root, compiler), "check", cb_abs(root, path)])
        let source_right = if wants_ok: from_source.rc == 0 else: from_source.rc != 0 and from_source.stderr.contains(fragment)
        if not source_right:
            wrong = wrong + 1
            eprint("package-interface-check: " ++ rel ++ " against the package's source: expected " ++ (if wants_ok: "ok" else: "an error containing `" ++ fragment ++ "`") ++ "\n" ++ from_source.stderr)
    // The package's source is removed before anything is checked against
    // the bundle: a bundled module resolves from its interface, so the
    // source need not exist, and nothing can be read from it.
    let package_source = fs.read_text(dir ++ "/lib/shapes.with")
    if fs.remove_tree(dir ++ "/lib") != 0: return cb_fail(ctx, "could not remove " ++ dir ++ "/lib")
    for rel in programs:
        let path = dir ++ "/" ++ rel
        let first = cb_first_line(fs.read_text(path))
        let wants_ok = first == "//! expect: ok"
        let fragment = if first.starts_with("//! expect-error: "): first.slice(18, first.len()) else: ""
        let label = rel.slice(4, rel.len() - 5)
        let from_interface = cb_run(ctx, label ++ ".interface", &[cb_abs(root, compiler), "check", cb_abs(root, path), "--link-bundle", cb_abs(root, prefix)])
        let interface_right = if wants_ok: from_interface.rc == 0 else: from_interface.rc != 0 and from_interface.stderr.contains(fragment)
        if not interface_right:
            wrong = wrong + 1
            eprint("package-interface-check: " ++ rel ++ " against the package's interface: expected " ++ (if wants_ok: "ok" else: "an error containing `" ++ fragment ++ "`") ++ "\n" ++ from_interface.stderr)
    // The importer reads the interface, never the body: a function added to
    // the package's source after its bundle was built is not there, for
    // `check` and for `run` alike. (`run` once dropped `--link-bundle` and
    // compiled the package from its source without a word.)
    let late_source = package_source ++ "\npub fn added_after_the_bundle() -> i32: 9\n"
    let late_program = dir ++ "/app/names_what_only_the_source_has.with"
    if fs.mkdir_all(dir ++ "/lib") != 0 or fs.write_text(dir ++ "/lib/shapes.with", late_source) != 0 or fs.write_text(late_program, "use shapes\nfn main: print(added_after_the_bundle())\n") != 0:
        return cb_fail(ctx, "could not write the late-source probe under " ++ dir)
    let late_check = cb_run(ctx, "late.check", &[cb_abs(root, compiler), "check", cb_abs(root, late_program), "--link-bundle", cb_abs(root, prefix)])
    let late_run = cb_run(ctx, "late.run", &[cb_abs(root, compiler), "run", "--link-bundle", cb_abs(root, prefix), cb_abs(root, late_program)])
    if late_check.rc == 0 or not late_check.stderr.contains("undefined variable"):
        wrong = wrong + 1
        eprint("package-interface-check: `check --link-bundle` saw a function that exists only in the package's source\n" ++ late_check.stderr)
    if late_run.rc == 0 or not late_run.stderr.contains("undefined variable"):
        wrong = wrong + 1
        eprint("package-interface-check: `run --link-bundle` saw a function that exists only in the package's source\n" ++ late_run.stderr ++ late_run.stdout)
    if wrong > 0:
        return cb_fail(ctx, f"{wrong} outcome(s) differ from what the programs state")
    print(f"package-interface-check: {programs.len()} programs agree against source and interface")
    0
