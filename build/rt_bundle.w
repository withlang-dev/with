module build.rt_bundle

// The runtime bundle (D30 R3, d30-implementation-plan.md
// §10): the runtime compiled as its own unit, in full, into
// <dir>/rt.{o,wi,manifest} — the artifact shape of a .wo bundle
// (wo_bundles.md), none of its store. A compiler embeds
// the bundle a compiler of its own generation built (stage2 embeds stage1's,
// stage3 stage2's), and `rt-bundle-fixpoint` proves the two agree byte for
// byte: the in-unit result is what the cache holds, by construction.
//
// The root is written here (`use rt.<module>` per module of this host's
// runtime, Frontend.parse_runtime_modules_frontend's set), and the compile
// compiles the runtime as its own unit (D30 step 4: in-unit is the default); the emitted
// interface is checked against the source's declaration fingerprint, as a
// .wo build checks its own.

use std.build
use std.process
use build.wo

fn rb_fail(ctx: &ActionCtx, message: &str) -> i32:
    ctx.diagnostics().error(ctx.target_name() ++ ": " ++ message)

fn rb_abs(root: &str, path: &str) -> str:
    if path.len() > 0 and path[0] == '/': path ++ "" else: root ++ "/" ++ path

// `lane`: the compile joins the runtime to the
// unit; the interface check does not (a `.wi` root supplies the runtime
// modules itself, as its own sections).
fn rb_run(ctx: &ActionCtx, label: &str, argv: &List[str], lane: bool) -> ToolProcessResult:
    let root = ctx.project_info().project_root()
    let capture_dir = "out/command/" ++ ctx.target_name()
    var process_env = process_env()
    process_env = process_env.set("WITH_OUT_DIR", rb_abs(root, "out"))
    // D50: the root's path enters the object's debug info; mapped, the
    // bundle is the same bytes from every checkout.
    process_env = process_env.set("WITH_FILE_PREFIX_MAP", root ++ "=/with-src")
    ctx.process_runner().run_capture_with_env(argv, rb_abs(root, capture_dir ++ "/" ++ label ++ ".stdout"), rb_abs(root, capture_dir ++ "/" ++ label ++ ".stderr"), ctx.timeout(), process_env)

fn rb_first_line(text: &str) -> str:
    var end: i64 = 0
    while end < text.len() and text[end] != '\n' and text[end] != '\r':
        end = end + 1
    text.slice(0, end)

// args: modules=<stem,stem,...>; output: the root, one `use` per runtime
// module of this host. One target, one path: both bundle compiles read it,
// so the root's path in their debug info is the same.
pub fn run_rt_bundle_root_action(ctx: ActionCtx) -> i32:
    let modules = wo_arg_value(ctx.args(), "modules=")
    if modules.len() == 0:
        return rb_fail(ctx, "requires a modules= argument")
    var root_text = "// Generated by with build (rt-bundle-root): the runtime bundle root, one\n// `use` per runtime module of this host (build/rt_bundle.w).\n"
    for stem in modules.split(","):
        root_text = root_text ++ "use rt." ++ stem ++ "\n"
    if ctx.fs().write_text(ctx.output(), root_text) != 0:
        return rb_fail(ctx, "could not write " ++ ctx.output())
    0

// args: compiler=<path> dir=<dir> root=<path> [target=<triple>]. The unit is
// the runtime alone (--no-prelude): the runtime does not use the prelude,
// and with it the prelude's std.regex pulled pcre2 in — from source on a
// stage1 whose .wo slots are empty, from the bundle on stage2, and the two
// objects differed in nothing but `l_str.N` numbering. Without it the
// bundle depends on nothing but the compiler, which the stage's own runtime
// objects and corpus bundles need: their std imports read its interface.
pub fn run_rt_bundle_build_action(ctx: ActionCtx) -> i32:
    let args = ctx.args()
    let compiler = wo_arg_value(args, "compiler=")
    let dir = wo_arg_value(args, "dir=")
    let root_path = wo_arg_value(args, "root=")
    // A cross target's bundle: compiled and checked for that triple, as
    // its runtime objects are (cross_object_target_with).
    let triple = wo_arg_value(args, "target=")
    if compiler.len() == 0 or dir.len() == 0 or root_path.len() == 0:
        return rb_fail(ctx, "requires compiler=, dir= and root= arguments")
    let fs = ctx.fs()
    let root = ctx.project_info().project_root()
    let capture_dir = "out/command/" ++ ctx.target_name()
    if fs.mkdir_all(dir) != 0 or fs.mkdir_all(capture_dir) != 0:
        return rb_fail(ctx, "could not create " ++ dir)
    let obj = dir ++ "/rt.o"
    let wi = dir ++ "/rt.wi"
    let manifest = dir ++ "/rt.manifest"
    let fp_source = dir ++ "/rt.fp"
    let fp_wi = dir ++ "/rt.wi.fp"
    var build_args: List[str] = List.new()
    build_args.push(rb_abs(root, compiler))
    build_args.push("build")
    build_args.push(rb_abs(root, root_path))
    build_args.push("--emit-obj")
    build_args.push("--no-prelude")
    if triple.len() > 0: build_args.push("--target=" ++ triple)
    build_args.push("--bundle-corpus")
    build_args.push("rt")
    build_args.push("--emit-bundle-interface")
    build_args.push(rb_abs(root, wi))
    build_args.push("--emit-bundle-manifest")
    build_args.push(rb_abs(root, manifest))
    build_args.push("--bundle-fingerprint")
    build_args.push(rb_abs(root, fp_source))
    build_args.push("-O1")
    build_args.push("-o")
    build_args.push(rb_abs(root, obj))
    let built = rb_run(ctx, "build", &build_args, true)
    if built.rc != 0:
        return rb_fail(ctx, f"runtime bundle build failed with exit code {built.rc}; captures under {capture_dir}\n" ++ built.stderr)
    if not fs.exists(obj) or not fs.exists(wi) or not fs.exists(manifest) or not fs.exists(fp_source):
        return rb_fail(ctx, "runtime bundle build wrote no object, interface, manifest or fingerprint under " ++ dir)
    // D39: the interface reproduces the source's exported declarations
    // exactly (the second fingerprint pass, out of process).
    var check_args: List[str] = List.new()
    check_args.push(rb_abs(root, compiler))
    check_args.push("check")
    check_args.push(rb_abs(root, wi))
    check_args.push("--no-prelude")
    if triple.len() > 0: check_args.push("--target=" ++ triple)
    check_args.push("--bundle-corpus")
    check_args.push("rt")
    check_args.push("--bundle-fingerprint")
    check_args.push(rb_abs(root, fp_wi))
    let checked = rb_run(ctx, "check-wi", &check_args, false)
    if checked.rc != 0:
        return rb_fail(ctx, f"check of the runtime interface failed with exit code {checked.rc}; captures under {capture_dir}\n" ++ checked.stderr)
    let source_fp = rb_first_line(fs.read_text(fp_source))
    let wi_fp = rb_first_line(fs.read_text(fp_wi))
    if source_fp.len() != 64 or source_fp != wi_fp:
        return rb_fail(ctx, "fingerprint of the runtime interface (" ++ wi_fp ++ ") differs from the source fingerprint (" ++ source_fp ++ "); diff " ++ fp_source ++ ".tsv against " ++ fp_wi ++ ".tsv")
    0

// args: left=<dir> right=<dir>. The bundle stage1 built (stage2 embeds it)
// and the one stage2 built (stage3 embeds it) are the same bytes, object
// and interface: D30's cache rule, proven at the fixpoint tier.
pub fn run_rt_bundle_fixpoint_action(ctx: ActionCtx) -> i32:
    let args = ctx.args()
    let left = wo_arg_value(args, "left=")
    let right = wo_arg_value(args, "right=")
    if left.len() == 0 or right.len() == 0:
        return rb_fail(ctx, "requires left= and right= arguments")
    let fs = ctx.fs()
    for kind in ["o", "wi", "manifest"]:
        let a = left ++ "/rt." ++ kind
        let b = right ++ "/rt." ++ kind
        let sa = fs.sha256_file(a)
        let sb = fs.sha256_file(b)
        if sa.len() == 0 or sb.len() == 0:
            return rb_fail(ctx, "missing " ++ a ++ " or " ++ b)
        if sa != sb:
            return rb_fail(ctx, "RUNTIME BUNDLE FIXPOINT FAILED: " ++ a ++ " (" ++ sa ++ ") differs from " ++ b ++ " (" ++ sb ++ "): the runtime stage1 compiled is not the one stage2 compiled (D30 §10: a cache hit is the in-unit result, byte for byte)")
    print("[rt-bundle-fixpoint] stage1 == stage2 over rt.o, rt.wi and rt.manifest")
    if fs.write_text(ctx.output(), "ok\n") != 0:
        return rb_fail(ctx, "cannot write " ++ ctx.output())
    0
