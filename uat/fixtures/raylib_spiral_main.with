use c_import("raylib.h")

fn draw_spiral(cx: f64, cy: f64, t: f64):
    for i in 0..180:
        let p = (i as f64) / 180.0
        let angle = p * 18.8495559215 + t * 0.8
        let radius = 28.0 + p * 250.0 + sin(t * 1.4 + p * 6.0) * 18.0
        let x = cx + cos(angle) * radius
        let y = cy + sin(angle) * radius
        let hue = (p * 360.0 + t * 50.0) as f32
        let col = ColorFromHSV(hue, 0.86 as f32, 1.0 as f32)
        DrawCircle(x as i32, y as i32, (4.0 + p * 4.0) as f32, col)

fn is_spiral_sample(c: Color) -> bool:
    let r = c.r as i32
    let g = c.g as i32
    let b = c.b as i32
    (r > 70 or g > 70 or b > 70) and (r + g + b > 170)

fn main:
    InitWindow(900, 600, "with raylib spiral uat")
    // No window means no GL context: every later call would run on nothing
    // (LoadImageFromScreen crashed with exit 139 on a host whose driver stops
    // at OpenGL 1.1). Say so and fail; a headless host needs a software GL.
    if not IsWindowReady():
        print("raylib spiral UAT failed: window not created (no OpenGL 3.3 context)")
        return 1

    let font = GetFontDefault()
    if not IsFontValid(font):
        print("raylib spiral UAT failed: default font not valid")
        UnloadFont(font)
        CloseWindow()
        return 1

    let bg = Color { r: 14, g: 16, b: 26, a: 255 }
    let label_pos = Vector2 { x: 20.0 as f32, y: 20.0 as f32 }
    let cx = 450.0
    let cy = 300.0
    let t = 1.25

    var frame = 0
    while frame < 10:
        let _ = IsKeyDown(KEY_SPACE)
        BeginDrawing()
        ClearBackground(bg)
        draw_spiral(cx, cy, t)
        DrawTextEx(font, "with raylib spiral uat", label_pos, 20.0 as f32, 1.0 as f32, LIGHTGRAY)
        EndDrawing()
        frame = frame + 1

    let image = LoadImageFromScreen()
    // Upload screen capture to a GPU texture, draw it once, then unload in order.
    let tex = LoadTextureFromImage(image)
    if IsTextureValid(tex):
        BeginDrawing()
        ClearBackground(bg)
        DrawTexture(tex, 0, 0, WHITE)
        EndDrawing()
    UnloadTexture(tex)

    var colored = 0
    var samples = 0

    var y = 40
    while y < 560:
        var x = 40
        while x < 860:
            let dx = (x as f64) - cx
            let dy = (y as f64) - cy
            let dist2 = dx * dx + dy * dy
            if dist2 > 900.0 and dist2 < 90000.0:
                samples = samples + 1
                if is_spiral_sample(GetImageColor(image, x, y)):
                    colored = colored + 1
            x = x + 6
        y = y + 6

    // Exercise AudioStream lifecycle when an audio device is available on the host.
    InitAudioDevice()
    if IsAudioDeviceReady():
        if let Some(stream) = LoadAudioStream(44100, 16, 1):
            let _ = IsAudioStreamValid(stream)
            PlayAudioStream(stream)
            StopAudioStream(stream)
            UnloadAudioStream(stream)
        CloseAudioDevice()

    UnloadImage(image)
    UnloadFont(font)
    CloseWindow()

    if samples < 4000:
        print(f"raylib spiral UAT failed: only sampled {samples} pixels")
        return 1
    if colored < 120:
        print(f"raylib spiral UAT failed: only found {colored} bright spiral samples")
        return 1

    print(f"raylib spiral UAT passed: {colored}/{samples} bright spiral samples")
    0
