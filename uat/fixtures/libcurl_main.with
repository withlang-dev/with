// Release UAT: libcurl through its registry facade (#3143, #3111). Zero
// `unsafe`, zero project facade: Easy handle, HeaderList (CURLOPT_HTTPHEADER),
// Mime + Part (CURLOPT_MIMEPOST), basic auth & timeout options, WRITEFUNCTION
// + HEADERFUNCTION callbacks, getinfo (CURLINFO_RESPONSE_CODE), file transfer,
// curl_version_info, and curl_version.
use contracts.libcurl
use c_import("curl/curl.h")
use std.fs

fn on_data(ptr: *mut c_char, size: u64, nmemb: u64, sink: &fn(i32) -> Unit) -> u64:
    sink((size * nmemb) as i32)
    size * nmemb

fn on_header(ptr: *mut c_char, size: u64, nmemb: u64, sink: &fn(i32) -> Unit) -> u64:
    sink((size * nmemb) as i32)
    size * nmemb

fn fetch_bytes(path: &str) -> Result[i32, SetoptError]:
    var total: i32 = 0
    var hdr_bytes: i32 = 0
    let body_sink = n => total = total + n
    let hdr_sink = n => hdr_bytes = hdr_bytes + n
    let Some(headers) = HeaderList.new("Accept: application/json") else:
        print("libcurl slist new failed")
        return Ok(-1)
    let headers = match headers.append("X-With-UAT: 1"):
        Ok(h) => h
        Err(HeaderListError.FailedWithResource(_, old)) => old
    let Some(easy_val) = Easy.new() else:
        print("libcurl easy init failed")
        return Ok(-1)
    var easy = easy_val
    easy.nosignal(1)?
    easy.timeout(10)?
    easy.connecttimeout(5)?
    easy.userpwd("user:pass")?
    easy.httpheader(&headers)?
    easy.url("file://" ++ path)?
    easy.writefunction(on_data)?
    easy.writedata(body_sink)?
    easy.headerfunction(on_header)?
    easy.headerdata(hdr_sink)?
    if easy.perform() != CURLE_OK: return Ok(-1)
    match easy.getinfo(CURLINFO_RESPONSE_CODE):
        Ok(_) => {}
        Err(_) => return Ok(-1)
    // Exercise multipart Mime + Part builder and CURLOPT_MIMEPOST retention.
    easy.reset()
    let Some(mime) = easy.mime() else:
        print("libcurl mime create failed")
        return Ok(-1)
    let Some(part) = mime.addpart() else:
        print("libcurl mime addpart failed")
        return Ok(-1)
    let _ = part.name("payload")
    let _ = part.filename("data.json")
    let _ = part.mime_type("application/json")
    let payload = "{\"ok\":true}"
    let _ = part.data(payload as []u8)
    let mime_res = easy.mimepost(&mime)
    easy.reset()
    mime_res?
    if hdr_bytes <= 0: return Ok(-1)
    total

fn version_number() -> u32:
    let info = curl_version_info(CURLVERSION_NOW)
    if info.is_none(): 0 else: info.unwrap().version_num

fn main:
    let init_rc = curl_global_init(CURL_GLOBAL_DEFAULT)
    if init_rc != CURLE_OK:
        print("libcurl global init failed")
        return 1

    let path = "/tmp/with-libcurl-uat.txt"
    let body = "libcurl UAT body\n"
    if write_file(path, body) != 0:
        print("libcurl UAT could not write its file")
        curl_global_cleanup()
        return 1
    let fetched = match fetch_bytes(path):
        Ok(n) => n
        Err(_) => -1
    if fetched != body.len() as i32:
        print("libcurl transfer failed")
        curl_global_cleanup()
        return 1

    if version_number() == 0:
        print("libcurl version info failed")
        curl_global_cleanup()
        return 1
    if curl_version().is_none():
        print("libcurl version missing")
        curl_global_cleanup()
        return 1

    curl_global_cleanup()
    print("libcurl UAT passed")
