run: with -n 'if line =~ /^[0-9]$/: print(line)'
expect stdout:
    1
    2
    3
    4
    5
    6
    7
    8
    9
write names.txt:
    Ada Lovelace
    Grace Hopper
    Katherine Johnson
    Margaret Hamilton
stdin:
    Ada Lovelace
    Grace Hopper
    Katherine Johnson
    Margaret Hamilton
run: with -p 'line = line.upper()'
expect stdout:
    ADA LOVELACE
    GRACE HOPPER
    KATHERINE JOHNSON
    MARGARET HAMILTON
stdin:
    error 42
    ok
    warning 7
run: with -n 'if line =~ /(?<kind>error|warning) (\d+)/: print(f"{nr}: {$kind.upper()} code={$2}")'
expect stdout:
    1: ERROR code=42
    3: WARNING code=7
stdin:
    apple
    banana
    pear
run: with -p 'line = f"{nr}:{line.upper()}"'
expect stdout:
    1:APPLE
    2:BANANA
    3:PEAR
stdin:
    abc
run: with -p 'line = line.upper(); line = line ++ "!"'
expect stdout: ABC!
run: with -e 'for arg in args: print(arg.upper())' -- alpha beta gamma
expect stdout:
    ALPHA
    BETA
    GAMMA
