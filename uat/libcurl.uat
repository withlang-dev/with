scenario: libcurl from a fresh project, over the facade with get writes
requires: network
platforms: darwin, linux
# D171, #2757: on darwin and linux-x86_64 libcurl uses Conan Center's openssl
# binary; on linux-aarch64 (no openssl binary and openssl's Configure needs
# Perl) with get selects mbedtls (3.6 line) from source cleanly. Windows is
# not yet enabled here.

new directory
run: with init .
run: with get c.libcurl
expect stderr contains: facade libcurl:
write src/main.with from libcurl_main.with
run: with run
expect stdout: libcurl UAT passed
