scenario: SDL opens a window and draws from a fresh project
requires: network, display
platforms: darwin, windows, linux-x86_64
# D171: only where with get provides the whole chain cleanly. SDL's Linux
# chain requires dbus, a Conan Center binary on linux-x86_64 and a meson
# build (Python, a host tool) on linux-aarch64, where Conan Center has no
# armv8 binaries (#2903).

new directory
run: with init .
run: with get c.sdl
write src/main.w from sdl_main.w
copy lib/facades/sdl.w to src/facades/sdl.w
run: with check src/main.w
expect stdout: ok
run: with run
expect exit: 0
expect stdout contains: sdl UAT passed:
